}

test "inflate rejects corrupt input" {
    fixed = [203, 72, 205, 201, 201, 87, 200, 192, 78, 2, 0]
    cut = [fixed[0], fixed[1], fixed[2]]
    assert_eq(xl_inflate(cut, 0, 3) or "bad", "bad")
    // block type 3 is reserved
    assert_eq(xl_inflate([7, 0, 0, 0], 0, 4) or "bad", "bad")
    // stored block whose NLEN does not complement LEN
    assert_eq(xl_inflate([1, 3, 0, 3, 0, 65, 66, 67], 0, 8) or "bad", "bad")
    // stored block longer than the input
    assert_eq(xl_inflate([1, 9, 0, 246, 255, 65], 0, 6) or "bad", "bad")
    // good stored block for contrast
    good = xl_inflate([1, 3, 0, 252, 255, 65, 66, 67], 0, 8) or []
    assert_eq(host.sys_bytes_to_str(good), "ABC")
    // match distance before the start of output (fixed block: match with distance 1 but no literals)
    assert_eq(xl_inflate([3, 2, 0], 0, 3) or "bad", "bad")
    assert_eq(xl_inflate([], 0, 0) or "bad", "bad")
    assert_eq(xl_inflate(fixed, 0, 99) or "bad", "bad")
    assert_eq(xl_inflate(fixed, -1, 2) or "bad", "bad")
    // truncated dynamic block
    dyn = [109, 85, 11, 110, 172, 48, 12, 188, 10, 87, 203, 182, 81, 23, 61, 194, 162, 150, 72, 21, 167, 127, 177, 199, 142, 199, 108, 37, 150, 13, 177, 61, 158, 248, 151, 173, 180, 199, 103, 89, 234, 241, 179, 110, 175, 125, 217, 251, 242, 168, 103, 89, 190, 74, 107, 101, 249, 89, 191, 198, 251, 179, 110, 99, 167, 245, 229, 44, 38, 253, 126, 190, 22, 249, 39, 213, 223, 85, 30, 172, 207, 231, 29, 98, 136, 84, 87, 16, 0, 7, 157, 137, 40, 11, 249, 185, 127, 136, 117, 9, 4, 39, 248, 175, 28, 135, 226, 249, 6, 115, 20, 4, 40, 96, 247, 18, 251, 16, 201, 175, 226, 40, 216, 132, 150, 145, 118, 42, 221, 128, 101, 125, 172, 113, 128, 13, 145, 122, 181, 245, 227, 123, 136, 69, 223, 215, 205, 221, 130, 246, 21, 39, 8, 108, 40, 72, 228, 142, 55, 44, 200, 220, 49, 108, 192, 80, 244, 135, 111, 69, 220, 114, 170, 142, 117, 134, 149, 67, 45, 190, 76, 211, 254, 6, 187, 30, 54, 204, 27, 118, 120, 175, 47, 156, 23, 95, 10, 107, 103, 34, 3, 236, 140, 36, 13, 204, 178, 29, 207, 194, 33, 184, 56, 122, 160, 127, 24, 193, 64, 115, 246, 8, 207, 174, 25, 159, 94, 21, 193, 17, 135, 0, 39, 82, 102, 110, 247, 187, 242, 238, 248, 106, 10, 1, 184, 154, 34, 120, 241, 150, 213, 155, 190, 193, 220, 98, 161, 90, 10, 6, 130, 16, 190, 185, 163, 32, 82, 132, 93, 77, 210, 228, 226, 7, 31, 2, 198, 56, 38, 158, 25, 24, 47, 245, 72, 32, 27, 82, 233, 154, 175, 132, 15, 9, 184, 106, 89, 255, 209, 13, 68, 25, 138, 225, 165, 71, 187, 187, 165, 134, 128, 76, 154, 230, 5, 72, 147, 179, 179, 27, 203, 241, 32, 96, 134, 154, 242, 110, 148, 189, 166, 46, 31, 26, 22, 92, 251, 106, 119, 222, 16, 139, 136, 161, 21, 197, 244, 47, 235, 95, 36, 18, 86, 120, 139, 130, 185, 133, 144, 251, 120, 86, 155, 213, 201, 57, 59, 113, 22, 50, 222, 206, 24, 53, 71, 40, 45, 117, 251, 120, 120, 212, 241, 72, 27, 198, 220, 172, 216, 113, 148, 156, 15, 184, 231, 118, 223, 187, 91, 232, 65, 99, 234, 64, 105, 239, 220, 29, 84, 229, 169, 212, 115, 5, 115, 251, 214, 27, 13, 26, 11, 111, 185, 200, 99, 151, 99, 20, 147, 137, 186, 196, 195, 74, 97, 140, 166, 23, 221, 24, 248, 92, 28, 115, 186, 86, 174, 110, 10, 182, 24, 216, 16, 100, 143, 153, 157, 72, 162, 188, 82, 11, 245, 63, 131, 146, 226, 69, 249, 225, 107, 225, 65, 105, 116, 7, 144, 204, 190, 32, 197, 40, 44, 61, 23, 53, 169, 216, 229, 113, 192, 221, 232, 146, 91, 147, 243, 64, 241, 219, 86, 129, 93, 63, 177, 137, 248, 202, 138, 2, 203, 19, 133, 146, 53, 139, 237, 230, 157, 107, 122, 222, 230, 145, 70, 152, 213, 232, 136, 52, 59, 252, 99, 102, 142, 90, 3, 67, 158, 238, 69, 47, 111, 225, 187, 207, 146, 176, 58, 106, 61, 19, 154, 61, 106, 187, 56, 155, 251, 241, 127, 168, 4, 24, 135, 48, 202, 144, 187, 141, 25, 210, 168, 137, 4, 198, 221, 64, 193, 211, 239, 253, 222, 46, 154, 130, 210, 233, 114, 39, 196, 7, 31, 153, 246, 185, 16, 116, 3, 203, 158, 238, 44, 18, 131, 106, 62, 112, 138, 137, 211, 155, 179, 143, 187, 42, 170, 4, 56, 87, 125, 63, 108, 36, 59, 66, 22, 123, 92, 124, 97, 61, 211, 19, 88, 60, 46, 162, 82, 235, 89, 254, 3]
    assert_eq(xl_inflate(dyn, 0, 100) or "bad", "bad")
    // flipping bits inside a dynamic block never crashes: it either fails or yields different bytes
    broken = dyn
    broken[20] = (broken[20] ^ 255)
    r = xl_inflate(broken, 0, host.sys_arr_len(broken)) or []
    #assert(host.sys_arr_len(r) != 2671 || ar_crc32(r) != 1694200615)
}

test "huffman table helpers" {
    h = xl_huff([2, 1, 3, 3], 4)
    #assert(xl_huff_valid(h))
    assert_eq(h.counts[1], 1)
    assert_eq(h.counts[2], 1)
    assert_eq(h.counts[3], 2)
    assert_eq(h.symbols[0], 1)
    assert_eq(h.symbols[1], 0)
    assert_eq(h.symbols[2], 2)
    assert_eq(h.symbols[3], 3)
    // over-subscribed: three codes of length 1
    #assert(!(xl_huff_valid(xl_huff([1, 1, 1], 3))))
    // incomplete is accepted (a single code)
    #assert(xl_huff_valid(xl_huff([1], 1)))
}

test "reads a DEFLATE-compressed workbook written by another tool" {
    bytes = xl_foreign()
    entries = xl_zip_entries(bytes) or []
    assert_eq(host.sys_arr_len(entries), 6)
    first: ZipEntry = entries[0]
    assert_eq(first.method, 8)
    assert_eq(first.name, "[Content_Types].xml")
    wb = xlsx_read(bytes) or XlWorkbook.new()
    assert_eq(wb.sheet_count(), 2)
    assert_eq(wb.sheet_names()[0], "Data & More")
    assert_eq(wb.sheet_names()[1], "Second")
    d = wb.sheet(0)
    assert_eq(d.height(), 5)
    assert_eq(d.width(), 8)
    assert_eq(d.get(0, 0).text, "Name")
    assert_eq(d.get(0, 1).text, "Rich text & more")
    assert_eq(d.get(0, 2).text, "  padded  ")
    assert_eq(d.get(1, 0).kind, XL_EMPTY)
    assert_eq(d.get(2, 0).num, 0.0015)
    assert_eq(d.get(2, 1).kind, XL_EMPTY)
    assert_eq(d.get(2, 2).num, 42.0)
    assert_eq(d.get(2, 3).kind, XL_BOOL)
    #assert(d.get(2, 3).flag)
    assert_eq(d.get(2, 4).text, "xy")
    assert_eq(d.get(2, 5).text, "#DIV/0!")
    assert_eq(d.get(2, 6).text, "inline")
    assert_eq(d.get(2, 7).kind, XL_EMPTY)
    assert_eq(d.get(3, 0).kind, XL_EMPTY)
    assert_eq(d.get(4, 0).num, -7.0)
    assert_eq(d.get(4, 1).kind, XL_BOOL)
    #assert(!(d.get(4, 1).flag))
    assert_eq(d.get(4, 2).kind, XL_EMPTY)
    assert_eq(d.get(4, 3).num, 12345678901.0)
    assert_eq(d.get(4, 4).kind, XL_EMPTY)
    two = wb.sheet(1)
    assert_eq(two.name, "Second")
    assert_eq(two.get(0, 0).num, 10.0)
    assert_eq(two.get(0, 1).num, 20.25)
    assert_eq(xl_target_path("worksheets/a.xml"), "xl/worksheets/a.xml")
    assert_eq(xl_target_path("/xl/worksheets/a.xml"), "xl/worksheets/a.xml")
    // the foreign workbook survives a trip through our own writer
    again = xlsx_read(wb.to_bytes() or []) or XlWorkbook.new()
    assert_eq(again.cell(0, 0, 1).text, "Rich text & more")
    assert_eq(again.cell(0, 4, 3).num, 12345678901.0)
    assert_eq(again.cell(1, 0, 1).num, 20.25)
}

test "reader rejects damaged files" {
    assert_eq(xlsx_read([]) or "bad", "bad")
    assert_eq(xlsx_read([1, 2, 3, 4]) or "bad", "bad")
    junk = []
    for 0..100 { junk = host.sys_arr_push(junk, it) }
    assert_eq(xlsx_read(junk) or "bad", "bad")
    good = xl_foreign()
    // flip a byte inside the compressed data of the first member: CRC or inflate must object
    broken = good
    broken[60] = (broken[60] ^ 255)
    first: ZipEntry = (xl_zip_entries(good) or [])[0]
    #assert(first.data_off <= 60 && 60 < first.data_off + first.comp_size)
    assert_eq(xl_member_bytes(broken, (xl_zip_entries(broken) or [])[0]) or "bad", "bad")
    // missing workbook part
    z = ZipWriter.new()
    @z.add("hello.txt", host.sys_str_to_bytes("hi"), 0, 0) or false
    assert_eq(xlsx_read(z.finish()) or "bad", "bad")
    msg = xlsx_read(z.finish()) or err { "{err}" }
    assert_eq(msg, "xlsx: missing member xl/workbook.xml")
    // workbook without sheets
    z2 = ZipWriter.new()
    @z2.add("xl/workbook.xml", host.sys_str_to_bytes("<workbook><sheets></sheets></workbook>"), 0, 0) or false
    msg2 = xlsx_read(z2.finish()) or err { "{err}" }
    assert_eq(msg2, "xlsx: workbook has no sheets")
    // sheet part missing
    z3 = ZipWriter.new()
    @z3.add("xl/workbook.xml", host.sys_str_to_bytes("<workbook><sheets><sheet name=\"A\" sheetId=\"1\"/></sheets></workbook>"), 0, 0) or false
    msg3 = xlsx_read(z3.finish()) or err { "{err}" }
    assert_eq(msg3, "xlsx: missing member xl/worksheets/sheet1.xml")
    // malformed XML inside a sheet
    z4 = ZipWriter.new()
    @z4.add("xl/workbook.xml", host.sys_str_to_bytes("<workbook><sheets><sheet name=\"A\" sheetId=\"1\"/></sheets></workbook>"), 0, 0) or false
    @z4.add("xl/worksheets/sheet1.xml", host.sys_str_to_bytes("<worksheet><sheetData><row></worksheet>"), 0, 0) or false
    assert_eq(xlsx_read(z4.finish()) or "bad", "bad")
    // an unsupported compression method is reported
    z5 = ZipWriter.new()
    @z5.add("xl/workbook.xml", host.sys_str_to_bytes("<workbook/>"), 0, 0) or false
    img = z5.finish()
    img[8] = 99
    img[9] = 0
    ents = xl_zip_entries(img) or []
    e5: ZipEntry = ents[0]
    img2 = img
    assert_eq(e5.method, 0)
    img2[host.sys_arr_len(img2) - 22 - 46 - 15 + 10] = 99
    msg5 = xlsx_read(img2) or err { "{err}" }
    #assert(contains(msg5, "unsupported compression method 99"))
}

test "minimal third-party sheet without shared strings or rels" {
    z = ZipWriter.new()
    @z.add("xl/workbook.xml", host.sys_str_to_bytes("<workbook><sheets><sheet name=\"Only\" sheetId=\"1\"/></sheets></workbook>"), 0, 0) or false
    @z.add("xl/worksheets/sheet1.xml", host.sys_str_to_bytes("<worksheet><sheetData><row r=\"2\"><c r=\"B2\"><v>3</v></c><c r=\"A2\" t=\"inlineStr\"><is><r><t>ab</t></r><r><t>cd</t></r></is></c></row></sheetData></worksheet>"), 0, 0) or false
    wb = xlsx_read(z.finish()) or XlWorkbook.new()
    assert_eq(wb.sheet_count(), 1)
    assert_eq(wb.sheet(0).height(), 2)
    // cells are placed by reference even when listed out of order
    assert_eq(wb.cell(0, 1, 0).text, "abcd")
    assert_eq(wb.cell(0, 1, 1).num, 3.0)
}

test "resolve cell kinds" {
    strings = ["zero", "one"]
    assert_eq(xl_resolve_cell("s", "1", "", strings).text, "one")
    assert_eq(xl_resolve_cell("s", "7", "", strings).kind, XL_EMPTY)
    assert_eq(xl_resolve_cell("s", "x", "", strings).kind, XL_EMPTY)
    #assert(xl_resolve_cell("b", "1", "", strings).flag)
    #assert(!(xl_resolve_cell("b", "0", "", strings).flag))
    assert_eq(xl_resolve_cell("", "2.5", "", strings).num, 2.5)
    assert_eq(xl_resolve_cell("n", "2.5", "", strings).num, 2.5)
    assert_eq(xl_resolve_cell("", "", "", strings).kind, XL_EMPTY)
    assert_eq(xl_resolve_cell("", "oops", "", strings).text, "oops")
    assert_eq(xl_resolve_cell("inlineStr", "", "hey", strings).text, "hey")
    assert_eq(xl_resolve_cell("str", "calc", "", strings).text, "calc")
    assert_eq(xl_resolve_cell("e", "#N/A", "", strings).text, "#N/A")
    assert_eq(xl_resolve_cell("d", "2020-01-02", "", strings).text, "2020-01-02")
}

test "file round trip" {
    dir = host.sys_temp_dir() or "/tmp"
    path = "{dir}/super_xlsx_roundtrip_test.xlsx"
    wb = XlWorkbook.new()
    s = @wb.add_sheet("Disk")
    @wb.push_row(s, [xl_text("k"), xl_num(2.5), xl_bool(true)])
    #assert(xlsx_write_file(path, wb) or false)
    back = xlsx_read_file(path) or XlWorkbook.new()
    assert_eq(back.cell(0, 0, 0).text, "k")
    assert_eq(back.cell(0, 0, 1).num, 2.5)
    #assert(back.cell(0, 0, 2).flag)
    assert_eq(xlsx_read_file("{dir}/super_xlsx_missing_file.xlsx") or "bad", "bad")
    assert_eq(xlsx_write_file(path, XlWorkbook.new()) or "bad", "bad")
    fs_remove(path) or false
}

test "large sheet round trip" {
    wb = XlWorkbook.new()
    s = @wb.add_sheet("Big")
    for 0..300 {
        label = "row{it % 17}"
        v = host.sys_to_float(it) * 0.5
        @wb.push_row(s, [xl_text(label), xl_num(v), xl_bool(it % 2 == 0), xl_num(host.sys_to_float(it * it))])
    }
    back = xlsx_read(wb.to_bytes() or []) or XlWorkbook.new()
    sh = back.sheet(0)
    assert_eq(sh.height(), 300)
    assert_eq(sh.width(), 4)
    assert_eq(sh.count(), 1200)
    assert_eq(sh.get(299, 1).num, 149.5)
    assert_eq(sh.get(17, 0).text, "row0")
    assert_eq(sh.get(100, 3).num, 10000.0)
    #assert(!(sh.get(3, 2).flag))
    st = XlStrings.new()
    xml = xl_sheet_xml(sh, @st)
    assert_eq(host.sys_arr_len(st.keys), 17)
    assert_eq(st.total, 300)
    assert_eq(xml_attr_of(xml, "dimension", "ref") or "?", "A1:D300")
}
