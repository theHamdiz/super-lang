test "column names and references" {
    assert_eq(xl_col_name(0), "A")
    assert_eq(xl_col_name(25), "Z")
    assert_eq(xl_col_name(26), "AA")
    assert_eq(xl_col_name(27), "AB")
    assert_eq(xl_col_name(51), "AZ")
    assert_eq(xl_col_name(52), "BA")
    assert_eq(xl_col_name(701), "ZZ")
    assert_eq(xl_col_name(702), "AAA")
    assert_eq(xl_col_name(16383), "XFD")
    assert_eq(xl_col_name(-1), "")
    assert_eq(xl_col_index("A"), 0)
    assert_eq(xl_col_index("ab"), 27)
    assert_eq(xl_col_index("XFD"), 16383)
    assert_eq(xl_col_index(""), -1)
    assert_eq(xl_col_index("A1"), -1)
    for 0..1500 { assert_eq(xl_col_index(xl_col_name(it)), it) }
    assert_eq(xl_ref(0, 0), "A1")
    assert_eq(xl_ref(11, 27), "AB12")
    assert_eq(xl_ref(1048575, 16383), "XFD1048576")
    p = xl_parse_ref("AB12")
    assert_eq(p[0], 11)
    assert_eq(p[1], 27)
    q = xl_parse_ref("$C$3")
    assert_eq(q[0], 2)
    assert_eq(q[1], 2)
    assert_eq(xl_parse_ref("12")[0], -1)
    assert_eq(xl_parse_ref("A")[0], -1)
    assert_eq(xl_parse_ref("A0")[0], -1)
    assert_eq(xl_parse_ref("1A")[0], -1)
    assert_eq(xl_parse_ref("")[1], -1)
    for 0..60 {
        rr = xl_parse_ref(xl_ref(it * 7, it * 13))
        assert_eq(rr[0], it * 7)
        assert_eq(rr[1], it * 13)
    }
}

test "sheet name validation" {
    #assert(xl_valid_sheet_name("Sheet1"))
    #assert(xl_valid_sheet_name("Data & More"))
    #assert(!(xl_valid_sheet_name("")))
    #assert(xl_valid_sheet_name("abcdefghijklmnopqrstuvwxyz12345"))
    #assert(!(xl_valid_sheet_name("abcdefghijklmnopqrstuvwxyz123456")))
    #assert(!(xl_valid_sheet_name("a/b")))
    #assert(!(xl_valid_sheet_name("a\\b")))
    #assert(!(xl_valid_sheet_name("a:b")))
    #assert(!(xl_valid_sheet_name("a*b")))
    #assert(!(xl_valid_sheet_name("a?b")))
    #assert(!(xl_valid_sheet_name("[a]")))
}

test "number parsing and printing" {
    assert_eq(xl_parse_num("42") or -1.0, 42.0)
    assert_eq(xl_parse_num("-42") or 0.0, -42.0)
    assert_eq(xl_parse_num("+42") or 0.0, 42.0)
    assert_eq(xl_parse_num("  3.25 ") or 0.0, 3.25)
    assert_eq(xl_parse_num(".5") or 0.0, 0.5)
    assert_eq(xl_parse_num("-.5") or 0.0, -0.5)
    assert_eq(xl_parse_num("7.") or 0.0, 7.0)
    assert_eq(xl_parse_num("1.5E-3") or 0.0, 0.0015)
    assert_eq(xl_parse_num("2e3") or 0.0, 2000.0)
    assert_eq(xl_parse_num("2E+3") or 0.0, 2000.0)
    assert_eq(xl_parse_num("-1.25e2") or 0.0, -125.0)
    assert_eq(xl_parse_num("1e0") or 0.0, 1.0)
    assert_eq(xl_parse_num("12345678901") or 0.0, 12345678901.0)
    assert_eq(xl_parse_num("0.1") or 0.0, 0.1)
    assert_eq(xl_parse_num("") or 99.0, 99.0)
    assert_eq(xl_parse_num("abc") or 99.0, 99.0)
    assert_eq(xl_parse_num("1.2.3") or 99.0, 99.0)
    assert_eq(xl_parse_num("-") or 99.0, 99.0)
    assert_eq(xl_parse_num(".") or 99.0, 99.0)
    assert_eq(xl_parse_num("e5") or 99.0, 99.0)
    assert_eq(xl_parse_num("1e") or 99.0, 99.0)
    assert_eq(xl_parse_num("1e+") or 99.0, 99.0)
    assert_eq(xl_parse_num("1e5e2") or 99.0, 99.0)
    assert_eq(xl_parse_num("1-2") or 99.0, 99.0)
    assert_eq(xl_parse_num("1e2.5") or 99.0, 99.0)
    assert_eq(xl_num_text(3.0), "3")
    assert_eq(xl_num_text(-12.0), "-12")
    assert_eq(xl_num_text(0.5), "0.5")
    assert_eq(xl_num_text(0.0), "0")
    assert_eq(xl_num_text(-0.25), "-0.25")
    assert_eq(xl_num_text(123456789012.0), "123456789012")
    assert_eq(xl_num_text(0.1 + 0.2), "0.30000000000000004")
    // text -> number -> text is stable
    for [0.0, 1.0, -3.5, 1234.5678, 0.001, 99999.0, -0.75] {
        assert_eq(xl_parse_num(xl_num_text(it)) or -1.0e9, it)
    }
}

test "cells" {
    #assert(xl_empty().is_empty())
    #assert(!(xl_num(1.0).is_empty()))
    assert_eq(xl_num(2.0).show(), "2")
    assert_eq(xl_num(2.5).show(), "2.5")
    assert_eq(xl_text("hi").show(), "hi")
    assert_eq(xl_bool(true).show(), "true")
    assert_eq(xl_bool(false).show(), "false")
    assert_eq(xl_empty().show(), "")
    assert_eq(xl_auto("").kind, XL_EMPTY)
    assert_eq(xl_auto("   ").kind, XL_EMPTY)
    assert_eq(xl_auto("12").kind, XL_NUM)
    assert_eq(xl_auto("12").num, 12.0)
    assert_eq(xl_auto("-1.5").num, -1.5)
    #assert(xl_auto("TRUE").flag)
    assert_eq(xl_auto("false").kind, XL_BOOL)
    assert_eq(xl_auto("12abc").kind, XL_STR)
    assert_eq(xl_auto("12abc").text, "12abc")
    assert_eq(xl_auto(" pad ").text, " pad ")
}

test "workbook model" {
    wb = XlWorkbook.new()
    assert_eq(wb.sheet_count(), 0)
    assert_eq(@wb.add_sheet("A"), 0)
    assert_eq(@wb.add_sheet("B"), 1)
    assert_eq(@wb.add_sheet("a"), -1)
    assert_eq(@wb.add_sheet("bad/name"), -1)
    assert_eq(@wb.add_sheet(""), -1)
    assert_eq(wb.sheet_count(), 2)
    assert_eq(wb.sheet_index("b"), 1)
    assert_eq(wb.sheet_index("zzz"), -1)
    names = wb.sheet_names()
    assert_eq(names[0], "A")
    assert_eq(names[1], "B")
    assert_eq(wb.sheet(0).height(), 0)
    assert_eq(wb.sheet(0).width(), 0)
    assert_eq(wb.sheet(7).name, "")
    assert_eq(wb.sheet(-1).name, "")
    // sparse put grows rows and columns
    #assert(@wb.put(0, 2, 3, xl_num(5.0)))
    assert_eq(wb.sheet(0).height(), 3)
    assert_eq(wb.sheet(0).width(), 4)
    assert_eq(wb.cell(0, 2, 3).num, 5.0)
    assert_eq(wb.cell(0, 2, 0).kind, XL_EMPTY)
    assert_eq(wb.cell(0, 0, 0).kind, XL_EMPTY)
    assert_eq(wb.cell(0, 9, 9).kind, XL_EMPTY)
    assert_eq(wb.cell(0, -1, 0).kind, XL_EMPTY)
    assert_eq(wb.cell(5, 0, 0).kind, XL_EMPTY)
    assert_eq(wb.sheet(0).count(), 1)
    // overwrite
    #assert(@wb.put(0, 2, 3, xl_text("x")))
    assert_eq(wb.cell(0, 2, 3).text, "x")
    assert_eq(wb.sheet(0).count(), 1)
    // out of range writes are refused
    #assert(!(@wb.put(0, -1, 0, xl_num(1.0))))
    #assert(!(@wb.put(0, 0, -1, xl_num(1.0))))
    #assert(!(@wb.put(0, XL_MAX_ROWS, 0, xl_num(1.0))))
    #assert(!(@wb.put(0, 0, XL_MAX_COLS, xl_num(1.0))))
    #assert(!(@wb.put(9, 0, 0, xl_num(1.0))))
    #assert(!(@wb.push_row(9, [])))
    // rows
    #assert(@wb.push_row(1, [xl_text("a"), xl_num(1.0)]))
    #assert(@wb.push_row(1, [xl_text("b")]))
    assert_eq(wb.sheet(1).height(), 2)
    assert_eq(wb.sheet(1).width(), 2)
    assert_eq(wb.cell(1, 1, 0).text, "b")
    assert_eq(wb.cell(1, 1, 1).kind, XL_EMPTY)
    assert_eq(wb.sheet(1).count(), 3)
}

test "write and read round trip" {
    wb = XlWorkbook.new()
    s0 = @wb.add_sheet("Report")
    @wb.push_row(s0, [xl_text("name"), xl_text("value"), xl_text("flag")])
    @wb.push_row(s0, [xl_text("alpha"), xl_num(1.5), xl_bool(true)])
    @wb.push_row(s0, [xl_text("beta"), xl_num(-2.0), xl_bool(false)])
    @wb.push_row(s0, [xl_text("alpha"), xl_num(1234567.125), xl_empty()])
    @wb.push_row(s0, [xl_text("<tag> & \"quotes\" 'single'"), xl_num(0.000125), xl_bool(true)])
    @wb.push_row(s0, [xl_text("  leading and trailing  "), xl_num(0.0), xl_text("")])
    @wb.push_row(s0, [xl_text("line1\nline2\ttab"), xl_num(99999999999.0), xl_text("héllo wörld ✓ 日本")])
    s1 = @wb.add_sheet("Sparse & Co")
    @wb.put(s1, 4, 5, xl_text("far"))
    @wb.put(s1, 0, 0, xl_num(1.0))
    @wb.put(s1, 2, 27, xl_bool(true))
    s2 = @wb.add_sheet("Empty")
    assert_eq(s2, 2)
    bytes = wb.to_bytes() or []
    #assert(host.sys_arr_len(bytes) > 500)
    back = xlsx_read(bytes) or XlWorkbook.new()
    assert_eq(back.sheet_count(), 3)
    names = back.sheet_names()
    assert_eq(names[0], "Report")
    assert_eq(names[1], "Sparse & Co")
    assert_eq(names[2], "Empty")
    rep = back.sheet(0)
    assert_eq(rep.height(), 7)
    assert_eq(rep.width(), 3)
    assert_eq(rep.get(0, 0).text, "name")
    assert_eq(rep.get(1, 0).text, "alpha")
    assert_eq(rep.get(1, 1).num, 1.5)
    assert_eq(rep.get(1, 2).kind, XL_BOOL)
    #assert(rep.get(1, 2).flag)
    assert_eq(rep.get(2, 1).num, -2.0)
    #assert(!(rep.get(2, 2).flag))
    assert_eq(rep.get(3, 1).num, 1234567.125)
    assert_eq(rep.get(3, 2).kind, XL_EMPTY)
    assert_eq(rep.get(4, 0).text, "<tag> & \"quotes\" 'single'")
    assert_eq(rep.get(4, 1).num, 0.000125)
    assert_eq(rep.get(5, 0).text, "  leading and trailing  ")
    assert_eq(rep.get(5, 1).kind, XL_NUM)
    assert_eq(rep.get(5, 2).kind, XL_STR)
    assert_eq(rep.get(5, 2).text, "")
    assert_eq(rep.get(6, 0).text, "line1\nline2\ttab")
    assert_eq(rep.get(6, 1).num, 99999999999.0)
    assert_eq(rep.get(6, 2).text, "héllo wörld ✓ 日本")
    sp = back.sheet(1)
    assert_eq(sp.height(), 5)
    assert_eq(sp.width(), 28)
    assert_eq(sp.get(0, 0).num, 1.0)
    assert_eq(sp.get(4, 5).text, "far")
    #assert(sp.get(2, 27).flag)
    assert_eq(sp.get(2, 26).kind, XL_EMPTY)
    assert_eq(sp.count(), 3)
    assert_eq(back.sheet(2).height(), 0)
    // writing again from the read model is a fixed point
    again = back.to_bytes() or []
    assert_eq(host.sys_arr_len(again), host.sys_arr_len(bytes))
    assert_eq(ar_crc32(again), ar_crc32(bytes))
}

test "sparse writes beyond column Z round trip" {
    wb = XlWorkbook.new()
    s = @wb.add_sheet("S")
    @wb.put(s, 2, 27, xl_bool(true))
    @wb.put(s, 0, 702, xl_num(7.0))
    back = xlsx_read(wb.to_bytes() or []) or XlWorkbook.new()
    #assert(back.cell(0, 2, 27).flag)
    assert_eq(back.cell(0, 0, 702).num, 7.0)
    assert_eq(back.sheet(0).width(), 703)
    assert_eq(back.sheet(0).count(), 2)
}

test "package layout" {
    wb = XlWorkbook.new()
    a = @wb.add_sheet("One")
    b = @wb.add_sheet("Two <&>")
    @wb.push_row(a, [xl_text("x"), xl_text("y"), xl_text("x")])
    @wb.push_row(b, [xl_num(1.0)])
    bytes = wb.to_bytes() or []
    entries = xl_zip_entries(bytes) or []
    names = []
    for entries {
        item = it
        e: ZipEntry = item
        names = host.sys_arr_push(names, e.name)
        assert_eq(e.method, 0)
        #assert(ar_zip_verify(bytes, e))
    }
    assert_eq(host.sys_arr_len(names), 8)
    assert_eq(names[0], "[Content_Types].xml")
    assert_eq(names[1], "_rels/.rels")
    assert_eq(names[2], "xl/workbook.xml")
    assert_eq(names[3], "xl/_rels/workbook.xml.rels")
    assert_eq(names[4], "xl/styles.xml")
    assert_eq(names[5], "xl/sharedStrings.xml")
    assert_eq(names[6], "xl/worksheets/sheet1.xml")
    assert_eq(names[7], "xl/worksheets/sheet2.xml")
    #assert(xl_has_member(entries, "xl/styles.xml"))
    #assert(!(xl_has_member(entries, "xl/nothing.xml")))
    sst = xl_member_text(bytes, entries, "xl/sharedStrings.xml") or ""
    assert_eq(xml_count(sst, "si") or -1, 2)
    assert_eq(xml_attr_of(sst, "sst", "count") or "?", "3")
    assert_eq(xml_attr_of(sst, "sst", "uniqueCount") or "?", "2")
    wbx = xl_member_text(bytes, entries, "xl/workbook.xml") or ""
    assert_eq(xml_count(wbx, "sheet") or -1, 2)
    assert_eq(xml_attr_of(wbx, "sheet", "name") or "?", "One")
    #assert(contains(wbx, "Two &lt;&amp;&gt;"))
    sheet = xl_member_text(bytes, entries, "xl/worksheets/sheet1.xml") or ""
    assert_eq(xml_attr_of(sheet, "dimension", "ref") or "?", "A1:C1")
    assert_eq(xml_count(sheet, "c") or -1, 3)
    // every part is well-formed XML
    for entries {
        item = it
        e: ZipEntry = item
        xml = xl_member_text(bytes, entries, e.name) or ""
        summary = xml_summary(xml) or ""
        #assert(summary != "")
    }
    // deterministic output
    assert_eq(ar_crc32(wb.to_bytes() or []), ar_crc32(bytes))
}

test "writer edge cases" {
    empty = XlWorkbook.new()
    msg = empty.to_bytes() or err { "{err}" }
    assert_eq(msg, "xlsx: a workbook needs at least one sheet")
    wb = XlWorkbook.new()
    s = @wb.add_sheet("S")
    bad = host.sys_sqrt(-1.0)
    @wb.push_row(s, [xl_num(bad), xl_text("a\x01b\x02"), xl_num(1.0e300 * 1.0e300), xl_num(2.0)])
    back = xlsx_read(wb.to_bytes() or []) or XlWorkbook.new()
    assert_eq(back.cell(0, 0, 0).kind, XL_EMPTY)
    assert_eq(back.cell(0, 0, 1).text, "ab")
    assert_eq(back.cell(0, 0, 2).kind, XL_EMPTY)
    assert_eq(back.cell(0, 0, 3).num, 2.0)
    assert_eq(xl_clean("plain"), "plain")
    assert_eq(xl_clean("a\x00b\tc\nd\re"), "ab\tc\nd\re")
    // dimension of an empty sheet
    only = XlWorkbook.new()
    @only.add_sheet("Blank")
    sheet = xl_sheet_xml(only.sheet(0), @XlStrings.new())
    assert_eq(xml_attr_of(sheet, "dimension", "ref") or "?", "A1")
}

test "shared string table dedupes and counts uses" {
    st = XlStrings.new()
    assert_eq(@st.intern("a"), 0)
    assert_eq(@st.intern("b"), 1)
    assert_eq(@st.intern("a"), 0)
    assert_eq(@st.intern(""), 2)
    assert_eq(@st.intern("b"), 1)
    assert_eq(st.total, 5)
    assert_eq(host.sys_arr_len(st.keys), 3)
    // many distinct strings exercise hash probing
    big = XlStrings.new()
    for 0..400 { assert_eq(@big.intern("k{it}"), it) }
    for 0..400 { assert_eq(@big.intern("k{it}"), it) }
    assert_eq(host.sys_arr_len(big.keys), 400)
    assert_eq(big.total, 800)
    xml = xl_strings_xml(st)
    #assert(contains(xml, "count=\"5\" uniqueCount=\"3\""))
    assert_eq(xl_hash("") , 5381)
}

