//! std.fmt.bin — compact binary encoding primitives
//!
//! Import with:
//!   use std.fmt.bin
//!
//! Varints (LEB128), zigzag signed ints, checksums (Adler-32, FNV-1a) and a
//! self-checking frame:  [varint payload_len][payload bytes][adler32 big-endian]
//!
//!   wire = frame([1, 2, 3])
//!   payload = unframe(wire) or err { return }
//!
//! Bytes are `i64` values in 0..255 held in arrays; array growth uses `arr_push`
//! from std.core.collections. All arithmetic is overflow-safe in i64.

use std.core.collections
use std.math.core

/// `ADLER_MOD` is `65521`.
+ADLER_MOD = 65521
/// `FNV_OFFSET` is `2166136261`.
+FNV_OFFSET = 2166136261
/// `FNV_PRIME` is `16777619`.
+FNV_PRIME = 16777619
/// `U32` is `4294967296`.
+U32 = 4294967296

/// Bin len (`a`). Returns `i64`.
+bin_len(a: _) : i64 {
    n = 0
    for a { n += 1 }
    n
}

/// Same as `arr_push`.
+bin_push(a: _, v: i64)  => arr_push(a, v)

/// Bin pow (`base`, `n`). Returns `i64`.
+bin_pow(base: i64, n: i64) : i64 {
    acc = 1
    for 0..n { acc = acc * base }
    acc
}

/// Bitwise XOR of two non-negative integers below 2^32.
+bit_xor(a: i64, b: i64) : i64 {
    out = 0
    x = a
    y = b
    place = 1
    for 0..32 {
        out += ((x % 2 + y % 2) % 2) * place
        x = x / 2
        y = y / 2
        place = place * 2
    }
    out
}

// --- zigzag ----------------------------------------------------------------------

/// Zigzag encoding of the signed integer `n`, so small negatives stay small.
+zigzag_encode(n: i64) : i64 {
    if n >= 0 {
        n * 2
    } else {
        (-n) * 2 - 1
    }
}

/// Signed integer encoded by `u`.
+zigzag_decode(u: i64) : i64 {
    if u % 2 == 0 {
        u / 2
    } else {
        0 - (u + 1) / 2
    }
}

// --- varint (unsigned LEB128) ------------------------------------------------------

/// How many LEB128 bytes `n` needs.
+varint_len(n: i64) : i64 {
    size = 1
    rest = n / 128
    for 0..9 {
        if rest > 0 {
            size += 1
            rest = rest / 128
        }
    }
    size
}

/// k-th encoded byte of `n` (continuation bit set on all but the last).
+varint_byte(n: i64, k: i64) : i64 {
    chunk = (n / bin_pow(128, k)) % 128
    if k + 1 < varint_len(n) { return chunk + 128 }
    chunk
}

/// Unsigned LEB128 bytes for `n`.
+varint_encode(n: i64) {
    out = []
    for 0..varint_len(n) { out = bin_push(out, varint_byte(n, it)) }
    out
}

/// Decode the varint at `pos`.
+varint_decode(bytes: _, pos: i64) : i64! {
    total = bin_len(bytes)
    ensure pos < total else {
        fail "varint: truncated"
        return
    }
    acc = 0
    shift = 1
    live = true
    for 0..9 {
        at = pos + it
        if live && at < total {
            b = bytes[at]
            acc += (b % 128) * shift
            shift = shift * 128
            if b < 128 { live = false }
        }
    }
    ensure !live else {
        fail "varint: unterminated"
        return
    }
    acc
}

/// Position just past the varint at `pos`.
+varint_next(bytes: _, pos: i64) : i64 {
    total = bin_len(bytes)
    end = pos
    live = true
    for 0..9 {
        at = pos + it
        if live && at < total {
            end = at + 1
            if bytes[at] < 128 { live = false }
        }
    }
    end
}

// --- checksums -----------------------------------------------------------------------

/// Checksum of `bytes`.
+adler32(bytes: _) : i64 {
    a = 1
    b = 0
    for bytes {
        a = (a + it) % ADLER_MOD
        b = (b + a) % ADLER_MOD
    }
    b * 65536 + a
}

/// Fnv1a32 (`bytes`). Returns `i64`.
+fnv1a32(bytes: _) : i64 {
    h = FNV_OFFSET
    for bytes {
        low = h % 256
        h = h - low + (bit_xor(low, it))
        h = (h * FNV_PRIME) % U32
    }
    h
}

// --- fixed-width big-endian words ---------------------------------------------------------

/// Big-endian unsigned 32-bit word stored in the four bytes of `bytes` starting at `at`.
#inline
+be32_get(bytes: _, at: i64) : i64 => (bytes[at] << 24) | (bytes[at + 1] << 16) | (bytes[at + 2] << 8) | bytes[at + 3]

/// Store the low 32 bits of `v` big-endian into the four bytes of `bytes` starting at `at`.
#inline
+be32_put(@bytes, at: i64, v: i64) {
    bytes[at] = (v >> 24) & 255
    bytes[at + 1] = (v >> 16) & 255
    bytes[at + 2] = (v >> 8) & 255
    bytes[at + 3] = v & 255
}

/// Store 64 bits of `v` big-endian into eight bytes starting at `at`.
#inline
+be64_put(@bytes, at: i64, v: i64) {
    be32_put(@bytes, at, v >> 32)
    be32_put(@bytes, at + 4, v & 4294967295)
}

// --- frames ----------------------------------------------------------------------------

/// Frame (`payload`).
+frame(payload: _) {
    out = varint_encode(bin_len(payload))
    for payload { out = bin_push(out, it) }
    sum = adler32(payload)
    for 0..4 { out = bin_push(out, (sum / bin_pow(256, 3 - it)) % 256) }
    out
}

/// Unframe (`wire`), or fail.
+unframe(wire: _) : _! {
    total = bin_len(wire)
    plen = varint_decode(wire, 0) or err {
        fail "frame: bad length"
        return
    }
    start = varint_next(wire, 0)
    ensure start + plen + 4 <= total else {
        fail "frame: truncated"
        return
    }
    payload = []
    for 0..plen { payload = bin_push(payload, wire[start + it]) }
    stored = 0
    for 0..4 { stored = stored * 256 + wire[start + plen + it] }
    ensure stored == adler32(payload) else {
        fail "frame: checksum mismatch"
        return
    }
    payload
}

// --- tests -------------------------------------------------------------------------------

/// Test that zigzag maps small magnitudes to small codes.
test "zigzag maps small magnitudes to small codes" {
    assert_eq(zigzag_encode(0), 0)
    assert_eq(zigzag_encode(-1), 1)
    assert_eq(zigzag_encode(1), 2)
    assert_eq(zigzag_encode(-2), 3)
    assert_eq(zigzag_decode(0), 0)
    assert_eq(zigzag_decode(1), -1)
    assert_eq(zigzag_decode(4), 2)
}

/// Test that zigzag round trips.
test "zigzag round trips" {
    for [0, 1, -1, 63, -64, 1000, -1000, 2147483647, -2147483648] {
        assert_eq(zigzag_decode(zigzag_encode(it)), it)
    }
}

/// Test that varint lengths and bytes.
test "varint lengths and bytes" {
    assert_eq(varint_len(0), 1)
    assert_eq(varint_len(127), 1)
    assert_eq(varint_len(128), 2)
    assert_eq(varint_len(16383), 2)
    assert_eq(varint_len(16384), 3)
    assert_eq(varint_byte(300, 0), 172)
    assert_eq(varint_byte(300, 1), 2)
    assert_eq(varint_byte(5, 0), 5)
}

/// Test that varint encode / decode round trip.
test "varint encode / decode round trip" {
    enc = varint_encode(300)
    assert_eq(bin_len(enc), 2)
    assert_eq(enc[0], 172)
    assert_eq(enc[1], 2)
    assert_eq(varint_decode(enc, 0) or -1, 300)
    assert_eq(varint_next(enc, 0), 2)
    big = varint_encode(1234567890)
    assert_eq(varint_decode(big, 0) or -1, 1234567890)
}

/// Test that varint decode rejects truncation.
test "varint decode rejects truncation" {
    assert_eq(varint_decode([], 0) or -1, -1)
    assert_eq(varint_decode([128], 0) or -1, -1)
    assert_eq(varint_decode([1, 2, 3], 1) or -1, 2)
}

/// Test that bit_xor.
test "bit_xor" {
    assert_eq(bit_xor(0, 0), 0)
    assert_eq(bit_xor(5, 3), 6)
    assert_eq(bit_xor(255, 255), 0)
    assert_eq(bit_xor(4294967295, 1), 4294967294)
}

/// Test that adler32 known vectors.
test "adler32 known vectors" {
    assert_eq(adler32([]), 1)
    assert_eq(adler32([87, 105, 107, 105, 112, 101, 100, 105, 97]), 300286872)
}

/// Test that fnv1a32 known vectors.
test "fnv1a32 known vectors" {
    assert_eq(fnv1a32([]), 2166136261)
    assert_eq(fnv1a32([97]), 3826002220)
}

/// Test that big-endian words round trip and land in network byte order.
test "be32 get / put" {
    b = [0; 8]
    be32_put(@b, 2, 305419896)
    assert_eq(b[2], 18)
    assert_eq(b[3], 52)
    assert_eq(b[4], 86)
    assert_eq(b[5], 120)
    assert_eq(b[0], 0)
    assert_eq(b[6], 0)
    assert_eq(be32_get(b, 2), 305419896)
    be32_put(@b, 4, 4294967295)
    assert_eq(be32_get(b, 4), 4294967295)
    assert_eq(b[3], 52)
    be32_put(@b, 0, 4294967296 + 7)
    assert_eq(be32_get(b, 0), 7)
    assert_eq(be32_get([0, 0, 1, 0], 0), 256)
}

/// Test that frame / unframe round trip.
test "frame / unframe round trip" {
    wire = frame([1, 2, 3, 250])
    assert_eq(bin_len(wire), 1 + 4 + 4)
    assert_eq(wire[0], 4)
    back = unframe(wire) or []
    assert_eq(bin_len(back), 4)
    assert_eq(back[3], 250)
    assert_eq(bin_len(unframe(frame([])) or [9]), 0)
}

/// Test that unframe detects corruption.
test "unframe detects corruption" {
    wire = frame([10, 20, 30])
    bad = [3, 10, 21, 30, wire[4], wire[5], wire[6], wire[7]]
    assert_eq(bin_len(unframe(bad) or [9, 9]), 2)
    assert_eq(bin_len(unframe([5, 1]) or [9, 9]), 2)
    assert_eq(bin_len(unframe([]) or [9, 9]), 2)
}
