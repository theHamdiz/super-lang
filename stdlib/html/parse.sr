//! std.html.parse -- tolerant HTML to text/Markdown parser
//!
//! Import: use std.html.parse

use std.core.str
use std.core.collections

+HtmlDoc = {
    text: str = ""
    markdown: str = ""
    links: _ = []
    tags: _ = []
}

+parse_html(src: str) : HtmlDoc {
    text = ""
    md = ""
    links = []
    tags = []
    n = host.sys_str_len(src)
    i = 0
    in_script = false
    in_style = false
    while i < n {
        if src[i] == "<" {
            j = i + 1
            while j < n && src[j] != ">" { j = j + 1 }
            if j >= n { break }
            tag = src[(i + 1)..j]
            low = html_lower(tag)
            closing = starts_with(low, "/")
            name = html_tag_name(low)
            if name == "script" {
                in_script = !closing
            } else {
                if name == "style" {
                    in_style = !closing
                } else {
                    if !closing && !in_script && !in_style {
                        tags = host.sys_arr_push(tags, name)
                        if name == "a" {
                            href = html_attr(tag, "href")
                            links = host.sys_arr_push(links, {href: href, text: ""})
                        }
                        if name == "p" || name == "div" || name == "br" || name == "li" {
                            text = text + "\n"
                            md = md + "\n"
                        }
                        if name == "h1" { md = md + "\n# " }
                        if name == "h2" { md = md + "\n## " }
                    }
                }
            }
            i = j + 1
        } else {
            if !in_script && !in_style {
                if src[i] == "&" {
                    ent = html_entity(src, i, n)
                    text = text + ent.text
                    md = md + ent.text
                    i = ent.next
                } else {
                    text = text + src[i]
                    md = md + src[i]
                    i = i + 1
                }
            } else {
                i = i + 1
            }
        }
    }
    HtmlDoc.{text: html_collapse(text), markdown: html_collapse(md), links, tags}
}

+select_count(doc: HtmlDoc, sel: str) : i64 {
    c = 0
    n = host.sys_arr_len(doc.tags)
    for 0..n {
        if doc.tags[it] == sel { c = c + 1 }
    }
    c
}

+html_lower(s: str) : str {
    out = ""
    n = host.sys_str_len(s)
    for 0..n {
        cp = host.sys_ord(s[it])
        if cp >= 65 && cp <= 90 { cp = cp + 32 }
        out = out + host.sys_chr(cp)
    }
    out
}

+html_tag_name(low: str) : str {
    s = low
    if starts_with(s, "/") {
        sn = host.sys_str_len(s)
        s = s[1..sn]
    }
    out = ""
    n = host.sys_str_len(s)
    for 0..n {
        c = s[it]
        cp = host.sys_ord(c)
        ok = (cp >= 97 && cp <= 122) || (cp >= 48 && cp <= 57)
        if !ok { return out }
        out = out + c
    }
    out
}

+html_attr(tag: str, key: str) : str {
    needle = key + "=\""
    pos = host.sys_str_find(tag, needle)
    if pos < 0 { return "" }
    start = pos + host.sys_str_len(needle)
    end = start
    n = host.sys_str_len(tag)
    while end < n && tag[end] != "\"" { end = end + 1 }
    tag[start..end]
}

+HtmlEntity = {
    text: str = ""
    next: i64 = 0
}

+html_entity(s: str, i: i64, n: i64) : HtmlEntity {
    if html_starts(s, i, n, "&amp;") { return HtmlEntity.{text: "&", next: i + 5} }
    if html_starts(s, i, n, "&lt;") { return HtmlEntity.{text: "<", next: i + 4} }
    if html_starts(s, i, n, "&gt;") { return HtmlEntity.{text: ">", next: i + 4} }
    if html_starts(s, i, n, "&quot;") { return HtmlEntity.{text: "\"", next: i + 6} }
    if html_starts(s, i, n, "&#39;") { return HtmlEntity.{text: "'", next: i + 5} }
    HtmlEntity.{text: s[i], next: i + 1}
}

+html_starts(s: str, i: i64, n: i64, pref: str) : bool {
    pn = host.sys_str_len(pref)
    if i + pn > n { return false }
    starts_with(s[i..(i + pn)], pref)
}

+html_collapse(s: str) : str {
    out = ""
    n = host.sys_str_len(s)
    space = false
    for 0..n {
        c = s[it]
        if c == " " || c == "\n" || c == "\t" || c == "\r" {
            if !space {
                out = out + " "
                space = true
            }
        } else {
            out = out + c
            space = false
        }
    }
    trim(out)
}

test "strips script and style" {
    doc = parse_html("<p>hi</p><script>alert(1)</script><style>x{}</style><p>yo</p>")
    #assert(!(contains(doc.text, "alert")))
    #assert(contains(doc.text, "hi"))
    #assert(contains(doc.text, "yo"))
}

test "decodes entities" {
    doc = parse_html("a&amp;b&lt;c&gt;")
    #assert(contains(doc.text, "a&b<c>"))
}

test "extracts links and selectors" {
    doc = parse_html("<div><a href=\"https://ex.com\">x</a><a href=\"/y\">y</a></div>")
    assert_eq(host.sys_arr_len(doc.links), 2)
    assert_eq(doc.links[0].href, "https://ex.com")
    assert_eq(select_count(doc, "a"), 2)
    assert_eq(select_count(doc, "div"), 1)
}

test "tolerates broken markup" {
    doc = parse_html("<p>unclosed <b>bold <div>ok")
    #assert(contains(doc.text, "unclosed"))
    #assert(contains(doc.text, "ok"))
}

test "markdown headings" {
    doc = parse_html("<h1>Title</h1><p>Body</p>")
    #assert(contains(doc.markdown, "# Title"))
}
