//! Laws for std.sec.secret — redaction invariant (pure model).
//! Implementation: `Secret.of` / `display` in `secret.sr`.

law_secret_payload_len(_s: str) : i64 => 1

law_secret_display_redacted() : str => "***"

#law("secret payload length model is positive")
secret_of_total() {
    #assert(law_secret_payload_len("x") == 1)
}

#law("secret display model is redacted")
secret_display_total() {
    #assert(law_secret_display_redacted() == "***")
}
