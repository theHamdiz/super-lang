//! std.sec.secret — in-memory Secret[T] with redaction and zeroization
//!
//! Boundary vs `std.sec.vault`:
//!   - **secret** (this module): process-local `Secret` values. Payload is redacted
//!     by Display/Debug/log interpolation, compared in constant time, and wiped by
//!     `clear` / `drop` (Drop trait; call at scope exit / early return — auto-drop
//!     lowering is not yet universal). Optional `FileKeyring` is a local
//!     AEAD-encrypted named store for Secrets (not a remote vault).
//!   - **vault** (`std.sec.vault`): HashiCorp Vault-shaped named storage (KV/auth/
//!     transit) and HTTP path builders. Vault APIs accept/return `Secret` from this
//!     module so plaintext never lands in logs by accident.
//!
//! Import: use std.sec.secret

use std.sec.csprng
use std.sec.crypto
use std.diag.log

/// In-memory secret. Display/Debug always redact; call `reveal` only at the edge.
+Secret: Display, Debug, Drop = {
    payload: str = ""
    alive: bool = true

    display(self) : str => "Secret(***)"
    debug(self) : str => "Secret(***)"

    of(raw: str) : Secret => Secret.{payload: raw, alive: true}

    /// Constant-time equality of payloads.
    eq_secret(self, other: Secret) : bool => ct_eq(self.payload, other.payload)

    /// Explicit reveal (greppable). Prefer never logging the result.
    reveal(self) : str => self.payload

    /// Overwrite payload bytes then clear. Safe to call more than once.
    clear(@self) : bool {
        n = host.sys_str_len(self.payload)
        zeros = ""
        for 0..n {
            zeros = zeros + host.sys_chr(0)
        }
        self.payload = zeros
        self.payload = ""
        self.alive = false
        true
    }

    /// Drop witness: zeroize on scope exit / early return paths that drop the value.
    drop(@self) {
        @self.clear()
    }
}

+KeyringEntry = {
    name: str = ""
    blob_hex: str = ""
}

/// Local AEAD file keyring for named Secrets (not HashiCorp Vault — see std.sec.vault).
+FileKeyring = {
    path: str = ""
    master_hex: str = ""
    items: _ = []

    open(path: str, master_hex: str) : FileKeyring => FileKeyring.{path, master_hex, items: []}

    derive_master(passphrase: str, salt_hex: str) : str => pbkdf2_hex(passphrase, salt_hex, 210000, 32)

    put(@self, name: str, secret: Secret) : bool! {
        ct = seal(self.master_hex, secret.reveal()) or err {
            fail err
            return
        }
        found = false
        n = host.sys_arr_len(self.items)
        out = []
        for 0..n {
            e = self.items[it]
            if e.name == name {
                out = host.sys_arr_push(out, KeyringEntry.{name, blob_hex: ct})
                found = true
            } else {
                out = host.sys_arr_push(out, e)
            }
        }
        if !found { out = host.sys_arr_push(out, KeyringEntry.{name, blob_hex: ct}) }
        self.items = out
        @self.flush()
        true
    }

    get(self, name: str) : Secret! {
        n = host.sys_arr_len(self.items)
        for 0..n {
            e = self.items[it]
            if e.name == name {
                pt = open_seal(self.master_hex, e.blob_hex) or err {
                    fail err
                    return
                }
                return Secret.of(pt)
            }
        }
        fail "secret: key not found: {name}"
    }

    flush(self) : bool {
        body = ""
        n = host.sys_arr_len(self.items)
        for 0..n {
            e = self.items[it]
            body = body + e.name + "=" + e.blob_hex + "\n"
        }
        host.sys_write_str(self.path, body)
    }
}

+seal(master_hex: str, plaintext: str) : str! {
    nonce = fill_hex(12) or err {
        fail err
        return
    }
    stream = hmac_sha256_hex(master_hex, nonce + ":0")
    ct = xor_hex_str(plaintext, stream)
    tag = hmac_sha256_hex(master_hex, nonce + ":" + ct)
    nonce + ct + tag
}

+open_seal(master_hex: str, blob: str) : str! {
    bl = host.sys_str_len(blob)
    ensure bl >= 24 + 64 else {
        fail "secret: blob too short"
        return
    }
    nonce = blob[0..24]
    rest = blob[24..bl]
    rn = host.sys_str_len(rest)
    ct = rest[0..(rn - 64)]
    tag = rest[(rn - 64)..rn]
    expect = hmac_sha256_hex(master_hex, nonce + ":" + ct)
    ensure ct_eq(tag, expect) else {
        fail "secret: AEAD tag mismatch"
        return
    }
    stream = hmac_sha256_hex(master_hex, nonce + ":0")
    xor_hex_str_decode(ct, stream)
}

+xor_hex_str(plaintext: str, stream_hex: str) : str {
    out = ""
    n = host.sys_str_len(plaintext)
    sn = host.sys_str_len(stream_hex) / 2
    for 0..n {
        pc = host.sys_ord(plaintext[it])
        hi = hex_val(stream_hex[((it % sn) * 2)])
        lo = hex_val(stream_hex[((it % sn) * 2) + 1])
        out = out + hex2(pc ^ (hi * 16 + lo))
    }
    out
}

+xor_hex_str_decode(ct_hex: str, stream_hex: str) : str {
    out = ""
    n = host.sys_str_len(ct_hex) / 2
    sn = host.sys_str_len(stream_hex) / 2
    for 0..n {
        hi = hex_val(ct_hex[it * 2])
        lo = hex_val(ct_hex[it * 2 + 1])
        shi = hex_val(stream_hex[((it % sn) * 2)])
        slo = hex_val(stream_hex[((it % sn) * 2) + 1])
        out = out + host.sys_chr((hi * 16 + lo) ^ (shi * 16 + slo))
    }
    out
}

+hex_val(c: str) : i64 {
    cp = host.sys_ord(c)
    if cp >= 48 && cp <= 57 { return cp - 48 }
    if cp >= 97 && cp <= 102 { return cp - 87 }
    if cp >= 65 && cp <= 70 { return cp - 55 }
    0
}

+HEXD = "0123456789abcdef"
+hex2(v: i64) : str => HEXD[(v / 16) % 16] + HEXD[v % 16]

/// Nested holder used by redaction doc tests.
+AuthCtx: Display = {
    user: str = ""
    token: Secret = Secret.{}

    display(self) : str => "AuthCtx(user=" + self.user + ", token=" + "{self.token}" + ")"
}

test "Secret redacts on display and interpolation" {
    s = Secret.of("sk-live-super-secret")
    assert_eq("{s}", "Secret(***)")
    assert_eq(s.reveal(), "sk-live-super-secret")
    #assert(host.sys_str_find("{s}", "sk-live") < 0)
}

test "Secret never appears in logs when redaction is on" {
    s = Secret.of("sk-live-nested-secret")
    ctx = AuthCtx.{user: "amina", token: s}
    lg = Logger.headless("api")
    @lg.infof("login", [field("user", ctx.user), field("token", "{ctx.token}"), field("secret", s.reveal())])
    // field named token/secret must redact values; Display of Secret must not leak.
    dump = lg.dump()
    #assert(host.sys_str_find(dump, "sk-live") < 0)
    #assert(host.sys_str_find("{ctx}", "sk-live") < 0)
    err_msg = "auth failed for {ctx}"
    #assert(host.sys_str_find(err_msg, "sk-live") < 0)
}

/// Scope-exit discipline helper: always wipe before leaving (Drop is explicit until runtime auto-drops).
secret_scope_exit_demo(raw: str) : str {
    s = Secret.of(raw)
    shown = "{s}"
    // Scope exit: Drop witness must run so payload cannot outlive the frame.
    @s.drop()
    // After drop, memory inspect via reveal must be empty (no residual plaintext).
    left = s.reveal()
    shown + "|" + left + "|" + "{host.sys_str_len(left)}"
}

secret_early_return_demo(take_early: bool) : str {
    s = Secret.of("early-return-secret")
    if take_early {
        @s.clear()
        return "early|" + s.reveal()
    }
    out = s.reveal()
    @s.clear()
    "full|" + out + "|" + s.reveal()
}

test "zeroization on clear and early return" {
    s = Secret.of("wipe-me-now-please")
    assert_eq(s.reveal(), "wipe-me-now-please")
    @s.clear()
    assert_eq(s.reveal(), "")
    #assert(!(s.alive))

    // Scope-exit path: drop at end of helper frame; payload length is 0.
    scoped = secret_scope_exit_demo("scope-exit-secret")
    assert_eq(scoped, "Secret(***)||0")
    #assert(host.sys_str_find(scoped, "scope-exit") < 0)

    // Early-return path: clear before return; reveal is empty afterwards.
    early = secret_early_return_demo(true)
    assert_eq(early, "early|")
    #assert(host.sys_str_find(early, "early-return") < 0)
    full = secret_early_return_demo(false)
    assert_eq(full, "full|early-return-secret|")
}

test "ct compare and drop witness" {
    a = Secret.of("same")
    b = Secret.of("same")
    c = Secret.of("diff")
    #assert(a.eq_secret(b))
    #assert(!(a.eq_secret(c)))
    @a.drop()
    assert_eq(a.reveal(), "")
}

test "file keyring put/get round-trip with tag check" {
    master = FileKeyring.derive_master("test-pass", "00aa11bb")
    kr = FileKeyring.open("/tmp/super-secret-keyring-test.cfg", master)
    ok = @kr.put("api", Secret.of("tok-123")) or false
    #assert(ok)
    got = kr.get("api") or Secret.of("")
    assert_eq(got.reveal(), "tok-123")
    e = kr.items[0]
    last = host.sys_str_len(e.blob_hex) - 1
    flipped = e.blob_hex[0..last] + "0"
    if e.blob_hex[last] == "0" { flipped = e.blob_hex[0..last] + "1" }
    kr.items = [KeyringEntry.{name: e.name, blob_hex: flipped}]
    failed = false
    _ = kr.get("api") or err {
        failed = true
        Secret.of("")
    }
    #assert(failed)
}
