//! Laws for std.sec.argon2 — constant-time compare (pure model).
//! Implementation: `a2_ct_eq` in `argon2.sr`.

law_a2_ct_eq_len(a: _, b: _) : i64 {
    la = 0
    for a { la += 1 }
    lb = 0
    for b { lb += 1 }
    if la != lb { return -1 }
    la
}

law_a2_ct_eq_empty() : bool => true

#law("ct_eq model accepts equal empty lengths")
argon2_ct_eq_empty() {
    #assert(law_a2_ct_eq_len([], []) == 0)
    #assert(law_a2_ct_eq_empty())
}

#law("ct_eq model rejects length mismatch")
argon2_ct_eq_sym() {
    #assert(law_a2_ct_eq_len([1], []) == -1)
    #assert(law_a2_ct_eq_len([], [1]) == -1)
}
