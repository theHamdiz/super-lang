//! std.sys.env — environment variables and `.env` files
//!
//! Import with:
//!   use std.sys.env
//!
//! Then:
//!   port = env_int("PORT", 8080)
//!   secret = env_require("JWT_SECRET") or err { return }
//!   cfg = env_parse(fs_read_str(".env") or "")
//!   host = cfg.get_or("HOST", "localhost")
//!
//! `env_get` & friends call the host intrinsics `sys_env_get` / `sys_env_set`.
//! `env_parse` is a pure `.env` parser, so it works (and is tested) offline.

/// `EnvMap` is a process environment as parallel key and value lists.
+EnvMap = {
    /// Keys on `EnvMap`. Defaults to `[]`.
    keys: _ = []
    /// Vals on `EnvMap`. Defaults to `[]`.
    vals: _ = []

    /// Create a fresh `EnvMap`.
    new() : EnvMap => EnvMap.{keys: [], vals: []}

    /// Slot of key `key`, or -1.
    slot(self, key: str) : i64 {
        pos = -1
        names = self.keys
        for names {
            if it == key { pos = index }
        }
        pos
    }

    /// Value of `key`, or empty when unset, or `none` when absent.
    get(self, key: str) : str? {
        at = self.slot(key)
        ensure at >= 0 else { return none }
        vals = self.vals
        vals[at]
    }

    /// Value of `key`, or `default` when unset.
    get_or(self, key: str, default: str) : str {
        v = self.get(key) or default
        v
    }

    /// Set `key` to `value` in this map.
    put(@self, key: str, value: str) : i64 {
        at = self.slot(key)
        if at >= 0 {
            self.vals = host.sys_arr_set(self.vals, at, value)
            at
        } else {
            self.keys = host.sys_arr_push(self.keys, key)
            self.vals = host.sys_arr_push(self.vals, value)
            self.slot(key)
        }
    }
}

/// Length of the environment text `s`.
+env_len(s: str) : i64 => host.sys_str_len(s)

// --- host-backed ----------------------------------------------------------------

/// Process environment value of `name`, or `none` when absent.
+env_get(name: str) : str? {
    v = host.sys_env_get(name) or none
    v
}

/// Process environment value of `name`, or `default` when unset.
+env_get_or(name: str, default: str) : str {
    v = host.sys_env_get(name) or default
    v
}

/// Set the process environment variable `name` to `value`.
+env_set(name: str, value: str) : bool {
    ok = host.sys_env_set(name, value) or false
    ok
}

/// Process environment value of `name`. Fails when it is unset.
+env_require(name: str) : str! {
    v = host.sys_env_get(name) or none
    ensure v != none else {
        fail "env: missing required variable {name}"
        return
    }
    v
}

// --- pure value parsers ------------------------------------------------------------

/// Integer parsed from the environment variable `s`.
+env_parse_int(s: str, default: i64) : i64 {
    n = env_len(s)
    ensure n > 0 else { return default }
    digits = "0123456789"
    from = 0
    sign = 1
    if s[0] == "-" {
        sign = -1
        from = 1
    }
    ensure from < n else { return default }
    acc = 0
    bad = false
    for from..n {
        c = s[it]
        d = -1
        for 0..10 {
            if digits[it] == c { d = it }
        }
        if d < 0 { bad = true }
        acc = acc * 10 + d
    }
    ensure !bad else { return default }
    sign * acc
}

/// Boolean parsed from the environment variable `s`.
+env_parse_bool(s: str, default: bool) : bool {
    if s == "1" || s == "true" || s == "TRUE" || s == "yes" || s == "on" { return true }
    if s == "0" || s == "false" || s == "FALSE" || s == "no" || s == "off" { return false }
    default
}

/// Integer value of `name`, or `default` when unset or invalid.
+env_int(name: str, default: i64) : i64 {
    v = host.sys_env_get(name) or ""
    env_parse_int(v, default)
}

/// Boolean value of `name`, or `default` when unset.
+env_bool(name: str, default: bool) : bool {
    v = host.sys_env_get(name) or ""
    env_parse_bool(v, default)
}

// --- .env parsing -------------------------------------------------------------------

/// True when `c` is whitespace.
+env_is_space(c: str) : bool => c == " " || c == "\t" || c == "\r"

/// `s` with surrounding whitespace removed.
+env_trim(s: str) : str {
    n = env_len(s)
    lo = n
    hi = 0
    for 0..n {
        if !env_is_space(s[it]) {
            if lo == n { lo = it }
            hi = it + 1
        }
    }
    ensure lo < hi else { return "" }
    s[lo..hi]
}

/// Strip one pair of matching quotes.
+env_unquote(v: str) : str {
    n = env_len(v)
    ensure n >= 2 else { return v }
    first = v[0]
    last = v[n - 1]
    if first == last && (first == "\"" || first == "'") { return v[1..(n - 1)] }
    v
}

/// Parse `KEY=VALUE` lines. Blank lines and `#` comments are skipped, an
/// optional `export ` prefix is accepted, and surrounding quotes are removed.
+env_parse(text: str) : EnvMap {
    m = EnvMap.new()
    n = env_len(text)
    start = 0
    for 0..(n + 1) {
        if it == n || text[it] == "\n" {
            line = env_trim(text[start..it])
            start = it + 1
            if line != "" && line[0] != "#" {
                if env_len(line) > 7 && line[0..7] == "export " { line = env_trim(line[7..env_len(line)]) }
                eq = -1
                for 0..env_len(line) {
                    if eq < 0 && line[it] == "=" { eq = it }
                }
                if eq > 0 {
                    key = env_trim(line[0..eq])
                    value = env_unquote(env_trim(line[(eq + 1)..env_len(line)]))
                    @m.put(key, value)
                }
            }
        }
    }
    m
}

// --- tests ---------------------------------------------------------------------------

/// Test that env_parse_int.
test "env_parse_int" {
    assert_eq(env_parse_int("8080", 1), 8080)
    assert_eq(env_parse_int("-5", 1), -5)
    assert_eq(env_parse_int("", 7), 7)
    assert_eq(env_parse_int("12ab", 7), 7)
    assert_eq(env_parse_int("-", 7), 7)
}

/// Test that env_parse_bool.
test "env_parse_bool" {
    #assert(env_parse_bool("true", false))
    #assert(!(env_parse_bool("off", true)))
    #assert(env_parse_bool("maybe", true))
    #assert(!(env_parse_bool("", false)))
}

/// Test that dotenv basic pairs.
test "dotenv basic pairs" {
    m = env_parse("HOST=localhost\nPORT=8080\n")
    assert_eq(m.get_or("HOST", "?"), "localhost")
    assert_eq(m.get_or("PORT", "?"), "8080")
    assert_eq(m.get_or("NOPE", "dflt"), "dflt")
}

/// Test that dotenv comments blanks quotes and export.
test "dotenv comments blanks quotes and export" {
    src = "# comment\n\nexport A = \"hello world\"\nB='x=y'\n  C =  spaced  \nbroken line\n=novalue\n"
    m = env_parse(src)
    assert_eq(m.get_or("A", "?"), "hello world")
    assert_eq(m.get_or("B", "?"), "x=y")
    assert_eq(m.get_or("C", "?"), "spaced")
    assert_eq(m.get("broken line") or "absent", "absent")
}

/// Test that dotenv later keys override.
test "dotenv later keys override" {
    m = env_parse("K=1\nK=2")
    assert_eq(m.get_or("K", "?"), "2")
}

/// Test that dotenv handles crlf and missing trailing newline.
test "dotenv handles crlf and missing trailing newline" {
    m = env_parse("A=1\r\nB=2")
    assert_eq(m.get_or("A", "?"), "1")
    assert_eq(m.get_or("B", "?"), "2")
}

/// Test that trim and unquote helpers.
test "trim and unquote helpers" {
    assert_eq(env_trim("  x  "), "x")
    assert_eq(env_trim("   "), "")
    assert_eq(env_unquote("\"q\""), "q")
    assert_eq(env_unquote("'q'"), "q")
    assert_eq(env_unquote("\"q'"), "\"q'")
}

/// Test that host-backed getters degrade without a host.
test "host-backed getters degrade without a host" {
    assert_eq(env_get_or("SUPER_SURELY_UNSET", "fallback"), "fallback")
    assert_eq(env_get("SUPER_SURELY_UNSET") or "none", "none")
    assert_eq(env_require("SUPER_SURELY_UNSET") or "missing", "missing")
    assert_eq(env_int("SUPER_SURELY_UNSET", 3000), 3000)
    #assert(env_bool("SUPER_SURELY_UNSET", true))
}
