//! Laws for std.core.decimal — real-body (`dec_abs`).
//! AI agents must not edit this file; put discharges in `decimal.proof.sr`.

#law("dec_abs is idempotent on integers")
decimal_dec_abs_idempotent() {
    #assert(dec_abs(dec_abs(-42)) == 42)
    #assert(dec_abs(dec_abs(7)) == 7)
}

#law("dec_abs is non-negative")
decimal_dec_abs_nonneg() {
    #assert(dec_abs(-3) == 3)
    #assert(dec_abs(0) == 0)
    #assert(dec_abs(9) == 9)
}
