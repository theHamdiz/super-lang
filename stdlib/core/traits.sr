//! std.core.traits — the language traits
//!
//! Import with:
//!   use std.core.traits
//!
//! These names are ambient. A struct may declare them without this import.
//! The signatures here are the compiler's witness: if this file drifts, `super
//! check` reports E0204. Builtin numbers, strings, arrays, maps, and records
//! already implement the witnesses. A declared method replaces that witness
//! with a direct call, on the VM and on the C23 backend.
//!
//!   +User: Display, Eq = {
//!       id: i64 = 0
//!       name: str = ""
//!       display(self) : str => "{self.name}#{self.id}"
//!       eq(self, other: User) : bool => self.id == other.id
//!   }
//!
//! `"{user}"` calls `display`. `user == other` calls `eq`. An array or a map
//! with no method of its own still renders, compares, and hashes.

/// Text for interpolation and string `+`.
+Display = trait {
    display(self) : str
}

/// Quoted, structural text for diagnostics.
+Debug = trait {
    debug(self) : str
}

/// `to_str` is the conversion form of `Display`.
+ToString = trait {
    to_str(self) : str
}

/// `==` and `!=`. One trait covers Rust's `PartialEq` and `Eq`.
+Eq = trait {
    eq(self, other) : bool
}

/// `<`, `<=`, `>`, `>=`. `cmp` returns -1, 0, or 1.
+Ord = trait {
    cmp(self, other) : i64
}

/// `hash` agrees with `eq`: equal values share a hash.
+Hash = trait {
    hash(self) : i64
}

/// Explicit copy. Values are already copied; `clone` is the named form.
+Clone = trait {
    clone(self)
}

/// Marker. The type is safe to copy bit for bit.
+Copy = trait {
}

/// `Type.default()` builds the zero value.
+Default = trait {
    default()
}

/// `Type.from(value)` converts into the type.
+From = trait {
    from(value)
}

/// `value.into()` converts out of the type.
+Into = trait {
    into(self)
}

/// Borrow the value as another view, usually `str`.
+AsRef = trait {
    as_ref(self)
}

/// Borrow without changing identity. Same shape as `AsRef`.
+Borrow = trait {
    borrow(self)
}

/// `next` yields the following element. The receiver is `@self`.
+Iter = trait {
    next(@self)
}

/// `+`.
+Add = trait {
    add(self, other)
}

/// `-`.
+Sub = trait {
    sub(self, other)
}

/// `*`.
+Mul = trait {
    mul(self, other)
}

/// `/`.
+Div = trait {
    div(self, other)
}

/// `%`.
+Rem = trait {
    rem(self, other)
}

/// Unary `-`.
+Neg = trait {
    neg(self)
}

/// Logical complement.
+Not = trait {
    not(self)
}

/// `value[key]`.
+Index = trait {
    index(self, key)
}

/// Text of a failure. `or err` already carries a string; this is for error structs.
+Error = trait {
    message(self) : str
}

/// Explicit release. The scoped stack still frees the value; `drop` runs first.
+Drop = trait {
    drop(@self)
}

/// Associative monoid for sequential and parallel reductions.
/// `identity` seeds the accumulator; `accumulate` folds one item; `merge`
/// combines partition states (must be associative + commutative for `par`);
/// `finalize` projects the accumulator to the output. O(1) auxiliary space.
+AssociativeReducer = trait {
    identity()
    accumulate(@self, item)
    merge(@self, other)
    finalize(self)
}

/// Lazy adapters and reductions over sequences. Builtin arrays and ranges
/// witness this via fused pipeline lowering (`xs.keep(…).map(…).sum()`), not
/// heap materialization or dynamic dispatch. Complexity: O(n) time, O(1)
/// auxiliary space for pure reductions; mean/variance use Welford's method.
+Iterable = trait {
    map(self, transform)
    keep(self, pred)
    reduce(self, reducer)
    sum(self)
    product(self)
    min(self)
    max(self)
    any(self)
    all(self)
    mean(self)
    variance(self)
}

/// Parallel reductions. Partition with `accumulate`, then merge with
/// `AssociativeReducer.merge`. On the C23 path, pure reducers may lower to
/// OpenMP chunking; the VM runs them sequentially with the same result.
+ParIterable = trait {
    par_reduce(self, reducer)
    par_sum(self)
    par_product(self)
    par_min(self)
    par_max(self)
    par_mean(self)
    par_variance(self)
}

/// A greeting whose `Display` and `Eq` replace the structural witness.
+Greeter: Display, Eq = {
    name: str = ""
    display(self) : str => "hello {self.name}"
    eq(self, other: Greeter) : bool => self.name == other.name
}

/// Display text of any value. Untyped parameters use the builtin witness.
/// A typed receiver calls its own `display` through `"{value}"` at the call site.
+show(value) : str => "{value}"

/// Debug text. Strings are quoted. This is the builtin witness.
+dbg(value) : str => value.debug()

test "builtins display arrays, maps, and records" {
    scores = [10, 20, 30]
    assert_eq("{scores}", "[10, 20, 30]")
    ports = {http: 80, https: 443}
    assert_eq("{ports}", "{http: 80, https: 443}")
    user = {name: "Amina", id: 7}
    assert_eq("{user}", "{id: 7, name: \"Amina\"}")
    #assert(scores == [10, 20, 30])
    #assert(!([1, 2] == [1, 3]))
    #assert("a" < "b")
    assert_eq(show(scores), "[10, 20, 30]")
}

test "a declared Display replaces the witness" {
    g = Greeter.{name: "Amina"}
    assert_eq("{g}", "hello Amina")
    #assert(g == Greeter.{name: "Amina"})
    #assert(!(g == Greeter.{name: "Sam"}))
}
