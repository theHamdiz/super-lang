//! std.core.decimal — exact fixed-point decimal numbers
//!
//! Import with:
//!   use std.core.decimal
//!
//! A `Decimal` is `units / 10^scale`: `Decimal.{units: 1250, scale: 2}` is `12.50`. All
//! arithmetic is integer arithmetic on `i64`, so money math never drifts:
//!
//!   price = Decimal.parse("19.99") or Decimal.zero()
//!   total = price * Decimal.from_i64(3) + Decimal.of(3, 2)
//!   print("{total}")                  // 59.97 + 0.03 = 60.00
//!
//! `==`, `<`, `+`, `-`, `*`, `/` and unary `-` work through the inline traits; `==` and `hash`
//! compare the *value* (`1.50 == 1.5`), not the representation. Values must stay within
//! 18 significant digits; `div` rounds half away from zero at `DEC_DIV_SCALE` digits.

/// Largest scale a `Decimal` may carry (powers of ten up to 10^18 fit in an `i64`).
+DEC_MAX_SCALE = 18
/// Fractional digits produced by `/` (use `div_scale` for another precision).
+DEC_DIV_SCALE = 9

/// `10` raised to `n` (0..=18).
+dec_pow10(n: i64) : i64 {
    acc = 1
    for 0..n { acc = acc * 10 }
    acc
}

/// Absolute value of `v`.
+dec_abs(v: i64) : i64 {
    if v < 0 { return -v }
    v
}

/// `num / den` rounded half away from zero (`den` must be non-zero).
+dec_div_round(num: i64, den: i64) : i64 {
    q = num / den
    r = dec_abs(num % den)
    if r * 2 >= dec_abs(den) {
        neg = 0
        if num < 0 { neg += 1 }
        if den < 0 { neg += 1 }
        if neg == 1 { return q - 1 }
        return q + 1
    }
    q
}

/// `Decimal` is an exact base-10 number `units / 10^scale`.
+Decimal: Display, ToString, Eq, Ord, Hash, Add, Sub, Mul, Div, Neg = {
    /// Scaled integer mantissa. Defaults to `0`.
    units: i64 = 0
    /// Number of fractional digits (0..=18). Defaults to `0`.
    scale: i64 = 0

    /// The value zero.
    zero() : Decimal => Decimal.{units: 0, scale: 0}

    /// The integer `n` as a `Decimal` with no fractional digits.
    from_i64(n: i64) : Decimal => Decimal.{units: n, scale: 0}

    /// `units / 10^scale` (`scale` is clamped to 0..=18).
    of(units: i64, scale: i64) : Decimal {
        s = scale
        if s < 0 { s = 0 }
        if s > 18 { s = 18 }
        Decimal.{units, scale: s}
    }

    /// Parse `[+-]digits[.digits]` (at most 18 digits in total), or fail.
    parse(text: str) : Decimal! {
        n = host.sys_str_len(text)
        ensure n > 0 else {
            fail "decimal: empty input"
            return
        }
        pos = 0
        negative = false
        if text[0] == "-" {
            negative = true
            pos = 1
        }
        if text[0] == "+" { pos = 1 }
        units = 0
        digits = 0
        scale = 0
        seen_dot = false
        bad = false
        for pos..n {
            c = text[it]
            if c == "." {
                if seen_dot { bad = true }
                seen_dot = true
            } else {
                code = host.sys_ord(c)
                if code < 48 { bad = true }
                if code > 57 { bad = true }
                if !bad {
                    units = units * 10 + (code - 48)
                    digits += 1
                    if seen_dot { scale += 1 }
                }
            }
        }
        ensure !bad else {
            fail "decimal: invalid character"
            return
        }
        ensure digits > 0 else {
            fail "decimal: no digits"
            return
        }
        ensure digits <= 18 else {
            fail "decimal: more than 18 digits"
            return
        }
        if negative { units = -units }
        Decimal.{units, scale}
    }

    /// True when the value is zero.
    is_zero(self) : bool => self.units == 0

    /// -1, 0 or 1 according to the sign of the value.
    signum(self) : i64 {
        if self.units < 0 { return -1 }
        if self.units > 0 { return 1 }
        0
    }

    /// Absolute value.
    abs(self) : Decimal => Decimal.{units: dec_abs(self.units), scale: self.scale}

    /// `-self`.
    neg(self) : Decimal => Decimal.{units: -self.units, scale: self.scale}

    /// Same value with trailing fractional zeros removed (`1.500` -> `1.5`, `2.0` -> `2`).
    normalize(self) : Decimal {
        u = self.units
        s = self.scale
        if u == 0 { return Decimal.{units: 0, scale: 0} }
        while s > 0 {
            if u % 10 != 0 { break }
            u = u / 10
            s -= 1
        }
        Decimal.{units: u, scale: s}
    }

    /// Same value expressed with exactly `scale` fractional digits. Reducing the scale rounds
    /// half away from zero.
    rescale(self, scale: i64) : Decimal {
        target = scale
        if target < 0 { target = 0 }
        if target > 18 { target = 18 }
        if target == self.scale { return self }
        if target > self.scale {
            return Decimal.{units: self.units * dec_pow10(target - self.scale), scale: target}
        }
        Decimal.{units: dec_div_round(self.units, dec_pow10(self.scale - target)), scale: target}
    }

    /// Round to `places` fractional digits, half away from zero.
    round(self, places: i64) : Decimal => self.rescale(places)

    /// Drop the fractional part, rounding toward zero.
    trunc(self) : Decimal {
        if self.scale == 0 { return self }
        Decimal.{units: self.units / dec_pow10(self.scale), scale: 0}
    }

    /// `self + other`, at the larger of the two scales.
    add(self, other: Decimal) : Decimal {
        s = self.scale
        if other.scale > s { s = other.scale }
        a = self.rescale(s)
        b = other.rescale(s)
        Decimal.{units: a.units + b.units, scale: s}
    }

    /// `self - other`, at the larger of the two scales.
    sub(self, other: Decimal) : Decimal {
        s = self.scale
        if other.scale > s { s = other.scale }
        a = self.rescale(s)
        b = other.rescale(s)
        Decimal.{units: a.units - b.units, scale: s}
    }

    /// `self * other`. The exact product scale is the sum of the scales; when that exceeds 18
    /// digits the result is rounded back to 18.
    mul(self, other: Decimal) : Decimal {
        raw = Decimal.{units: self.units * other.units, scale: self.scale + other.scale}
        if raw.scale > 18 {
            drop = raw.scale - 18
            return Decimal.{units: dec_div_round(raw.units, dec_pow10(drop)), scale: 18}
        }
        raw
    }

    /// `self / other` with `scale` fractional digits (rounded half away from zero), or fail
    /// when `other` is zero.
    checked_div(self, other: Decimal, scale: i64) : Decimal! {
        ensure other.units != 0 else {
            fail "decimal: division by zero"
            return
        }
        s = scale
        if s < 0 { s = 0 }
        if s > 18 { s = 18 }
        num = self.units
        den = other.units
        e = s + other.scale - self.scale
        if e >= 0 {
            num = num * dec_pow10(e)
        } else {
            den = den * dec_pow10(-e)
        }
        Decimal.{units: dec_div_round(num, den), scale: s}
    }

    /// `self / other` with `scale` fractional digits; division by zero yields zero.
    div_scale(self, other: Decimal, scale: i64) : Decimal => self.checked_div(other, scale) or Decimal.zero()

    /// `self / other` at `DEC_DIV_SCALE` digits; division by zero yields zero (use
    /// `checked_div` to detect it).
    div(self, other: Decimal) : Decimal => self.div_scale(other, 9)

    /// Remainder of `self / other` (sign follows `self`), or fail when `other` is zero.
    modulo(self, other: Decimal) : Decimal! {
        ensure other.units != 0 else {
            fail "decimal: modulo by zero"
            return
        }
        s = self.scale
        if other.scale > s { s = other.scale }
        a = self.units * dec_pow10(s - self.scale)
        b = other.units * dec_pow10(s - other.scale)
        Decimal.{units: a % b, scale: s}
    }

    /// Smaller of `self` and `other`.
    min(self, other: Decimal) : Decimal {
        if self.cmp(other) <= 0 { return self }
        other
    }

    /// Larger of `self` and `other`.
    max(self, other: Decimal) : Decimal {
        if self.cmp(other) >= 0 { return self }
        other
    }

    /// Value equality: `1.50 == 1.5`.
    eq(self, other: Decimal) : bool => self.cmp(other) == 0

    /// -1, 0 or 1 comparing numeric value regardless of scale.
    cmp(self, other: Decimal) : i64 {
        s = self.scale
        if other.scale > s { s = other.scale }
        a = self.units * dec_pow10(s - self.scale)
        b = other.units * dec_pow10(s - other.scale)
        if a < b { return -1 }
        if a > b { return 1 }
        0
    }

    /// Hash that agrees with `eq` (computed on the normalized form).
    hash(self) : i64 {
        n = self.normalize()
        h = ((n.units % 2147483647) * 31 + n.scale) & 2147483647
        h
    }

    /// Canonical text: `-12.340` (always `scale` fractional digits, no exponent).
    to_str(self) : str {
        neg = self.units < 0
        digits = "{dec_abs(self.units)}"
        if self.scale == 0 {
            if neg { return "-{digits}" }
            return digits
        }
        width = host.sys_str_len(digits)
        while width <= self.scale {
            digits = "0{digits}"
            width += 1
        }
        cut = width - self.scale
        whole = digits[0..cut]
        frac = digits[cut..width]
        if neg { return "-{whole}.{frac}" }
        "{whole}.{frac}"
    }

    /// Alias of `to_str` in the alternate name.
    to_string(self) : str => self.to_str()

    /// `Display` witness.
    display(self) : str => self.to_str()

    /// Nearest `f64` (lossy for more than 15 significant digits).
    to_f64(self) : f64 {
        whole = self.units / dec_pow10(self.scale)
        frac = self.units % dec_pow10(self.scale)
        scale_f = 1.0 * dec_pow10(self.scale)
        1.0 * whole + (1.0 * frac) / scale_f
    }
}

/// Sum of the `Decimal` values in `items` (zero for an empty array).
+dec_sum(items: _) : Decimal {
    total = Decimal.zero()
    for items { total = total.add(it) }
    total
}

/// Parse `text` or return `fallback`.
+dec_parse_or(text: str, fallback: Decimal) : Decimal => Decimal.parse(text) or fallback

// --- tests -------------------------------------------------------------------------------

/// Test that construction and zero/from_i64 behave.
test "decimal constructors" {
    z = Decimal.zero()
    assert_eq(z.units, 0)
    #assert(z.is_zero())
    n = Decimal.from_i64(42)
    assert_eq(n.units, 42)
    assert_eq(n.scale, 0)
    assert_eq("{n}", "42")
    d = Decimal.of(1250, 2)
    assert_eq(d.to_string(), "12.50")
    clamped = Decimal.of(5, 40)
    assert_eq(clamped.scale, 18)
    low = Decimal.of(5, -3)
    assert_eq(low.scale, 0)
}

/// Test that to_string pads, signs and places the point.
test "decimal to_string" {
    assert_eq(Decimal.of(12345, 2).to_string(), "123.45")
    assert_eq(Decimal.of(5, 3).to_string(), "0.005")
    assert_eq(Decimal.of(-5, 3).to_string(), "-0.005")
    assert_eq(Decimal.of(-1250, 2).to_string(), "-12.50")
    assert_eq(Decimal.of(0, 2).to_string(), "0.00")
    assert_eq(Decimal.of(-7, 0).to_string(), "-7")
    assert_eq(Decimal.of(100, 2).display(), "1.00")
    assert_eq(Decimal.of(123456789012345678, 18).to_string(), "0.123456789012345678")
}

/// Test that parse accepts good input and rejects bad input.
test "decimal parse" {
    a = Decimal.parse("19.99") or Decimal.zero()
    assert_eq(a.units, 1999)
    assert_eq(a.scale, 2)
    b = Decimal.parse("-0.5") or Decimal.zero()
    assert_eq(b.units, -5)
    assert_eq(b.scale, 1)
    c = Decimal.parse("+7") or Decimal.zero()
    assert_eq(c.units, 7)
    assert_eq(c.scale, 0)
    d = Decimal.parse(".25") or Decimal.zero()
    assert_eq(d.to_string(), "0.25")
    e = Decimal.parse("3.") or Decimal.zero()
    assert_eq(e.units, 3)
    sentinel = Decimal.of(-1, 0)
    assert_eq(Decimal.parse("") or sentinel, sentinel)
    assert_eq(Decimal.parse("abc") or sentinel, sentinel)
    assert_eq(Decimal.parse("1.2.3") or sentinel, sentinel)
    assert_eq(Decimal.parse("-") or sentinel, sentinel)
    assert_eq(Decimal.parse("1234567890123456789") or sentinel, sentinel)
    assert_eq(Decimal.parse("1e5") or sentinel, sentinel)
    assert_eq(dec_parse_or("x", Decimal.of(9, 0)).units, 9)
}

/// Test that Eq, Ord and Hash look at value, not representation.
test "decimal eq ord hash" {
    a = Decimal.of(150, 2)
    b = Decimal.of(15, 1)
    c = Decimal.of(151, 2)
    #assert(a == b)
    #assert(a != c)
    #assert(a < c)
    #assert(c > b)
    #assert(a <= b)
    #assert(a >= b)
    assert_eq(a.cmp(c), -1)
    assert_eq(c.cmp(a), 1)
    assert_eq(a.cmp(b), 0)
    assert_eq(a.hash(), b.hash())
    #assert(!(a.hash() == c.hash()))
    assert_eq(Decimal.of(0, 5).hash(), Decimal.zero().hash())
    neg = Decimal.of(-1, 0)
    #assert(neg < Decimal.zero())
    #assert(Decimal.of(-3, 1) < Decimal.of(-2, 1))
}

/// Test that normalize, rescale, round and trunc agree.
test "decimal normalize rescale round trunc" {
    assert_eq(Decimal.of(1500, 3).normalize().to_string(), "1.5")
    assert_eq(Decimal.of(200, 2).normalize().to_string(), "2")
    assert_eq(Decimal.of(0, 7).normalize().to_string(), "0")
    assert_eq(Decimal.of(15, 1).rescale(3).to_string(), "1.500")
    assert_eq(Decimal.of(12345, 3).rescale(2).to_string(), "12.35")
    assert_eq(Decimal.of(12344, 3).rescale(2).to_string(), "12.34")
    assert_eq(Decimal.of(-12345, 3).rescale(2).to_string(), "-12.35")
    assert_eq(Decimal.of(25, 1).round(0).to_string(), "3")
    assert_eq(Decimal.of(-25, 1).round(0).to_string(), "-3")
    assert_eq(Decimal.of(24, 1).round(0).to_string(), "2")
    assert_eq(Decimal.of(799, 2).trunc().to_string(), "7")
    assert_eq(Decimal.of(-799, 2).trunc().to_string(), "-7")
    assert_eq(Decimal.of(7, 0).trunc().to_string(), "7")
}

/// Test that add and sub align scales.
test "decimal add and sub" {
    a = Decimal.of(1999, 2)
    b = Decimal.of(3, 2)
    assert_eq((a + b).to_string(), "20.02")
    assert_eq((a - b).to_string(), "19.96")
    c = Decimal.of(5, 1)
    d = Decimal.of(25, 2)
    assert_eq((c + d).to_string(), "0.75")
    assert_eq((d - c).to_string(), "-0.25")
    assert_eq(a.add(Decimal.zero()).to_string(), "19.99")
    tenth = Decimal.of(1, 1)
    acc = Decimal.zero()
    for 0..10 { acc = acc + tenth }
    #assert(acc == Decimal.from_i64(1))
    assert_eq(acc.to_string(), "1.0")
}

/// Test that mul keeps exact digits and caps at scale 18.
test "decimal mul" {
    a = Decimal.of(1999, 2)
    three = Decimal.from_i64(3)
    assert_eq((a * three).to_string(), "59.97")
    assert_eq((Decimal.of(15, 1) * Decimal.of(15, 1)).to_string(), "2.25")
    assert_eq((Decimal.of(-5, 1) * Decimal.of(4, 0)).to_string(), "-2.0")
    #assert((a * Decimal.zero()).is_zero())
    tiny = Decimal.of(1, 10)
    prod = tiny * tiny
    assert_eq(prod.scale, 18)
    assert_eq(prod.units, 0)
    five = Decimal.of(5, 9)
    exact = five * five
    assert_eq(exact.scale, 18)
    assert_eq(exact.units, 25)
    rounded = Decimal.of(15, 10) * Decimal.of(15, 10)
    assert_eq(rounded.scale, 18)
    assert_eq(rounded.units, 2)
    up = Decimal.of(5, 10) * Decimal.of(1, 9)
    assert_eq(up.scale, 18)
    assert_eq(up.units, 1)
}

/// Test that div rounds and guards zero.
test "decimal div" {
    one = Decimal.from_i64(1)
    three = Decimal.from_i64(3)
    assert_eq((one / three).to_string(), "0.333333333")
    two = Decimal.from_i64(2)
    assert_eq((two / three).to_string(), "0.666666667")
    assert_eq(one.div_scale(three, 2).to_string(), "0.33")
    assert_eq(Decimal.of(-1, 0).div_scale(three, 2).to_string(), "-0.33")
    assert_eq(Decimal.of(1, 0).div_scale(Decimal.of(-3, 0), 2).to_string(), "-0.33")
    assert_eq(Decimal.of(10, 0).div_scale(Decimal.of(4, 0), 1).to_string(), "2.5")
    assert_eq(Decimal.of(150, 2).div_scale(Decimal.of(5, 1), 3).to_string(), "3.000")
    assert_eq(Decimal.of(1, 0).div_scale(Decimal.of(8, 0), 0).to_string(), "0")
    assert_eq(Decimal.of(5, 0).div_scale(Decimal.of(8, 0), 0).to_string(), "1")
    assert_eq(Decimal.of(12345, 4).div_scale(Decimal.of(5, 0), 2).to_string(), "0.25")
    sentinel = Decimal.of(-1, 0)
    assert_eq(one.checked_div(Decimal.zero(), 2) or sentinel, sentinel)
    #assert((one / Decimal.zero()).is_zero())
    ok = one.checked_div(two, 1) or sentinel
    assert_eq(ok.to_string(), "0.5")
}

/// Test that neg, abs, signum, min, max and modulo work.
test "decimal neg abs signum min max modulo" {
    a = Decimal.of(-125, 2)
    assert_eq((-a).to_string(), "1.25")
    assert_eq(a.abs().to_string(), "1.25")
    assert_eq(a.signum(), -1)
    assert_eq(Decimal.zero().signum(), 0)
    assert_eq(Decimal.of(3, 0).signum(), 1)
    b = Decimal.of(2, 0)
    assert_eq(a.min(b).to_string(), "-1.25")
    assert_eq(a.max(b).to_string(), "2")
    sentinel = Decimal.of(-99, 0)
    r = Decimal.of(75, 1).modulo(Decimal.of(2, 0)) or sentinel
    assert_eq(r.to_string(), "1.5")
    r2 = Decimal.of(1, 0).modulo(Decimal.of(2, 0)) or sentinel
    assert_eq(r2.to_string(), "1")
    r3 = Decimal.of(1, 0).modulo(Decimal.zero()) or sentinel
    assert_eq(r3, sentinel)
}

/// Test that dec_sum folds an array and to_f64 approximates.
test "decimal sum and to_f64" {
    items = [Decimal.of(1999, 2), Decimal.of(1, 2), Decimal.of(5, 0)]
    assert_eq(dec_sum(items).to_string(), "25.00")
    #assert(dec_sum([]).is_zero())
    assert_eq(Decimal.of(25, 1).to_f64(), 2.5)
    assert_eq(Decimal.of(-125, 2).to_f64(), -1.25)
    assert_eq(Decimal.of(7, 0).to_f64(), 7.0)
}

/// Test that Display drives string interpolation.
test "decimal display in interpolation" {
    price = Decimal.of(1999, 2)
    assert_eq("total: {price}", "total: 19.99")
    line = "{Decimal.of(-5, 1)}|{Decimal.of(0, 3)}"
    assert_eq(line, "-0.5|0.000")
}
