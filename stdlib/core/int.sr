//! std.core.int -- fixed-width integer helpers for `u8`/`u16`/`u32`/`u64`/`i8`/`i16`/`i32`/`i128`
//!
//! Language scalars `u8`, `u16`, `u32`, `u64`, `i8`, `i16`, `i32`, `i64`, and `i128` are
//! first-class TypeKinds with C23 ABI sizes. The VM stores every width in an `i64`
//! register (full `i128` is preserved on the C ABI path). This module provides range
//! checks, wrapping / checked / saturating arithmetic, and named conversions.
//!
//! Import: use std.core.int
//!
//!   x: u8 = 200
//!   y = u8_wrapping_add(x, 100)   // 44
//!   z = u8_checked_add(x, 100) or 0

/// Maximum value of each unsigned width as `i64`.
+U8_MAX  : i64 = 255
+U16_MAX : i64 = 65535
+U32_MAX : i64 = 4294967295
+I8_MIN  : i64 = 0 - 128
+I8_MAX  : i64 = 127
+I16_MIN : i64 = 0 - 32768
+I16_MAX : i64 = 32767
+I32_MIN : i64 = 0 - 2147483648
+I32_MAX : i64 = 2147483647

/// Bit masks (two's complement lanes in the i64 register).
+U8_MASK  : i64 = 255
+U16_MASK : i64 = 65535
+U32_MASK : i64 = 4294967295

/// True when `n` fits in `u8` (0..255).
+is_u8(n: i64) : bool => n >= 0 && n <= U8_MAX
/// True when `n` fits in `u16`.
+is_u16(n: i64) : bool => n >= 0 && n <= U16_MAX
/// True when `n` fits in `u32`.
+is_u32(n: i64) : bool => n >= 0 && n <= U32_MAX
/// True when `n` fits in `i8`.
+is_i8(n: i64) : bool => n >= I8_MIN && n <= I8_MAX
/// True when `n` fits in `i16`.
+is_i16(n: i64) : bool => n >= I16_MIN && n <= I16_MAX
/// True when `n` fits in `i32`.
+is_i32(n: i64) : bool => n >= I32_MIN && n <= I32_MAX

/// Truncate to `u8` bits (wrap). Return type pins the width.
+as_u8(n: i64) : u8 => n & U8_MASK
/// Truncate to `u16` bits.
+as_u16(n: i64) : u16 => n & U16_MASK
/// Truncate to `u32` bits.
+as_u32(n: i64) : u32 => n & U32_MASK
/// Identity on the `i64`/`u64` register lane.
+as_u64(n: i64) : u64 => n
/// Truncate toward `i8` range by wrap.
+as_i8(n: i64) : i8 {
    v = n & U8_MASK
    if v >= 128 { v = v - 256 }
    v
}
/// Truncate toward `i16` range by wrap.
+as_i16(n: i64) : i16 {
    v = n & U16_MASK
    if v >= 32768 { v = v - 65536 }
    v
}
/// Truncate toward `i32` range by wrap.
+as_i32(n: i64) : i32 {
    v = n & U32_MASK
    if v >= 2147483648 { v = v - 4294967296 }
    v
}
/// `i128` view of an `i64` (VM narrows; C ABI keeps width).
+as_i128(n: i64) : i128 => n

/// Checked cast: fail when out of range.
+to_u8(n: i64) : u8! {
    ensure is_u8(n) else {
        fail "int: value {n} out of u8 range"
        return
    }
    n
}
+to_u16(n: i64) : u16! {
    ensure is_u16(n) else {
        fail "int: value {n} out of u16 range"
        return
    }
    n
}
+to_u32(n: i64) : u32! {
    ensure is_u32(n) else {
        fail "int: value {n} out of u32 range"
        return
    }
    n
}
+to_i8(n: i64) : i8! {
    ensure is_i8(n) else {
        fail "int: value {n} out of i8 range"
        return
    }
    n
}
+to_i16(n: i64) : i16! {
    ensure is_i16(n) else {
        fail "int: value {n} out of i16 range"
        return
    }
    n
}
+to_i32(n: i64) : i32! {
    ensure is_i32(n) else {
        fail "int: value {n} out of i32 range"
        return
    }
    n
}

/// Wrapping add on `u8` lanes.
+u8_wrapping_add(a: i64, b: i64) : u8 => (a + b) & U8_MASK
+u8_wrapping_sub(a: i64, b: i64) : u8 => (a - b) & U8_MASK
+u8_wrapping_mul(a: i64, b: i64) : u8 => (a * b) & U8_MASK

+u16_wrapping_add(a: i64, b: i64) : u16 => (a + b) & U16_MASK
+u16_wrapping_sub(a: i64, b: i64) : u16 => (a - b) & U16_MASK
+u16_wrapping_mul(a: i64, b: i64) : u16 => (a * b) & U16_MASK

+u32_wrapping_add(a: i64, b: i64) : u32 => (a + b) & U32_MASK
+u32_wrapping_sub(a: i64, b: i64) : u32 => (a - b) & U32_MASK
+u32_wrapping_mul(a: i64, b: i64) : u32 => (a * b) & U32_MASK

/// Checked add: none on overflow past the width.
+u8_checked_add(a: i64, b: i64) : u8? {
    s = a + b
    if is_u8(s) { s } else { none }
}
+u16_checked_add(a: i64, b: i64) : u16? {
    s = a + b
    if is_u16(s) { s } else { none }
}
+u32_checked_add(a: i64, b: i64) : u32? {
    s = a + b
    if is_u32(s) { s } else { none }
}
+i32_checked_add(a: i64, b: i64) : i32? {
    s = a + b
    if is_i32(s) { s } else { none }
}

/// Saturating add clamps to the type min/max.
+u8_saturating_add(a: i64, b: i64) : u8 {
    s = a + b
    if s < 0 { return 0 }
    if s > U8_MAX { return U8_MAX }
    s
}
+u16_saturating_add(a: i64, b: i64) : u16 {
    s = a + b
    if s < 0 { return 0 }
    if s > U16_MAX { return U16_MAX }
    s
}
+i32_saturating_add(a: i64, b: i64) : i32 {
    s = a + b
    if s < I32_MIN { return I32_MIN }
    if s > I32_MAX { return I32_MAX }
    s
}

/// C-ABI type spelling for a scalar width name.
+c_abi_type_name(width: str) : str {
    when width {
        "u8" => "uint8_t"
        "i8" => "int8_t"
        "u16" => "uint16_t"
        "i16" => "int16_t"
        "u32" => "uint32_t"
        "i32" => "int32_t"
        "u64" => "uint64_t"
        "i64" => "int64_t"
        "i128" => "__int128"
        else => "int64_t"
    }
}

/// Byte size of a scalar width name.
+c_abi_size(width: str) : i64 {
    when width {
        "u8" => 1
        "i8" => 1
        "u16" => 2
        "i16" => 2
        "u32" => 4
        "i32" => 4
        "f32" => 4
        "u64" => 8
        "i64" => 8
        "f64" => 8
        "i128" => 16
        else => 8
    }
}

test "u8 wrapping and checked arithmetic" {
    assert_eq(u8_wrapping_add(200, 100), 44)
    assert_eq(u8_wrapping_sub(0, 1), 255)
    assert_eq(u8_wrapping_mul(16, 16), 0)
    assert_eq(u8_checked_add(200, 50) or 0, 250)
    assert_eq(u8_checked_add(200, 100) or 0, 0)
    assert_eq(u8_saturating_add(250, 10), 255)
}

test "u16 u32 range and casts" {
    #assert(is_u16(65535))
    #assert(!(is_u16(65536)))
    assert_eq(as_u16(65536), 0)
    assert_eq(to_u16(1000) or 0, 1000)
    assert_eq(to_u16(70000) or 0, 0)
    assert_eq(u32_wrapping_add(U32_MAX, 1), 0)
    #assert(is_u32(U32_MAX))
    #assert(!(is_u32(U32_MAX + 1)))
}

test "signed widths wrap and saturate" {
    assert_eq(as_i8(128), I8_MIN)
    assert_eq(as_i8(255), 0 - 1)
    assert_eq(to_i8(127) or 0, 127)
    assert_eq(to_i8(128) or 0, 0)
    assert_eq(i32_saturating_add(I32_MAX, 1), I32_MAX)
    assert_eq(i32_saturating_add(I32_MIN, 0 - 1), I32_MIN)
    assert_eq(i32_checked_add(I32_MAX, 1) or 0, 0)
}

test "C ABI size table matches language scalars" {
    assert_eq(c_abi_size("u8"), 1)
    assert_eq(c_abi_size("u16"), 2)
    assert_eq(c_abi_size("u32"), 4)
    assert_eq(c_abi_size("u64"), 8)
    assert_eq(c_abi_size("i32"), 4)
    assert_eq(c_abi_size("i128"), 16)
    assert_eq(c_abi_type_name("u8"), "uint8_t")
    assert_eq(c_abi_type_name("i128"), "__int128")
}

test "typed bindings accept fixed-width annotations" {
    a: u8 = 42
    b: u16 = 8080
    c: u32 = 4000000000
    d: i32 = 0 - 100
    e: u64 = 1
    f: i128 = 99
    assert_eq(a, 42)
    assert_eq(b, 8080)
    assert_eq(c, 4000000000)
    assert_eq(d, 0 - 100)
    assert_eq(e, 1)
    assert_eq(f, 99)
}
