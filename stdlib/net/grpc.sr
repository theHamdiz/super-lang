}

test "grpc request headers" {
    block = grpc_request_headers("api.example.com", "/pkg.Svc/Do", 2000, ["x-token"], ["abc"]) or []
    dec = HpackDecoder.{}
    h = @dec.decode(block) or HeaderList.{}
    assert_eq(h.get(":method", ""), "POST")
    assert_eq(h.get(":scheme", ""), "http")
    assert_eq(h.get(":path", ""), "/pkg.Svc/Do")
    assert_eq(h.get(":authority", ""), "api.example.com")
    assert_eq(h.get("content-type", ""), "application/grpc")
    assert_eq(h.get("te", ""), "trailers")
    assert_eq(h.get("grpc-timeout", ""), "2000m")
    assert_eq(h.get("x-token", ""), "abc")
    no_timeout = grpc_request_headers("h", "/a/b", 0, [], []) or []
    dec2 = HpackDecoder.{}
    h2 = @dec2.decode(no_timeout) or HeaderList.{}
    #assert(!(h2.has("grpc-timeout")))
    assert_eq(host.sys_arr_len(grpc_request_headers("", "/a/b", 0, [], []) or []), 0)
    assert_eq(host.sys_arr_len(grpc_request_headers("h\r\nx", "/a/b", 0, [], []) or []), 0)
    assert_eq(host.sys_arr_len(grpc_request_headers("h", "bad", 0, [], []) or []), 0)
    assert_eq(host.sys_arr_len(grpc_request_headers("h", "/a/b", 0, ["k"], []) or []), 0)
    assert_eq(host.sys_arr_len(grpc_request_headers("h", "/a/b", 0, [":path"], ["x"]) or []), 0)
    assert_eq(host.sys_arr_len(grpc_request_headers("h", "/a/b", 0, ["grpc-status"], ["0"]) or []), 0)
    assert_eq(host.sys_arr_len(grpc_request_headers("h", "/a/b", 0, ["X-Upper"], ["x"]) or []), 0)
    assert_eq(host.sys_arr_len(grpc_request_headers("h", "/a/b", 0, [""], ["x"]) or []), 0)
    assert_eq(host.sys_arr_len(grpc_request_headers("h", "/a/b", -5, [], []) or []), 0)
}

test "grpc unary call roundtrip" {
    req = pb_string_field(1, "Amina") or []
    wire = grpc_unary_request(1, "api.example.com", "/helloworld.Greeter/SayHello", req, 5000) or []
    call = grpc_parse_request(wire) or GrpcCall.{}
    assert_eq(call.stream_id, 1)
    assert_eq(call.path, "/helloworld.Greeter/SayHello")
    assert_eq(call.authority, "api.example.com")
    assert_eq(call.timeout_ms, 5000)
    assert_eq(call.message, req)
    assert_eq(call.headers.get("te", ""), "trailers")
    out = greeter_serve(wire)
    res = grpc_parse_response(out) or GrpcReply.{status: -1}
    #assert(res.ok())
    assert_eq(res.status, 0)
    #assert(!(res.trailers_only))
    fields = pb_parse(res.message) or []
    assert_eq(pb_get_string(fields, 1, ""), "Hello, Amina!")
    assert_eq(pb_get_varint(fields, 2, 0), 5)
    again = grpc_unary_request(7, "h", "/helloworld.Greeter/SayHello", pb_string_field(1, "中文") or [], 0) or []
    reply = grpc_parse_response(greeter_serve(again)) or GrpcReply.{status: -1}
    assert_eq(pb_get_string(pb_parse(reply.message) or [], 1, ""), "Hello, 中文!")
    call2 = grpc_parse_request(again) or GrpcCall.{timeout_ms: -1}
    assert_eq(call2.timeout_ms, 0)
    assert_eq(call2.stream_id, 7)
}

test "grpc unary error statuses" {
    wrong_path = grpc_unary_request(3, "h", "/helloworld.Greeter/Missing", [], 0) or []
    r1 = grpc_parse_response(greeter_serve(wrong_path)) or GrpcReply.{status: -1}
    assert_eq(r1.status, GRPC_UNIMPLEMENTED)
    assert_eq(r1.status_message, "unknown method /helloworld.Greeter/Missing")
    #assert(r1.trailers_only)
    #assert(!(r1.ok()))
    assert_eq(host.sys_arr_len(r1.message), 0)
    empty_name = grpc_unary_request(5, "h", "/helloworld.Greeter/SayHello", pb_string_field(1, "") or [], 0) or []
    r2 = grpc_parse_response(greeter_serve(empty_name)) or GrpcReply.{status: -1}
    assert_eq(r2.status, GRPC_INVALID_ARGUMENT)
    assert_eq(r2.status_message, "name must not be empty")
    rich = grpc_unary_response(1, [1, 2], GRPC_NOT_FOUND, "café 100%") or []
    r3 = grpc_parse_response(rich) or GrpcReply.{status: -1}
    assert_eq(r3.status, GRPC_NOT_FOUND)
    assert_eq(r3.status_message, "café 100%")
    #assert(!(r3.trailers_only))
    assert_eq(r3.message, [1, 2])
    bare = grpc_unary_response(1, [], GRPC_UNAVAILABLE, "") or []
    r4 = grpc_parse_response(bare) or GrpcReply.{status: -1}
    assert_eq(r4.status, GRPC_UNAVAILABLE)
    assert_eq(r4.status_message, "")
    #assert(r4.trailers_only)
    ok_empty = grpc_unary_response(1, [], GRPC_OK, "") or []
    r5 = grpc_parse_response(ok_empty) or GrpcReply.{status: -1}
    assert_eq(r5.status, 0)
    #assert(!(r5.trailers_only))
    assert_eq(host.sys_arr_len(r5.message), 0)
}

test "grpc request validation" {
    assert_eq(host.sys_arr_len(grpc_unary_request(2, "h", "/a/b", [], 0) or []), 0)
    assert_eq(host.sys_arr_len(grpc_unary_request(1, "", "/a/b", [], 0) or []), 0)
    assert_eq(host.sys_arr_len(grpc_unary_request(1, "h", "nope", [], 0) or []), 0)
    ok = grpc_unary_request(1, "h", "/a/b", [], 0) or []
    #assert(host.sys_arr_len(ok) > 0)
    block = hpack_encode([":method", ":path", "content-type"], ["GET", "/a/b", "application/grpc"]) or []
    getreq = g_cat(h2_headers(1, block, false, true) or [], h2_data(1, grpc_frame([], false) or [], true) or [])
    assert_eq(grpc_parse_request(getreq) or GrpcCall.{stream_id: -1}.stream_id, -1)
    block2 = hpack_encode([":method", ":path", "content-type"], ["POST", "/a/b", "text/plain"]) or []
    plain = g_cat(h2_headers(1, block2, false, true) or [], h2_data(1, grpc_frame([], false) or [], true) or [])
    assert_eq(grpc_parse_request(plain) or GrpcCall.{stream_id: -1}.stream_id, -1)
    block3 = hpack_encode([":method", ":path", "content-type"], ["POST", "nope", "application/grpc"]) or []
    badpath = g_cat(h2_headers(1, block3, false, true) or [], h2_data(1, grpc_frame([], false) or [], true) or [])
    assert_eq(grpc_parse_request(badpath) or GrpcCall.{stream_id: -1}.stream_id, -1)
    block4 = grpc_request_headers("h", "/a/b", 0, [], []) or []
    noend = g_cat(h2_headers(1, block4, false, true) or [], h2_data(1, grpc_frame([1], false) or [], false) or [])
    assert_eq(grpc_parse_request(noend) or GrpcCall.{stream_id: -1}.stream_id, -1)
    twice = g_cat(h2_headers(1, block4, false, true) or [], h2_data(1, g_cat(grpc_frame([1], false) or [], grpc_frame([2], false) or []), true) or [])
    assert_eq(grpc_parse_request(twice) or GrpcCall.{stream_id: -1}.stream_id, -1)
    none = h2_headers(1, block4, true, true) or []
    assert_eq(grpc_parse_request(none) or GrpcCall.{stream_id: -1}.stream_id, -1)
    squeezed = g_cat(h2_headers(1, block4, false, true) or [], h2_data(1, grpc_frame([1], true) or [], true) or [])
    assert_eq(grpc_parse_request(squeezed) or GrpcCall.{stream_id: -1}.stream_id, -1)
    mixed = g_cat(h2_headers(1, block4, false, true) or [], h2_data(3, grpc_frame([1], false) or [], true) or [])
    assert_eq(grpc_parse_request(mixed) or GrpcCall.{stream_id: -1}.stream_id, -1)
    assert_eq(grpc_parse_request([]) or GrpcCall.{stream_id: -1}.stream_id, -1)
}

test "grpc request with settings frames and continuation" {
    block = grpc_request_headers("h", "/a/b", 1000, [], []) or []
    half = host.sys_arr_len(block) / 2
    first = g_slice(block, 0, half)
    rest = g_slice(block, half, host.sys_arr_len(block))
    wire = h2_settings([H2_SET_INITIAL_WINDOW_SIZE], [65535]) or []
    wire = g_cat(wire, h2_settings_ack())
    wire = g_cat(wire, h2_headers(1, first, false, false) or [])
    wire = g_cat(wire, h2_continuation(1, rest, true) or [])
    wire = g_cat(wire, h2_data(1, grpc_frame([4, 5], false) or [], true) or [])
    call = grpc_parse_request(wire) or GrpcCall.{stream_id: -1}
    assert_eq(call.stream_id, 1)
    assert_eq(call.path, "/a/b")
    assert_eq(call.timeout_ms, 1000)
    assert_eq(call.message, [4, 5])
    stray = g_cat(h2_headers(1, first, false, false) or [], h2_data(1, [], true) or [])
    assert_eq(grpc_parse_request(stray) or GrpcCall.{stream_id: -1}.stream_id, -1)
    orphan = g_cat(h2_continuation(1, rest, true) or [], h2_data(1, [], true) or [])
    assert_eq(grpc_parse_request(orphan) or GrpcCall.{stream_id: -1}.stream_id, -1)
    ping_frame = h2_ping([1, 2, 3, 4, 5, 6, 7, 8], false) or []
    skipped = g_cat(ping_frame, wire)
    via_ping = grpc_parse_request(skipped) or GrpcCall.{stream_id: -1}
    assert_eq(via_ping.stream_id, 1)
    priority = h2_frame(H2_PRIORITY, 0, 1, [0, 0, 0, 0, 16]) or []
    assert_eq(grpc_parse_request(g_cat(wire, priority)) or GrpcCall.{stream_id: -1}.stream_id, -1)
}

test "grpc response validation" {
    assert_eq(host.sys_arr_len(grpc_unary_response(0, [], 0, "") or []), 0)
    assert_eq(host.sys_arr_len(grpc_unary_response(1, [], -1, "") or []), 0)
    assert_eq(host.sys_arr_len(grpc_unary_response(1, [], 17, "") or []), 0)
    not_200 = hpack_encode([":status", "content-type", "grpc-status"], ["500", "application/grpc", "0"]) or []
    r = grpc_parse_response(h2_headers(1, not_200, true, true) or []) or GrpcReply.{status: -1}
    assert_eq(r.status, -1)
    wrong_type = hpack_encode([":status", "content-type", "grpc-status"], ["200", "text/html", "0"]) or []
    r2 = grpc_parse_response(h2_headers(1, wrong_type, true, true) or []) or GrpcReply.{status: -1}
    assert_eq(r2.status, -1)
    missing = hpack_encode([":status", "content-type"], ["200", "application/grpc"]) or []
    r3 = grpc_parse_response(h2_headers(1, missing, true, true) or []) or GrpcReply.{status: -1}
    assert_eq(r3.status, -1)
    letters = hpack_encode([":status", "content-type", "grpc-status"], ["200", "application/grpc", "x1"]) or []
    r4 = grpc_parse_response(h2_headers(1, letters, true, true) or []) or GrpcReply.{status: -1}
    assert_eq(r4.status, -1)
    high = hpack_encode([":status", "content-type", "grpc-status"], ["200", "application/grpc", "99"]) or []
    r5 = grpc_parse_response(h2_headers(1, high, true, true) or []) or GrpcReply.{status: -1}
    assert_eq(r5.status, -1)
    open_stream = g_cat(h2_headers(1, missing, false, true) or [], h2_data(1, [], false) or [])
    r6 = grpc_parse_response(open_stream) or GrpcReply.{status: -1}
    assert_eq(r6.status, -1)
    good_head = grpc_response_block()
    two_msgs = g_cat(h2_headers(1, good_head, false, true) or [], h2_data(1, g_cat(grpc_frame([1], false) or [], grpc_frame([2], false) or []), false) or [])
    two_msgs = g_cat(two_msgs, h2_headers(1, grpc_trailer_block(0, ""), true, true) or [])
    r7 = grpc_parse_response(two_msgs) or GrpcReply.{status: -1}
    assert_eq(r7.status, -1)
    zipped = g_cat(h2_headers(1, good_head, false, true) or [], h2_data(1, grpc_frame([1], true) or [], false) or [])
    zipped = g_cat(zipped, h2_headers(1, grpc_trailer_block(0, ""), true, true) or [])
    r8 = grpc_parse_response(zipped) or GrpcReply.{status: -1}
    assert_eq(r8.status, -1)
    three = g_cat(h2_headers(1, good_head, false, true) or [], h2_headers(1, grpc_trailer_block(0, ""), false, true) or [])
    three = g_cat(three, h2_headers(1, grpc_trailer_block(0, ""), true, true) or [])
    r9 = grpc_parse_response(three) or GrpcReply.{status: -1}
    assert_eq(r9.status, -1)
}

test "grpc large message spans several data frames" {
    payload = host.sys_arr_new(40000, 65)
    wire = grpc_unary_request(1, "h", "/big.Svc/Echo", payload, 0) or []
    frames = h2_frames(wire, H2_DEFAULT_MAX_FRAME) or []
    #assert(host.sys_arr_len(frames) >= 4)
    call = grpc_parse_request(wire) or GrpcCall.{stream_id: -1}
    assert_eq(host.sys_arr_len(call.message), 40000)
    assert_eq(call.message[0], 65)
    assert_eq(call.message[39999], 65)
    echoed = grpc_unary_response(call.stream_id, call.message, GRPC_OK, "") or []
    res = grpc_parse_response(echoed) or GrpcReply.{status: -1}
    assert_eq(res.status, 0)
    assert_eq(host.sys_arr_len(res.message), 40000)
}
