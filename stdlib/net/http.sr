//! std.net.http — HTTP types, wire codec, router, middleware, server and client
//!
//! Import with:
//!   use std.net.http
//!
//! Then call: http.ok(.{…}), http.bad_request({error: "…"}), http.not_found(...),
//! http.simulate_post(...), http.simulate_get(...). Status helpers take a Super value:
//! objects/maps/arrays are JSON-encoded; a `str` is the raw wire body.
//! Types: Response, Request, Router, RouteMatch, Cookie, CookieJar, Server, Conn, Client.
//!
//! Handlers are ordinary functions annotated with `#get("/path")` / `#post(...)`
//! / `#route("METHOD", "/path")`; this module supplies everything around them: canonical responses,
//! path-pattern routing (`/users/:id`, `/users/{id}`, `/files/{rest...}`, `GET /x`,
//! trailing `*`), query / form / multipart access, HTTP/1.1 message framing,
//! conditional + range responses, cookies, middleware helpers that are plain
//! functions over Request / Response (so a whole pipeline can be exercised in tests
//! with no sockets), and a blocking server and client over `std.io.socket`.
//!
//! Design notes (how this maps to Go's net/http):
//!   * Prefer `App.get("/path", |req| { … })` + `App.handle(req)` / `Server.serve(@app, stop)`
//!     so application code never touches `poll_stop` / `try_accept` / `read_request`.
//!     Handler ids (`Handler.Create`, …) remain for CRUD packs and hot-reload mounts.
//!   * `Conn.read_request` / `Conn.write_response` replace `ServeHTTP` + `ResponseWriter`
//!     and own keep-alive, HEAD and Date (used inside `Server.serve`, not by apps).
//!   * Wire framing runs on byte buffers (socket reads are raw bytes), so Content-Length
//!     and chunk sizes stay correct for multi-byte text and a message may straddle reads.
//!   * Hot-path tables are fixed-size: the router hashes the first literal segment into 64
//!     buckets, `RateLimiter` is a fixed slot table, `CookieJar` and the client's idle pool
//!     are bounded. Nothing grows with request count.
//!   * Every error that maps to a status starts with that status: `"431 request header too
//!     large"`. `error_status(msg)` recovers it.
//!   * JSON is the universal fallback body: `json_ok`, `json_error`, `problem`, and
//!     `wants_json` / `wants_binary` for Accept negotiation next to protobuf bodies.

use std.core.collections
use std.core.str
use std.sec.encoding
use std.fmt.json
use std.sec.hash
use std.sys.time
use std.sys.fs
use std.io.socket
use std.sys.signal

/// `HTTP_JSON` is `"application/json"`.
+HTTP_JSON = "application/json"
/// `HTTP_TEXT` is `"text/plain"`.
+HTTP_TEXT = "text/plain"
/// `HTTP_HTML` is `"text/html; charset=utf-8"`.
+HTTP_HTML = "text/html; charset=utf-8"
/// `HTTP_CRLF` is `"\r\n"`.
+HTTP_CRLF = "\r\n"
/// `HTTP_DOUBLE_CRLF` is `"\r\n\r\n"`.
+HTTP_DOUBLE_CRLF = "\r\n\r\n"
/// `HTTP_VERSION` is `"HTTP/1.1"`.
+HTTP_VERSION = "HTTP/1.1"
/// `HTTP_MAX_HEADER_BYTES` is `1048576`.
+HTTP_MAX_HEADER_BYTES = 1048576
/// `HTTP_MAX_BODY_BYTES` is `10485760`.
+HTTP_MAX_BODY_BYTES = 10485760
/// `HTTP_MAX_HEADERS` is `128`.
+HTTP_MAX_HEADERS = 128
/// `HTTP_READ_CHUNK` is `65536`.
+HTTP_READ_CHUNK = 65536

// --- methods and status codes (net/http Method* and Status*) -------------------------------

