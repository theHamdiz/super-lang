/// Test that ETags: strong, weak, list matching.
test "ETags: strong, weak, list matching" {
    a = etag_of("hello")
    assert_eq(a, etag_of("hello"))
    #assert(!(a == etag_of("hellp")))
    #assert(http_starts_with(a, "\""))
    w = etag_weak_of("hello")
    #assert(http_starts_with(w, "W/\""))
    big = repeat("x", 5000)
    #assert(!(etag_weak_of(big) == etag_weak_of(big + "y")))
    assert_eq(etag_strip("W/\"abc\""), "\"abc\"")
    #assert(etag_list_match("*", "\"a\"", false))
    #assert(etag_list_match("\"a\", \"b\"", "\"b\"", false))
    #assert(!(etag_list_match("\"a\", \"b\"", "\"c\"", false)))
    #assert(etag_list_match("W/\"a\"", "\"a\"", true))
    #assert(!(etag_list_match("W/\"a\"", "\"a\"", false)))
    #assert(etag_list_match("\"a\"", "W/\"a\"", true))
    #assert(!(etag_list_match("\"a\"", "", true)))
}

/// Test that preconditions: If-Match, If-None-Match, If-Modified-Since, If-Unmodified-Since.
test "preconditions: If-Match, If-None-Match, If-Modified-Since, If-Unmodified-Since" {
    et = "\"v1\""
    mt = 784111777
    gr = request("GET", "/", "")
    pu = request("PUT", "/", "")
    assert_eq(check_preconditions(gr, et, mt), 0)
    assert_eq(check_preconditions(req_with_header(gr, "If-None-Match", et), et, mt), 304)
    assert_eq(check_preconditions(req_with_header(gr, "If-None-Match", "\"other\""), et, mt), 0)
    assert_eq(check_preconditions(req_with_header(gr, "If-None-Match", "*"), et, mt), 304)
    assert_eq(check_preconditions(req_with_header(pu, "If-None-Match", et), et, mt), 412)
    assert_eq(check_preconditions(req_with_header(pu, "If-Match", et), et, mt), 0)
    assert_eq(check_preconditions(req_with_header(pu, "If-Match", "\"stale\""), et, mt), 412)
    assert_eq(check_preconditions(req_with_header(pu, "If-Match", "*"), et, mt), 0)
    assert_eq(check_preconditions(req_with_header(pu, "If-Match", et), "", mt), 412)
    assert_eq(check_preconditions(req_with_header(gr, "If-Modified-Since", http_date(mt)), et, mt), 304)
    assert_eq(check_preconditions(req_with_header(gr, "If-Modified-Since", http_date(mt - 10)), et, mt), 0)
    assert_eq(check_preconditions(req_with_header(gr, "If-Modified-Since", http_date(mt + 10)), et, mt), 304)
    assert_eq(check_preconditions(req_with_header(pu, "If-Unmodified-Since", http_date(mt - 10)), et, mt), 412)
    assert_eq(check_preconditions(req_with_header(pu, "If-Unmodified-Since", http_date(mt + 10)), et, mt), 0)
    both = req_with_header(req_with_header(gr, "If-None-Match", "\"nope\""), "If-Modified-Since", http_date(mt))
    assert_eq(check_preconditions(both, et, mt), 0)
    assert_eq(check_preconditions(req_with_header(gr, "If-Modified-Since", "junk"), et, mt), 0)
}

/// Test that ranges: forms, clamping, unsatisfiable, ignored.
test "ranges: forms, clamping, unsatisfiable, ignored" {
    s = parse_range("bytes=0-0", 10)
    assert_eq(s.status, 206)
    assert_eq(s.first, 0)
    assert_eq(s.last, 0)
    assert_eq(parse_range("bytes=5-100", 10).last, 9)
    assert_eq(parse_range("bytes=-100", 10).first, 0)
    assert_eq(parse_range("bytes=-1", 10).first, 9)
    assert_eq(parse_range("bytes=9-", 10).first, 9)
    assert_eq(parse_range("bytes=10-", 10).status, 416)
    assert_eq(parse_range("bytes=-0", 10).status, 416)
    assert_eq(parse_range("bytes=0-0", 0).status, 416)
    assert_eq(parse_range("bytes=5-2", 10).status, 0)
    assert_eq(parse_range("bytes=a-b", 10).status, 0)
    assert_eq(parse_range("items=0-1", 10).status, 0)
    assert_eq(parse_range("bytes=nope", 10).status, 0)
    assert_eq(parse_range("", 10).status, 0)
    assert_eq(parse_range("bytes= 2 - 4 ", 10).first, 2)
}

/// Test that serve_content: 200 / 206 / 304 / 412 / 416, If-Range, HEAD, validators.
test "serve_content: 200 / 206 / 304 / 412 / 416, If-Range, HEAD, validators" {
    body = "0123456789"
    et = etag_of(body)
    mt = 784111777
    gr = request("GET", "/f", "")
    full = serve_content(gr, "text/plain", body, et, mt)
    assert_eq(full.status, 200)
    assert_eq(full.body, body)
    assert_eq(header_of(full, "ETag") or "?", et)
    assert_eq(header_of(full, "Accept-Ranges") or "?", "bytes")
    assert_eq(header_of(full, "Last-Modified") or "?", "Sun, 06 Nov 1994 08:49:37 GMT")
    part = serve_content(req_with_header(gr, "Range", "bytes=2-4"), "text/plain", body, et, mt)
    assert_eq(part.status, 206)
    assert_eq(response_body_len(part), 3)
    assert_eq(header_of(part, "Content-Range") or "?", "bytes 2-4/10")
    assert_eq(header_of(part, "Content-Length") or "?", "3")
    assert_eq(socket_buf_text(part.bin), "234")
    tail = serve_content(req_with_header(gr, "Range", "bytes=-3"), "text/plain", body, et, mt)
    assert_eq(socket_buf_text(tail.bin), "789")
    assert_eq(header_of(tail, "Content-Range") or "?", "bytes 7-9/10")
    nope = serve_content(req_with_header(gr, "Range", "bytes=50-"), "text/plain", body, et, mt)
    assert_eq(nope.status, 416)
    assert_eq(header_of(nope, "Content-Range") or "?", "bytes */10")
    ifr_ok = serve_content(req_with_header(req_with_header(gr, "Range", "bytes=0-1"), "If-Range", et), "text/plain", body, et, mt)
    assert_eq(ifr_ok.status, 206)
    ifr_stale = serve_content(req_with_header(req_with_header(gr, "Range", "bytes=0-1"), "If-Range", "\"stale\""), "text/plain", body, et, mt)
    assert_eq(ifr_stale.status, 200)
    ifr_date = serve_content(req_with_header(req_with_header(gr, "Range", "bytes=0-1"), "If-Range", http_date(mt)), "text/plain", body, et, mt)
    assert_eq(ifr_date.status, 206)
    nm = serve_content(req_with_header(gr, "If-None-Match", et), "text/plain", body, et, mt)
    assert_eq(nm.status, 304)
    assert_eq(header_of(nm, "ETag") or "?", et)
    assert_eq(serve_content(req_with_header(request("PUT", "/f", ""), "If-Match", "\"zzz\""), "text/plain", body, et, mt).status, 412)
    // Ranges apply to bytes, not characters.
    uni = serve_content(req_with_header(gr, "Range", "bytes=0-1"), "text/plain", "é!", etag_of("é!"), 0)
    assert_eq(uni.status, 206)
    assert_eq(response_body_len(uni), 2)
    // Range only for GET / HEAD.
    assert_eq(serve_content(req_with_header(request("POST", "/f", ""), "Range", "bytes=0-1"), "text/plain", body, et, mt).status, 200)
}

/// Test that serve_file: index.html, mime, ETag, directory redirect and traversal safety.
test "serve_file: index.html, mime, ETag, directory redirect and traversal safety" {
    root = "/tmp/super_http_serve_file_{http_hex(http_now(), 1)}"
    fs_remove_all(root) or false
    #assert(fs_mkdir_all(root) or false)
    #assert(fs_mkdir_all("{root}/sub") or false)
    fs_write_str("{root}/index.html", "<h1>home</h1>") or false
    fs_write_str("{root}/app.css", "body{margin:0}") or false
    fs_write_str("{root}/sub/index.html", "sub-home") or false
    fs_write_str("{root}/hello world.txt", "spaced") or false
    home = serve_file(root, request("GET", "/", ""))
    assert_eq(home.status, 200)
    assert_eq(home.body, "<h1>home</h1>")
    assert_eq(home.content_type, "text/html; charset=utf-8")
    css = serve_file(root, request("GET", "/app.css?v=3", ""))
    assert_eq(css.content_type, "text/css; charset=utf-8")
    assert_eq(css.body, "body\{margin:0\}")
    tag = header_of(css, "ETag") or ""
    #assert(http_starts_with(tag, "W/"))
    cached = serve_file(root, req_with_header(request("GET", "/app.css", ""), "If-None-Match", tag))
    assert_eq(cached.status, 304)
    assert_eq(serve_file(root, request("GET", "/sub", "")).status, 301)
    assert_eq(header_of(serve_file(root, request("GET", "/sub", "")), "Location") or "?", "/sub/")
    assert_eq(serve_file(root, request("GET", "/sub/", "")).body, "sub-home")
    assert_eq(serve_file(root, request("GET", "/hello%20world.txt", "")).body, "spaced")
    assert_eq(serve_file(root, request("GET", "/missing.txt", "")).status, 404)
    assert_eq(serve_file(root, request("GET", "/../../../etc/passwd", "")).status, 404)
    assert_eq(serve_file(root, request("GET", "/%2e%2e/%2e%2e/etc/passwd", "")).status, 404)
    assert_eq(serve_file(root, request("GET", "/sub/../../etc/passwd", "")).status, 404)
    assert_eq(serve_file(root, request("GET", "/%zz", "")).status, 400)
    assert_eq(serve_file(root, request("GET", "relative", "")).status, 400)
    pst = serve_file(root, request("POST", "/app.css", ""))
    assert_eq(pst.status, 405)
    assert_eq(header_of(pst, "Allow") or "?", "GET, HEAD")
    fs_remove_all(root) or false
}

/// Fluent App: chaining, groups, CRUD, middleware, runtime mount/unmount.
test "app: fluent chain groups crud middleware mount" {
    app = App.new()
    app = @app
        .use(Mw.Security)
        .use(Mw.Logger)
        .use_cors(["*"], false)
        .route("GET", "/health", 10)
        .group("/api")
        .use(Mw.Json)
        .use_max_body(64)
        .route("POST", "/login", 20)
        .resource("/tasks", Crud.rest())
        .end()
    #assert(app.router.size() >= 8)
    assert_eq(app.match(request("GET", "/health", "")).id, 10)
    assert_eq(app.match(request("POST", "/api/login", "")).id, 20)
    assert_eq(app.match(request("GET", "/api/tasks", "")).id, Handler.List)
    assert_eq(app.match(request("POST", "/api/tasks", "")).id, Handler.Create)
    assert_eq(app.match(request("GET", "/api/tasks/9", "")).id, Handler.Show)
    assert_eq(app.match(request("PUT", "/api/tasks/9", "")).id, Handler.Update)
    assert_eq(app.match(request("PATCH", "/api/tasks/9", "")).id, Handler.Update)
    assert_eq(app.match(request("DELETE", "/api/tasks/9", "")).id, Handler.Destroy)
    // Runtime injection
    app = @app.route("GET", "/debug", 99)
    assert_eq(app.match(request("GET", "/debug", "")).id, 99)
    app = @app.unmount("GET", "/debug")
    assert_eq(app.match(request("GET", "/debug", "")).status, 404)
    // Middleware: oversized JSON body rejected under /api scope (JSON CT so Mw.Json passes).
    big = req_with_header(
        request("POST", "/api/tasks", "abcdefghijklmnopqrstuvwxyzabcdefghijklmnopqrstuvwxyzabcdefghijklmnopqrstuvwxyz"),
        "Content-Type",
        "application/json",
    )
    early = @app.before(big) or none
    #assert(early != none)
    assert_eq((early or ok("")).status, 413)
    // Health is outside /api — max-body does not apply
    tiny = request("GET", "/health", "")
    assert_eq((@app.before(tiny) or ok("pass")).status, 200)
    res = @app.after(tiny, ok("{\"ok\":true}"))
    assert_eq(header_of(res, "X-Content-Type-Options") or "?", "nosniff")
    #assert(header_of(res, "X-Super-Log") != none)
}

/// Mw / Handler sums and Crud helpers pack correctly.
test "app: crud helpers and mw ids" {
    #assert(Mw.Logger != Mw.Cors("", false))
    #assert(Mw.Compress != Mw.Etag)
    #assert(Handler.List != Handler.Create)
    #assert(Handler.Health != Handler.Login)
    pack = Crud.rest()
    assert_eq(pack.list, Handler.List)
    assert_eq(pack.create, Handler.Create)
    assert_eq(pack.show, Handler.Show)
    assert_eq(pack.update, Handler.Update)
    assert_eq(pack.destroy, Handler.Destroy)
    r = Crud.read(1, 2)
    assert_eq(r.list, 1)
    assert_eq(r.show, 2)
    assert_eq(r.create, -1)
    w = Crud.write(3, 4, 5)
    assert_eq(w.create, 3)
    assert_eq(w.destroy, 5)
    assert_eq(app_join("/api", "/tasks"), "/api/tasks")
    assert_eq(app_join("/api/", "tasks"), "/api/tasks")
    #assert(gate_early(RouteMatch.{id: -2, status: 204, keys: [], vals: [], pattern: "", allow: [], redirect: ""}))
}

/// App.handle + get + TestClient dispatch through middleware without sockets.
test "app: handle get and TestClient" {
    app = App.new()
    app = @app.use(Mw.Security)
    app = @app.get("/health", |_req| { ok({ok: true}) })
    app = @app.get(r"/items/{id}", |req| {
        ok({id: req.param("id")})
    })
    res = @app.handle(request("GET", "/health", ""))
    assert_eq(res.status, 200)
    assert_eq(header_of(res, "X-Content-Type-Options") or "?", "nosniff")
    miss = @app.handle(request("GET", "/nope", ""))
    assert_eq(miss.status, 404)
    item = @app.handle(request("GET", "/items/7", ""))
    assert_eq(item.status, 200)
    #assert(contains(item.body, "7"))
    tc = TestClient.new(app)
    assert_eq(@tc.get("/health").status, 200)
    assert_eq(@tc.get("/missing").status, 404)
}

test "#routes matches the plain App builder" {
    plain = App.new()
    plain = @plain.get("/health", |_req| { ok({up: true}) })
    sugar = #routes {
        get "/health" { ok({up: true}) }
    }
    plain_client = TestClient.new(plain)
    sugar_client = TestClient.new(sugar)
    assert_eq(@plain_client.get("/health").status, @sugar_client.get("/health").status)
    assert_eq(@plain_client.get("/health").body, @sugar_client.get("/health").body)
}

/// App.handle returns 301 with Location on unclean / trailing-slash paths.
test "app: handle 301 redirect with Location" {
    app = App.new()
    app = @app.get("/dir/", |_req| { ok({ok: true}) })
    res = @app.handle(request("GET", "/dir", ""))
    assert_eq(res.status, 301)
    assert_eq(header_of(res, "Location") or "?", "/dir/")
}

/// App.handle returns 405 with Allow header (RFC 9110).
test "app: handle 405 with Allow header" {
    app = App.new()
    app = @app.get("/only-get", |_req| { ok({ok: true}) })
    res = @app.handle(request("POST", "/only-get", ""))
    assert_eq(res.status, 405)
    allow = header_of(res, "Allow") or ""
    #assert(contains(allow, "GET"))
}

/// TestClient.post/put accept raw str and record bodies; patch + send work.
test "app: TestClient json bodies and send" {
    app = App.new()
    app = @app.post("/echo", |req| { text(req.body) })
    app = @app.put("/echo", |req| { text(req.body) })
    app = @app.patch("/echo", |req| { text(req.body) })
    tc = TestClient.new(app)
    raw = @tc.post("/echo", "{\"x\":1}")
    assert_eq(raw.status, 200)
    assert_eq(raw.body, "{\"x\":1}")
    rec = @tc.put("/echo", {title: "hi"})
    assert_eq(rec.status, 200)
    #assert(contains(rec.body, "title"))
    patched = @tc.patch("/echo", {done: true})
    assert_eq(patched.status, 200)
    #assert(contains(patched.body, "done"))
    custom = @tc.send(request("POST", "/echo", "raw"))
    assert_eq(custom.status, 200)
    assert_eq(custom.body, "raw")
}

/// Domain endpoints via get / post / crud with req.param / param_int.
test "app: get post crud with params" {
    app = App.new()
    app = @app
        .group("/api")
        .get("/health", |_req| { ok({ok: true}) })
        .post("/login", |_req| { ok({token: "t"}) })
        .crud("/tasks", CrudHandlers.rest(
            |_req| { ok({tasks: []}) },
            |req| { ok({created: req.body}) },
            |req| { ok({id: req.param_int("id", 0)}) },
            |req| { ok({id: req.param_int("id", 0), updated: true}) },
            |req| { ok({deleted: req.param("id")}) }
        ))
        .end()
    app = @app.mount("GET", "/debug/stats", |_req| { ok({stats: 1}) })
    app = @app.any("/ping", |_req| { ok({pong: true}) })
    tc = TestClient.new(app)
    assert_eq(@tc.get("/api/health").status, 200)
    assert_eq(@tc.post("/api/login", {}).status, 200)
    assert_eq(@tc.get("/api/tasks").status, 200)
    show = @tc.get("/api/tasks/42")
    assert_eq(show.status, 200)
    #assert(contains(show.body, "42"))
    destroyed = @tc.delete("/api/tasks/7")
    assert_eq(destroyed.status, 200)
    #assert(contains(destroyed.body, "7"))
    assert_eq(@tc.get("/debug/stats").status, 200)
    assert_eq(@tc.get("/ping").status, 200)
    assert_eq(@tc.post("/ping", "").status, 200)
}

/// Keep-alive loop (same shape as Server.serve) handles >2 requests on one Conn.
test "server: serve keep-alive beyond two requests" {
    app = App.new()
    app = @app.get("/n", |_req| { ok({ok: true}) })
    srv = t_server()
    if srv.fd < 0 { return }
    c = t_client()
    conn = t_dead_conn()
    n = 0
    for 0..5 {
        call = @c.start("GET", t_url(srv, "/n"), [], "")
        if n == 0 {
            conn = @srv.accept() or t_dead_conn()
        }
        ensure conn.open else {
            @srv.shutdown()
            return
        }
        mark = socket_req_enter()
        req = @conn.read_request() or err {
            conn = conn_req_revive(conn, mark)
            @conn.close()
            @srv.shutdown()
            return
        }
        res = @app.handle(req)
        @conn.write_response(req, res) or -1
        app = socket_req_promote(app)
        conn = conn_req_revive(conn, mark)
        ex = @c.finish(call)
        assert_eq(ex.res.status, 200)
        n += 1
        if !conn.keep { break }
    }
    #assert(n >= 3)
    #assert(conn.served >= 3)
    if conn.open { @conn.close() }
    _ = socket_conn_leave(0)
    @c.close_idle()
    @srv.shutdown()
}

/// Regression (ROUND7): multi-route keep-alive must not 404 after enter/leave.
/// Root cause was `arr_new` on the frame stack; `sup_stack_reset` at leave
/// overwrote `Router.prefix_heads` so only some routes survived.
test "server: multi-route keep-alive survives request leave" {
    app = App.new()
    app = @app.get("/ping", |_req| { ok("pong") })
    app = @app.get("/a", |_req| { ok("A") })
    app = @app.post("/echo", |req| { ok(req.body) })
    assert_eq(app.router.match("GET", "/a").status, 200)
    assert_eq(app.router.match("POST", "/echo").status, 200)
    // enter/leave alone must not clobber durable router tables
    mark = socket_req_enter()
    socket_req_leave(mark)
    assert_eq(app.router.match("GET", "/ping").status, 200)
    assert_eq(app.router.match("GET", "/a").status, 200)
    assert_eq(app.router.match("POST", "/echo").status, 200)
    // handle + promote + leave cycle (Server.serve shape)
    for 0..8 {
        mark = socket_req_enter()
        path = "/a"
        method = "GET"
        body = ""
        if it % 3 == 1 {
            path = "/echo"
            method = "POST"
            body = "hi"
        }
        if it % 3 == 2 { path = "/ping" }
        res = @app.handle(request(method, path, body))
        assert_eq(res.status, 200)
        app = socket_req_promote(app)
        socket_req_leave(mark)
        assert_eq(app.router.match("GET", "/a").status, 200)
        assert_eq(app.router.match("POST", "/echo").status, 200)
        assert_eq(app.router.match("GET", "/ping").status, 200)
    }
}
