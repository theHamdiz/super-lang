/// `Response` is an HTTP response: status, body, content type, headers, and optional raw bytes.
+Response = {
    /// HTTP status code.
    status: i64
    /// Response body text. Empty when the payload is raw bytes in `bin`. Defaults to `""`.
    body: str = ""
    /// Content-Type header value. Defaults to `"application/json"`.
    content_type: str = "application/json"
    /// Extra `Name: value` header lines. Defaults to `[]`.
    headers: _ = []
    /// Raw payload for binary bodies (protobuf, images). Empty array means "use `body`".
    bin: _ = []
}

/// `Request` is an HTTP request: method, path, body, and headers.
+Request = {
    /// Request method, such as `GET` or `POST`. Defaults to `"GET"`.
    method: str = "GET"
    /// Request path, including the query string when present. Defaults to `"/"`.
    path: str = "/"
    /// Request body text. Defaults to `""`.
    body: str = ""
    /// Header names, parallel with `hdr_vals`. Defaults to `[]`.
    hdr_names: _ = []
    /// Header values, parallel with `hdr_names`. Defaults to `[]`.
    hdr_vals: _ = []
    /// Protocol token, such as `HTTP/1.1`. Defaults to `"HTTP/1.1"`.
    proto: str = "HTTP/1.1"
    /// Peer address string, when the server recorded one. Defaults to `""`.
    remote_addr: str = ""
    /// Matched route id (filled by `App.handle`). Defaults to `-1`.
    match_id: i64 = -1
    /// Matched route status (`200` / `404` / `405`). Defaults to `0`.
    match_status: i64 = 0
    /// Captured path-parameter names from the matched route.
    match_keys: _ = []
    /// Captured path-parameter values, parallel with `match_keys`.
    match_vals: _ = []

    /// Path parameter `name` from the last `App.handle` match, or `""`.
    param(self, name: str) : str {
        keys = self.match_keys
        vals = self.match_vals
        n = len(keys)
        for i in 0..n {
            if keys[i] == name { return vals[i] }
        }
        ""
    }

    /// Integer path parameter, or `fallback` when missing / not a non-negative integer.
    param_int(self, name: str, fallback: i64) : i64 {
        v = http_parse_uint(self.param(name))
        if v < 0 { return fallback }
        v
    }

    /// Raw JSON body. Fails when empty. Typed `req.json(T)` uses the same body with
    /// a type witness for decode (struct name is first-class).
    json(self, _ty) : str! {
        ensure self.body != "" else { fail "empty JSON body" }
        self.body
    }
}

/// Length in characters, O(1). (Slicing and indexing are character based; use `.len` for
/// the UTF-8 byte length that goes on the wire.)
+http_len(s: str) : i64 => byte_len(s)

// --- character and token helpers ---------------------------------------------------------

/// True when `o` is a legal HTTP token character.
+http_is_token_char(o: i64) : bool {
    if o >= 48 && o <= 57 { return true }
    if o >= 65 && o <= 90 { return true }
    if o >= 97 && o <= 122 { return true }
    o == 33 || o == 35 || o == 36 || o == 37 || o == 38 || o == 39 || o == 42 || o == 43 || o == 45 || o == 46 || o == 94 || o == 95 || o == 96 || o == 124 || o == 126
}

/// True when `s` is a legal HTTP token.
+http_is_token(s: str) : bool {
    n = http_len(s)
    if n == 0 { return false }
    ok = true
    for 0..n {
        if !http_is_token_char(ord(s[it])) { ok = false }
    }
    ok
}

/// True when `s` contains an ASCII upper-case letter (stops at the first one, no allocation).
+http_has_upper(s: str) : bool {
    for 0..http_len(s) {
        o = ord(s[it])
        if o >= 65 && o <= 90 { return true }
    }
    false
}

/// ASCII lower-casing; returns `s` itself when it has no upper-case letters.
+http_lower(s: str) : str {
    n = http_len(s)
    if !http_has_upper(s) { return s }
    out = ""
    for 0..n {
        o = ord(s[it])
        if o >= 65 && o <= 90 { o = o + 32 }
        out = out + host.sys_chr(o)
    }
    out
}

/// Case-insensitive equality (header names, methods, tokens): one pass, early exit on the
/// first differing byte, no lower-cased copies.
+http_ieq(a: str, b: str) : bool {
    if a == b { return true }
    n = http_len(a)
    if n != http_len(b) { return false }
    for 0..n {
        x = ord(a[it])
        y = ord(b[it])
        if x >= 65 && x <= 90 { x = x + 32 }
        if y >= 65 && y <= 90 { y = y + 32 }
        if x != y { return false }
    }
    true
}

/// `content-type` -> `Content-Type` (textproto.CanonicalMIMEHeaderKey). Returns `name`
/// itself, with no allocation, when it is already canonical (the common case on the wire).
+canonical_header(name: str) : str {
    n = http_len(name)
    upper = true
    dirty = false
    for 0..n {
        o = ord(name[it])
        if !http_is_token_char(o) { return name }
        if upper && o >= 97 && o <= 122 { dirty = true }
        if !upper && o >= 65 && o <= 90 { dirty = true }
        upper = o == 45
    }
    if !dirty { return name }
    out = ""
    upper = true
    for 0..n {
        o = ord(name[it])
        if upper && o >= 97 && o <= 122 { o = o - 32 }
        if !upper && o >= 65 && o <= 90 { o = o + 32 }
        out = out + host.sys_chr(o)
        upper = o == 45
    }
    out
}

/// Header values may not carry CR / LF / NUL (response splitting) — those bytes are dropped.
+header_value_clean(v: str) : str {
    n = http_len(v)
    dirty = false
    for 0..n {
        o = ord(v[it])
        if o == 13 || o == 10 || o == 0 { dirty = true }
    }
    if !dirty { return v }
    out = ""
    for 0..n {
        c = v[it]
        o = ord(c)
        if o != 13 && o != 10 && o != 0 { out = out + c }
    }
    out
}

/// True when `v` is a legal header value.
+header_valid_value(v: str) : bool => header_value_clean(v) == v

/// True when `c` is HTTP horizontal whitespace (space or tab).
+http_is_space_tab(c: str) : bool => c == " " || c == "\t"

/// Trim index `lo` forward across spaces and tabs.
+http_trim_advance_lo(s: str, lo: i64, hi: i64) : i64 {
    if lo < hi && http_is_space_tab(s[lo]) { return lo + 1 }
    lo
}

/// Trim index `hi` backward across spaces and tabs.
+http_trim_rewind_hi(s: str, lo: i64, hi: i64) : i64 {
    if hi > lo && http_is_space_tab(s[hi - 1]) { return hi - 1 }
    hi
}

/// `s` with leading and trailing HTTP whitespace removed.
+http_trim(s: str) : str {
    n = http_len(s)
    lo = 0
    hi = n
    for 0..n {
        lo = http_trim_advance_lo(s, lo, hi)
    }
    for 0..n {
        hi = http_trim_rewind_hi(s, lo, hi)
    }
    s[lo..hi]
}

/// Index of `needle` in `s`, or -1.
+http_index_of(s: str, needle: str, from: i64) : i64 {
    n = http_len(s)
    m = http_len(needle)
    if m == 0 { return from }
    pos = -1
    first = needle[0]
    for from..(n - m + 1) {
        if pos < 0 && s[it] == first && s[it..(it + m)] == needle { pos = it }
    }
    pos
}

/// True when `s` begins with `prefix`.
+http_starts_with(s: str, prefix: str) : bool {
    m = http_len(prefix)
    if m > http_len(s) { return false }
    s[0..m] == prefix
}

/// True when `s` ends with `suffix`.
+http_ends_with(s: str, suffix: str) : bool {
    n = http_len(s)
    m = http_len(suffix)
    if m > n { return false }
    s[(n - m)..n] == suffix
}

/// Non-negative decimal; -1 when `s` is empty, has a non-digit, or exceeds 15 digits.
+http_parse_uint(s: str) : i64 {
    n = http_len(s)
    if n == 0 || n > 15 { return -1 }
    acc = 0
    for 0..n {
        d = ord(s[it]) - 48
        if d < 0 || d > 9 { return -1 }
        acc = acc * 10 + d
    }
    acc
}

/// True when `v` is a hex digit.
+http_hex_digit(v: i64) : str {
    digits = "0123456789abcdef"
    digits[v % 16]
}

/// Lower-case hex of a non-negative value, at least `width` digits.
+http_hex(v: i64, width: i64) : str {
    out = ""
    n = v
    for 0..16 {
        if n > 0 || http_len(out) < width {
            out = http_hex_digit(n % 16) + out
            n = n / 16
        }
    }
    if out == "" { return "0" }
    out
}

/// Value of hex digit `c`, or -1.
+http_hex_value(c: str) : i64 {
    o = ord(c)
    if o >= 48 && o <= 57 { return o - 48 }
    if o >= 97 && o <= 102 { return o - 87 }
    if o >= 65 && o <= 70 { return o - 55 }
    -1
}

/// Hex number (chunk sizes); -1 on empty / bad digit / overflow.
+http_parse_hex(s: str) : i64 {
    n = http_len(s)
    if n == 0 || n > 12 { return -1 }
    acc = 0
    for 0..n {
        d = http_hex_value(s[it])
        if d < 0 { return -1 }
        acc = acc * 16 + d
    }
    acc
}

// --- status table -------------------------------------------------------------------------

/// Reason phrase for a 1xx code, or empty.
+status_text_1xx(code: i64) : str {
    if code == 100 { return "Continue" }
    if code == 101 { return "Switching Protocols" }
    if code == 102 { return "Processing" }
    if code == 103 { return "Early Hints" }
    "Unknown"
}

/// Reason phrase for a 2xx code, or empty.
+status_text_2xx(code: i64) : str {
    if code == 200 { return "OK" }
    if code == 201 { return "Created" }
    if code == 202 { return "Accepted" }
    if code == 203 { return "Non-Authoritative Information" }
    if code == 204 { return "No Content" }
    if code == 205 { return "Reset Content" }
    if code == 206 { return "Partial Content" }
    if code == 207 { return "Multi-Status" }
    if code == 208 { return "Already Reported" }
    if code == 226 { return "IM Used" }
    "Unknown"
}

/// Reason phrase for a 3xx code, or empty.
+status_text_3xx(code: i64) : str {
    if code == 300 { return "Multiple Choices" }
    if code == 301 { return "Moved Permanently" }
    if code == 302 { return "Found" }
    if code == 303 { return "See Other" }
    if code == 304 { return "Not Modified" }
    if code == 305 { return "Use Proxy" }
    if code == 307 { return "Temporary Redirect" }
    if code == 308 { return "Permanent Redirect" }
    "Unknown"
}

/// Reason phrase for a 4xx code, or empty.
+status_text_4xx(code: i64) : str {
    if code == 400 { return "Bad Request" }
    if code == 401 { return "Unauthorized" }
    if code == 402 { return "Payment Required" }
    if code == 403 { return "Forbidden" }
    if code == 404 { return "Not Found" }
    if code == 405 { return "Method Not Allowed" }
    if code == 406 { return "Not Acceptable" }
    if code == 407 { return "Proxy Authentication Required" }
    if code == 408 { return "Request Timeout" }
    if code == 409 { return "Conflict" }
    if code == 410 { return "Gone" }
    if code == 411 { return "Length Required" }
    if code == 412 { return "Precondition Failed" }
    if code == 413 { return "Payload Too Large" }
    if code == 414 { return "URI Too Long" }
    if code == 415 { return "Unsupported Media Type" }
    if code == 416 { return "Range Not Satisfiable" }
    if code == 417 { return "Expectation Failed" }
    if code == 418 { return "I'm a teapot" }
    if code == 421 { return "Misdirected Request" }
    if code == 422 { return "Unprocessable Entity" }
    if code == 423 { return "Locked" }
    if code == 424 { return "Failed Dependency" }
    if code == 425 { return "Too Early" }
    if code == 426 { return "Upgrade Required" }
    if code == 428 { return "Precondition Required" }
    if code == 429 { return "Too Many Requests" }
    if code == 431 { return "Request Header Fields Too Large" }
    if code == 451 { return "Unavailable For Legal Reasons" }
    "Unknown"
}

/// Reason phrase for a 5xx code, or empty.
+status_text_5xx(code: i64) : str {
    if code == 500 { return "Internal Server Error" }
    if code == 501 { return "Not Implemented" }
    if code == 502 { return "Bad Gateway" }
    if code == 503 { return "Service Unavailable" }
    if code == 504 { return "Gateway Timeout" }
    if code == 505 { return "HTTP Version Not Supported" }
    if code == 506 { return "Variant Also Negotiates" }
    if code == 507 { return "Insufficient Storage" }
    if code == 508 { return "Loop Detected" }
    if code == 510 { return "Not Extended" }
    if code == 511 { return "Network Authentication Required" }
    "Unknown"
}

/// Reason phrase for every IANA-registered code; "Unknown" otherwise. At most one class
/// jump plus a bounded compare chain — O(1).
+status_text(code: i64) : str {
    cls = code / 100
    if cls == 2 { return status_text_2xx(code) }
    if cls == 4 { return status_text_4xx(code) }
    if cls == 5 { return status_text_5xx(code) }
    if cls == 3 { return status_text_3xx(code) }
    if cls == 1 { return status_text_1xx(code) }
    "Unknown"
}

/// True when `code` is in 100..199.
+status_is_informational(code: i64) : bool => code >= 100 && code < 200
/// True when `code` is in 200..299.
+status_is_success(code: i64) : bool => code >= 200 && code < 300
/// True when `code` is in 300..399.
+status_is_redirect(code: i64) : bool => code >= 300 && code < 400
/// True when `code` is in 400..499.
+status_is_client_error(code: i64) : bool => code >= 400 && code < 500
/// True when `code` is in 500..599.
+status_is_server_error(code: i64) : bool => code >= 500 && code < 600

/// 1xx, 204 and 304 never carry a body (RFC 9110 §6.4.1).
+status_has_body(code: i64) : bool => !(code < 200 || code == 204 || code == 304)

/// Only the redirect codes a client may follow (300 and 305 are not auto-followed).
+status_follows_location(code: i64) : bool => code == 301 || code == 302 || code == 303 || code == 307 || code == 308

/// Leading status of an `"NNN message"` error string; `fallback` when there isn't one.
+error_status(msg: str, fallback: i64) : i64 {
    if http_len(msg) < 3 { return fallback }
    n = http_parse_uint(msg[0..3])
    if n < 100 || n > 599 { return fallback }
    n
}

/// Message of an `"NNN message"` error with the status stripped.
+error_message(msg: str) : str {
    if http_len(msg) > 4 && http_parse_uint(msg[0..3]) >= 100 && msg[3] == " " { return msg[4..http_len(msg)] }
    msg
}

// --- responses ----------------------------------------------------------------------

/// Response with status `status`, body `body`, and content type `content_type`.
+response(status: i64, body: str, content_type: str) : Response => Response.{status, body, content_type, headers: [], bin: []}

/// Dual-mode JSON body: a `str` is the wire body as-is; any other Super value is `json_encode`d.
json_response_body(body) : str => json_body(body)

/// HTTP 200 OK. Pass a Super object/record/array to auto-JSON-encode, or a `str` for a raw body.
+ok(body) : Response => response(200, json_response_body(body), HTTP_JSON)
/// HTTP 201 Created. Pass a Super object/record/array to auto-JSON-encode, or a `str` for a raw body.
+created(body) : Response => response(201, json_response_body(body), HTTP_JSON)
/// HTTP 202 Accepted. Pass a Super object/record/array to auto-JSON-encode, or a `str` for a raw body.
+accepted(body) : Response => response(202, json_response_body(body), HTTP_JSON)
/// HTTP 204 No Content response with an empty body.
+no_content() : Response => response(204, "", HTTP_JSON)
/// HTTP 400 Bad Request. Pass a Super object/record/array to auto-JSON-encode, or a `str` for a raw body.
+bad_request(body) : Response => response(400, json_response_body(body), HTTP_JSON)
/// HTTP 401 Unauthorized. Pass a Super object/record/array to auto-JSON-encode, or a `str` for a raw body.
+unauthorized(body) : Response => response(401, json_response_body(body), HTTP_JSON)
/// HTTP 403 Forbidden. Pass a Super object/record/array to auto-JSON-encode, or a `str` for a raw body.
+forbidden(body) : Response => response(403, json_response_body(body), HTTP_JSON)
/// HTTP 404 Not Found. Pass a Super object/record/array to auto-JSON-encode, or a `str` for a raw body.
+not_found(body) : Response => response(404, json_response_body(body), HTTP_JSON)
/// HTTP 405 Method Not Allowed. Pass a Super object/record/array to auto-JSON-encode, or a `str` for a raw body.
+method_not_allowed(body) : Response => response(405, json_response_body(body), HTTP_JSON)
/// HTTP 429 Too Many Requests. Pass a Super object/record/array to auto-JSON-encode, or a `str` for a raw body.
+too_many_requests(body) : Response => response(429, json_response_body(body), HTTP_JSON)
/// HTTP 500 Internal Server Error. Pass a Super object/record/array to auto-JSON-encode, or a `str` for a raw body.
+server_error(body) : Response => response(500, json_response_body(body), HTTP_JSON)
/// 200 OK response whose plain-text body is `body`.
+text(body: str) : Response => response(200, body, HTTP_TEXT)
/// 200 OK response whose HTML body is `body`.
+html(body: str) : Response => response(200, body, HTTP_HTML)

/// HTTP 406 Not Acceptable. Pass a Super object/record/array to auto-JSON-encode, or a `str` for a raw body.
+not_acceptable(body) : Response => response(406, json_response_body(body), HTTP_JSON)
/// HTTP 408 Request Timeout. Pass a Super object/record/array to auto-JSON-encode, or a `str` for a raw body.
+request_timeout(body) : Response => response(408, json_response_body(body), HTTP_JSON)
/// HTTP 411 Length Required. Pass a Super object/record/array to auto-JSON-encode, or a `str` for a raw body.
+length_required(body) : Response => response(411, json_response_body(body), HTTP_JSON)
/// HTTP 412 Precondition Failed. Pass a Super object/record/array to auto-JSON-encode, or a `str` for a raw body.
+precondition_failed(body) : Response => response(412, json_response_body(body), HTTP_JSON)
/// HTTP 413 Payload Too Large. Pass a Super object/record/array to auto-JSON-encode, or a `str` for a raw body.
+payload_too_large(body) : Response => response(413, json_response_body(body), HTTP_JSON)
/// HTTP 414 URI Too Long. Pass a Super object/record/array to auto-JSON-encode, or a `str` for a raw body.
+uri_too_long(body) : Response => response(414, json_response_body(body), HTTP_JSON)
/// HTTP 415 Unsupported Media Type. Pass a Super object/record/array to auto-JSON-encode, or a `str` for a raw body.
+unsupported_media_type(body) : Response => response(415, json_response_body(body), HTTP_JSON)
/// HTTP 418 I'm a teapot. Pass a Super object/record/array to auto-JSON-encode, or a `str` for a raw body.
+teapot(body) : Response => response(418, json_response_body(body), HTTP_JSON)
/// HTTP 428 Precondition Required. Pass a Super object/record/array to auto-JSON-encode, or a `str` for a raw body.
+precondition_required(body) : Response => response(428, json_response_body(body), HTTP_JSON)
/// HTTP 431 Request Header Fields Too Large. Pass a Super object/record/array to auto-JSON-encode, or a `str` for a raw body.
+header_fields_too_large(body) : Response => response(431, json_response_body(body), HTTP_JSON)
/// HTTP 501 Not Implemented. Pass a Super object/record/array to auto-JSON-encode, or a `str` for a raw body.
+not_implemented(body) : Response => response(501, json_response_body(body), HTTP_JSON)
/// HTTP 502 Bad Gateway. Pass a Super object/record/array to auto-JSON-encode, or a `str` for a raw body.
+bad_gateway(body) : Response => response(502, json_response_body(body), HTTP_JSON)
/// HTTP 504 Gateway Timeout. Pass a Super object/record/array to auto-JSON-encode, or a `str` for a raw body.
+gateway_timeout(body) : Response => response(504, json_response_body(body), HTTP_JSON)
/// HTTP 505 HTTP Version Not Supported. Pass a Super object/record/array to auto-JSON-encode, or a `str` for a raw body.
+version_not_supported(body) : Response => response(505, json_response_body(body), HTTP_JSON)

/// HTTP 302 redirect to `location`.
+redirect(location: str) : Response {
    r = response(302, "", HTTP_TEXT)
    r.headers = arr_push(r.headers, "Location: {header_value_clean(location)}")
    r
}

/// Redirect with an explicit status: 301/308 permanent, 302/307 temporary, 303 "see other".
+redirect_with(code: i64, location: str) : Response {
    r = response(code, "", HTTP_TEXT)
    r.headers = arr_push(r.headers, "Location: {header_value_clean(location)}")
    r
}

/// HTTP 301 redirect. The `Location` header is `location`.
+moved_permanently(location: str) : Response => redirect_with(301, location)
/// HTTP 303 redirect. The `Location` header is `location`.
+see_other(location: str) : Response => redirect_with(303, location)
/// HTTP 307 redirect. The `Location` header is `location`.
+temporary_redirect(location: str) : Response => redirect_with(307, location)
/// HTTP 308 redirect. The `Location` header is `location`.
+permanent_redirect(location: str) : Response => redirect_with(308, location)

/// 304 Not Modified response with an empty body.
+not_modified() : Response => response(304, "", HTTP_TEXT)

/// `net/http.Error`: plain-text body plus a newline, sniffing disabled.
+http_error(code: i64, msg: str) : Response {
    r = response(code, "{msg}\n", "text/plain; charset=utf-8")
    r.headers = arr_push(r.headers, "X-Content-Type-Options: nosniff")
    r
}

/// `net/http.NotFound` / status-only helper: the canonical reason phrase as the body.
+error_for(code: i64) : Response => http_error(code, status_text(code))

/// 416 with the `Content-Range: bytes */size` Go and nginx send.
+range_not_satisfiable(size: i64) : Response {
    r = response(416, "", HTTP_TEXT)
    r.headers = arr_push(r.headers, "Content-Range: bytes */{size}")
    r
}

// --- JSON bodies (the universal fallback next to binary / protobuf payloads) --------------------

/// HTTP 200 OK. Same dual-mode body as `ok`.
+json_ok(body) : Response => ok(body)
/// JSON response with status `code`. Same dual-mode body as `ok`.
+json_status(code: i64, body) : Response => response(code, json_response_body(body), HTTP_JSON)

/// JSON response with status `code` and an `{"error": ...}` body quoting `msg`.
+json_error(code: i64, msg: str) : Response => response(code, "{JSON_LB}\"error\":{json_quote(msg)}{JSON_RB}", HTTP_JSON)

/// RFC 9457 problem details.
+problem(code: i64, title: str, detail: str) : Response {
    body = "{JSON_LB}\"type\":\"about:blank\",\"title\":{json_quote(title)},\"status\":{code},\"detail\":{json_quote(detail)}{JSON_RB}"
    response(code, body, "application/problem+json")
}

/// Binary payload (protobuf, images, …). `body` stays empty; the bytes go out as-is.
+binary(code: i64, content_type: str, data: _) : Response {
    Response.{status: code, body: "", content_type, headers: [], bin: data}
}

/// True when `r`'s status is in 200..299.
+is_success(r: Response) : bool => r.status >= 200 && r.status < 300
/// True when `r`'s status is 400 or higher.
+is_error(r: Response) : bool => r.status >= 400
/// True when `r`'s status is one that carries a `Location` header.
+is_redirect(r: Response) : bool => status_follows_location(r.status)

// --- response headers (Go: Header.Add / Set / Get / Values / Del) -------------------------

/// "Name: value" entry -> name part.
+entry_name(e: str) : str {
    n = http_len(e)
    pos = n
    for 0..n {
        if pos == n && e[it] == ":" { pos = it }
    }
    e[0..pos]
}

/// "Name: value" entry -> value part with optional whitespace trimmed.
+entry_value(e: str) : str {
    n = http_len(e)
    pos = -1
    for 0..n {
        if pos < 0 && e[it] == ":" { pos = it }
    }
    if pos < 0 { return "" }
    http_trim(e[(pos + 1)..n])
}

/// Copy of `r` with `Name: value` appended (Header.Add). `Content-Type` replaces the field.
+with_header(r: Response, name: str, value: str) : Response {
    out = Response.{status: r.status, body: r.body, content_type: r.content_type, headers: r.headers, bin: r.bin}
    if !http_is_token(name) {
        out.headers = r.headers
        return out
    }
    v = header_value_clean(value)
    if http_ieq(name, "Content-Type") {
        out.content_type = v
        out.headers = r.headers
        return out
    }
    out.headers = arr_push(r.headers, "{canonical_header(name)}: {v}")
    out
}

/// Replace every existing `name` header with a single value (Header.Set).
+set_header(r: Response, name: str, value: str) : Response => with_header(del_header(r, name), name, value)

/// Copy of `r` without any `name` header (Header.Del).
+del_header(r: Response, name: str) : Response {
    out = Response.{status: r.status, body: r.body, content_type: r.content_type, headers: [], bin: r.bin}
    kept = []
    for (r.headers) {
        if !http_ieq(entry_name(it), name) { kept = arr_push(kept, it) }
    }
    out.headers = kept
    out
}

/// First value of header `name`, case-insensitively (Header.Get). Content-Type and
/// Content-Length read from the fields they are rendered from.
+header_of(r: Response, name: str) : str? {
    if http_ieq(name, "Content-Type") { return r.content_type }
    if http_ieq(name, "Content-Length") { return "{response_body_len(r)}" }
    found = none
    for (r.headers) {
        if found == none && http_ieq(entry_name(it), name) { found = entry_value(it) }
    }
    found
}

/// Every value of header `name` (Header.Values), in order.
+header_values(r: Response, name: str) {
    out = []
    for (r.headers) {
        if http_ieq(entry_name(it), name) { out = arr_push(out, entry_value(it)) }
    }
    out
}

/// True when `r` already has a header named `name`.
+has_header(r: Response, name: str) : bool => header_of(r, name) != none

/// Length of the response body.
+response_body_len(r: Response) : i64 {
    if len(r.bin) > 0 { return len(r.bin) }
    b = "{r.body}"
    b.len
}

/// Copy of `r` with status `code`.
+with_status(r: Response, code: i64) : Response {
    Response.{status: code, body: r.body, content_type: r.content_type, headers: r.headers, bin: r.bin}
}

/// Copy of `r` with body `body`.
+with_body(r: Response, body: str) : Response {
    Response.{status: r.status, body, content_type: r.content_type, headers: r.headers, bin: []}
}

/// Copy of `r` with a `Cache-Control` header of `value`.
+with_cache_control(r: Response, value: str) : Response => set_header(r, "Cache-Control", value)
/// Copy of `r` with an `ETag` header of `etag`.
+with_etag(r: Response, etag: str) : Response => set_header(r, "ETag", etag)
/// Copy of `r` with a `Last-Modified` header of `unix_secs`.
+with_last_modified(r: Response, unix_secs: i64) : Response => set_header(r, "Last-Modified", http_date(unix_secs))

/// `Cache-Control: no-store` plus the legacy `Pragma` / `Expires` trio.
+with_no_store(r: Response) : Response {
    a = set_header(r, "Cache-Control", "no-store, no-cache, must-revalidate")
    b = set_header(a, "Pragma", "no-cache")
    set_header(b, "Expires", "0")
}

/// Copy of `r` with a `Cache-Control: max-age=`seconds`` header.
+with_max_age(r: Response, seconds: i64) : Response => set_header(r, "Cache-Control", "public, max-age={seconds}")

// --- rendering (Response.Write) --------------------------------------------------------------

/// Status line + headers + blank line. `body_len` is what Content-Length announces; codes
/// that never carry a body (1xx / 204 / 304) omit Content-Type and Content-Length.
+render_head(r: Response, body_len: i64) : str {
    head = "HTTP/1.1 {r.status} {status_text(r.status)}\r\n"
    if status_has_body(r.status) {
        head = "{head}Content-Type: {r.content_type}\r\nContent-Length: {body_len}\r\n"
    }
    extra = ""
    for (r.headers) { extra = "{extra}{it}\r\n" }
    "{head}{extra}\r\n"
}

/// The full text of the response as written to the socket (binary `bin` payloads excluded;
/// use `Conn.write_response`).
+render(r: Response) : str {
    body = "{r.body}"
    if !status_has_body(r.status) { body = "" }
    "{render_head(r, body.len)}{body}"
}

/// Response to a HEAD request: same head as GET, no body.
+render_head_only(r: Response) : str => render_head(r, response_body_len(r))

/// Adds `Date`, and `Connection: close` when the connection will not be reused.
+render_full(r: Response, now_unix: i64, keep_alive: bool) : str {
    out = with_header(r, "Date", http_date(now_unix))
    if !keep_alive { out = with_header(out, "Connection", "close") }
    render(out)
}

// --- requests ----------------------------------------------------------------------------

/// Request with method `method`, path `path`, and body `body`.
+request(method: str, path: str, body: str) : Request => Request.{method, path, body, hdr_names: [], hdr_vals: [], proto: "HTTP/1.1", remote_addr: "", match_id: -1, match_status: 0, match_keys: [], match_vals: []}

/// Copy of `r` with header `name` set to `value`.
+req_with_header(r: Request, name: str, value: str) : Request {
    out = r
    out.hdr_names = arr_push(r.hdr_names, canonical_header(name))
    out.hdr_vals = arr_push(r.hdr_vals, header_value_clean(value))
    out
}

/// Replace all existing `name` headers with one value.
+req_set_header(r: Request, name: str, value: str) : Request {
    out = r
    names = []
    vals = []
    rn = r.hdr_names
    rv = r.hdr_vals
    for rn {
        if !http_ieq(it, name) {
            names = arr_push(names, it)
            vals = arr_push(vals, rv[index])
        }
    }
    out.hdr_names = names
    out.hdr_vals = vals
    req_with_header(out, name, value)
}

/// First value of `name`, case-insensitively (Header.Get).
+req_header(r: Request, name: str) : str? {
    found = none
    names = r.hdr_names
    vals = r.hdr_vals
    for names {
        if http_ieq(it, name) {
            found = vals[index]
            break
        }
    }
    found
}

/// All values of `name` in arrival order (Header.Values).
+req_header_values(r: Request, name: str) {
    out = []
    names = r.hdr_names
    vals = r.hdr_vals
    for names {
        if http_ieq(it, name) { out = arr_push(out, vals[index]) }
    }
    out
}

/// True when `r` has a header named `name`.
+req_has_header(r: Request, name: str) : bool => req_header(r, name) != none

/// `Host` header of `r`.
+req_host(r: Request) : str => req_header(r, "Host") or ""
/// `User-Agent` header of `r`.
+req_user_agent(r: Request) : str => req_header(r, "User-Agent") or ""
/// `Referer` header of `r`.
+req_referer(r: Request) : str => req_header(r, "Referer") or ""
/// `Content-Type` header of `r`.
+req_content_type(r: Request) : str => req_header(r, "Content-Type") or ""

/// Media type without parameters, lower-cased: `Text/HTML; charset=x` -> `text/html`.
+media_type(content_type: str) : str {
    n = http_len(content_type)
    cut = n
    for 0..n {
        if cut == n && content_type[it] == chr(59) { cut = it }
    }
    http_lower(http_trim(content_type[0..cut]))
}

/// Path without its `?query` part.
+path_only(target: str) : str {
    n = http_len(target)
    q = n
    for 0..n {
        if q == n && target[it] == "?" { q = it }
    }
    target[0..q]
}

/// Raw query string of `target` (no leading `?`), "" when absent.
+query_raw(target: str) : str {
    n = http_len(target)
    q = -1
    for 0..n {
        if q < 0 && target[it] == "?" { q = it }
    }
    if q < 0 { return "" }
    target[(q + 1)..n]
}

/// Value of `key` in the query string of `target`, or none (raw, not percent-decoded).
+query_get(target: str, key: str) : str? {
    n = http_len(target)
    start = -1
    for 0..n {
        if start < 0 && target[it] == "?" { start = it + 1 }
    }
    if start < 0 { return none }
    found = none
    pair_start = start
    for start..(n + 1) {
        if it == n || target[it] == "&" {
            pair = target[pair_start..it]
            pair_start = it + 1
            pn = http_len(pair)
            eq = pn
            for 0..pn {
                if eq == pn && pair[it] == "=" { eq = it }
            }
            if found == none && pair[0..eq] == key {
                if eq < pn { found = pair[(eq + 1)..pn] } else { found = "" }
            }
        }
    }
    found
}

// --- percent encoding, query strings and forms ------------------------------------------------------

/// Decode `%XX` escapes (and `+` as space when `plus_space`) over UTF-8 bytes. Returns `s`
/// itself when there is nothing to decode.
+http_unescape(s: str, plus_space: bool) : str! {
    n = http_len(s)
    clean = true
    for 0..n {
        c = s[it]
        if c == "%" || (plus_space && c == "+") { clean = false }
    }
    if clean { return s }
    bytes = []
    i = 0
    while i < n {
        c = s[i]
        if c == "%" {
            if i + 2 >= n { fail "400 bad percent escape" }
            hi = http_hex_value(s[i + 1])
            lo = http_hex_value(s[i + 2])
            if hi < 0 || lo < 0 { fail "400 bad percent escape" }
            bytes = arr_push(bytes, hi * 16 + lo)
            i += 3
        } else {
            if c == "+" && plus_space {
                bytes = arr_push(bytes, 32)
            } else {
                o = ord(c)
                if o < 128 {
                    bytes = arr_push(bytes, o)
                } else {
                    cb = socket_octets(c)
                    m = cb.len
                    for 0..m { bytes = arr_push(bytes, cb[it]) }
                }
            }
            i += 1
        }
    }
    socket_buf_text(bytes)
}

/// Percent-decode one `%HH` sequence.
+http_pct(v: i64) : str {
    digits = "0123456789ABCDEF"
    "%" + digits[v / 16] + digits[v % 16]
}

/// Percent-encode everything but RFC 3986 unreserved characters (QueryEscape, with %20 for space).
+http_escape(s: str) : str {
    n = http_len(s)
    out = ""
    for 0..n {
        c = s[it]
        o = ord(c)
        if (o >= 48 && o <= 57) || (o >= 65 && o <= 90) || (o >= 97 && o <= 122) || o == 45 || o == 46 || o == 95 || o == 126 {
            out = out + c
        } else {
            cb = socket_octets(c)
            m = cb.len
            for 0..m { out = out + http_pct(cb[it]) }
        }
    }
    out
}

/// Like `http_escape` but keeps `/` so URL paths stay readable (PathEscape for whole paths).
+path_escape(s: str) : str {
    n = http_len(s)
    out = ""
    start = 0
    for 0..(n + 1) {
        if it == n || s[it] == "/" {
            out = out + http_escape(s[start..it])
            if it < n { out = out + "/" }
            start = it + 1
        }
    }
    out
}

/// Flat decoded [key, value, key, value, …] from `k=v&k=v` text (query string or form body).
+form_pairs(raw: str) {
    out = []
    n = http_len(raw)
    if n == 0 { return out }
    start = 0
    for 0..(n + 1) {
        if it == n || raw[it] == "&" {
            pair = raw[start..it]
            start = it + 1
            pn = http_len(pair)
            if pn > 0 {
                eq = pn
                for 0..pn {
                    if eq == pn && pair[it] == "=" { eq = it }
                }
                kraw = pair[0..eq]
                k = http_unescape(kraw, true) or kraw
                v = ""
                if eq < pn {
                    vraw = pair[(eq + 1)..pn]
                    v = http_unescape(vraw, true) or vraw
                }
                out = arr_push(out, k)
                out = arr_push(out, v)
            }
        }
    }
    out
}

/// Decoded query parameters of a request target.
+query_pairs(target: str)  => form_pairs(query_raw(target))

/// First value for `key` in flat pairs, or none.
+pairs_get(pairs: _, key: str) : str? {
    n = len(pairs) / 2
    for 0..n {
        if pairs[it * 2] == key { return pairs[it * 2 + 1] }
    }
    none
}

/// Every value for `key` in flat pairs (Values / `?tag=a&tag=b`).
+pairs_get_all(pairs: _, key: str) {
    out = []
    n = len(pairs) / 2
    for 0..n {
        if pairs[it * 2] == key { out = arr_push(out, pairs[it * 2 + 1]) }
    }
    out
}

/// Decoded value of `key` in the query of `target`.
+query_value(target: str, key: str) : str? => pairs_get(query_pairs(target), key)

/// Integer query parameter with a default for missing / malformed values.
+query_int(target: str, key: str, fallback: i64) : i64 {
    v = query_value(target, key) or ""
    n = http_parse_uint(v)
    if n < 0 { return fallback }
    n
}

/// True when the query string `target` contains the key `key`.
+query_has(target: str, key: str) : bool => query_get(target, key) != none

/// `k=v&k=v` from flat pairs, percent-encoded (Values.Encode, insertion order).
+build_query(pairs: _) : str {
    out = ""
    n = len(pairs) / 2
    for 0..n {
        piece = http_escape(pairs[it * 2]) + "=" + http_escape(pairs[it * 2 + 1])
        if it == 0 { out = piece } else { out = out + "&" + piece }
    }
    out
}

/// Request.FormValue: urlencoded body fields (POST/PUT/PATCH) first, then the query string.
+req_form_value(r: Request, key: str) : str? {
    if r.method == "POST" || r.method == "PUT" || r.method == "PATCH" {
        if media_type(req_content_type(r)) == "application/x-www-form-urlencoded" {
            v = pairs_get(form_pairs(r.body), key) or none
            if v != none { return v }
        }
    }
    query_value(r.path, key)
}

/// Request.PostFormValue: body fields only.
+req_post_value(r: Request, key: str) : str? {
    if media_type(req_content_type(r)) != "application/x-www-form-urlencoded" { return none }
    pairs_get(form_pairs(r.body), key)
}

// --- header parameters and multipart ------------------------------------------------------------

/// `key` parameter of a header value: `form-data; name="a b"; filename=x` -> `a b` for "name".
/// Quoted and bare values are both handled; "" when absent.
+header_param(h: str, key: str) : str {
    needle = key + "="
    n = http_len(h)
    from = 0
    for 0..8 {
        pos = http_index_of(h, needle, from)
        if pos < 0 { return "" }
        prev = ""
        if pos > 0 { prev = h[pos - 1] }
        if pos == 0 || prev == " " || prev == chr(59) {
            vs = pos + http_len(needle)
            if vs < n && h[vs] == "\"" {
                ve = http_index_of(h, "\"", vs + 1)
                if ve < 0 { return h[(vs + 1)..n] }
                return h[(vs + 1)..ve]
            }
            ve = n
            for vs..n {
                if ve == n && h[it] == chr(59) { ve = it }
            }
            return http_trim(h[vs..ve])
        }
        from = pos + 1
    }
    ""
}

/// Multipart boundary from Content-Type, or none.
+multipart_boundary(content_type: str) : str? {
    b = header_param(content_type, "boundary")
    if b == "" { return none }
    b
}

/// `MultipartForm` holds the parts of a parsed multipart body.
+MultipartForm = {
    /// Names on `MultipartForm`. Defaults to `[]`.
    names: _ = []
    /// Filenames on `MultipartForm`. Defaults to `[]`.
    filenames: _ = []
    /// Ctypes on `MultipartForm`. Defaults to `[]`.
    ctypes: _ = []
    /// Datas on `MultipartForm`. Defaults to `[]`.
    datas: _ = []
}

/// Split a multipart/form-data body into parts (Request.ParseMultipartForm). Offsets are UTF-8
/// bytes, so binary-ish text survives. At most 1024 parts.
+multipart_parse(body: str, boundary: str) : MultipartForm! {
    form = MultipartForm.{names: [], filenames: [], ctypes: [], datas: []}
    if boundary == "" { fail "400 multipart: empty boundary" }
    delim = "--{boundary}"
    sep = "\r\n--{boundary}"
    dl = delim.len
    pos = socket_buf_find(body, delim, 0)
    if pos < 0 { fail "400 multipart: missing opening boundary" }
    done = false
    for 0..1024 {
        if !done {
            aft = pos + dl
            tail = socket_buf_text(socket_buf_slice(body, aft, aft + 2))
            if tail == "--" {
                done = true
            } else {
                if tail != "\r\n" { fail "400 multipart: malformed boundary line" }
                hs = aft + 2
                he = socket_buf_find(body, "\r\n\r\n", hs - 2)
                if he < 0 { fail "400 multipart: unterminated part headers" }
                head = ""
                if he >= hs { head = socket_buf_text(socket_buf_slice(body, hs, he)) }
                cs = he + 4
                nxt = socket_buf_find(body, sep, cs - 2)
                if nxt < 0 { fail "400 multipart: missing closing boundary" }
                data = ""
                if nxt >= cs { data = socket_buf_text(socket_buf_slice(body, cs, nxt)) }
                cd = ""
                ct = ""
                for (http_lines(head)) {
                    if http_starts_with(http_lower(it), "content-disposition:") { cd = it }
                    if http_starts_with(http_lower(it), "content-type:") { ct = entry_value(it) }
                }
                form.names = arr_push(form.names, header_param(cd, "name"))
                form.filenames = arr_push(form.filenames, header_param(cd, "filename"))
                form.ctypes = arr_push(form.ctypes, ct)
                form.datas = arr_push(form.datas, data)
                pos = nxt + 2
            }
        }
    }
    if !done { fail "400 multipart: too many parts or no closing delimiter" }
    form
}

/// Data of the first part named `name`.
+mp_get(f: MultipartForm, name: str) : str? {
    names = f.names
    datas = f.datas
    for names {
        if it == name { return datas[index] }
    }
    none
}

/// Uploaded filename of the first part named `name` ("" for plain fields).
+mp_filename(f: MultipartForm, name: str) : str {
    names = f.names
    fns = f.filenames
    for names {
        if it == name { return fns[index] }
    }
    ""
}

/// Build a multipart/form-data body. `filenames[i] == ""` makes a plain field.
+multipart_encode(boundary: str, names: _, filenames: _, ctypes: _, datas: _) : str {
    out = ""
    for names {
        i = index
        out = "{out}--{boundary}\r\nContent-Disposition: form-data; name=\"{it}\""
        if filenames[i] != "" { out = "{out}{chr(59)} filename=\"{filenames[i]}\"" }
        out = "{out}\r\n"
        if ctypes[i] != "" { out = "{out}Content-Type: {ctypes[i]}\r\n" }
        out = "{out}\r\n{datas[i]}\r\n"
    }
    "{out}--{boundary}--\r\n"
}

/// Lines of `s` split on LF with a trailing CR removed; empty lines are dropped.
+http_lines(s: str) {
    out = []
    n = http_len(s)
    start = 0
    for 0..(n + 1) {
        if it == n || s[it] == "\n" {
            hi = it
            if hi > start && s[hi - 1] == "\r" { hi -= 1 }
            if hi > start { out = arr_push(out, s[start..hi]) }
            start = it + 1
        }
    }
    out
}

// --- dates (RFC 9110 IMF-fixdate) -------------------------------------------------------------

/// `Sun, 06 Nov 1994 08:49:37 GMT` for a Unix timestamp in seconds.
+http_date(unix_secs: i64) : str {
    secs = unix_secs
    if secs < 0 { secs = 0 }
    dt = DateTime.unix(secs)
    wd = ((secs / 86400) + 4) % 7
    mo = dt.month() - 1
    days = "SunMonTueWedThuFriSat"
    months = "JanFebMarAprMayJunJulAugSepOctNovDec"
    dname = days[(wd * 3)..(wd * 3 + 3)]
    mname = months[(mo * 3)..(mo * 3 + 3)]
    dd = time_pad2(dt.day(), 2)
    hh = time_pad2(dt.hour(), 2)
    mm = time_pad2(dt.minute(), 2)
    ss = time_pad2(dt.second(), 2)
    yy = dt.year()
    "{dname}, {dd} {mname} {yy} {hh}:{mm}:{ss} GMT"
}

/// Unix seconds from an IMF-fixdate, or -1 when `s` is not one.
+parse_http_date(s: str) : i64 {
    if http_len(s) != 29 || s[3] != "," || s[25..29] != " GMT" { return -1 }
    d = http_parse_uint(s[5..7])
    y = http_parse_uint(s[12..16])
    hh = http_parse_uint(s[17..19])
    mm = http_parse_uint(s[20..22])
    ss = http_parse_uint(s[23..25])
    months = "JanFebMarAprMayJunJulAugSepOctNovDec"
    mo = 0
    mname = s[8..11]
    for 0..12 {
        if months[(it * 3)..(it * 3 + 3)] == mname { mo = it + 1 }
    }
    if d < 1 || d > 31 || mo == 0 || y < 1970 || hh > 23 || mm > 59 || ss > 60 { return -1 }
    time_days_from_civil(y, mo, d) * 86400 + hh * 3600 + mm * 60 + ss
}

// --- cookies --------------------------------------------------------------------------------

/// `Cookie` is one HTTP cookie (name, value, path, flags, and max-age).
+Cookie = {
    /// Cookie name. Defaults to `""`.
    name: str = ""
    /// Cookie value. Defaults to `""`.
    value: str = ""
    /// Cookie path attribute. Defaults to `"/"`.
    path: str = "/"
    /// True when the cookie is marked HttpOnly. Defaults to `false`.
    http_only: bool = false
    /// True when the cookie is marked Secure. Defaults to `false`.
    secure: bool = false
    /// Max-Age in seconds. Negative means no expiry was set. Defaults to `-1`.
    max_age: i64 = -1
    /// Cookie domain attribute. Empty means a host-only cookie. Defaults to `""`.
    domain: str = ""
    /// "Lax", "Strict" or "None"; "" omits the attribute.
    same_site: str = ""
    /// Unix seconds; -1 omits `Expires`.
    expires: i64 = -1
}

/// Cookie named `name` with value `value`.
+cookie_new(name: str, value: str) : Cookie => Cookie.{name, value, path: "/", http_only: false, secure: false, max_age: -1, domain: "", same_site: "", expires: -1}

/// A session cookie hardened by default: HttpOnly, Secure, SameSite=Lax.
+cookie_session(name: str, value: str, max_age: i64) : Cookie => Cookie.{name, value, path: "/", http_only: true, secure: true, max_age, domain: "", same_site: "Lax", expires: -1}

/// Cookie values drop control characters, quotes, `;` and `\` (Go's sanitizeCookieValue).
+cookie_clean_value(v: str) : str {
    n = http_len(v)
    out = ""
    for 0..n {
        c = v[it]
        o = ord(c)
        if o >= 32 && o < 127 && o != 34 && o != 92 && o != 59 { out = out + c }
    }
    out
}

/// `Set-Cookie` header line for `c`.
+set_cookie_header(c: Cookie) : str {
    sep = chr(59)
    out = c.name + "=" + cookie_clean_value(c.value) + sep + " Path=" + c.path
    dom = c.domain or ""
    expd = c.expires or -1
    ss = c.same_site or ""
    if dom != "" { out = out + sep + " Domain=" + dom }
    if expd >= 0 { out = out + sep + " Expires=" + http_date(expd) }
    if c.http_only == true { out = out + sep + " HttpOnly" }
    if c.secure == true { out = out + sep + " Secure" }
    if ss != "" { out = out + sep + " SameSite=" + ss }
    if c.max_age >= 0 { out = out + sep + " Max-Age=" + "{c.max_age}" }
    out
}

/// Copy of the response with a `Set-Cookie` header for `c`.
+with_cookie(res: Response, c: Cookie) : Response => with_header(res, "Set-Cookie", set_cookie_header(c))

/// A cookie that tells the client to drop `name`.
+delete_cookie(name: str, path: str) : Cookie => Cookie.{name, value: "", path, http_only: false, secure: false, max_age: 0, domain: "", same_site: "", expires: 0}

/// Cookies parsed from a `Cookie` header line.
+parse_cookie_header(hdr: str) {
    out = []
    start = 0
    n = http_len(hdr)
    for 0..(n + 1) {
        cur = it
        if cur == n || hdr[cur] == chr(59) {
            piece = http_trim(hdr[start..cur])
            eq = -1
            for 0..http_len(piece) {
                if piece[it] == "=" && eq < 0 { eq = it }
            }
            if eq > 0 {
                val = piece[(eq + 1)..http_len(piece)]
                vn = http_len(val)
                if vn >= 2 && val[0] == "\"" && val[vn - 1] == "\"" { val = val[1..(vn - 1)] }
                out = arr_push(out, piece[0..eq])
                out = arr_push(out, val)
            }
            start = cur + 1
        }
    }
    out
}

/// Value of the cookie named `name`, or empty when missing, or `none` when absent.
+cookie_get(pairs: _, name: str) : str? {
    n = len(pairs) / 2
    for 0..n {
        if pairs[it * 2] == name { return pairs[it * 2 + 1] }
    }
    none
}

/// All cookies a request carries (several `Cookie:` headers are merged).
+req_cookies(r: Request) {
    out = []
    for (req_header_values(r, "Cookie")) {
        out = merge_pairs(out, parse_cookie_header(it))
    }
    out
}

/// Merge pairs (`a`, `b`).
+merge_pairs(a: _, b: _) {
    out = a
    for (b) { out = arr_push(out, it) }
    out
}

/// Cookie named `name` on the request, or `none` when absent.
+req_cookie(r: Request, name: str) : str? => cookie_get(req_cookies(r), name)

/// Cookie parsed from one `Set-Cookie` line, or fail.
+parse_set_cookie(line: str) : Cookie! {
    n = http_len(line)
    segs = []
    start = 0
    for 0..(n + 1) {
        if it == n || line[it] == chr(59) {
            segs = arr_push(segs, http_trim(line[start..it]))
            start = it + 1
        }
    }
    first = segs[0]
    fe = -1
    for 0..http_len(first) {
        if fe < 0 && first[it] == "=" { fe = it }
    }
    if fe <= 0 { fail "400 set-cookie: missing name=value" }
    cname = first[0..fe]
    if !http_is_token(cname) { fail "400 set-cookie: bad cookie name" }
    c = cookie_new(cname, first[(fe + 1)..http_len(first)])
    segn = len(segs)
    for 1..segn {
        seg = segs[it]
        eq = -1
        for 0..http_len(seg) {
            if eq < 0 && seg[it] == "=" { eq = it }
        }
        attr = http_lower(seg)
        val = ""
        if eq >= 0 {
            attr = http_lower(seg[0..eq])
            val = http_trim(seg[(eq + 1)..http_len(seg)])
        }
        if attr == "path" && val != "" { c.path = val }
        if attr == "domain" && val != "" {
            c.domain = http_lower(val)
            if c.domain[0] == "." { c.domain = c.domain[1..http_len(c.domain)] }
        }
        if attr == "max-age" {
            m = http_parse_uint(val)
            if m >= 0 { c.max_age = m } else { c.max_age = 0 }
        }
        if attr == "expires" { c.expires = parse_http_date(val) }
        if attr == "secure" { c.secure = true }
        if attr == "httponly" { c.http_only = true }
        if attr == "samesite" { c.same_site = val }
    }
    c
}

// --- cookie jar (http.CookieJar): bounded, no growth ---------------------------------------------

/// `CookieJar` stores cookies keyed by domain.
+CookieJar = {
    /// Domains on `CookieJar`. Defaults to `[]`.
    domains: _ = []
    /// Host only on `CookieJar`. Defaults to `[]`.
    host_only: _ = []
    /// Names on `CookieJar`. Defaults to `[]`.
    names: _ = []
    /// Vals on `CookieJar`. Defaults to `[]`.
    vals: _ = []
    /// Paths on `CookieJar`. Defaults to `[]`.
    paths: _ = []
    /// Secures on `CookieJar`. Defaults to `[]`.
    secures: _ = []
    /// Expiry on `CookieJar`. Defaults to `[]`.
    expiry: _ = []
    /// Cap on `CookieJar` (`i64`). Defaults to `64`.
    cap: i64 = 64
    /// Cursor on `CookieJar` (`i64`). Defaults to `0`.
    cursor: i64 = 0

    /// Empty value of this HTTP type.
    new(cap: i64) : CookieJar {
        n = cap
        if n < 1 { n = 1 }
        CookieJar.{domains: http_strs(n, ""), host_only: arr_new(n, 0), names: http_strs(n, ""), vals: http_strs(n, ""), paths: http_strs(n, ""), secures: arr_new(n, 0), expiry: arr_new(n, -1), cap: n, cursor: 0}
    }

    /// Number of live (non-expired) cookies.
    live(self, now: i64) : i64 {
        live = 0
        n = self.cap
        for 0..n {
            if self.names[it] != "" && !jar_expired(self.expiry[it], now) { live += 1 }
        }
        live
    }

    /// Remember a cookie set by `host`. Max-Age / Expires in the past delete the entry.
    store(@self, host: str, c: Cookie, now: i64) : bool {
        dom = c.domain or ""
        h = http_lower(host)
        host_only = dom == ""
        key_dom = dom
        if host_only { key_dom = h }
        if !host_only && !jar_domain_match(h, dom) { return false }
        until = -1
        if c.max_age >= 0 { until = now + c.max_age }
        if c.max_age < 0 && c.expires >= 0 { until = c.expires }
        slot = -1
        spare = -1
        n = self.cap
        for 0..n {
            if self.names[it] == "" || jar_expired(self.expiry[it], now) {
                if spare < 0 { spare = it }
            } else {
                if self.names[it] == c.name && self.domains[it] == key_dom && (self.paths[it] == c.path) { slot = it }
            }
        }
        gone = c.max_age == 0 || (until >= 0 && until <= now)
        if gone {
            if slot >= 0 { self.names = arr_set(self.names, slot, "") }
            return false
        }
        if slot < 0 { slot = spare }
        if slot < 0 {
            slot = self.cursor
            self.cursor = (self.cursor + 1) % n
        }
        self.domains = arr_set(self.domains, slot, key_dom)
        self.host_only = arr_set(self.host_only, slot, http_flag(host_only))
        self.names = arr_set(self.names, slot, c.name)
        self.vals = arr_set(self.vals, slot, c.value)
        self.paths = arr_set(self.paths, slot, c.path)
        self.secures = arr_set(self.secures, slot, http_flag(c.secure))
        self.expiry = arr_set(self.expiry, slot, until)
        true
    }

    /// Value for a `Cookie:` request header: `a=1; b=2` ("" when nothing applies).
    header_for(self, host: str, path: str, secure: bool, now: i64) : str {
        h = http_lower(host)
        out = ""
        n = self.cap
        for 0..n {
            if self.names[it] != "" && !jar_expired(self.expiry[it], now) {
                dom_ok = false
                if self.host_only[it] == 1 { dom_ok = self.domains[it] == h } else { dom_ok = jar_domain_match(h, self.domains[it]) }
                if dom_ok && jar_path_match(path, self.paths[it]) && (secure || self.secures[it] == 0) {
                    piece = self.names[it] + "=" + self.vals[it]
                    if out == "" { out = piece } else { out = out + chr(59) + " " + piece }
                }
            }
        }
        out
    }
}

/// Flag (`b`). Returns `i64`.
+http_flag(b: bool) : i64 {
    if b { return 1 }
    0
}

/// `n` copies of `fill` as a fresh array.
+http_strs(n: i64, fill: str) {
    out = []
    for 0..n { out = arr_push(out, fill) }
    out
}

/// True when the jar entry has passed its expiry.
+jar_expired(expiry: i64, now: i64) : bool => expiry >= 0 && expiry <= now

/// RFC 6265 domain-match: equal, or `host` ends with `.domain`.
+jar_domain_match(host: str, domain: str) : bool {
    if host == domain { return true }
    http_ends_with(host, "." + domain)
}

/// RFC 6265 path-match.
+jar_path_match(req_path: str, cookie_path: str) : bool {
    if cookie_path == "" || cookie_path == "/" { return true }
    if req_path == cookie_path { return true }
    if !http_starts_with(req_path, cookie_path) { return false }
    if http_ends_with(cookie_path, "/") { return true }
    req_path[http_len(cookie_path)] == "/"
}

// --- paths ----------------------------------------------------------------------------------

/// `path.Clean` for rooted URL paths: collapses `//`, resolves `.` and `..` (never above the
/// root), keeps a trailing slash. "" and "/" both clean to "/".
+path_clean(p: str) : str {
    n = http_len(p)
    if n == 0 { return "/" }
    segs = []
    start = 0
    for 0..(n + 1) {
        if it == n || p[it] == "/" {
            piece = p[start..it]
            start = it + 1
            if piece == ".." {
                if len(segs) > 0 { segs = arr_pop(segs) }
            } else {
                if piece != "" && piece != "." { segs = arr_push(segs, piece) }
            }
        }
    }
    out = ""
    for segs { out = out + "/" + it }
    if out == "" { return "/" }
    if p[n - 1] == "/" || http_ends_with(p, "/.") || http_ends_with(p, "/..") { out = out + "/" }
    out
}

/// `http.StripPrefix`: path with `prefix` removed (keeps a leading `/`), or none if absent.
+strip_prefix_path(path: str, prefix: str) : str? {
    if !http_starts_with(path, prefix) { return none }
    rest = path[http_len(prefix)..http_len(path)]
    if rest == "" { return "/" }
    if rest[0] != "/" { return "/" + rest }
    rest
}

// --- media types ----------------------------------------------------------------------------

/// `mime.TypeByExtension` for the web's usual suspects; `ext` may include the dot.
+mime_by_ext(ext: str) : str {
    e = http_lower(ext)
    if http_len(e) > 0 && e[0] == "." { e = e[1..http_len(e)] }
    if e == "html" || e == "htm" { return "text/html; charset=utf-8" }
    if e == "css" { return "text/css; charset=utf-8" }
    if e == "js" || e == "mjs" { return "text/javascript; charset=utf-8" }
    if e == "json" { return "application/json" }
    if e == "txt" || e == "text" || e == "log" || e == "md" { return "text/plain; charset=utf-8" }
    if e == "csv" { return "text/csv; charset=utf-8" }
    if e == "xml" { return "application/xml" }
    if e == "svg" { return "image/svg+xml" }
    if e == "png" { return "image/png" }
    if e == "jpg" || e == "jpeg" { return "image/jpeg" }
    if e == "gif" { return "image/gif" }
    if e == "webp" { return "image/webp" }
    if e == "ico" { return "image/x-icon" }
    if e == "avif" { return "image/avif" }
    if e == "pdf" { return "application/pdf" }
    if e == "zip" { return "application/zip" }
    if e == "gz" { return "application/gzip" }
    if e == "tar" { return "application/x-tar" }
    if e == "wasm" { return "application/wasm" }
    if e == "mp3" { return "audio/mpeg" }
    if e == "wav" { return "audio/wav" }
    if e == "ogg" { return "audio/ogg" }
    if e == "mp4" { return "video/mp4" }
    if e == "webm" { return "video/webm" }
    if e == "woff" { return "font/woff" }
    if e == "woff2" { return "font/woff2" }
    if e == "ttf" { return "font/ttf" }
    if e == "otf" { return "font/otf" }
    if e == "proto" { return "text/plain; charset=utf-8" }
    if e == "pb" || e == "bin" { return "application/octet-stream" }
    if e == "sr" { return "text/plain; charset=utf-8" }
    "application/octet-stream"
}

/// Media type for a file path (extension of the last segment).
+mime_for_path(path: str) : str {
    n = http_len(path)
    dot = -1
    for 0..n {
        if path[it] == "/" { dot = -1 }
        if path[it] == "." { dot = it }
    }
    if dot < 0 { return "application/octet-stream" }
    mime_by_ext(path[(dot + 1)..n])
}

/// `http.DetectContentType` over the first bytes: HTML, XML, PDF, GIF, plain text, else octet-stream.
+sniff_content_type(body: str) : str {
    n = http_len(body)
    head = body[0..32]
    low = http_lower(head)
    if http_starts_with(low, "<!doctype html") || http_starts_with(low, "<html") || http_starts_with(low, "<head") || http_starts_with(low, "<body") { return "text/html; charset=utf-8" }
    if http_starts_with(low, "<?xml") { return "text/xml; charset=utf-8" }
    if http_starts_with(head, "%PDF-") { return "application/pdf" }
    if http_starts_with(head, "GIF87a") || http_starts_with(head, "GIF89a") { return "image/gif" }
    lim = n
    if lim > 512 { lim = 512 }
    for 0..lim {
        o = ord(body[it])
        if o >= 0 && o < 32 && o != 9 && o != 10 && o != 12 && o != 13 && o != 27 { return "application/octet-stream" }
    }
    "text/plain; charset=utf-8"
}

// --- content negotiation (Accept) -----------------------------------------------------------

/// Quality of an `;q=0.8` parameter list as 0..1000 (1000 when absent or malformed).
+http_parse_q(params: str) : i64 {
    pos = http_index_of(params, "q=", 0)
    if pos < 0 { return 1000 }
    v = params[(pos + 2)..http_len(params)]
    stop = http_len(v)
    for 0..stop {
        if v[it] == chr(59) || v[it] == " " { stop = it }
    }
    v = v[0..stop]
    if v == "" { return 1000 }
    whole = http_parse_uint(v[0..1])
    if whole < 0 { return 1000 }
    if whole >= 1 { return 1000 }
    frac = 0
    digits = 0
    for 2..http_len(v) {
        d = ord(v[it]) - 48
        if d >= 0 && d <= 9 && digits < 3 {
            frac = frac * 10 + d
            digits += 1
        }
    }
    for 0..(3 - digits) { frac = frac * 10 }
    frac
}

/// q (0..1000) the `Accept` header gives `mime`, taking the most specific matching rng;
/// 0 when nothing matches.
+accept_quality(header: str, mime: str) : i64 {
    slash = http_index_of(mime, "/", 0)
    major = mime
    if slash >= 0 { major = mime[0..slash] }
    best = 0
    best_spec = 0
    n = http_len(header)
    start = 0
    for 0..(n + 1) {
        if it == n || header[it] == "," {
            item = http_trim(header[start..it])
            start = it + 1
            semi = http_index_of(item, chr(59), 0)
            rng = item
            params = ""
            if semi >= 0 {
                rng = http_trim(item[0..semi])
                params = item[(semi + 1)..http_len(item)]
            }
            rng = http_lower(rng)
            spec = 0
            if rng == mime { spec = 3 }
            if spec == 0 && rng == major + "/*" { spec = 2 }
            if spec == 0 && rng == "*/*" { spec = 1 }
            if spec > best_spec {
                best_spec = spec
                best = http_parse_q(params)
            }
        }
    }
    best
}

/// Does the client accept `mime`? A missing Accept header accepts everything.
+accepts(r: Request, mime: str) : bool {
    h = req_header(r, "Accept") or ""
    if h == "" { return true }
    accept_quality(h, mime) > 0
}

/// Highest-quality entry of `offers` the client accepts (earlier offers win ties); "" if none.
+negotiate(r: Request, offers: _) : str {
    h = req_header(r, "Accept") or ""
    best = ""
    best_q = 0
    for offers {
        q = 1000
        if h != "" { q = accept_quality(h, it) }
        if q > best_q {
            best_q = q
            best = it
        }
    }
    best
}

/// JSON is the default body: true when Accept is absent or admits application/json.
+wants_json(r: Request) : bool => accepts(r, "application/json")

/// Binary only when the client names `mime` explicitly (e.g. application/x-protobuf); `*/*`
/// keeps JSON. This is the JSON-fallback rule for protobuf-first APIs.
+wants_binary(r: Request, mime: str) : bool {
    h = req_header(r, "Accept") or ""
    if h == "" { return false }
    n = http_len(h)
    start = 0
    hit = false
    for 0..(n + 1) {
        if it == n || h[it] == "," {
            item = http_trim(h[start..it])
            start = it + 1
            semi = http_index_of(item, chr(59), 0)
            rng = item
            params = ""
            if semi >= 0 {
                rng = item[0..semi]
                params = item[(semi + 1)..http_len(item)]
            }
            if http_ieq(http_trim(rng), mime) && http_parse_q(params) > 0 { hit = true }
        }
    }
    hit
}

/// Protobuf-or-JSON reply: `bin` when the client explicitly asked for `mime`, else `json`.
+negotiate_body(r: Request, mime: str, json: str, bin: _) : Response {
    if wants_binary(r, mime) { return binary(200, mime, bin) }
    response(200, json, HTTP_JSON)
}

// --- authentication ------------------------------------------------------------------------

/// `Credentials` is a username and password for basic auth.
+Credentials = {
    /// User on `Credentials` (`str`). Defaults to `""`.
    user: str = ""
    /// Password on `Credentials` (`str`). Defaults to `""`.
    password: str = ""
}

/// Request.BasicAuth.
+req_basic_auth(r: Request) : Credentials? {
    h = req_header(r, "Authorization") or ""
    if http_len(h) < 7 || !http_ieq(h[0..6], "Basic ") { return none }
    raw = base64_decode(http_trim(h[6..http_len(h)])) or ""
    colon = http_index_of(raw, ":", 0)
    if colon < 0 { return none }
    Credentials.{user: raw[0..colon], password: raw[(colon + 1)..http_len(raw)]}
}

/// `Authorization` header value for HTTP Basic.
+basic_auth_header(user: str, password: str) : str => "Basic " + base64_encode(user + ":" + password)

/// Copy of `r` with an `Authorization: Basic` header for `user`.
+req_set_basic_auth(r: Request, user: str, password: str) : Request => req_set_header(r, "Authorization", basic_auth_header(user, password))

// --- validators: ETag, conditional requests, ranges --------------------------------------------

/// Strong ETag from the whole body (FNV-1a + length).
+etag_of(body: str) : str {
    n = body.len
    "\"" + http_hex(fnv1a32(body), 8) + "-" + http_hex(n, 1) + "\""
}

/// Weak ETag from the length and a bounded sample (first and last 256 characters): O(1) for
/// large files where hashing every byte is wasteful.
+etag_weak_of(body: str) : str {
    n = http_len(body)
    lo = body[0..256]
    hi = body[(n - 256)..n]
    if n <= 256 { hi = "" }
    "W/\"" + http_hex(fnv1a32(lo + hi), 8) + "-" + http_hex(body.len, 1) + "\""
}

/// `e` with weak-validator and quote marks removed.
+etag_strip(e: str) : str {
    t = http_trim(e)
    if http_starts_with(t, "W/") { return t[2..http_len(t)] }
    t
}

/// Does the comma-separated ETag list `h` (If-Match / If-None-Match) contain `etag`? Weak
/// comparison ignores `W/`; strong comparison requires both to be strong. `*` matches any
/// representation.
+etag_list_match(h: str, etag: str, weak_ok: bool) : bool {
    if http_trim(h) == "*" { return true }
    if etag == "" { return false }
    n = http_len(h)
    start = 0
    hit = false
    for 0..(n + 1) {
        if it == n || h[it] == "," {
            item = http_trim(h[start..it])
            start = it + 1
            if item != "" {
                if weak_ok {
                    if etag_strip(item) == etag_strip(etag) { hit = true }
                } else {
                    if item == etag && !http_starts_with(item, "W/") { hit = true }
                }
            }
        }
    }
    hit
}

/// RFC 9110 §13.2 preconditions: 0 = proceed, 304 = not modified, 412 = precondition failed.
/// `mtime` is the representation's Unix seconds (0 when unknown).
+check_preconditions(r: Request, etag: str, mtime: i64) : i64 {
    im = req_header(r, "If-Match") or ""
    if im != "" && !etag_list_match(im, etag, false) { return 412 }
    if im == "" && mtime > 0 {
        ius = parse_http_date(req_header(r, "If-Unmodified-Since") or "")
        if ius >= 0 && mtime > ius { return 412 }
    }
    safe = r.method == "GET" || r.method == "HEAD"
    inm = req_header(r, "If-None-Match") or ""
    if inm != "" {
        if etag_list_match(inm, etag, true) {
            if safe { return 304 }
            return 412
        }
        return 0
    }
    if safe && mtime > 0 {
        ims = parse_http_date(req_header(r, "If-Modified-Since") or "")
        if ims >= 0 && mtime <= ims { return 304 }
    }
    0
}

/// `RangeSpec` is a parsed `Range` byte interval.
+RangeSpec = {
    /// 0 = no usable rng (serve everything), 206 = satisfiable, 416 = not satisfiable.
    status: i64 = 0
    /// First on `RangeSpec` (`i64`). Defaults to `0`.
    first: i64 = 0
    /// Inclusive.
    last: i64 = 0
}

/// Parse one `Range: bytes=a-b | a- | -n` against a body of `size` bytes. Multi-rng and
/// malformed headers are ignored (status 0), which RFC 9110 allows.
+parse_range(h: str, size: i64) : RangeSpec {
    none_spec = RangeSpec.{status: 0, first: 0, last: 0}
    if !http_starts_with(h, "bytes=") { return none_spec }
    spec = http_trim(h[6..http_len(h)])
    if http_index_of(spec, ",", 0) >= 0 { return none_spec }
    dash = http_index_of(spec, "-", 0)
    if dash < 0 { return none_spec }
    a = http_trim(spec[0..dash])
    b = http_trim(spec[(dash + 1)..http_len(spec)])
    unsat = RangeSpec.{status: 416, first: 0, last: 0}
    if a == "" {
        n = http_parse_uint(b)
        if n < 0 { return none_spec }
        if n == 0 || size == 0 { return unsat }
        s = size - n
        if s < 0 { s = 0 }
        return RangeSpec.{status: 206, first: s, last: size - 1}
    }
    s = http_parse_uint(a)
    if s < 0 { return none_spec }
    if s >= size { return unsat }
    e = size - 1
    if b != "" {
        v = http_parse_uint(b)
        if v < 0 || v < s { return none_spec }
        if v < e { e = v }
    }
    RangeSpec.{status: 206, first: s, last: e}
}

/// Attach `ETag`, `Last-Modified` and `Accept-Ranges` to `res`.
+with_validators(res: Response, etag: str, mtime: i64) : Response {
    out = set_header(res, "Accept-Ranges", "bytes")
    if etag != "" { out = set_header(out, "ETag", etag) }
    if mtime > 0 { out = set_header(out, "Last-Modified", http_date(mtime)) }
    out
}

/// `http.ServeContent` over an in-memory body: conditional requests (304 / 412), single byte
/// ranges (206 / 416, honouring `If-Range`), validators and Content-Type. HEAD handling is the
/// connection's job (`Conn.write_response`).
+serve_content(r: Request, ctype: str, body: str, etag: str, mtime: i64) : Response {
    pre = check_preconditions(r, etag, mtime)
    if pre == 304 { return with_validators(not_modified(), etag, mtime) }
    if pre == 412 { return precondition_failed("") }
    size = body.len
    rh = req_header(r, "Range") or ""
    use_range = rh != "" && (r.method == "GET" || r.method == "HEAD")
    ir = req_header(r, "If-Range") or ""
    if use_range && ir != "" {
        if http_starts_with(ir, "\"") || http_starts_with(ir, "W/") {
            use_range = ir == etag
        } else {
            d = parse_http_date(ir)
            use_range = d >= 0 && mtime > 0 && d == mtime
        }
    }
    if use_range {
        spec = parse_range(rh, size)
        if spec.status == 416 { return with_validators(range_not_satisfiable(size), etag, mtime) }
        if spec.status == 206 {
            part = binary(206, ctype, socket_buf_slice(body, spec.first, spec.last + 1))
            part = with_header(part, "Content-Range", "bytes {spec.first}-{spec.last}/{size}")
            return with_validators(part, etag, mtime)
        }
    }
    with_validators(response(200, body, ctype), etag, mtime)
}

/// `http.ServeFile` / `FileServer` for one request: `root` + the cleaned, decoded request path.
/// Traversal (`..`, NUL, encoded slashes) is neutralised by `path_clean`; directories redirect to
/// a trailing slash and serve `index.html`. Text assets only (files are read as UTF-8).
+serve_file(root: str, r: Request) : Response {
    if r.method != "GET" && r.method != "HEAD" { return with_header(http_error(405, "405 method not allowed"), "Allow", "GET, HEAD") }
    raw = path_only(r.path)
    dec = http_unescape(raw, false) or ""
    if dec == "" || dec[0] != "/" { return http_error(400, "400 bad request") }
    if http_index_of(dec, chr(0), 0) >= 0 { return http_error(400, "400 bad request") }
    clean = path_clean(dec)
    base = root
    if http_ends_with(base, "/") { base = base[0..(http_len(base) - 1)] }
    full = base + clean
    if dec == "/" {
        if !http_ends_with(raw, "/") { return redirect_with(301, raw + "/") }
        full = base
        if !http_ends_with(full, "/") { full = full + "/" }
        full = full + "index.html"
    } else {
        index = "{full}/index.html"
        if fs_exists(index) {
            if !http_ends_with(raw, "/") { return redirect_with(301, raw + "/") }
            if !http_ends_with(full, "/") { full = full + "/" }
            full = index
        } else {
            if fs_is_dir(full) {
                if !http_ends_with(raw, "/") { return redirect_with(301, raw + "/") }
                if !http_ends_with(full, "/") { full = full + "/" }
                full = full + "index.html"
            }
        }
    }
    if !fs_exists(full) { return http_error(404, "404 page not found") }
    body = fs_read_str(full) or ""
    serve_content(r, mime_for_path(full), body, etag_weak_of(body), 0)
}

// --- HTTP/1.1 message codec (ReadRequest / ReadResponse / Request.Write) -------------------------------------

/// Is `token` in the comma-separated header value `v` (case-insensitive, e.g. `Connection`)?
+header_has_token(v: str, token: str) : bool {
    n = http_len(v)
    start = 0
    hit = false
    for 0..(n + 1) {
        if it == n || v[it] == "," {
            if http_ieq(http_trim(v[start..it]), token) { hit = true }
            start = it + 1
        }
    }
    hit
}

/// HTTP/1.1 connections persist unless `Connection: close`; HTTP/1.0 only with `keep-alive`.
+req_keep_alive(r: Request) : bool {
    conn = ""
    for (req_header_values(r, "Connection")) { conn = conn + "," + it }
    if header_has_token(conn, "close") { return false }
    if r.proto == "HTTP/1.0" { return header_has_token(conn, "keep-alive") }
    true
}

/// True when the response asks to keep the connection open.
+res_keep_alive(r: Response) : bool {
    conn = ""
    for (header_values(r, "Connection")) { conn = conn + "," + it }
    !header_has_token(conn, "close")
}

/// `Upgrade: websocket` handshake request (RFC 6455 section 4.2.1).
+req_is_upgrade(r: Request, proto: str) : bool {
    conn = ""
    for (req_header_values(r, "Connection")) { conn = conn + "," + it }
    header_has_token(conn, "upgrade") && http_ieq(req_header(r, "Upgrade") or "", proto)
}

/// True when `r` is a WebSocket upgrade request.
+req_is_websocket(r: Request) : bool => req_is_upgrade(r, "websocket") && r.method == "GET"

/// True when `r` sends `Expect: 100-continue`.
+req_expects_continue(r: Request) : bool => http_ieq(req_header(r, "Expect") or "", "100-continue")

/// Declared Content-Length, or -1 when absent / malformed.
+req_content_length(r: Request) : i64 {
    v = req_header(r, "Content-Length") or ""
    if v == "" { return -1 }
    http_parse_uint(http_trim(v))
}

/// Parse the request line and header block (everything before the blank line) into a frame:
/// stage 0 with `req`, or stage 2 with the status a server should answer in `why`: 400, 414,
/// 431, 501, 505. (`fail` surfaces as an absent value, so internal code carries the reason.)
+read_request_head(head: str) : ReqFrame {
    blank = request("GET", "/", "")
    hls = http_lines(head)
    if len(hls) == 0 { return req_frame(2, "400 empty request", false, blank, 0) }
    line = hls[0]
    sp1 = http_index_of(line, " ", 0)
    if sp1 <= 0 { return req_frame(2, "400 malformed request line", false, blank, 0) }
    ln = http_len(line)
    sp2 = -1
    for 0..ln {
        if line[it] == " " { sp2 = it }
    }
    if sp2 <= sp1 { return req_frame(2, "400 malformed request line", false, blank, 0) }
    method = line[0..sp1]
    target = line[(sp1 + 1)..sp2]
    proto = line[(sp2 + 1)..ln]
    if !http_is_token(method) { return req_frame(2, "400 invalid method", false, blank, 0) }
    if !http_has_upper(method) { return req_frame(2, "400 invalid method", false, blank, 0) }
    if target == "" || target != http_trim(target) || http_index_of(target, " ", 0) >= 0 {
        return req_frame(2, "400 malformed request target", false, blank, 0)
    }
    if http_len(target) > 16384 { return req_frame(2, "414 request target too long", false, blank, 0) }
    if http_index_of(proto, " ", 0) >= 0 { return req_frame(2, "400 malformed http version", false, blank, 0) }
    if proto != "HTTP/1.1" && proto != "HTTP/1.0" {
        if http_starts_with(proto, "HTTP/") { return req_frame(2, "505 http version not supported", false, blank, 0) }
        return req_frame(2, "400 malformed http version", false, blank, 0)
    }
    r = request(method, target, "")
    r.proto = proto
    total = len(hls)
    if total - 1 > HTTP_MAX_HEADERS { return req_frame(2, "431 too many header fields", false, blank, 0) }
    cl_seen = ""
    hosts = 0
    for 1..total {
        h = hls[it]
        first = h[0]
        if first == " " || first == "\t" { return req_frame(2, "400 obsolete line folding rejected", false, blank, 0) }
        colon = http_index_of(h, ":", 0)
        if colon <= 0 { return req_frame(2, "400 malformed header line", false, blank, 0) }
        name = h[0..colon]
        if !http_is_token(name) { return req_frame(2, "400 invalid header name", false, blank, 0) }
        value = http_trim(h[(colon + 1)..http_len(h)])
        if !header_valid_value(value) { return req_frame(2, "400 invalid header value", false, blank, 0) }
        cname = canonical_header(name)
        if cname == "Content-Length" {
            if cl_seen != "" { return req_frame(2, "400 duplicate content-length", false, blank, 0) }
            if http_parse_uint(value) < 0 { return req_frame(2, "400 invalid content-length", false, blank, 0) }
            cl_seen = value
        }
        if cname == "Host" { hosts += 1 }
        r.hdr_names = arr_push(r.hdr_names, cname)
        r.hdr_vals = arr_push(r.hdr_vals, value)
    }
    if proto == "HTTP/1.1" {
        if hosts == 0 { return req_frame(2, "400 missing required host header", false, blank, 0) }
        if hosts > 1 { return req_frame(2, "400 duplicate host header", false, blank, 0) }
    }
    te = req_header(r, "Transfer-Encoding") or ""
    if te != "" {
        if cl_seen != "" { return req_frame(2, "400 both transfer-encoding and content-length", false, blank, 0) }
        if proto == "HTTP/1.0" { return req_frame(2, "400 transfer-encoding on http/1.0", false, blank, 0) }
        if !http_ieq(te, "chunked") { return req_frame(2, "501 unsupported transfer-encoding", false, blank, 0) }
    }
    req_frame(0, "", true, r, 0)
}

/// `read_request_head` as a fallible value: use `parse_request_head(h) or fallback`.
+parse_request_head(head: str) : Request! {
    f = read_request_head(head)
    if f.stage == 2 { fail "{f.why}" }
    f.req
}

/// `ReqFrame` is an incremental HTTP request parse.
+ReqFrame = {
    /// 0 = complete message, 1 = need more bytes, 2 = error (`err` is "NNN message").
    stage: i64 = 1
    /// Why on `ReqFrame` (`str`). Defaults to `""`.
    why: str = ""
    /// Request line + headers parsed (body may still be incomplete): enough for `Expect`.
    head_ready: bool = false
    /// Req on `ReqFrame` (`Request`).
    req: Request
    /// Bytes of `buf` this message used (leading blank hls included).
    consumed: i64 = 0
}

/// Continue parsing an HTTP request from `stage`.
+req_frame(stage: i64, why: str, head_ready: bool, req: Request, consumed: i64) : ReqFrame => ReqFrame.{stage, why, head_ready, req, consumed}

/// `ChunkScan` is the state of a chunked-body scan.
+ChunkScan = {
    /// Stage on `ChunkScan` (`i64`). Defaults to `1`.
    stage: i64 = 1
    /// Why on `ChunkScan` (`str`). Defaults to `""`.
    why: str = ""
    /// Body on `ChunkScan`. Defaults to `[]`.
    body: _ = []
    /// Offset just past the terminating CRLF of the last chunk / trailers.
    end: i64 = 0
}

/// Decode a chunked body starting at `from` in `buf` (bytes or text). State 1 = incomplete,
/// 2 = malformed or larger than `max_body` (413). Chunk extensions and trailers are skipped.
+chunk_scan(buf: _, from: i64, max_body: i64) : ChunkScan {
    n = socket_buf_len(buf)
    acc = socket_buf_slice(buf, 0, 0)
    pos = from
    total = 0
    for 0..1000000 {
        le = socket_buf_find(buf, "\r\n", pos)
        if le < 0 {
            if n - pos > 1024 { return ChunkScan.{stage: 2, why: "400 chunk size line too long", body: [], end: 0} }
            return ChunkScan.{stage: 1, why: "", body: [], end: 0}
        }
        line = socket_buf_text(socket_buf_slice(buf, pos, le))
        semi = http_index_of(line, chr(59), 0)
        sz = line
        if semi >= 0 { sz = line[0..semi] }
        size = http_parse_hex(http_trim(sz))
        if size < 0 { return ChunkScan.{stage: 2, why: "400 malformed chunk size", body: [], end: 0} }
        if size == 0 {
            ds = le + 2
            de = ds + 2
            if n >= de && socket_buf_text(socket_buf_slice(buf, ds, de)) == "\r\n" {
                return ChunkScan.{stage: 0, why: "", body: acc, end: de}
            }
            te = socket_buf_find(buf, "\r\n\r\n", ds)
            if te < 0 { return ChunkScan.{stage: 1, why: "", body: [], end: 0} }
            return ChunkScan.{stage: 0, why: "", body: acc, end: te + 4}
        }
        total += size
        if total > max_body { return ChunkScan.{stage: 2, why: "413 request body too large", body: [], end: 0} }
        ds = le + 2
        de = ds + size
        if n < de + 2 { return ChunkScan.{stage: 1, why: "", body: [], end: 0} }
        if socket_buf_text(socket_buf_slice(buf, de, de + 2)) != "\r\n" { return ChunkScan.{stage: 2, why: "400 malformed chunk terminator", body: [], end: 0} }
        acc = socket_buf_concat(acc, socket_buf_slice(buf, ds, de))
        pos = de + 2
    }
    ChunkScan.{stage: 2, why: "400 too many chunks", body: [], end: 0}
}

/// Frame one request out of `buf` (bytes or text). Never blocks and never over-reads, so a
/// connection loop can feed it whatever has arrived and keep the leftover for pipelining.
+frame_request(buf: _, max_header: i64, max_body: i64) : ReqFrame {
    blank = request("GET", "/", "")
    n = socket_buf_len(buf)
    s0 = 0
    for 0..4 {
        if s0 + 2 <= n && socket_buf_find(buf, "\r\n", s0) == s0 { s0 += 2 }
    }
    he = socket_buf_find(buf, "\r\n\r\n", s0)
    if he < 0 {
        if n - s0 > max_header { return req_frame(2, "431 request header fields too large", false, blank, 0) }
        return req_frame(1, "", false, blank, 0)
    }
    if he - s0 > max_header { return req_frame(2, "431 request header fields too large", false, blank, 0) }
    head = socket_buf_text(socket_buf_slice(buf, s0, he))
    hf = read_request_head(head)
    if hf.stage == 2 { return req_frame(2, hf.why, false, blank, 0) }
    r = hf.req
    bs = he + 4
    te = req_header(r, "Transfer-Encoding") or ""
    if te != "" {
        ck = chunk_scan(buf, bs, max_body)
        if ck.stage == 1 { return req_frame(1, "", true, r, 0) }
        if ck.stage == 2 { return req_frame(2, ck.why, false, blank, 0) }
        r.body = socket_buf_text(ck.body)
        return req_frame(0, "", true, r, ck.end)
    }
    cl = req_content_length(r)
    if cl > max_body { return req_frame(2, "413 request body too large", false, blank, 0) }
    if cl <= 0 { return req_frame(0, "", true, r, bs) }
    if n - bs < cl { return req_frame(1, "", true, r, 0) }
    r.body = socket_buf_text(socket_buf_slice(buf, bs, bs + cl))
    req_frame(0, "", true, r, bs + cl)
}

/// Whole-message parse of text that must hold exactly one complete request.
+parse_request(raw: str) : Request! {
    f = frame_request(raw, HTTP_MAX_HEADER_BYTES, HTTP_MAX_BODY_BYTES)
    if f.stage == 2 { fail "{f.why}" }
    if f.stage == 1 { fail "400 incomplete request" }
    f.req
}

/// 0 when `raw` parses as one complete request, otherwise the status a server answers with.
+request_error_status(raw: str) : i64 {
    f = frame_request(raw, HTTP_MAX_HEADER_BYTES, HTTP_MAX_BODY_BYTES)
    if f.stage == 2 { return error_status(f.why, 400) }
    if f.stage == 1 { return 400 }
    0
}

/// Request.Write: request line, headers, Content-Length when there is a body, blank line, body.
+render_request(r: Request) : str {
    out = "{r.method} {r.path} {r.proto}\r\n"
    names = r.hdr_names
    vals = r.hdr_vals
    for names { out = "{out}{it}: {vals[index]}\r\n" }
    blen = r.body.len
    if blen > 0 && !req_has_header(r, "Content-Length") && !req_has_header(r, "Transfer-Encoding") {
        out = "{out}Content-Length: {blen}\r\n"
    }
    "{out}\r\n{r.body}"
}

// --- chunked transfer coding -------------------------------------------------------------------

/// One chunk: `size-in-hex CRLF data CRLF`. Empty data is the terminator, not a chunk.
+chunk_frame(data: str) : str {
    if data == "" { return "" }
    "{http_hex(data.len, 1)}\r\n{data}\r\n"
}

/// The chunked-encoding terminator, `0\r\n\r\n`.
+chunk_end() : str => "0\r\n\r\n"

/// Chunk `data` into pieces of at most `size` characters and terminate.
+chunk_encode(data: str, size: i64) : str {
    n = http_len(data)
    step = size
    if step < 1 { step = 1 }
    out = ""
    pos = 0
    for 0..(n + 1) {
        if pos < n {
            hi = pos + step
            if hi > n { hi = n }
            out = out + chunk_frame(data[pos..hi])
            pos = hi
        }
    }
    out + chunk_end()
}

/// Decode a complete chunked body held in text.
+chunk_decode(wire: str) : str! {
    ck = chunk_scan(wire, 0, HTTP_MAX_BODY_BYTES)
    if ck.stage == 2 { fail "{ck.why}" }
    if ck.stage == 1 { fail "400 incomplete chunked body" }
    socket_buf_text(ck.body)
}

// --- response parsing (Client side) ----------------------------------------------------------------

/// Status line + headers as a frame (stage 0 with `res`, or stage 2 with a 502 reason). Every
/// header (Content-Type / Content-Length included) stays in `headers` until
/// `normalize_response` folds Content-Type into the field.
+read_response_head(head: str) : ResFrame {
    blank = response(0, "", "")
    hls = http_lines(head)
    if len(hls) == 0 { return res_frame(2, "502 empty response", blank, 0) }
    line = hls[0]
    if !http_starts_with(line, "HTTP/1.") || http_len(line) < 12 { return res_frame(2, "502 malformed status line", blank, 0) }
    code = http_parse_uint(line[9..12])
    if code < 100 || code > 599 { return res_frame(2, "502 invalid status code", blank, 0) }
    r = response(code, "", "")
    total = len(hls)
    for 1..total {
        h = hls[it]
        colon = http_index_of(h, ":", 0)
        if colon <= 0 { return res_frame(2, "502 malformed response header", blank, 0) }
        name = h[0..colon]
        if !http_is_token(name) { return res_frame(2, "502 invalid response header name", blank, 0) }
        value = http_trim(h[(colon + 1)..http_len(h)])
        r.headers = arr_push(r.headers, "{canonical_header(name)}: {value}")
    }
    res_frame(0, "", r, 0)
}

/// Status and headers parsed from the response head `head`, or fail.
+parse_response_head(head: str) : Response! {
    f = read_response_head(head)
    if f.stage == 2 { fail "{f.why}" }
    f.res
}

/// Fold Content-Type into the field and drop the framing headers `render` regenerates.
+normalize_response(r: Response) : Response {
    out = Response.{status: r.status, body: r.body, content_type: "", headers: [], bin: r.bin}
    kept = []
    for (r.headers) {
        nm = entry_name(it)
        if http_ieq(nm, "Content-Type") {
            out.content_type = entry_value(it)
        } else {
            if !http_ieq(nm, "Content-Length") { kept = arr_push(kept, it) }
        }
    }
    out.headers = kept
    out
}

/// First `name` entry in the header list itself ("" if absent): no Content-Type / Content-Length
/// special-casing like `header_of`, which is what framing needs before the body is known.
+raw_header(r: Response, name: str) : str {
    for (r.headers) {
        if http_ieq(entry_name(it), name) { return entry_value(it) }
    }
    ""
}

/// `ResFrame` is an incremental HTTP response parse.
+ResFrame = {
    /// Stage on `ResFrame` (`i64`). Defaults to `1`.
    stage: i64 = 1
    /// Why on `ResFrame` (`str`). Defaults to `""`.
    why: str = ""
    /// Res on `ResFrame` (`Response`).
    res: Response
    /// Consumed on `ResFrame` (`i64`). Defaults to `0`.
    consumed: i64 = 0
    /// The body was delimited by the peer closing, so the connection cannot be reused.
    closes: bool = false
}

/// Continue parsing an HTTP response from `stage`.
+res_frame(stage: i64, why: str, res: Response, consumed: i64) : ResFrame => ResFrame.{stage, why, res, consumed, closes: false}

/// Frame one response out of `buf`. `head_only` for replies to HEAD; `eof` tells the framer the
/// peer closed, which is what ends a body that has neither Content-Length nor chunking.
/// Interim 1xx responses (100 Continue, 103 Early Hints) are skipped.
+frame_response(buf: _, head_only: bool, eof: bool, max_body: i64) : ResFrame {
    blank = response(0, "", "")
    n = socket_buf_len(buf)
    s0 = 0
    head = ""
    res = blank
    he = -1
    for 0..8 {
        he = socket_buf_find(buf, "\r\n\r\n", s0)
        if he < 0 { return res_frame(1, "", blank, 0) }
        head = socket_buf_text(socket_buf_slice(buf, s0, he))
        hf = read_response_head(head)
        if hf.stage == 2 { return res_frame(2, hf.why, blank, 0) }
        res = hf.res
        if res.status >= 100 && res.status < 200 && res.status != 101 {
            s0 = he + 4
        } else {
            break
        }
    }
    if res.status >= 100 && res.status < 200 && res.status != 101 { return res_frame(2, "502 too many interim responses", blank, 0) }
    bs = he + 4
    if head_only || !status_has_body(res.status) || res.status == 101 { return res_frame(0, "", normalize_response(res), bs) }
    te = raw_header(res, "Transfer-Encoding")
    if te != "" {
        if !http_ieq(te, "chunked") { return res_frame(2, "502 unsupported transfer-encoding", blank, 0) }
        ck = chunk_scan(buf, bs, max_body)
        if ck.stage == 1 {
            if eof { return res_frame(2, "502 truncated chunked body", blank, 0) }
            return res_frame(1, "", blank, 0)
        }
        if ck.stage == 2 { return res_frame(2, "502 malformed chunked body", blank, 0) }
        res.body = socket_buf_text(ck.body)
        return res_frame(0, "", normalize_response(res), ck.end)
    }
    clv = raw_header(res, "Content-Length")
    if clv != "" {
        cl = http_parse_uint(clv)
        if cl < 0 { return res_frame(2, "502 invalid content-length", blank, 0) }
        if cl > max_body { return res_frame(2, "413 response body too large", blank, 0) }
        if n - bs < cl {
            if eof { return res_frame(2, "502 truncated response body", blank, 0) }
            return res_frame(1, "", blank, 0)
        }
        res.body = socket_buf_text(socket_buf_slice(buf, bs, bs + cl))
        return res_frame(0, "", normalize_response(res), bs + cl)
    }
    if !eof { return res_frame(1, "", blank, 0) }
    if n - bs > max_body { return res_frame(2, "413 response body too large", blank, 0) }
    res.body = socket_buf_text(socket_buf_slice(buf, bs, n))
    ResFrame.{stage: 0, why: "", res: normalize_response(res), consumed: n, closes: true}
}

/// Whole-message parse of text holding one complete response (`eof` = true).
+parse_response(raw: str) : Response! {
    f = frame_response(raw, false, true, HTTP_MAX_BODY_BYTES)
    if f.stage != 0 { fail "{f.why}" }
    f.res
}

// --- routing -----------------------------------------------------------------------------------
///
/// Patterns (`:name` / `{name}` / `*` forms):
///   /tasks              exact
///   /tasks/:id          one segment captured as `id`  (also `/tasks/{id}`)
///   /static/*           any remainder, captured as `*`  (also `/static/{path...}` under `path`)
///   /static/            subtree: a trailing slash matches everything below
///   /{$}                the root only
///   GET /tasks/{id}     method-qualified (`Router.handle`); GET also answers HEAD
/// The most specific match wins (literal > parameter > wildcard, left to right, method-qualified
/// before method-less); equal rank goes to the earlier registration.

+Router = {
    /// Methods on `Router`. Defaults to `[]`.
    methods: _ = []
    /// Patterns on `Router`. Defaults to `[]`.
    patterns: _ = []
    /// Ids on `Router`. Defaults to `[]`.
    ids: _ = []
    /// Ranks on `Router`. Defaults to `[]`.
    ranks: _ = []
    /// Prefix heads on `Router`. Defaults to `[]`.
    prefix_heads: _ = []
    /// Prefix next on `Router`. Defaults to `[]`.
    prefix_next: _ = []
    /// Dynamic head on `Router` (`i64`). Defaults to `-1`.
    dynamic_head: i64 = -1

    /// Empty value of this HTTP type.
    new() : Router => Router.{methods: [], patterns: [], ids: [], ranks: [], prefix_heads: arr_new(64, -1), prefix_next: [], dynamic_head: -1}

    /// Register `pattern` for `method` ("" or "*" = any method) under `id`.
    add(@self, method: str, pattern: str, id: i64) : i64 {
        route = len(self.patterns)
        first = seg(pattern, 1)
        dynamic = http_len(first) > 0 && (first[0] == ":" || ord(first[0]) == 123 || first == "*")
        if first == "{$}" { dynamic = false }
        link = self.dynamic_head
        if dynamic == false {
            key = first
            if first == "{$}" { key = "" }
            bucket = route_prefix_hash(key) & 63
            link = self.prefix_heads[bucket]
            self.prefix_heads = arr_set(self.prefix_heads, bucket, route)
        } else {
            self.dynamic_head = route
        }
        rank = pattern_rank(pattern) * 2
        if method != "" && method != "*" { rank = rank + 1 }
        self.methods = arr_push(self.methods, method)
        self.patterns = arr_push(self.patterns, pattern)
        self.ids = arr_push(self.ids, id)
        self.ranks = arr_push(self.ranks, rank)
        self.prefix_next = arr_push(self.prefix_next, link)
        id
    }

    /// Register from a `"GET /tasks/{id}"` or `"/health"` spec (the router).
    handle(@self, spec: str, id: i64) : i64 {
        s = http_trim(spec)
        sp = http_index_of(s, " ", 0)
        if sp > 0 && s[0] != "/" {
            return @self.add(s[0..sp], http_trim(s[(sp + 1)..http_len(s)]), id)
        }
        @self.add("", s, id)
    }

    /// Same as `len`.
    size(self) : i64 => len(self.patterns)

    /// Raw lookup on an already clean path: 200 hit, 405 path exists under other methods
    /// (`allow` lists them), 404 nothing.
    lookup(self, method: str, path: str) : RouteMatch {
        best = no_match()
        best_rank = -1
        best_route = -1
        path_hit = false
        allow = []
        first = seg(path, 1)
        heads = [self.prefix_heads[route_prefix_hash(first) & 63]]
        if first != "" { heads = arr_push(heads, self.prefix_heads[route_prefix_hash("") & 63]) }
        heads = arr_push(heads, self.dynamic_head)
        methods = self.methods
        patterns = self.patterns
        ranks = self.ranks
        total = len(patterns)
        for heads {
            route = it
            for 0..total {
                if route < 0 { break }
                if route >= 0 {
                    m = pattern_capture(patterns[route], path)
                    if m.status == 200 {
                        rm = methods[route]
                        ok_method = rm == "" || rm == "*" || rm == method || (rm == "GET" && method == "HEAD")
                        if ok_method {
                            rank = ranks[route]
                            if rank > best_rank || (rank == best_rank && route < best_route) {
                                best = RouteMatch.{id: self.ids[route], status: 200, keys: m.keys, vals: m.vals, pattern: patterns[route], allow: [], redirect: ""}
                                best_rank = rank
                                best_route = route
                            }
                        } else {
                            path_hit = true
                            allow = allow_push(allow, rm)
                        }
                    }
                    route = self.prefix_next[route]
                }
            }
        }
        if best.status == 200 { return best }
        if path_hit { return RouteMatch.{id: -1, status: 405, keys: [], vals: [], pattern: "", allow, redirect: ""} }
        best
    }

    /// Find the route for (method, target). status: 200 hit, 301 canonical-path or trailing-slash
    /// redirect (`redirect` is the Location), 405 path exists under another method (`allow`),
    /// 404 nothing matches.
    match(self, method: str, target: str) : RouteMatch {
        path = path_only(target)
        q = query_raw(target)
        suffix = ""
        if q != "" { suffix = "?" + q }
        if path != "" && method != "CONNECT" {
            clean = path_clean(path)
            if clean != path { return redirect_match(clean + suffix) }
        }
        found = self.lookup(method, path)
        if found.status == 404 && path != "" && !http_ends_with(path, "/") {
            alt = self.lookup(method, path + "/")
            if alt.status == 200 { return redirect_match(path + "/" + suffix) }
        }
        found
    }

    /// Methods registered for the path of `target`, `GET, HEAD, POST`-style ("" if none).
    allowed(self, target: str) : str {
        path = path_only(target)
        out = []
        methods = self.methods
        patterns = self.patterns
        for patterns {
            if pattern_capture(it, path).status == 200 {
                out = allow_push(out, methods[index])
            }
        }
        allow_join(out)
    }

    /// Dry-run a request through the router: 200 with `{"route":id}` on a hit.
    simulate(self, method: str, target: str) : Response {
        m = self.match(method, target)
        if m.status == 200 { return ok({route: m.id}) }
        if m.status == 301 { return redirect_with(301, m.redirect) }
        if m.status == 405 { return with_header(method_not_allowed(""), "Allow", allow_join(m.allow)) }
        not_found("")
    }
}

/// `RouteMatch` is the route a request hit, or a miss/redirect.
+RouteMatch = {
    /// Id on `RouteMatch` (`i64`). Defaults to `0`.
    id: i64 = 0
    /// Status on `RouteMatch` (`i64`). Defaults to `404`.
    status: i64 = 404
    /// Keys on `RouteMatch`. Defaults to `[]`.
    keys: _ = []
    /// Vals on `RouteMatch`. Defaults to `[]`.
    vals: _ = []
    /// Pattern that matched (200 only).
    pattern: str = ""
    /// Registered methods for the path (405 only), HEAD implied by GET.
    allow: _ = []
    /// Location (301 only).
    redirect: str = ""
}

/// Route match that hit nothing.
+no_match() : RouteMatch => RouteMatch.{id: -1, status: 404, keys: [], vals: [], pattern: "", allow: [], redirect: ""}

/// Route match that redirects.
+redirect_match(location: str) : RouteMatch => RouteMatch.{id: -1, status: 301, keys: [], vals: [], pattern: "", allow: [], redirect: location}

/// Append `m` unless already present (any-method routes are not listed).
+allow_push(a: _, m: str) {
    if m == "" || m == "*" { return a }
    out = []
    for (a) { out = arr_push(out, it) }
    for (out) {
        if it == m { return out }
    }
    arr_push(out, m)
}

/// `GET, HEAD, POST`: canonical method order, HEAD implied by GET, unknown methods last.
+allow_join(a: _) : str {
    canon = ["GET", "HEAD", "POST", "PUT", "PATCH", "DELETE", "OPTIONS", "CONNECT", "TRACE"]
    out = ""
    for canon {
        m = it
        if allow_has(a, m) || (m == "HEAD" && allow_has(a, "GET")) {
            if out != "" { out = out + ", " }
            out = out + m
        }
    }
    for (a) {
        if !allow_has(canon, it) {
            if out != "" { out = out + ", " }
            out = out + it
        }
    }
    out
}

/// True when the `Allow` list contains `a`.
+allow_has(a: _, m: str) : bool {
    for (a) {
        if it == m { return true }
    }
    false
}

/// How many `/`-separated segments `p` has.
+seg_count(p: str) : i64 {
    if p == "/" || p == "" { return 0 }
    n = 0
    for 0..http_len(p) {
        if p[it] == "/" { n += 1 }
    }
    n
}

/// Path segment `n` of `p`.
+seg(p: str, n: i64) : str {
    ln = http_len(p)
    piece = 0
    start = 0
    out = ""
    for 0..(ln + 1) {
        if it == ln || p[it] == "/" {
            if piece == n { out = p[start..it] }
            piece += 1
            start = it + 1
        }
    }
    out
}

/// Index of the next `/` at or after `from`, or `n`.
+slash_from(s: str, from: i64, n: i64) : i64 {
    for from..n {
        if s[it] == "/" { return it }
    }
    n
}

/// Specificity of a pattern as a base-4 number over its first 12 segments: literal 3,
/// parameter 2, wildcard / subtree 1, missing 0. Earlier segments weigh more.
+pattern_rank(pattern: str) : i64 {
    if pattern == "/" { return 0 }
    n = http_len(pattern)
    rank = 0
    pos = 0
    for 0..13 {
        digit = 0
        if pos <= n {
            e = slash_from(pattern, pos, n)
            s = pattern[pos..e]
            digit = 3
            if s == "*" || (http_len(s) > 0 && ord(s[0]) == 123 && http_ends_with(s, "...}")) { digit = 1 }
            if s == "" && pos > 0 { digit = 1 }
            if s != "{$}" && (http_starts_with(s, ":") || (http_len(s) > 0 && ord(s[0]) == 123 && !http_ends_with(s, "...}"))) { digit = 2 }
            pos = e + 1
        }
        rank = rank * 4 + digit
    }
    rank
}

/// Hash of the static prefix of a route pattern.
+route_prefix_hash(s: str) : i64 {
    h = 2166136261
    for 0..http_len(s) {
        h = ((h ^ ord(s[it])) * 16777619) & 2147483647
    }
    h
}

/// Match `path` (query stripped) against `pattern`: single pass over both strings, no
/// intermediate arrays. `:name` / `{name}` capture one non-empty segment (percent-decoded);
/// a final `*`, `{name...}` or trailing `/` swallows the rest, captured as `*` / `name`;
/// a final `{$}` matches only a path that ends right there with a slash. status is 200 on
/// success, else 404.
+pattern_capture(pattern: str, path: str) : RouteMatch {
    if pattern == "/" && path != "" { return RouteMatch.{id: 0, status: 200, keys: [], vals: [], pattern: "", allow: [], redirect: ""} }
    pn = http_len(pattern)
    tn = http_len(path)
    if pn == 0 { return no_match() }
    keys = []
    vals = []
    pi = 0
    ti = 0
    for 0..64 {
        pe = slash_from(pattern, pi, pn)
        te = slash_from(path, ti, tn)
        sp = pattern[pi..pe]
        st = path[ti..te]
        last_p = pe == pn
        last_t = te == tn
        rest_name = ""
        is_rest = false
        if last_p {
            if sp == "*" {
                is_rest = true
                rest_name = "*"
            }
            if http_len(sp) > 0 && ord(sp[0]) == 123 && http_ends_with(sp, "...}") {
                is_rest = true
                rest_name = sp[1..(http_len(sp) - 4)]
            }
            if sp == "" && pi > 0 {
                is_rest = true
                rest_name = "*"
            }
        }
        if is_rest {
            if ti > tn { return no_match() }
            tail = path[ti..tn]
            if tail == "/" { tail = "" }
            keys = arr_push(keys, rest_name)
            vals = arr_push(vals, http_unescape(tail, false) or tail)
            return RouteMatch.{id: 0, status: 200, keys, vals, pattern: "", allow: [], redirect: ""}
        }
        if last_p && sp == "{$}" {
            if st == "" && last_t && pi > 0 { return RouteMatch.{id: 0, status: 200, keys, vals, pattern: "", allow: [], redirect: ""} }
            return no_match()
        }
        is_param = http_len(sp) > 0 && (sp[0] == ":" || ord(sp[0]) == 123)
        if is_param {
            if st == "" { return no_match() }
            pname = ""
            if sp[0] == ":" {
                pname = sp[1..http_len(sp)]
            } else {
                if ord(sp[http_len(sp) - 1]) != 125 { return no_match() }
                pname = sp[1..(http_len(sp) - 1)]
            }
            keys = arr_push(keys, pname)
            vals = arr_push(vals, http_unescape(st, false) or st)
        } else {
            if sp != st { return no_match() }
        }
        if last_p || last_t {
            if last_p && last_t { return RouteMatch.{id: 0, status: 200, keys, vals, pattern: "", allow: [], redirect: ""} }
            return no_match()
        }
        pi = pe + 1
        ti = te + 1
    }
    no_match()
}

/// Captured path parameter named `m`.
+route_param(m: RouteMatch, name: str) : str {
    out = ""
    keys = m.keys
    vals = m.vals
    for keys {
        if it == name { out = vals[index] }
    }
    out
}

/// Integer path parameter, or `fallback` when missing / not a non-negative integer.
+route_param_int(m: RouteMatch, name: str, fallback: i64) : i64 {
    v = http_parse_uint(route_param(m, name))
    if v < 0 { return fallback }
    v
}

/// Named path-parameter access: route `target` through `router` and read `name`.
+path_value(router: Router, method: str, target: str, name: str) : str => route_param(router.match(method, target), name)

// --- middleware (pure Request/Response transforms) -------------------------------------------

/// Equality that always inspects every character (credential comparison without early exit).
+secure_eq(a: str, b: str) : bool {
    na = http_len(a)
    nb = http_len(b)
    diff = na ^ nb
    n = na
    if nb > n { n = nb }
    for 0..n {
        ca = 0
        cb = 0
        if it < na { ca = ord(a[it]) }
        if it < nb { cb = ord(b[it]) }
        diff = diff | (ca ^ cb)
    }
    diff == 0
}

/// Token from `Authorization: Bearer <token>`, or none.
+mw_bearer(req: Request) : str? {
    h = req_header(req, "Authorization") or none
    if h == none { return none }
    if !(http_len(h) > 7 && http_ieq(h[0..7], "Bearer ")) { return none }
    h[7..http_len(h)]
}

/// Short-circuit with 401 unless the request carries `expected`.
+mw_require_token(req: Request, expected: str) : Response? {
    tok = mw_bearer(req) or none
    if tok == none { return with_header(unauthorized("missing bearer token"), "WWW-Authenticate", "Bearer") }
    if !secure_eq(tok, expected) { return with_header(unauthorized("invalid token"), "WWW-Authenticate", "Bearer error=\"invalid_token\"") }
    none
}

/// Short-circuit with 401 + `WWW-Authenticate: Basic` unless the credentials match.
+mw_basic_auth(req: Request, user: str, password: str, realm: str) : Response? {
    challenge = "Basic realm=\"{realm}\", charset=\"UTF-8\""
    cred = req_basic_auth(req) or none
    if cred == none { return with_header(unauthorized("authentication required"), "WWW-Authenticate", challenge) }
    u_ok = secure_eq(cred.user, user)
    p_ok = secure_eq(cred.password, password)
    if u_ok && p_ok { return none }
    with_header(unauthorized("invalid credentials"), "WWW-Authenticate", challenge)
}

/// Response with CORS headers applied.
+mw_cors(res: Response, origin: str) : Response {
    a = with_header(res, "Access-Control-Allow-Origin", origin)
    with_header(a, "Access-Control-Allow-Methods", "GET, POST, PUT, DELETE, OPTIONS")
}

/// Is `origin` allowed by `origins` (exact entries, or `*`)?
+cors_origin_allowed(origins: _, origin: str) : bool {
    for origins {
        if it == "*" || it == origin { return true }
    }
    false
}

/// CORS for a simple request: echoes an allowed Origin (never `*` with credentials) and adds
/// `Vary: Origin`. Requests without an Origin, or from a disallowed one, pass unchanged.
+mw_cors_headers(req: Request, res: Response, origins: _, allow_credentials: bool) : Response {
    origin = req_header(req, "Origin") or ""
    if origin == "" || !cors_origin_allowed(origins, origin) { return res }
    allow_origin = origin
    if !allow_credentials {
        for (origins) {
            if it == "*" { allow_origin = "*" }
        }
    }
    out = set_header(res, "Access-Control-Allow-Origin", allow_origin)
    out = set_header(out, "Vary", "Origin")
    if allow_credentials { out = set_header(out, "Access-Control-Allow-Credentials", "true") }
    out
}

/// Answer a CORS preflight (OPTIONS + Access-Control-Request-Method) with 204, or none when the
/// request is not a preflight. A preflight from a disallowed origin gets 403.
+mw_cors_preflight(req: Request, origins: _, methods: str, headers: str, max_age: i64) : Response? {
    if req.method != "OPTIONS" { return none }
    origin = req_header(req, "Origin") or ""
    wanted = req_header(req, "Access-Control-Request-Method") or ""
    if origin == "" || wanted == "" { return none }
    if !cors_origin_allowed(origins, origin) { return forbidden("origin not allowed") }
    out = no_content()
    out = set_header(out, "Access-Control-Allow-Origin", origin)
    out = set_header(out, "Access-Control-Allow-Methods", methods)
    asked = req_header(req, "Access-Control-Request-Headers") or ""
    if headers != "" { out = set_header(out, "Access-Control-Allow-Headers", headers) }
    if headers == "" && asked != "" { out = set_header(out, "Access-Control-Allow-Headers", asked) }
    if max_age > 0 { out = set_header(out, "Access-Control-Max-Age", "{max_age}") }
    set_header(out, "Vary", "Origin, Access-Control-Request-Method, Access-Control-Request-Headers")
}

/// Response with the default security headers applied.
+mw_security_headers(res: Response) : Response {
    a = with_header(res, "X-Content-Type-Options", "nosniff")
    with_header(a, "X-Frame-Options", "DENY")
}

/// Strict-Transport-Security.
+mw_hsts(res: Response, max_age: i64, include_subdomains: bool) : Response {
    v = "max-age={max_age}"
    if include_subdomains { v = v + chr(59) + " includeSubDomains" }
    set_header(res, "Strict-Transport-Security", v)
}

/// Response with a `Content-Security-Policy` header of `res`.
+mw_csp(res: Response, policy: str) : Response => set_header(res, "Content-Security-Policy", policy)

/// 308 to the https:// URL unless the request already arrived over TLS (X-Forwarded-Proto).
+mw_https_redirect(req: Request) : Response? {
    proto = req_header(req, "X-Forwarded-Proto") or ""
    if http_ieq(proto, "https") { return none }
    host = req_host(req)
    if host == "" { return none }
    permanent_redirect("https://{host}{req.path}")
}

/// 301 to the path without its trailing slash (`/a/b/` -> `/a/b`); the root stays.
+mw_strip_trailing_slash(req: Request) : Response? {
    p = path_only(req.path)
    if http_len(p) > 1 && http_ends_with(p, "/") {
        q = query_raw(req.path)
        suffix = ""
        if q != "" { suffix = "?" + q }
        return moved_permanently(p[0..(http_len(p) - 1)] + suffix)
    }
    none
}

/// 405 + `Allow` unless the request method is in `methods`.
+mw_require_method(req: Request, methods: _) : Response? {
    if allow_has(methods, req.method) { return none }
    with_header(method_not_allowed(""), "Allow", allow_join(methods))
}

/// 415 for bodies that are not JSON (POST / PUT / PATCH with a non-empty body).
+mw_require_json(req: Request) : Response? {
    if req.method != "POST" && req.method != "PUT" && req.method != "PATCH" { return none }
    if req.body == "" { return none }
    mt = media_type(req_content_type(req))
    if mt == "application/json" || http_ends_with(mt, "+json") { return none }
    unsupported_media_type("expected application/json")
}

/// 413 when the declared or actual body exceeds `limit` bytes (http.MaxBytesReader).
+mw_max_body(req: Request, limit: i64) : Response? {
    declared = req_content_length(req)
    if declared > limit || req.body.len > limit { return payload_too_large("request body exceeds {limit} bytes") }
    none
}

/// Conditional GET for handlers that did not set validators: strong ETag from the body, then
/// 304 when `If-None-Match` matches. Only 200 responses to GET / HEAD are touched.
+mw_etag(req: Request, res: Response) : Response {
    if res.status != 200 || (req.method != "GET" && req.method != "HEAD") { return res }
    existing = header_of(res, "ETag") or ""
    tag = existing
    if tag == "" { tag = etag_of("{res.body}") }
    if check_preconditions(req, tag, 0) == 304 { return with_validators(not_modified(), tag, 0) }
    set_header(res, "ETag", tag)
}

/// Give the request an `X-Request-Id` (kept when the client sent one): `seed` is typically a
/// counter or timestamp the caller owns, rendered as 16 hex digits.
+mw_request_id(req: Request, seed: i64) : Request {
    if req_header(req, "X-Request-Id") != none { return req }
    req_with_header(req, "X-Request-Id", http_hex(seed, 16))
}

/// One access-log line: `GET /x 200 12B 340us`.
+mw_log_line(req: Request, res: Response, micros: i64) : str => "{req.method} {path_only(req.path)} {res.status} {response_body_len(res)}B {micros}us"

/// Cooperative deadline: 503 once more than `limit_ms` passed since `started_ms`.
+mw_timeout(started_ms: i64, now_ms: i64, limit_ms: i64) : Response? {
    if now_ms - started_ms > limit_ms { return unavailable("request timed out") }
    none
}

/// 429 once `count` requests in the current window exceed `limit`.
+mw_rate_limit(n: i64, limit: i64) : Response? {
    if n > limit { return too_many_requests("rate limit exceeded") }
    none
}

/// Client address for rate limiting and logs: first `X-Forwarded-For` hop, else the socket peer
/// without its port.
+req_client_ip(r: Request) : str {
    xff = req_header(r, "X-Forwarded-For") or ""
    if xff != "" {
        comma = http_index_of(xff, ",", 0)
        if comma < 0 { return http_trim(xff) }
        return http_trim(xff[0..comma])
    }
    ra = r.remote_addr
    n = http_len(ra)
    colon = -1
    for 0..n {
        if ra[it] == ":" { colon = it }
    }
    if colon < 0 { return ra }
    host = ra[0..colon]
    if http_starts_with(host, "[") && http_ends_with(host, "]") { return host[1..(http_len(host) - 1)] }
    host
}

/// Token bucket per key in a fixed slot table: O(1) per check and no allocation as keys come
/// and go (distinct keys that hash to one slot share a bucket). `rate` tokens/second up to
/// `burst`; time is injected as milliseconds so tests stay deterministic.
+RateLimiter = {
    /// milli-tokens (1000 = one request)
    tokens: _ = []
    /// Stamps on `RateLimiter`. Defaults to `[]`.
    stamps: _ = []
    /// Mask on `RateLimiter` (`i64`). Defaults to `255`.
    mask: i64 = 255
    /// Rate on `RateLimiter` (`i64`). Defaults to `10`.
    rate: i64 = 10
    /// Burst on `RateLimiter` (`i64`). Defaults to `20`.
    burst: i64 = 20

    /// Empty value of this HTTP type.
    new(slots: i64, rate_per_s: i64, burst: i64) : RateLimiter {
        n = next_pow2_i64(slots)
        if n < 1 { n = 1 }
        RateLimiter.{tokens: arr_new(n, burst * 1000), stamps: arr_new(n, -1), mask: n - 1, rate: rate_per_s, burst}
    }

    /// Rate-limit bucket for the key `key`.
    slot_of(self, key: str) : i64 => fnv1a32(key) & self.mask

    /// Refilled milli-tokens of the key's bucket at `now_ms` (no mutation).
    level(self, key: str, now_ms: i64) : i64 {
        s = self.slot_of(key)
        stamp = self.stamps[s]
        cap = self.burst * 1000
        if stamp < 0 { return cap }
        elapsed = now_ms - stamp
        if elapsed < 0 { elapsed = 0 }
        t = self.tokens[s] + elapsed * self.rate
        if t > cap { t = cap }
        t
    }

    /// Consume one token: true if the request may proceed.
    allow(@self, key: str, now_ms: i64) : bool {
        s = self.slot_of(key)
        t = self.level(key, now_ms)
        allowed = t >= 1000
        if allowed { t = t - 1000 }
        self.tokens = arr_set(self.tokens, s, t)
        self.stamps = arr_set(self.stamps, s, now_ms)
        allowed
    }

    /// Whole requests still available to `key` right now.
    remaining(self, key: str, now_ms: i64) : i64 => self.level(key, now_ms) / 1000

    /// Milliseconds until one token is available (0 when one already is).
    retry_after_ms(self, key: str, now_ms: i64) : i64 {
        t = self.level(key, now_ms)
        if t >= 1000 { return 0 }
        if self.rate <= 0 { return 3600000 }
        need = (1000 - t + self.rate - 1) / self.rate
        need
    }

    /// Middleware form: none to proceed, or 429 with `Retry-After` (seconds, rounded up).
    check(@self, key: str, now_ms: i64) : Response? {
        if @self.allow(key, now_ms) { return none }
        secs = (self.retry_after_ms(key, now_ms) + 999) / 1000
        if secs < 1 { secs = 1 }
        r = too_many_requests("rate limit exceeded")
        set_header(r, "Retry-After", "{secs}")
    }
}

/// HTTP 409 Conflict. Pass a Super object/record/array to auto-JSON-encode, or a `str` for a raw body.
+conflict(body) : Response => response(409, json_response_body(body), HTTP_JSON)
/// HTTP 410 Gone. Pass a Super object/record/array to auto-JSON-encode, or a `str` for a raw body.
+gone(body) : Response => response(410, json_response_body(body), HTTP_JSON)
/// HTTP 422 Unprocessable Content. Pass a Super object/record/array to auto-JSON-encode, or a `str` for a raw body.
+unprocessable(body) : Response => response(422, json_response_body(body), HTTP_JSON)
/// HTTP 425 Too Early. Pass a Super object/record/array to auto-JSON-encode, or a `str` for a raw body.
+too_early(body) : Response => response(425, json_response_body(body), HTTP_JSON)
/// HTTP 503 Service Unavailable. Pass a Super object/record/array to auto-JSON-encode, or a `str` for a raw body.
+unavailable(body) : Response => response(503, json_response_body(body), HTTP_JSON)
/// HTTP 402 Payment Required. Pass a Super object/record/array to auto-JSON-encode, or a `str` for a raw body.
+payment_required(body) : Response => response(402, json_response_body(body), HTTP_JSON)

/// Compatibility entry points used by route tests. A path that is not
/// absolute is a 400; everything else is a 200 carrying no body.
+simulate_post(path: str, _body: str) : Response {
    if http_len(path) == 0 || path[0] != "/" { return bad_request("invalid path") }
    ok("")
}

/// In-process GET of `path`, used by tests.
+simulate_get(path: str) : Response {
    if http_len(path) == 0 || path[0] != "/" { return bad_request("invalid path") }
    ok("")
}

// --- URLs (client side) --------------------------------------------------------------------------

/// `ParsedUrl` is a URL split into scheme, host, port, and the rest.
+ParsedUrl = {
    /// Ok on `ParsedUrl` (`bool`). Defaults to `false`.
    ok: bool = false
    /// Scheme on `ParsedUrl` (`str`). Defaults to `""`.
    scheme: str = ""
    /// Userinfo on `ParsedUrl` (`str`). Defaults to `""`.
    userinfo: str = ""
    /// Host on `ParsedUrl` (`str`). Defaults to `""`.
    host: str = ""
    /// Port on `ParsedUrl` (`i64`). Defaults to `80`.
    port: i64 = 80
    /// Path plus query, always starting with `/`.
    target: str = "/"
}

/// Parsed URL that failed.
+bad_url() : ParsedUrl => ParsedUrl.{ok: false, scheme: "", userinfo: "", host: "", port: 80, target: "/"}

/// Split `raw` into scheme, host, port, and the rest.
+parse_url(raw: str) : ParsedUrl {
    s = raw
    hash = http_index_of(s, "#", 0)
    if hash >= 0 { s = s[0..hash] }
    se = http_index_of(s, "://", 0)
    if se <= 0 { return bad_url() }
    scheme = http_lower(s[0..se])
    if scheme != "http" && scheme != "https" { return bad_url() }
    rest = s[(se + 3)..http_len(s)]
    n = http_len(rest)
    ae = n
    for 0..n {
        if ae == n && (rest[it] == "/" || rest[it] == "?") { ae = it }
    }
    authority = rest[0..ae]
    target = rest[ae..n]
    if target == "" { target = "/" }
    if target[0] == "?" { target = "/" + target }
    userinfo = ""
    at = -1
    for 0..http_len(authority) {
        if authority[it] == "@" { at = it }
    }
    if at >= 0 {
        userinfo = authority[0..at]
        authority = authority[(at + 1)..http_len(authority)]
    }
    port = 80
    if scheme == "https" { port = 443 }
    host = authority
    an = http_len(authority)
    if an > 0 && authority[0] == "[" {
        rb = http_index_of(authority, "]", 0)
        if rb < 0 { return bad_url() }
        host = authority[1..rb]
        tail = authority[(rb + 1)..an]
        if tail != "" {
            if tail[0] != ":" { return bad_url() }
            p = http_parse_uint(tail[1..http_len(tail)])
            if p < 1 || p > 65535 { return bad_url() }
            port = p
        }
    } else {
        colon = -1
        for 0..an {
            if authority[it] == ":" { colon = it }
        }
        if colon >= 0 {
            host = authority[0..colon]
            p = http_parse_uint(authority[(colon + 1)..an])
            if p < 1 || p > 65535 { return bad_url() }
            port = p
        }
    }
    if host == "" { return bad_url() }
    ParsedUrl.{ok: true, scheme, userinfo, host: http_lower(host), port, target}
}

/// Default port for the scheme `scheme` (`80` or `443`).
+url_default_port(scheme: str) : i64 {
    if scheme == "https" { return 443 }
    80
}

/// `host` or `host:port` as it belongs in a Host header (default ports omitted, IPv6 bracketed).
+url_host_header(u: ParsedUrl) : str {
    h = u.host
    if http_index_of(h, ":", 0) >= 0 { h = "[{h}]" }
    if u.port != url_default_port(u.scheme) { return "{h}:{u.port}" }
    h
}

/// `host:port` to dial.
+url_dial_addr(u: ParsedUrl) : str {
    h = u.host
    if http_index_of(h, ":", 0) >= 0 { h = "[{h}]" }
    "{h}:{u.port}"
}

/// Scheme, host, and port of `u`.
+url_origin(u: ParsedUrl) : str => "{u.scheme}://{url_host_header(u)}"

/// Resolve a redirect `Location` against the URL that produced it (RFC 3986 section 5, trimmed to
/// what redirects use): absolute, `//host`, `/abs`, `?query` and relative references.
+resolve_url(base: str, ref: str) : str {
    r = http_trim(ref)
    sch = http_index_of(r, "://", 0)
    if sch > 0 && http_is_token(r[0..sch]) { return r }
    b = parse_url(base)
    if !(b.ok) { return r }
    if http_starts_with(r, "//") { return "{b.scheme}:{r}" }
    origin = url_origin(b)
    if http_starts_with(r, "?") { return "{origin}{path_only(b.target)}{r}" }
    q = query_raw(r)
    suffix = ""
    if q != "" { suffix = "?" + q }
    rp = path_only(r)
    if http_starts_with(r, "/") { return "{origin}{path_clean(rp)}{suffix}" }
    bp = path_only(b.target)
    dir = bp
    cut = -1
    for 0..http_len(bp) {
        if bp[it] == "/" { cut = it }
    }
    if cut >= 0 { dir = bp[0..(cut + 1)] }
    "{origin}{path_clean(dir + rp)}{suffix}"
}

/// Wall-clock seconds since the Unix epoch.
+http_now() : i64 => wall_clock_ns() / 1000000000

// --- server (http.Server / ResponseWriter over blocking sockets) ------------------------------------

/// A listening socket plus the limits applied to every connection it accepts. Defaults follow
/// Go: 1 MiB of headers; bodies are capped separately (10 MiB). Timeouts are per read / write.
+Server = {
    /// Fd on `Server` (`i64`). Defaults to `-1`.
    fd: i64 = -1
    /// Addr on `Server` (`str`). Defaults to `""`.
    addr: str = ""
    /// Read timeout ms on `Server` (`i64`). Defaults to `30000`.
    read_timeout_ms: i64 = 30000
    /// Write timeout ms on `Server` (`i64`). Defaults to `30000`.
    write_timeout_ms: i64 = 30000
    /// Idle timeout ms on `Server` (`i64`). Defaults to `60000`.
    idle_timeout_ms: i64 = 60000
    /// Max header bytes on `Server` (`i64`). Defaults to `1048576`.
    max_header_bytes: i64 = 1048576
    /// Max body bytes on `Server` (`i64`). Defaults to `10485760`.
    max_body_bytes: i64 = 10485760
    /// Requests served per connection before it is closed (keep-alive cap).
    max_requests: i64 = 1000
    /// Closed on `Server` (`bool`). Defaults to `false`.
    closed: bool = false
    /// Why on `Server` (`str`). Defaults to `""`.
    why: str = ""

    /// Bind and listen on `addr`, or fail.
    listen(addr: str) : Server! {
        fd = socket_tcp_listen(addr) or err {
            fail "{err}"
        }
        bound = socket_local_addr(fd) or addr
        Server.{fd, addr: bound, read_timeout_ms: 30000, write_timeout_ms: 30000, idle_timeout_ms: 60000, max_header_bytes: HTTP_MAX_HEADER_BYTES, max_body_bytes: HTTP_MAX_BODY_BYTES, max_requests: 1000, closed: false, why: ""}
    }

    /// Port the listener is bound to.
    port(self) : i64 {
        a = self.addr
        n = http_len(a)
        colon = -1
        for 0..n {
            if a[it] == ":" { colon = it }
        }
        if colon < 0 { return -1 }
        http_parse_uint(a[(colon + 1)..n])
    }

    /// Block for the next connection (ListenAndServe's accept loop, one step at a time).
    accept(@self) : Conn! {
        if (self.closed) {
            self.why = "server closed"
            fail "server closed"
        }
        cfd = socket_tcp_accept(self.fd) or err {
            self.why = "accept failed"
            return
        }
        // Conn + peer/buf birth into the connection arena (reclaimed at close).
        _ = socket_conn_enter()
        remote = socket_peer_addr(cfd) or ""
        Conn.{fd: cfd, buf: socket_buf_slice("", 0, 0), remote, served: 0, open: true, keep: true, detached: false, sent_continue: false, read_timeout_ms: self.read_timeout_ms, write_timeout_ms: self.write_timeout_ms, idle_timeout_ms: self.idle_timeout_ms, max_header_bytes: self.max_header_bytes, max_body_bytes: self.max_body_bytes, max_requests: self.max_requests, why: ""}
    }

    /// Stop accepting. Connections already accepted keep working until they finish.
    shutdown(@self) : bool {
        if (self.closed) { return false }
        self.closed = true
        socket_fd_close(self.fd)
        true
    }

    /// Put the listener in non-blocking mode for `serve`.
    set_nonblock(@self, on: bool) : bool! {
        socket_set_nonblock(self.fd, on)
    }

    /// Wait until the listener or `stop_fd` is readable.
    /// Returns `1` (accept), `2` (stop), `3` (both), or `0` (timeout).
    poll_stop(self, stop_fd: i64, timeout_ms: i64) : i64! {
        host.sys_net_poll2(self.fd, stop_fd, timeout_ms) or err {
            fail "http: poll failed: {err}"
            return
        }
    }

    /// Accept one connection when the listener is ready (non-blocking).
    try_accept(@self) : Conn! {
        if (self.closed) {
            self.why = "server closed"
            fail "server closed"
        }
        cfd = socket_tcp_accept(self.fd) or err {
            self.why = "accept failed"
            return
        }
        // Conn + peer/buf birth into the connection arena (reclaimed at close).
        _ = socket_conn_enter()
        remote = socket_peer_addr(cfd) or ""
        Conn.{fd: cfd, buf: socket_buf_slice("", 0, 0), remote, served: 0, open: true, keep: true, detached: false, sent_continue: false, read_timeout_ms: self.read_timeout_ms, write_timeout_ms: self.write_timeout_ms, idle_timeout_ms: self.idle_timeout_ms, max_header_bytes: self.max_header_bytes, max_body_bytes: self.max_body_bytes, max_requests: self.max_requests, why: ""}
    }

    /// Production accept loop until `stop` fires. Dispatches every request through
    /// `app.handle` (middleware + router + registered handlers). Application code
    /// should call this instead of `poll_stop` / `try_accept` / `read_request`.
    serve(@self, @app: App, stop: Notify) : i64! {
        @self.set_nonblock(true) or false
        handled = 0
        loop {
            if self.closed { break }
            bits = self.poll_stop(stop.fd(), 500) or 0
            if (bits & 2) != 0 {
                @self.shutdown()
                break
            }
            if (bits & 1) == 0 { continue }
            conn = @self.try_accept() or err { continue }
            // Bounded keep-alive: read/dispatch while open+keep, up to max_requests.
            // Request arena must stay live through write_response; conn arena is
            // reclaimed only after this connection is fully finished (not in close).
            loop {
                if !conn.open || !conn.keep { break }
                if conn.served >= self.max_requests { break }
                mark = socket_req_enter()
                req = @conn.read_request() or err {
                    app = socket_req_promote(app)
                    conn = conn_req_revive(conn, mark)
                    @conn.close()
                    break
                }
                res = @app.handle(req)
                @conn.write_response(req, res) or -1
                // Promote any arena-born App COW (escaping stores); no-op when in-place.
                app = socket_req_promote(app)
                conn = conn_req_revive(conn, mark)
                handled += 1
            }
            if conn.open { @conn.close() }
            _ = socket_conn_leave(0)
        }
        handled
    }
}

/// Promote connection-lifetime fields out of the request arena, then leave.
/// Mutates the durable Conn in place (existing keys) so keep-alive does not
/// allocate a new Conn header every request. Spent read buffer is cleared, not
/// promoted. Peer addr / why are keep_str'd when they still live in the arena.
+conn_req_revive(c: Conn, mark: i64) : Conn {
    c = socket_req_promote(c)
    c.remote = socket_req_keep_str(c.remote)
    c.why = socket_req_keep_str(c.why)
    c.buf = ""
    socket_req_leave(mark)
    c
}

/// Stack-only overrides for the common `App.serve` path. Defaults match `Server.listen`.
+ServeConfig = {
    read_timeout_ms: i64 = 30000
    write_timeout_ms: i64 = 30000
    idle_timeout_ms: i64 = 60000
    max_header_bytes: i64 = 1048576
    max_body_bytes: i64 = 10485760
    max_requests: i64 = 1000

    defaults() : ServeConfig => ServeConfig{}

    read_timeout(@self, ms: i64) : ServeConfig {
        self.read_timeout_ms = ms
        self
    }

    write_timeout(@self, ms: i64) : ServeConfig {
        self.write_timeout_ms = ms
        self
    }

    idle_timeout(@self, ms: i64) : ServeConfig {
        self.idle_timeout_ms = ms
        self
    }

    header_limit(@self, bytes: i64) : ServeConfig {
        self.max_header_bytes = bytes
        self
    }

    body_limit(@self, bytes: i64) : ServeConfig {
        self.max_body_bytes = bytes
        self
    }

    keep_alive_limit(@self, requests: i64) : ServeConfig {
        self.max_requests = requests
        self
    }
}

// --- App: fluent router + middleware pipeline + CRUD -----------------------------------------
//
// Ultra-low boilerplate:
//
//   app = App.new()
//     .use(Mw.Recover).use(Mw.RequestId).use(Mw.Logger).use(Mw.Security)
//     .use_cors(["*"], false)
//     .get("/health", |_req| { ok({ok: true}) })
//     .group("/api")
//       .use(Mw.Json).use_max_body(1048576)
//       .post("/login", |req| { handle_login(req) })
//       .crud("/tasks", Crud.rest())   // still uses Handler ids + bind()
//     .end()
//
//   res = @app.handle(req)            // full middleware + router + handler
//   @srv.serve(@app, stop)            // production accept loop
//
// Handler ids remain for CRUD packs / hot mounts:
//   @app.mount("GET", "/debug/stats", Handler.Debug)
//   @app.bind(Handler.Debug, |req| { ok({stats: 1}) })

/// Middleware slot sum — kind is the variant; config is the payload.
/// Default behavior lives on `before` / `after`; override by `App.replace` / `remove`.
+Mw = {
    None
    Recover
    Logger
    RequestId
    Security
    Cors(origins: str, credentials: bool)
    Json
    MaxBody(limit: i64)
    StripSlash
    Https
    Etag
    RateLimit(rate: i64, burst: i64)
    Bearer(token: str)
    Basic(user: str, password: str, realm: str)
    Hsts(max_age: i64, include_subdomains: bool)
    Csp(policy: str)
    Compress
    NoCache
    PoweredBy

    /// True when `other` is the same middleware kind (payload ignored).
    same_kind(self, other: Mw) : bool {
        a = 0
        b = 0
        when self {
            Mw.None => a = 0
            Mw.Recover => a = 1
            Mw.Logger => a = 2
            Mw.RequestId => a = 3
            Mw.Security => a = 4
            Mw.Cors => a = 5
            Mw.Json => a = 6
            Mw.MaxBody => a = 7
            Mw.StripSlash => a = 8
            Mw.Https => a = 9
            Mw.Etag => a = 10
            Mw.RateLimit => a = 11
            Mw.Bearer => a = 12
            Mw.Basic => a = 13
            Mw.Hsts => a = 14
            Mw.Csp => a = 15
            Mw.Compress => a = 16
            Mw.NoCache => a = 17
            Mw.PoweredBy => a = 18
        }
        when other {
            Mw.None => b = 0
            Mw.Recover => b = 1
            Mw.Logger => b = 2
            Mw.RequestId => b = 3
            Mw.Security => b = 4
            Mw.Cors => b = 5
            Mw.Json => b = 6
            Mw.MaxBody => b = 7
            Mw.StripSlash => b = 8
            Mw.Https => b = 9
            Mw.Etag => b = 10
            Mw.RateLimit => b = 11
            Mw.Bearer => b = 12
            Mw.Basic => b = 13
            Mw.Hsts => b = 14
            Mw.Csp => b = 15
            Mw.Compress => b = 16
            Mw.NoCache => b = 17
            Mw.PoweredBy => b = 18
        }
        a == b
    }

    /// Request-phase default. `none` continues; a `Response` short-circuits.
    before(self, req: Request, @app: App) : Response? {
        when self {
            Mw.StripSlash => mw_strip_trailing_slash(req)
            Mw.Https => mw_https_redirect(req)
            Mw.Json => mw_require_json(req)
            Mw.MaxBody { limit } => mw_max_body(req, limit)
            Mw.Bearer { token } => mw_require_token(req, token)
            Mw.Basic { user, password, realm } => mw_basic_auth(req, user, password, realm)
            Mw.RateLimit => {
                key = req_client_ip(req)
                if key == "" { key = "unknown" }
                lim = app.limiter
                early = @lim.check(key, app.clock) or none
                app.limiter = lim
                early
            }
            Mw.Cors { origins, credentials } => {
                _ = credentials
                list = mw_origins_of(origins)
                mw_cors_preflight(req, list, "GET, POST, PUT, PATCH, DELETE, OPTIONS", "Authorization, Content-Type, X-Request-Id", 600)
            }
            else => none
        }
    }

    /// Response-phase default.
    after(self, req: Request, res: Response, app: App) : Response {
        when self {
            Mw.RequestId => {
                rid = req_header(req, "X-Request-Id") or ""
                if rid == "" { rid = http_hex(app.clock, 16) }
                set_header(res, "X-Request-Id", rid)
            }
            Mw.Security => mw_security_headers(res)
            Mw.Hsts { max_age, include_subdomains } => mw_hsts(res, max_age, include_subdomains)
            Mw.Csp { policy } => mw_csp(res, policy)
            Mw.NoCache => set_header(res, "Cache-Control", "no-store")
            Mw.PoweredBy => set_header(res, "X-Powered-By", "Super")
            Mw.Cors { origins, credentials } => {
                list = mw_origins_of(origins)
                mw_cors_headers(req, res, list, credentials)
            }
            Mw.Etag => mw_etag(req, res)
            Mw.Compress => {
                ae = req_header(req, "Accept-Encoding") or ""
                if http_len(ae) > 0 { set_header(res, "Vary", "Accept-Encoding") } else { res }
            }
            Mw.Logger => {
                line = mw_log_line(req, res, 0)
                set_header(res, "X-Super-Log", line)
            }
            else => res
        }
    }
}

/// Standard route handler ids — unit sum variants coerce to stable `i64` tags.
/// Use with `App.get` / `post` / `crud` / `mount` and `when m.id { Handler.Create => … }`.
/// App-specific routes: pick an unused variant below, or a raw `i64` ≥ 64.
+Handler = {
    List
    Create
    Show
    Update
    Destroy
    Health
    Ready
    Live
    Login
    Logout
    Register
    Refresh
    Webhook
    Callback
    Metrics
    Admin
    Debug
    Static
    CatchAll
}

/// REST handler id pack for `App.crud` / `App.resource`.
+Crud = {
    list: i64 = -1
    create: i64 = -1
    show: i64 = -1
    update: i64 = -1
    destroy: i64 = -1

    /// Build from five handler ids (list, create, show, update, destroy).
    of(list: i64, create: i64, show: i64, update: i64, destroy: i64) : Crud {
        Crud.{list, create, show, update, destroy}
    }

    /// Standard REST pack using `Handler` CRUD variants.
    rest() : Crud {
        Crud.of(Handler.List, Handler.Create, Handler.Show, Handler.Update, Handler.Destroy)
    }

    /// Read-only collection (list + show).
    read(list: i64, show: i64) : Crud {
        Crud.{list, create: -1, show, update: -1, destroy: -1}
    }

    /// Write-only collection (create + update + destroy).
    write(create: i64, update: i64, destroy: i64) : Crud {
        Crud.{list: -1, create, show: -1, update, destroy}
    }

    /// First-class callable pack for `App.crud` (skip a verb with `none`).
    handlers(
        list: Fn[Request, Response],
        create: Fn[Request, Response],
        show: Fn[Request, Response],
        update: Fn[Request, Response],
        destroy: Fn[Request, Response]
    ) : CrudHandlers {
        CrudHandlers.{list, create, show, update, destroy}
    }
}

/// Optional callables for `App.crud` — register REST without `Handler` ids / `.bind`.
+CrudHandlers = {
    list: Fn[Request, Response] = none
    create: Fn[Request, Response] = none
    show: Fn[Request, Response] = none
    update: Fn[Request, Response] = none
    destroy: Fn[Request, Response] = none

    of(
        list: Fn[Request, Response],
        create: Fn[Request, Response],
        show: Fn[Request, Response],
        update: Fn[Request, Response],
        destroy: Fn[Request, Response]
    ) : CrudHandlers {
        CrudHandlers.{list, create, show, update, destroy}
    }

    /// All five verbs present.
    rest(
        list: Fn[Request, Response],
        create: Fn[Request, Response],
        show: Fn[Request, Response],
        update: Fn[Request, Response],
        destroy: Fn[Request, Response]
    ) : CrudHandlers {
        CrudHandlers.of(list, create, show, update, destroy)
    }

    /// List + show only.
    read(list: Fn[Request, Response], show: Fn[Request, Response]) : CrudHandlers {
        CrudHandlers.{list, create: none, show, update: none, destroy: none}
    }

    /// Create + update + destroy only.
    write(
        create: Fn[Request, Response],
        update: Fn[Request, Response],
        destroy: Fn[Request, Response]
    ) : CrudHandlers {
        CrudHandlers.{list: none, create, show: none, update, destroy}
    }
}

/// Join a group prefix with a route pattern (`/api` + `/tasks` → `/api/tasks`).
+app_join(prefix: str, pattern: str) : str {
    if prefix == "" { return pattern }
    if pattern == "" || pattern == "/" { return prefix }
    p = prefix
    if http_ends_with(p, "/") { p = p[0..(http_len(p) - 1)] }
    if http_starts_with(pattern, "/") { return p + pattern }
    p + "/" + pattern
}

/// Split a `\n`-joined origin list into an array (used by CORS slots).
+mw_origins_of(joined: str) : _ {
    out = []
    if joined == "" { return out }
    start = 0
    n = http_len(joined)
    for 0..(n + 1) {
        at_end = it == n
        sep = false
        if !at_end { sep = joined[it] == "\n" }
        if at_end || sep {
            if it > start { out = arr_push(out, joined[start..it]) }
            start = it + 1
        }
    }
    out
}

/// Join origin strings with newlines for storage in an `Mw` slot.
+mw_join_origins(origins: _) : str {
    out = ""
    for origins {
        if index > 0 { out = out + "\n" }
        out = out + it
    }
    out
}

/// Build an [`App`] from route entries `verb "/path" handler`, where the
/// handler is a `{ block }` (the request is unnamed) or a `|req| …` lambda.
///
/// ```super
/// app = #routes {
///     get "/health" { ok({ok: true}) }
///     post "/echo" |req| { ok({echo: req.body}) }
/// }
/// ```
///
/// Expands to `App.new()` followed by one `@app.verb(path, handler)` call per
/// entry. Unknown verbs and a repeated `VERB /path` are compile errors.
+#routes {
    ($($verb:ident $path:str $handler:closure)*) => {
        $(
            #route_verb($verb)
        )*
        #ensure_distinct("duplicate route `{}` in `#routes`", $((#upper($verb) $path))*)
        $app = App.new()
        $(
            $app = @$app.$verb($path, #route_handler($handler))
        )*
        $app
    }
    ($($entry:tt)*) => {
        #error("`#routes` entries are `verb \"/path\" handler`, where the handler is a `\{ block \}` or a `|req| …` lambda")
    }
}

/// Accepts the HTTP verbs `App` registers routes for.
#route_verb {
    (get) => {}
    (post) => {}
    (put) => {}
    (patch) => {}
    (delete) => {}
    (head) => {}
    (options) => {}
    (any) => {}
    ($other:ident) => {
        #error($other, #concat("unknown route method `", $other, "` in `#routes`"))
    }
}

/// A `{ block }` handler becomes a one-parameter lambda; a lambda is kept.
#route_handler {
    ({ $($body:tt)* }) => { |$req| { $($body)* } }
    ($handler:expr) => { $handler }
}

/// One registered HTTP application: fluent router, groups, middleware, CRUD.
+App = {
    /// Router on `App`.
    router: Router = Router.new()
    /// Served request count.
    served: i64 = 0
    /// Middleware slots (registration order).
    mws: _ = []
    /// Parallel path scopes for each `mws` entry (`""` = every request).
    mw_scopes: _ = []
    /// Active group path prefix (nested via `group` / `end`).
    prefix: str = ""
    /// Saved prefixes for nested groups.
    prefix_stack: _ = []
    /// Auto-id counter for `on` / anonymous mounts.
    next_id: i64 = 1
    /// Optional shared rate limiter (used by `Mw.RateLimit` slots).
    limiter: RateLimiter = RateLimiter.new(256, 100, 200)
    /// Logical clock seed for request ids; advanced per request.
    clock: i64 = 1
    /// CORS allow-credentials default for `.use_cors`.
    cors_creds: bool = false
    /// Handler ids that have a bound callable (parallel with `fns`).
    fn_ids: _ = []
    /// Callables `Request -> Response` for `fn_ids` (first-class lambdas / fns).
    fns: _ = []

    /// Empty app.
    new() : App {
        App.{router: Router.new(), served: 0, mws: [], mw_scopes: [], prefix: "", prefix_stack: [], next_id: 1, limiter: RateLimiter.new(256, 100, 200), clock: 1, cors_creds: false, fn_ids: [], fns: []}
    }

    /// Bind a callable to handler id `id` (used by CRUD packs and `get`).
    bind(@self, id: i64, h: Fn[Request, Response]) : App {
        n = len(self.fn_ids)
        for 0..n {
            if self.fn_ids[it] == id {
                self.fns = arr_set(self.fns, it, h)
                return self
            }
        }
        self.fn_ids = arr_push(self.fn_ids, id)
        self.fns = arr_push(self.fns, h)
        self
    }

    /// Look up a bound callable for `id`.
    find_fn(self, id: i64) : i64 {
        n = len(self.fn_ids)
        for 0..n {
            if self.fn_ids[it] == id { return it }
        }
        -1
    }

    /// Match `req` against the router.
    match(self, req: Request) : RouteMatch {
        self.router.match(req.method, req.path)
    }

    /// Next free handler id (runtime registration helper).
    alloc_id(@self) : i64 {
        id = self.next_id
        self.next_id = id + 1
        id
    }

    /// Push a middleware slot. Inside a `group`, the slot is scoped to that prefix
    /// (skipped for requests outside it) — O(1) prefix check per slot.
    use(@self, slot: Mw) : App {
        self.mws = arr_push(self.mws, slot)
        self.mw_scopes = arr_push(self.mw_scopes, self.prefix)
        self
    }

    /// Alias of `use` (configured slots).
    use_mw(@self, slot: Mw) : App {
        @self.use(slot)
    }

    /// Replace the first slot with the same kind as `old` by `new` (no-op if missing).
    replace(@self, old: Mw, new: Mw) : App {
        n = len(self.mws)
        for 0..n {
            if self.mws[it].same_kind(old) {
                self.mws[it] = new
                return self
            }
        }
        self
    }

    /// Remove the first slot with the same kind as `kind` (no-op if missing).
    remove(@self, kind: Mw) : App {
        out = []
        scopes = []
        n = len(self.mws)
        dropped = false
        for 0..n {
            if !dropped && self.mws[it].same_kind(kind) {
                dropped = true
                continue
            }
            out = arr_push(out, self.mws[it])
            scopes = arr_push(scopes, self.mw_scopes[it])
        }
        self.mws = out
        self.mw_scopes = scopes
        self
    }

    /// CORS for the listed origins (`["*"]` or concrete hosts).
    use_cors(@self, origins: _, allow_credentials: bool) : App {
        self.cors_creds = allow_credentials
        @self.use(Mw.Cors(mw_join_origins(origins), allow_credentials))
    }

    /// Reject non-JSON write bodies.
    use_json(@self) : App {
        @self.use(Mw.Json)
    }

    /// Cap request bodies at `limit` bytes.
    use_max_body(@self, limit: i64) : App {
        @self.use(Mw.MaxBody(limit))
    }

    /// Require `Authorization: Bearer <token>`.
    use_bearer(@self, token: str) : App {
        @self.use(Mw.Bearer(token))
    }

    /// Require HTTP Basic credentials.
    use_basic(@self, user: str, password: str, realm: str) : App {
        @self.use(Mw.Basic(user, password, realm))
    }

    /// Token-bucket rate limit (`rate`/s, `burst`).
    use_rate_limit(@self, rate: i64, burst: i64) : App {
        self.limiter = RateLimiter.new(256, rate, burst)
        @self.use(Mw.RateLimit(rate, burst))
    }

    /// HSTS response header.
    use_hsts(@self, max_age: i64, include_subdomains: bool) : App {
        @self.use(Mw.Hsts(max_age, include_subdomains))
    }

    /// Content-Security-Policy.
    use_csp(@self, policy: str) : App {
        @self.use(Mw.Csp(policy))
    }

    /// Open a route group with path `prefix` (nestable). Call `end` to leave.
    group(@self, prefix: str) : App {
        self.prefix_stack = arr_push(self.prefix_stack, self.prefix)
        self.prefix = app_join(self.prefix, prefix)
        self
    }

    /// Leave the current group (restore previous prefix).
    end(@self) : App {
        n = len(self.prefix_stack)
        ensure n > 0 else { return self }
        self.prefix = self.prefix_stack[n - 1]
        self.prefix_stack = self.prefix_stack[0..(n - 1)]
        self
    }

    /// Register `method` `pattern` under handler id `id`. Returns `self` for chaining.
    route(@self, method: str, pattern: str, id: i64) : App {
        full = app_join(self.prefix, pattern)
        r = self.router
        @r.add(method, full, id)
        self.router = r
        self
    }

    /// Same as `route` but returns the handler id (when you need the number).
    route_id(@self, method: str, pattern: str, id: i64) : i64 {
        @self.route(method, pattern, id)
        id
    }

    /// Allocate a fresh id and mount it; returns the id.
    on(@self, method: str, pattern: str) : i64 {
        id = @self.alloc_id()
        @self.route(method, pattern, id)
        id
    }

    /// Remove every registration of `method`+`pattern` (rebuilds the router table).
    unmount(@self, method: str, pattern: str) : App {
        full = app_join(self.prefix, pattern)
        r = self.router
        methods = []
        patterns = []
        ids = []
        n = len(r.patterns)
        for 0..n {
            keep = !(r.methods[it] == method && r.patterns[it] == full)
            if keep {
                methods = arr_push(methods, r.methods[it])
                patterns = arr_push(patterns, r.patterns[it])
                ids = arr_push(ids, r.ids[it])
            }
        }
        fresh = Router.new()
        m = len(patterns)
        for 0..m {
            @fresh.add(methods[it], patterns[it], ids[it])
        }
        self.router = fresh
        self
    }

    /// Register `GET pattern` with a typed `Request -> Response` callable.
    get(@self, pattern: str, h: Fn[Request, Response]) : App {
        id = @self.alloc_id()
        @self.route("GET", pattern, id)
        @self.bind(id, h)
    }
    post(@self, pattern: str, h: Fn[Request, Response]) : App {
        id = @self.alloc_id()
        @self.route("POST", pattern, id)
        @self.bind(id, h)
    }
    put(@self, pattern: str, h: Fn[Request, Response]) : App {
        id = @self.alloc_id()
        @self.route("PUT", pattern, id)
        @self.bind(id, h)
    }
    delete(@self, pattern: str, h: Fn[Request, Response]) : App {
        id = @self.alloc_id()
        @self.route("DELETE", pattern, id)
        @self.bind(id, h)
    }
    patch(@self, pattern: str, h: Fn[Request, Response]) : App {
        id = @self.alloc_id()
        @self.route("PATCH", pattern, id)
        @self.bind(id, h)
    }

    /// Register any-method `pattern` with a typed callable (respects `group` prefix).
    head(@self, pattern: str, h: Fn[Request, Response]) : App {
        id = @self.alloc_id()
        @self.route("HEAD", pattern, id)
        @self.bind(id, h)
    }
    options(@self, pattern: str, h: Fn[Request, Response]) : App {
        id = @self.alloc_id()
        @self.route("OPTIONS", pattern, id)
        @self.bind(id, h)
    }
    any(@self, pattern: str, h: Fn[Request, Response]) : App {
        id = @self.alloc_id()
        @self.route("", pattern, id)
        @self.bind(id, h)
    }

    /// Register `method` `pattern` with a typed callable (respects `group` prefix).
    mount(@self, method: str, pattern: str, h: Fn[Request, Response]) : App {
        id = @self.alloc_id()
        @self.route(method, pattern, id)
        @self.bind(id, h)
    }

    /// `"GET /path"` method+path registration by handler id.
    handle_route(@self, spec: str, id: i64) : App {
        r = self.router
        // Prefix the path part when grouped.
        s = http_trim(spec)
        sp = http_index_of(s, " ", 0)
        if sp > 0 && s[0] != "/" {
            method = s[0..sp]
            path = http_trim(s[(sp + 1)..http_len(s)])
            @r.add(method, app_join(self.prefix, path), id)
        } else {
            @r.add("", app_join(self.prefix, s), id)
        }
        self.router = r
        self
    }

    /// Full middleware + router + bound-handler pipeline. Auto 301 / 404 / 405.
    /// Prefer this (and `Server.serve`) over manual `before` / `match` / `when` / `after`.
    handle(@self, req: Request) : Response {
        early = @self.before(req) or none
        if early != none { return @self.after(req, early) }
        m = self.router.match(req.method, req.path)
        req.match_id = m.id
        req.match_status = m.status
        req.match_keys = m.keys
        req.match_vals = m.vals
        if m.status == 301 {
            return @self.after(req, redirect_with(301, m.redirect))
        }
        if m.status == 404 {
            return @self.after(req, not_found({error: "not found"}))
        }
        if m.status == 405 {
            return @self.after(req, with_header(method_not_allowed(""), "Allow", allow_join(m.allow)))
        }
        at = self.find_fn(m.id)
        res = not_found({error: "unhandled route"})
        if at >= 0 {
            h = self.fns[at]
            res = h(req)
        }
        @self.after(req, res)
    }

    /// Listen on `addr` (convenience wrapper around `Server.listen`).
    listen(_self, addr: str) : Server! {
        Server.listen(addr)
    }

    /// Common production path: listen, install SIGINT/SIGTERM handling, serve, and clean up.
    serve(@self, addr: str) : i64! {
        @self.serve_with(addr, ServeConfig.defaults())
    }

    /// Common production path with explicit stack-only server limits.
    serve_with(@self, addr: str, config: ServeConfig) : i64! {
        server = Server.listen(addr) or err {
            fail "{err}"
            return
        }
        server.read_timeout_ms = config.read_timeout_ms
        server.write_timeout_ms = config.write_timeout_ms
        server.idle_timeout_ms = config.idle_timeout_ms
        server.max_header_bytes = config.max_header_bytes
        server.max_body_bytes = config.max_body_bytes
        server.max_requests = config.max_requests
        stop = Notify.graceful() or err {
            @server.shutdown()
            fail "signal setup failed: {err}"
            return
        }
        handled = Server.serve(@server, @self, stop) or err {
            @stop.close()
            fail "{err}"
            return
        }
        @stop.close()
        handled
    }

    /// Handler-id REST resource under `base`. The callable common path is `crud`.
    resource(@self, base: str, c: Crud) : App {
        // Raw string: a normal `"/{id}"` would interpolate `id` away.
        item = app_join(base, r"/{id}")
        if c.list >= 0 { @self.route("GET", base, c.list) }
        if c.create >= 0 { @self.route("POST", base, c.create) }
        if c.show >= 0 { @self.route("GET", item, c.show) }
        if c.update >= 0 {
            @self.route("PUT", item, c.update)
            @self.route("PATCH", item, c.update)
        }
        if c.destroy >= 0 { @self.route("DELETE", item, c.destroy) }
        self
    }

    /// REST resource with first-class callables (no `Handler` ids / `.bind`).
    /// Skip a verb by passing `none`. Respects `group` / `end` prefixes.
    crud(@self, base: str, h: CrudHandlers) : App {
        item = app_join(base, r"/{id}")
        if h.list != none { @self.get(base, h.list) }
        if h.create != none { @self.post(base, h.create) }
        if h.show != none { @self.get(item, h.show) }
        if h.update != none {
            @self.put(item, h.update)
            @self.patch(item, h.update)
        }
        if h.destroy != none { @self.delete(item, h.destroy) }
        self
    }

    /// Request-phase middleware. Returns a short-circuit `Response`, or `none` to continue.
    before(@self, req: Request) : Response? {
        self.clock += 1
        self.served += 1
        app_run_before(@self, req)
    }

    /// Response-phase middleware (logger, security headers, CORS echo, etag, compress).
    after(@self, req: Request, res: Response) : Response {
        app_run_after(@self, req, res)
    }

    /// Run request middleware then match.
    gate(@self, req: Request) : RouteMatch {
        early = @self.before(req) or none
        if early != none {
            return RouteMatch.{id: -2, status: early.status, keys: [], vals: [], pattern: "", allow: [], redirect: ""}
        }
        self.router.match(req.method, req.path)
    }
}

/// In-process test client — dispatches through `App.handle` (full middleware + router).
+TestClient = {
    app: App = App.new()

    new(app: App) : TestClient {
        TestClient.{app}
    }

    /// Dispatch an arbitrary request (custom method / headers / body).
    send(@self, req: Request) : Response {
        @self.app.handle(req)
    }

    get(@self, path: str) : Response {
        @self.send(request("GET", path, ""))
    }

    /// `body` is dual-mode: raw `str` wire body, or JSON-encode records/maps/arrays.
    /// Sets `Content-Type: application/json` so `Mw.Json` accepts the request.
    post(@self, path: str, body) : Response {
        @self.send(req_with_header(request("POST", path, json_body(body)), "Content-Type", HTTP_JSON))
    }

    put(@self, path: str, body) : Response {
        @self.send(req_with_header(request("PUT", path, json_body(body)), "Content-Type", HTTP_JSON))
    }

    patch(@self, path: str, body) : Response {
        @self.send(req_with_header(request("PATCH", path, json_body(body)), "Content-Type", HTTP_JSON))
    }

    delete(@self, path: str) : Response {
        @self.send(request("DELETE", path, ""))
    }
}

/// True when middleware scope at `idx` covers `path`.
+app_mw_applies(scopes: _, idx: i64, path: str) : bool {
    scope = scopes[idx]
    if scope == "" { return true }
    p = path_only(path)
    if p == scope { return true }
    if http_starts_with(p, scope + "/") { return true }
    false
}

/// Request-phase middleware runner for an `App`.
+app_run_before(@a: App, req: Request) : Response? {
    path = req.path
    stack = a.mws
    scopes = a.mw_scopes
    n = len(stack)
    for 0..n {
        if !app_mw_applies(scopes, it, path) { continue }
        slot = stack[it]
        early = slot.before(req, @a) or none
        if early != none { return early }
    }
    none
}

/// Response-phase middleware runner for an `App`.
+app_run_after(@a: App, req: Request, res: Response) : Response {
    out = res
    path = req.path
    stack = a.mws
    scopes = a.mw_scopes
    n = len(stack)
    for 0..n {
        if !app_mw_applies(scopes, it, path) { continue }
        slot = stack[it]
        out = slot.after(req, out, a)
    }
    out
}

/// True when `gate` short-circuited in middleware (`id == -2`).
+gate_early(m: RouteMatch) : bool => m.id == -2

/// One accepted connection: `read_request` / `write_response` are the ServeHTTP loop body, with
/// framing, limits, keep-alive, HEAD, `Expect: 100-continue` and error replies handled here.
+Conn = {
    /// Fd on `Conn` (`i64`). Defaults to `-1`.
    fd: i64 = -1
    /// Bytes read but not yet consumed (the start of a pipelined next request).
    buf: _ = []
    /// Remote on `Conn` (`str`). Defaults to `""`.
    remote: str = ""
    /// Served on `Conn` (`i64`). Defaults to `0`.
    served: i64 = 0
    /// Open on `Conn` (`bool`). Defaults to `true`.
    open: bool = true
    /// Whether the response being written keeps the connection alive.
    keep: bool = true
    /// Detached on `Conn` (`bool`). Defaults to `false`.
    detached: bool = false
    /// Sent continue on `Conn` (`bool`). Defaults to `false`.
    sent_continue: bool = false
    /// Read timeout ms on `Conn` (`i64`). Defaults to `30000`.
    read_timeout_ms: i64 = 30000
    /// Write timeout ms on `Conn` (`i64`). Defaults to `30000`.
    write_timeout_ms: i64 = 30000
    /// Idle timeout ms on `Conn` (`i64`). Defaults to `60000`.
    idle_timeout_ms: i64 = 60000
    /// Max header bytes on `Conn` (`i64`). Defaults to `1048576`.
    max_header_bytes: i64 = 1048576
    /// Max body bytes on `Conn` (`i64`). Defaults to `10485760`.
    max_body_bytes: i64 = 10485760
    /// Max requests on `Conn` (`i64`). Defaults to `1000`.
    max_requests: i64 = 1000
    /// Why the last `read_request` / write failed: "eof", "timeout", "400 …".
    why: str = ""

    /// Read the next request. Fails (and closes) on EOF, timeout, reset or malformed input; for
    /// protocol errors the matching 4xx/5xx reply is written first. `why` says which.
    read_request(@self) : Request! {
        if !(self.open) {
            self.why = "closed"
            fail "closed"
        }
        for 0..1000000 {
            f = frame_request(self.buf, self.max_header_bytes, self.max_body_bytes)
            if f.stage == 0 {
                self.buf = socket_buf_slice(self.buf, f.consumed, socket_buf_len(self.buf))
                self.served += 1
                self.sent_continue = false
                r = f.req
                r.remote_addr = self.remote
                self.keep = req_keep_alive(r) && self.served < self.max_requests
                return r
            }
            if f.stage == 2 {
                code = error_status(f.why, 400)
                self.why = f.why
                @self.write_raw(render_full(http_error(code, error_message(f.why)), http_now(), false))
                @self.close()
                fail "{f.why}"
            }
            if f.head_ready && !self.sent_continue && req_expects_continue(f.req) {
                self.sent_continue = true
                @self.write_raw("HTTP/1.1 100 Continue\r\n\r\n")
            }
            idle = socket_buf_len(self.buf) == 0
            wait = self.read_timeout_ms
            if idle && self.served > 0 { wait = self.idle_timeout_ms }
            socket_set_timeout(self.fd, wait, self.write_timeout_ms) or false
            chunk = socket_tcp_read(self.fd, HTTP_READ_CHUNK) or err {
                if !idle {
                    @self.write_raw(render_full(http_error(408, "request timeout"), http_now(), false))
                }
                self.why = "timeout"
                @self.close()
                return
            }
            if socket_buf_len(chunk) == 0 {
                self.why = "eof"
                if !idle { self.why = "400 incomplete request" }
                @self.close()
                fail "{self.why}"
            }
            self.buf = socket_buf_concat(self.buf, chunk)
        }
        @self.close()
        fail "too many reads"
    }

    /// Write raw response bytes `data` on this connection, or fail.
    write_raw(@self, data: _) : i64! {
        if !(self.open) { fail "closed" }
        socket_set_timeout(self.fd, self.read_timeout_ms, self.write_timeout_ms) or false
        n = socket_tcp_write(self.fd, data) or err {
            self.why = "write failed"
            @self.close()
            return
        }
        n
    }

    /// Answer `req` with `res`: adds Date, `Connection: close` when the connection ends here, sends
    /// only the head for HEAD, writes `bin` payloads byte-exact, and closes the socket unless both
    /// sides keep it alive. Returns bytes written.
    write_response(@self, req: Request, res: Response) : i64! {
        if !(self.open) { fail "closed" }
        out = res
        if !has_header(out, "Date") { out = with_header(out, "Date", http_date(http_now())) }
        keep = self.keep
        if !keep { out = with_header(out, "Connection", "close") }
        if keep && req.proto == "HTTP/1.0" { out = with_header(out, "Connection", "keep-alive") }
        total = 0
        if req.method == "HEAD" {
            total = @self.write_raw(render_head_only(out)) or -1
        } else {
            if len(out.bin) > 0 && status_has_body(out.status) {
                blen = response_body_len(out)
                wire = socket_buf_concat(render_head(out, blen), out.bin)
                total = @self.write_raw(wire) or -1
            } else {
                total = @self.write_raw(render(out)) or -1
            }
        }
        if total < 0 { fail "write failed: {self.why}" }
        if !keep { @self.close() }
        total
    }

    /// Start a streamed (chunked) response: head now, body through `write_chunk`, finish with
    /// `end_stream`. This is http.Flusher: every chunk goes out immediately.
    begin_stream(@self, res: Response) : i64! {
        head = "HTTP/1.1 {res.status} {status_text(res.status)}\r\nContent-Type: {res.content_type}\r\nTransfer-Encoding: chunked\r\n"
        for (res.headers) { head = "{head}{it}\r\n" }
        if !(self.keep) { head = "{head}Connection: close\r\n" }
        @self.write_raw("{head}\r\n")
    }

    /// Write one chunked-encoding chunk, or fail.
    write_chunk(@self, data: str) : i64! {
        if data == "" { return 0 }
        @self.write_raw(chunk_frame(data))
    }

    /// Finish a chunked body, or fail.
    end_stream(@self) : i64! {
        n = @self.write_raw(chunk_end())
        if !(self.keep) { @self.close() }
        n
    }

    /// Server-Sent Events: stream head with the right headers, then `write_event`.
    begin_sse(@self) : i64! {
        r = response(200, "", "text/event-stream")
        r = set_header(r, "Cache-Control", "no-cache")
        r = set_header(r, "X-Accel-Buffering", "no")
        @self.begin_stream(r)
    }

    /// One SSE event; multi-line data becomes several `data:` lines.
    write_event(@self, event: str, data: str, id: str) : i64! {
        out = ""
        if event != "" { out = "event: {event}\n" }
        for (http_lines(data)) { out = "{out}data: {it}\n" }
        if data == "" { out = "{out}data: \n" }
        if id != "" { out = "{out}id: {id}\n" }
        @self.write_chunk("{out}\n")
    }

    /// http.Hijacker: hand the raw socket (e.g. for a WebSocket upgrade) to the caller. The
    /// connection stops being managed here; `pending()` returns bytes already read.
    hijack(@self) : i64 {
        self.open = false
        self.detached = true
        self.fd
    }

    /// Bytes buffered and not yet flushed.
    pending(self) : _ => self.buf

    /// Close the socket or client.
    /// Does not leave the connection arena — `Server.serve` (and tests) call
    /// `socket_conn_leave` after the last Conn field read so request writebacks
    /// are not dangling. Detached hijacks skip both close and leave.
    close(@self) : bool {
        if self.fd < 0 || (self.detached) { return false }
        was = self.open
        self.open = false
        socket_fd_close(self.fd)
        self.fd = -1
        was
    }

    /// Close the fd and reclaim the connection bump arena (Conn + peer/buf).
    /// Use when the caller is done reading Conn fields (tests / manual accept).
    finish(@self) : bool {
        was = @self.close()
        _ = socket_conn_leave(0)
        was
    }
}

// --- client (http.Client / Transport) -----------------------------------------------------------------
//
// Phases are separate so a single-threaded program can talk to its own server: `start` connects
// and writes the request, `finish` reads the response, `follow` takes the next redirect hop.
// `fetch` runs the whole loop for the usual case (a remote peer).

/// One request in flight (possibly after redirects).
+Call = {
    /// Url on `Call` (`str`). Defaults to `""`.
    url: str = ""
    /// Req on `Call` (`Request`).
    req: Request
    /// Fd on `Call` (`i64`). Defaults to `-1`.
    fd: i64 = -1
    /// Addr on `Call` (`str`). Defaults to `""`.
    addr: str = ""
    /// The connection came from the idle pool (so a dead one may be retried once).
    reused: bool = false
    /// Hops on `Call` (`i64`). Defaults to `0`.
    hops: i64 = 0
    /// Next url on `Call` (`str`). Defaults to `""`.
    next_url: str = ""
    /// Next method on `Call` (`str`). Defaults to `""`.
    next_method: str = ""
    /// Why on `Call` (`str`). Defaults to `""`.
    why: str = ""
}

/// A finished exchange: the response plus the call state (`next_url` set for redirects).
+Exchange = {
    /// `res` type.
    res: Response
    /// `call` type.
    call: Call
}

/// `Client` sends HTTP requests, follows redirects, and can reuse connections.
+Client = {
    /// Per-request timeout in milliseconds. Defaults to `30000`.
    timeout_ms: i64 = 30000
    /// How many redirects to follow before failing. Defaults to `10`.
    max_redirects: i64 = 10
    /// `follow` (default), `error` (stop on 3xx fail on redirect), `same_host`.
    redirect_policy: str = "follow"
    /// User-Agent sent on each request. Defaults to `"super-http/0.1"`.
    user_agent: str = "super-http/0.1"
    /// Largest response body that will be kept. Defaults to `10485760`.
    max_body_bytes: i64 = 10485760
    /// Cookie jar used when `use_jar` is true.
    jar: CookieJar
    /// True when cookies are stored and sent. Defaults to `true`.
    use_jar: bool = true
    /// Keep connections for reuse (HTTP/1.1 persistent connections), at most 8 idle.
    reuse: bool = true
    /// https:// needs a TLS-capable host socket layer. The built-in one is plain TCP, so https is
    /// refused unless the embedder opts in after wiring TLS (never send secrets in the clear).
    tls_enabled: bool = false
    /// Pool addrs on `Client`. Defaults to `[]`.
    pool_addrs: _ = []
    /// Pool fds on `Client`. Defaults to `[]`.
    pool_fds: _ = []
    /// Why on `Client` (`str`). Defaults to `""`.
    why: str = ""

    /// Empty value of this HTTP type.
    new() : Client => Client.{timeout_ms: 30000, max_redirects: 10, redirect_policy: "follow", user_agent: "super-http/0.1", max_body_bytes: HTTP_MAX_BODY_BYTES, jar: CookieJar.new(64), use_jar: true, reuse: true, tls_enabled: false, pool_addrs: http_strs(8, ""), pool_fds: arr_new(8, -1), why: ""}

    /// Go CheckRedirect helper: allow redirect when policy permits it.
    redirect_ok(self, from_url: str, to_url: str, _status: i64) : bool {
        if self.redirect_policy == "error" { return false }
        if self.redirect_policy != "same_host" { return true }
        a = parse_url(from_url)
        b = parse_url(to_url)
        if !(a.ok) || !(b.ok) { return false }
        http_ieq(a.host, b.host)
    }

    /// Take an idle connection to `addr` out of the pool, or -1.
    pool_take(@self, addr: str) : i64 {
        for 0..8 {
            if self.pool_addrs[it] == addr && self.pool_fds[it] >= 0 {
                fd = self.pool_fds[it]
                self.pool_addrs = arr_set(self.pool_addrs, it, "")
                self.pool_fds = arr_set(self.pool_fds, it, -1)
                return fd
            }
        }
        -1
    }

    /// Park a healthy connection for reuse; the oldest slot is closed when the pool is full.
    pool_put(@self, addr: str, fd: i64) : bool {
        slot = -1
        for 0..8 {
            if slot < 0 && self.pool_fds[it] < 0 { slot = it }
        }
        if slot < 0 {
            slot = 0
            socket_fd_close(self.pool_fds[0])
        }
        self.pool_addrs = arr_set(self.pool_addrs, slot, addr)
        self.pool_fds = arr_set(self.pool_fds, slot, fd)
        true
    }

    /// How many pooled connections are idle.
    idle_count(self) : i64 {
        n = 0
        for 0..8 {
            if self.pool_fds[it] >= 0 { n += 1 }
        }
        n
    }

    /// Close every idle pooled connection.
    close_idle(@self) : i64 {
        closed = 0
        for 0..8 {
            if self.pool_fds[it] >= 0 {
                socket_fd_close(self.pool_fds[it])
                self.pool_addrs = arr_set(self.pool_addrs, it, "")
                self.pool_fds = arr_set(self.pool_fds, it, -1)
                closed += 1
            }
        }
        closed
    }

    /// Build the request for `url` with the client's defaults: Host, User-Agent, Accept,
    /// `Accept-Encoding: identity` (bodies are never compressed here), Cookie from the jar.
    /// `headers` is a flat [name, value, …] list that overrides the defaults.
    build(self, method: str, url: ParsedUrl, headers: _, body: str) : Request {
        r = request(method, url.target, body)
        r = req_with_header(r, "Host", url_host_header(url))
        n = len(headers) / 2
        for 0..n { r = req_set_header(r, headers[it * 2], headers[it * 2 + 1]) }
        if !req_has_header(r, "User-Agent") { r = req_with_header(r, "User-Agent", self.user_agent) }
        if !req_has_header(r, "Accept") { r = req_with_header(r, "Accept", "*/*") }
        if !req_has_header(r, "Accept-Encoding") { r = req_with_header(r, "Accept-Encoding", "identity") }
        if !(self.reuse) { r = req_with_header(r, "Connection", "close") }
        if self.use_jar && !req_has_header(r, "Cookie") {
            ck = self.jar.header_for(url.host, path_only(url.target), url.scheme == "https", http_now())
            if ck != "" { r = req_with_header(r, "Cookie", ck) }
        }
        r
    }

    /// Connect (or reuse) and write the request of `call`. Returns the call with `fd` set, or
    /// with `fd` -1 and the reason in `why`.
    dispatch(@self, call: Call) : Call {
        out = call
        out.fd = -1
        u = parse_url(call.url)
        if !(u.ok) {
            out.why = "bad url: {call.url}"
            return out
        }
        if u.scheme == "https" && !(self.tls_enabled) {
            out.why = "https needs a TLS-capable transport (set tls_enabled)"
            return out
        }
        addr = url_dial_addr(u)
        fd = -1
        out.reused = false
        if (self.reuse) {
            fd = @self.pool_take(addr)
            if fd >= 0 { out.reused = true }
        }
        if fd < 0 {
            if u.scheme == "https" {
                fd = socket_tls_connect(addr) or -1
            } else {
                fd = socket_tcp_connect(addr) or -1
            }
        }
        if fd < 0 {
            out.why = "dial {addr} failed"
            return out
        }
        socket_set_timeout(fd, self.timeout_ms, self.timeout_ms) or false
        sent = socket_tcp_write(fd, render_request(call.req)) or -1
        if sent < 0 {
            socket_fd_close(fd)
            out.why = "write to {addr} failed"
            return out
        }
        out.fd = fd
        out.addr = addr
        out.why = ""
        out
    }

    /// Prepare and send a request. On failure the returned call has `fd < 0` and `why` set
    /// (`call_ok` tells them apart).
    start(@self, method: str, url: str, headers: _, body: str) : Call {
        u = parse_url(url)
        if !(u.ok) {
            self.why = "bad url: {url}"
            failed = failed_call()
            failed.why = self.why
            return failed
        }
        req = self.build(method, u, headers, body)
        call = Call.{url, req, fd: -1, addr: "", reused: false, hops: 0, next_url: "", next_method: "", why: ""}
        sent = @self.dispatch(call)
        if sent.fd < 0 { self.why = sent.why }
        sent
    }

    /// Read the response for `call`. Updates the cookie jar, returns or closes the connection, and
    /// sets `next_url` on the returned call when the response is a redirect the client should
    /// follow. A failed exchange has `res.status == 0` and the reason in `why`.
    finish(@self, call: Call) : Exchange {
        cur = call
        buf = socket_buf_slice("", 0, 0)
        eof = false
        head_only = call.req.method == "HEAD"
        deadline = monotonic_ms() + self.timeout_ms
        cur.next_url = ""
        for 0..1000000 {
            f = frame_response(buf, head_only, eof, self.max_body_bytes)
            if f.stage == 2 {
                socket_fd_close(cur.fd)
                self.why = f.why
                return Exchange.{res: failed_response(), call: cur}
            }
            if f.stage == 0 {
                res = f.res
                keep = self.reuse && !(f.closes) && res_keep_alive(res) && f.consumed >= socket_buf_len(buf)
                if keep { @self.pool_put(cur.addr, cur.fd) } else { socket_fd_close(cur.fd) }
                cur.fd = -1
                u = parse_url(cur.url)
                if (self.use_jar) {
                    jar = self.jar
                    for (header_values(res, "Set-Cookie")) {
                        c = parse_set_cookie(it) or none
                        if c != none { @jar.store(u.host, c, http_now()) }
                    }
                    self.jar = jar
                }
                loc = header_of(res, "Location") or ""
                if self.max_redirects > 0 && status_follows_location(res.status) && loc != "" {
                    if cur.hops >= (self.max_redirects) {
                        self.why = "stopped after {self.max_redirects} redirects"
                        return Exchange.{res: failed_response(), call: cur}
                    }
                    target = resolve_url(cur.url, loc)
                    if !self.redirect_ok(cur.url, target, res.status) {
                        self.why = "redirect blocked by policy"
                        return Exchange.{res, call: cur}
                    }
                    cur.next_url = target
                    cur.next_method = redirect_method(res.status, cur.req.method)
                }
                return Exchange.{res, call: cur}
            }
            left = deadline - monotonic_ms()
            if left <= 0 {
                socket_fd_close(cur.fd)
                self.why = "timeout"
                return Exchange.{res: failed_response(), call: cur}
            }
            socket_set_timeout(cur.fd, left, left) or false
            // A failed read (timeout, reset) and EOF both come back empty; the deadline tells
            // them apart.
            got = socket_tcp_read(cur.fd, HTTP_READ_CHUNK) or socket_buf_slice("", 0, 0)
            if socket_buf_len(got) > 0 {
                buf = socket_buf_concat(buf, got)
            } else {
                if monotonic_ms() >= deadline {
                    socket_fd_close(cur.fd)
                    self.why = "timeout"
                    return Exchange.{res: failed_response(), call: cur}
                }
                eof = true
            }
        }
        socket_fd_close(cur.fd)
        self.why = "too many reads"
        Exchange.{res: failed_response(), call: cur}
    }

    /// Send the redirect hop `finish` prepared (`next_url` / `next_method`). 301/302/303 turn the
    /// method into GET (HEAD stays HEAD) and drop the body; 307/308 replay it. Credentials never
    /// cross hosts. Returns the new call (`fd < 0` on failure).
    follow(@self, call: Call) : Call {
        target = call.next_url
        u = parse_url(target)
        old = parse_url(call.url)
        if !(u.ok) {
            failed = failed_call()
            failed.why = "bad redirect: {target}"
            self.why = failed.why
            return failed
        }
        method = call.next_method
        body = call.req.body
        if method != (call.req.method) { body = "" }
        headers = []
        names = call.req.hdr_names
        vals = call.req.hdr_vals
        same_host = u.host == old.host && u.port == old.port && u.scheme == old.scheme
        for names {
            lower = http_lower(it)
            skip = lower == "host" || lower == "content-length" || lower == "cookie"
            if !same_host && (lower == "authorization" || lower == "proxy-authorization") { skip = true }
            if body == "" && (lower == "content-type" || lower == "content-encoding") { skip = true }
            if !skip {
                headers = arr_push(headers, it)
                headers = arr_push(headers, vals[index])
            }
        }
        next = call
        next.url = target
        next.req = self.build(method, u, headers, body)
        next.hops = call.hops + 1
        next.next_url = ""
        out = @self.dispatch(next)
        if out.fd < 0 { self.why = out.why }
        out
    }

    /// The whole exchange, following redirects up to `max_redirects`. `headers` is a flat
    /// [name, value, …] list ([] for none). Fails with the reason in `why`.
    fetch(@self, method: str, url: str, headers: _, body: str) : Response! {
        call = @self.start(method, url, headers, body)
        if call.fd < 0 { fail "{call.why}" }
        for 0..64 {
            ex = @self.finish(call)
            if ex.res.status == 0 { fail "{self.why}" }
            call = ex.call
            if call.next_url == "" { return ex.res }
            call = @self.follow(call)
            if call.fd < 0 { fail "{call.why}" }
        }
        fail "too many redirects"
    }

    /// GET `url`, or fail.
    get(@self, url: str) : Response! => @self.fetch("GET", url, [], "")
    /// HEAD `url`, or fail.
    head(@self, url: str) : Response! => @self.fetch("HEAD", url, [], "")
    /// DELETE `url`, or fail.
    delete(@self, url: str) : Response! => @self.fetch("DELETE", url, [], "")
    /// POST `content_type` to `url`, or fail.
    post(@self, url: str, content_type: str, body: str) : Response! => @self.fetch("POST", url, ["Content-Type", content_type], body)
    /// PUT `content_type` to `url`, or fail.
    put(@self, url: str, content_type: str, body: str) : Response! => @self.fetch("PUT", url, ["Content-Type", content_type], body)
    /// PATCH `content_type` to `url`, or fail.
    patch(@self, url: str, content_type: str, body: str) : Response! => @self.fetch("PATCH", url, ["Content-Type", content_type], body)
    /// POST the JSON body `json` to `url`, or fail.
    post_json(@self, url: str, json: str) : Response! => @self.fetch("POST", url, ["Content-Type", HTTP_JSON, "Accept", HTTP_JSON], json)

    /// POST `application/x-www-form-urlencoded` from flat [key, value, …] pairs.
    post_form(@self, url: str, pairs: _) : Response! => @self.fetch("POST", url, ["Content-Type", "application/x-www-form-urlencoded"], build_query(pairs))
}

/// Placeholders that stand for "the call / response failed" (a `fail` reaches callers as an
/// absent value, so `or failed_call()` keeps the type and `why` carries the reason).
+call_ok(c: Call) : bool => c.fd >= 0

/// A call result that failed before a response.
+failed_call() : Call => Call.{url: "", req: request("GET", "/", ""), fd: -2, addr: "", reused: false, hops: 0, next_url: "", next_method: "", why: "failed"}

/// A response that represents a transport failure.
+failed_response() : Response => response(0, "", "")

/// Method used for the redirected request: 301/302/303 -> GET (HEAD stays HEAD); 307/308 keep it.
+redirect_method(status: i64, method: str) : str {
    if status == 307 || status == 308 { return method }
    if method == "HEAD" { return "HEAD" }
    "GET"
}

// --- reverse-proxy building blocks (httputil.ReverseProxy) ------------------------------------------------

/// Hop-by-hop headers (RFC 9110 section 7.6.1): meaningful for one connection only.
+hop_by_hop_headers()  => ["Connection", "Keep-Alive", "Proxy-Authenticate", "Proxy-Authorization", "Te", "Trailer", "Transfer-Encoding", "Upgrade"]

/// Is `name` hop-by-hop, either by the standard list or because `connection` (the value of the
/// Connection header) names it?
+is_hop_by_hop(name: str, connection: str) : bool {
    for (hop_by_hop_headers()) {
        if http_ieq(it, name) { return true }
    }
    header_has_token(connection, name)
}

/// Request without hop-by-hop headers (and without anything the Connection header lists).
+req_strip_hop_by_hop(r: Request) : Request {
    conn = ""
    for (req_header_values(r, "Connection")) { conn = conn + "," + it }
    out = r
    names = []
    vals = []
    rn = r.hdr_names
    rv = r.hdr_vals
    for rn {
        if !is_hop_by_hop(it, conn) {
            names = arr_push(names, it)
            vals = arr_push(vals, rv[index])
        }
    }
    out.hdr_names = names
    out.hdr_vals = vals
    out
}

/// Copy of the response without hop-by-hop headers.
+res_strip_hop_by_hop(res: Response) : Response {
    conn = ""
    for (header_values(res, "Connection")) { conn = conn + "," + it }
    out = response(res.status, res.body, res.content_type)
    out.bin = res.bin
    kept = []
    for (res.headers) {
        if !is_hop_by_hop(entry_name(it), conn) { kept = arr_push(kept, it) }
    }
    out.headers = kept
    out
}

/// The request to send upstream: hop-by-hop headers removed, `Host` set to the upstream, and the
/// X-Forwarded-For / -Proto / -Host trio appended so the origin can see the real client.
+proxy_request(r: Request, upstream_host: str, client_ip: str, proto: str) : Request {
    out = req_strip_hop_by_hop(r)
    original_host = req_host(r)
    prior = req_header(out, "X-Forwarded-For") or ""
    chain = client_ip
    if prior != "" { chain = prior + ", " + client_ip }
    out = req_set_header(out, "Host", upstream_host)
    out = req_set_header(out, "X-Forwarded-For", chain)
    out = req_set_header(out, "X-Forwarded-Proto", proto)
    if original_host != "" { out = req_set_header(out, "X-Forwarded-Host", original_host) }
    out
}

// --- tests -----------------------------------------------------------------------------------------

/// Test that response constructors.
test "response constructors" {
    assert_eq(ok("x").status, 200)
    assert_eq(created("x").status, 201)
    assert_eq(no_content().status, 204)
    assert_eq(bad_request("x").status, 400)
    assert_eq(unauthorized("x").status, 401)
    assert_eq(forbidden("x").status, 403)
    assert_eq(not_found("x").status, 404)
    assert_eq(method_not_allowed("x").status, 405)
    assert_eq(too_many_requests("x").status, 429)
    assert_eq(server_error("x").status, 500)
    assert_eq(ok("body").body, "body")
    assert_eq(text("hi").content_type, "text/plain")
}

/// Test that dual-mode object bodies auto-JSON-encode while strings pass through.
test "object response bodies" {
    assert_eq(ok("raw").body, "raw")
    assert_eq(ok({id: 7}).body, "{\"id\":7}")
    assert_eq(bad_request({error: "empty body"}).body, "{\"error\":\"empty body\"}")
    assert_eq(not_found({error: "not found"}).status, 404)
    assert_eq(created({ok: true}).body, "{\"ok\":true}")
}

/// Test that status_text and predicates.
test "status_text and predicates" {
    assert_eq(status_text(200), "OK")
    assert_eq(status_text(404), "Not Found")
    assert_eq(status_text(999), "Unknown")
    #assert(is_success(ok("")))
    #assert(!(is_success(not_found(""))))
    #assert(is_error(server_error("")))
    #assert(!(is_error(ok(""))))
}

/// Test that headers and rendering.
test "headers and rendering" {
    r = with_header(ok("hi"), "X-Id", "7")
    assert_eq(header_of(r, "X-Id") or "?", "7")
    assert_eq(header_of(r, "X-Nope") or "none", "none")
    assert_eq(render(r), "HTTP/1.1 200 OK\r\nContent-Type: application/json\r\nContent-Length: 2\r\nX-Id: 7\r\n\r\nhi")
    assert_eq(header_of(redirect("/home"), "Location") or "?", "/home")
    assert_eq(redirect("/home").status, 302)
}

/// Test that request headers.
test "request headers" {
    r = req_with_header(request("GET", "/", ""), "Authorization", "Bearer abc")
    assert_eq(req_header(r, "Authorization") or "?", "Bearer abc")
    assert_eq(req_header(r, "Cookie") or "none", "none")
}

/// Test that path_only and query_get.
test "path_only and query_get" {
    assert_eq(path_only("/a/b?x=1"), "/a/b")
    assert_eq(path_only("/a/b"), "/a/b")
    assert_eq(query_get("/s?q=super&page=2", "q") or "?", "super")
    assert_eq(query_get("/s?q=super&page=2", "page") or "?", "2")
    assert_eq(query_get("/s?flag", "flag") or "?", "")
    assert_eq(query_get("/s?q=1", "zzz") or "none", "none")
    assert_eq(query_get("/s", "q") or "none", "none")
}

/// Test that pattern captures.
test "pattern captures" {
    m = pattern_capture("/users/:id/posts/:post", "/users/7/posts/42")
    assert_eq(m.status, 200)
    assert_eq(route_param(m, "id"), "7")
    assert_eq(route_param(m, "post"), "42")
    assert_eq(pattern_capture("/users/:id", "/users").status, 404)
    assert_eq(pattern_capture("/users/:id", "/users/").status, 404)
    assert_eq(pattern_capture("/users/:id", "/users/1/extra").status, 404)
    assert_eq(pattern_capture("/a/b", "/a/b").status, 200)
    assert_eq(pattern_capture("/a/b", "/a/c").status, 404)
}

/// Test that wildcard tail.
test "wildcard tail" {
    assert_eq(pattern_capture("/static/*", "/static/css/app.css").status, 200)
    assert_eq(pattern_capture("/static/*", "/static").status, 404)
    assert_eq(pattern_capture("/static/*", "/other/x").status, 404)
}

/// Test that router: hit, 404 and 405.
test "router: hit, 404 and 405" {
    r = Router.new()
    @r.add("GET", "/tasks", 1)
    @r.add("POST", "/tasks", 2)
    @r.add("GET", "/tasks/:id", 3)
    hit = r.match("GET", "/tasks/9?verbose=1")
    assert_eq(hit.status, 200)
    assert_eq(hit.id, 3)
    assert_eq(route_param(hit, "id"), "9")
    assert_eq(r.match("POST", "/tasks").id, 2)
    assert_eq(r.match("DELETE", "/tasks").status, 405)
    assert_eq(r.match("GET", "/nope").status, 404)
}

/// Test that simulate_route maps match status to responses.
test "simulate_route maps match status to responses" {
    r = Router.new()
    @r.add("GET", "/ping", 7)
    assert_eq(r.simulate("GET", "/ping").status, 200)
    assert_eq(r.simulate("GET", "/ping").body, json_encode({route: 7}))
    assert_eq(r.simulate("POST", "/ping").status, 405)
    assert_eq(r.simulate("GET", "/pong").status, 404)
}

/// Test that middleware: bearer auth.
test "middleware: bearer auth" {
    anon = request("GET", "/", "")
    good = req_with_header(anon, "Authorization", "Bearer s3cret")
    bad = req_with_header(anon, "Authorization", "Bearer nope")
    basic = req_with_header(anon, "Authorization", "Basic abc")
    assert_eq(mw_bearer(good) or "none", "s3cret")
    assert_eq(mw_bearer(basic) or "none", "none")
    assert_eq((mw_require_token(good, "s3cret") or ok("pass")).status, 200)
    assert_eq((mw_require_token(anon, "s3cret") or ok("pass")).status, 401)
    assert_eq((mw_require_token(bad, "s3cret") or ok("pass")).status, 401)
}

/// Test that middleware: cors, security, rate limit.
test "middleware: cors, security, rate limit" {
    r = mw_cors(ok(""), "https://app.example")
    assert_eq(header_of(r, "Access-Control-Allow-Origin") or "?", "https://app.example")
    s = mw_security_headers(ok(""))
    assert_eq(header_of(s, "X-Frame-Options") or "?", "DENY")
    assert_eq((mw_rate_limit(5, 10) or ok("pass")).status, 200)
    assert_eq((mw_rate_limit(11, 10) or ok("pass")).status, 429)
}

/// Test that simulate_get / simulate_post compatibility.
test "simulate_get / simulate_post compatibility" {
    assert_eq(simulate_get("/tasks").status, 200)
    assert_eq(simulate_post("/tasks", "x").status, 200)
    assert_eq(simulate_get("tasks").status, 400)
    assert_eq(simulate_post("", "x").status, 400)
}

/// Test that cookies and extra statuses.
test "cookies and extra statuses" {
    c = Cookie.{name: "sid", value: "abc", path: "/", http_only: true, secure: false, max_age: 3600}
    h = set_cookie_header(c)
    #assert(http_len(h) > 10)
    pairs = parse_cookie_header("sid=abc")
    assert_eq(cookie_get(pairs, "sid") or "", "abc")
    assert_eq(multipart_boundary("multipart/form-data" + chr(59) + " boundary=----xyz") or "", "----xyz")
    assert_eq(conflict("x").status, 409)
    assert_eq(gone("x").status, 410)
    assert_eq(unprocessable("x").status, 422)
    assert_eq(unavailable("x").status, 503)
}
/// Test that p3 smoke.
test "p3 smoke" {
    assert_eq(http_unescape("a%20b+c%C3%A9", true) or "?", "a b cé")
    assert_eq(http_unescape("%zz", true) or "bad", "bad")
    assert_eq(http_escape("a b/é"), "a%20b%2F%C3%A9")
    assert_eq(path_escape("/a b/c"), "/a%20b/c")
    p = form_pairs("a=1&b=x%20y&c&a=2")
    assert_eq(pairs_get(p, "b") or "?", "x y")
    assert_eq(pairs_get(p, "c") or "?", "")
    assert_eq(len(pairs_get_all(p, "a")), 2)
    assert_eq(build_query(["q", "a b", "n", "é"]), "q=a%20b&n=%C3%A9")
    assert_eq(query_int("/x?page=3", "page", 1), 3)
    assert_eq(query_int("/x?page=z", "page", 1), 1)
    assert_eq(header_param("form-data; name=\"a b\"; filename=\"x.txt\"", "name"), "a b")
    assert_eq(header_param("form-data; name=\"a b\"; filename=\"x.txt\"", "filename"), "x.txt")
    assert_eq(header_param("text/html; charset=utf-8", "charset"), "utf-8")
    body = multipart_encode("XyZ", ["title", "doc"], ["", "a.txt"], ["", "text/plain"], ["hello", "line1\r\nline2 é"])
    f = multipart_parse(body, "XyZ") or err {
        assert_eq(1, 0)
        return
    }
    assert_eq(mp_get(f, "title") or "?", "hello")
    assert_eq(mp_get(f, "doc") or "?", "line1\r\nline2 é")
    assert_eq(mp_filename(f, "doc"), "a.txt")
    assert_eq(http_date(784111777), "Sun, 06 Nov 1994 08:49:37 GMT")
    assert_eq(parse_http_date("Sun, 06 Nov 1994 08:49:37 GMT"), 784111777)
    c = parse_set_cookie("sid=abc; Path=/a; Domain=.Example.com; Max-Age=60; Secure; HttpOnly; SameSite=Lax") or err {
        assert_eq(1, 0)
        return
    }
    assert_eq(c.domain, "example.com")
    assert_eq(c.max_age, 60)
    assert_eq(c.path, "/a")
    assert_eq(set_cookie_header(c), "sid=abc; Path=/a; Domain=example.com; HttpOnly; Secure; SameSite=Lax; Max-Age=60")
    jar = CookieJar.new(4)
    @jar.store("api.example.com", c, 1000)
    assert_eq(jar.header_for("www.example.com", "/a/b", true, 1010), "sid=abc")
    assert_eq(jar.header_for("www.example.com", "/b", true, 1010), "")
    assert_eq(jar.header_for("www.example.com", "/a", false, 1010), "")
    assert_eq(jar.header_for("www.example.com", "/a", true, 1100), "")
    assert_eq(jar.live(1010), 1)
}

/// Test that p4 smoke.
test "p4 smoke" {
    assert_eq(path_clean("/a/./b//c/../d"), "/a/b/d")
    assert_eq(path_clean("/../../x"), "/x")
    assert_eq(path_clean("/a/b/"), "/a/b/")
    assert_eq(path_clean(""), "/")
    assert_eq(path_clean("/a/.."), "/")
    assert_eq(strip_prefix_path("/api/v1/x", "/api") or "?", "/v1/x")
    assert_eq(mime_for_path("/a/b.CSS"), "text/css; charset=utf-8")
    assert_eq(mime_for_path("/a.b/c"), "application/octet-stream")
    assert_eq(sniff_content_type("<!DOCTYPE html><p>"), "text/html; charset=utf-8")
    assert_eq(sniff_content_type("plain"), "text/plain; charset=utf-8")
    assert_eq(accept_quality("text/html, application/json;q=0.5, */*;q=0.1", "application/json"), 500)
    assert_eq(accept_quality("text/html, */*;q=0.1", "application/json"), 100)
    assert_eq(accept_quality("text/*", "text/plain"), 1000)
    assert_eq(accept_quality("text/html", "image/png"), 0)
    r = req_with_header(request("GET", "/", ""), "Accept", "application/x-protobuf, application/json;q=0.8")
    assert_eq(negotiate(r, ["application/json", "application/x-protobuf"]), "application/x-protobuf")
    #assert(wants_binary(r, "application/x-protobuf"))
    #assert(!(wants_binary(req_with_header(request("GET", "/", ""), "Accept", "*/*"), "application/x-protobuf")))
    ba = req_set_basic_auth(request("GET", "/", ""), "ana", "s3:cret")
    cr = req_basic_auth(ba) or Credentials.{user: "?", password: "?"}
    assert_eq(cr.user, "ana")
    assert_eq(cr.password, "s3:cret")
    sp = parse_range("bytes=2-5", 10)
    assert_eq(sp.status, 206)
    assert_eq(sp.first, 2)
    assert_eq(sp.last, 5)
    assert_eq(parse_range("bytes=-3", 10).first, 7)
    assert_eq(parse_range("bytes=4-", 10).last, 9)
    assert_eq(parse_range("bytes=20-", 10).status, 416)
    assert_eq(parse_range("bytes=0-1,3-4", 10).status, 0)
    et = etag_of("hello")
    gr = req_with_header(request("GET", "/", ""), "If-None-Match", et)
    assert_eq(serve_content(gr, "text/plain", "hello", et, 0).status, 304)
    rr = req_with_header(request("GET", "/", ""), "Range", "bytes=1-3")
    pr = serve_content(rr, "text/plain", "hello", et, 0)
    assert_eq(pr.status, 206)
    assert_eq(header_of(pr, "Content-Range") or "?", "bytes 1-3/5")
    assert_eq(header_of(pr, "Content-Length") or "?", "3")
    assert_eq(serve_content(request("GET", "/", ""), "text/plain", "hello", et, 0).status, 200)
    assert_eq(serve_content(req_with_header(request("PUT", "/", ""), "If-Match", "\"zzz\""), "text/plain", "hello", et, 0).status, 412)
}

/// Test that p5 smoke.
test "p5 smoke" {
    raw = "POST /orders?x=1 HTTP/1.1\r\nHost: a.test\r\ncontent-length: 5\r\nX-Multi: a\r\nX-Multi: b\r\n\r\nhello"
    r = parse_request(raw) or err {
        assert_eq("{err}", "")
        return
    }
    assert_eq(r.method, "POST")
    assert_eq(r.path, "/orders?x=1")
    assert_eq(r.body, "hello")
    assert_eq(req_header(r, "CONTENT-LENGTH") or "?", "5")
    assert_eq(len(req_header_values(r, "x-multi")), 2)
    // truncated body -> need more
    f = frame_request("POST / HTTP/1.1\r\nHost: a\r\nContent-Length: 10\r\n\r\nabc", 4096, 4096)
    assert_eq(f.stage, 1)
    #assert(f.head_ready)
    // pipelined: two requests in one buffer, leftover is the second
    two = "GET /a HTTP/1.1\r\nHost: h\r\n\r\nGET /b HTTP/1.1\r\nHost: h\r\n\r\n"
    f1 = frame_request(two, 4096, 4096)
    assert_eq(f1.stage, 0)
    assert_eq(f1.req.path, "/a")
    rest = socket_buf_slice(two, f1.consumed, socket_buf_len(two))
    f2 = frame_request(rest, 4096, 4096)
    assert_eq(f2.req.path, "/b")
    // chunked body with multi-byte text
    ck = "POST /c HTTP/1.1\r\nHost: h\r\nTransfer-Encoding: chunked\r\n\r\n4\r\nhél\r\n2;ext=1\r\nlo\r\n0\r\n\r\n"
    cr = parse_request(ck) or err {
        assert_eq("{err}", "")
        return
    }
    assert_eq(cr.body, "héllo")
    assert_eq(chunk_decode(chunk_encode("héllo wörld", 4)) or "?", "héllo wörld")
    assert_eq(chunk_frame("abc"), "3\r\nabc\r\n")
    // rejects
    assert_eq(request_error_status("GET / HTTP/1.1\r\n\r\n"), 400)
    assert_eq(request_error_status("GET / HTTP/2.0\r\nHost: h\r\n\r\n"), 505)
    assert_eq(request_error_status("GET / HTTP/1.1\r\nHost: h\r\nContent-Length: 1\r\nContent-Length: 2\r\n\r\nx"), 400)
    assert_eq(request_error_status("POST / HTTP/1.1\r\nHost: h\r\nContent-Length: 1\r\nTransfer-Encoding: chunked\r\n\r\nx"), 400)
    assert_eq(request_error_status("GET / HTTP/1.1\r\nHost: h\r\nBad Name: x\r\n\r\n"), 400)
    assert_eq(request_error_status("GET / HTTP/1.1\r\nHost: h\r\n folded: x\r\n\r\n"), 400)
    assert_eq(request_error_status("POST / HTTP/1.1\r\nHost: h\r\nTransfer-Encoding: gzip\r\n\r\n"), 501)
    big = frame_request("POST / HTTP/1.1\r\nHost: h\r\nContent-Length: 99\r\n\r\n", 4096, 10)
    assert_eq(big.stage, 2)
    assert_eq(error_status(big.why, 0), 413)
    assert_eq(frame_request("GET / HTTP/1.1\r\nHost: h\r\nX: yyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyy", 20, 10).stage, 2)
    // response
    resp = parse_response("HTTP/1.1 201 Created\r\nContent-Type: text/plain\r\nContent-Length: 4\r\nSet-Cookie: a=1\r\nSet-Cookie: b=2\r\n\r\nbody") or err {
        assert_eq("{err}", "")
        return
    }
    assert_eq(resp.status, 201)
    assert_eq(resp.body, "body")
    assert_eq(resp.content_type, "text/plain")
    assert_eq(len(header_values(resp, "set-cookie")), 2)
    assert_eq(render(resp), "HTTP/1.1 201 Created\r\nContent-Type: text/plain\r\nContent-Length: 4\r\nSet-Cookie: a=1\r\nSet-Cookie: b=2\r\n\r\nbody")
    cont = frame_response("HTTP/1.1 100 Continue\r\n\r\nHTTP/1.1 200 OK\r\nContent-Length: 2\r\n\r\nok", false, false, 4096)
    assert_eq(cont.stage, 0)
    assert_eq(cont.res.body, "ok")
    until_close = frame_response("HTTP/1.1 200 OK\r\n\r\nstream", false, false, 4096)
    assert_eq(until_close.stage, 1)
    assert_eq(frame_response("HTTP/1.1 200 OK\r\n\r\nstream", false, true, 4096).res.body, "stream")
    assert_eq(frame_response("HTTP/1.1 304 Not Modified\r\nETag: x\r\n\r\n", false, false, 4096).stage, 0)
    assert_eq(frame_response("HTTP/1.1 200 OK\r\nContent-Length: 9\r\n\r\n", true, false, 4096).stage, 0)
    rq = req_with_header(req_with_header(request("POST", "/p", "{\"a\":1}"), "Host", "h"), "Content-Type", "application/json")
    assert_eq(render_request(rq), "POST /p HTTP/1.1\r\nHost: h\r\nContent-Type: application/json\r\nContent-Length: 7\r\n\r\n\{\"a\":1\}")
    #assert(req_keep_alive(request("GET", "/", "")))
    #assert(!(req_keep_alive(req_with_header(request("GET", "/", ""), "Connection", "Close"))))
    #assert(req_is_websocket(req_with_header(req_with_header(request("GET", "/", ""), "Connection", "keep-alive, Upgrade"), "Upgrade", "WebSocket")))
}

/// Test that p6 router smoke.
test "p6 router smoke" {
    r = Router.new()
    @r.handle("GET /tasks", 1)
    @r.handle("POST /tasks", 2)
    @r.handle(r"GET /tasks/{id}", 3)
    @r.handle("GET /tasks/new", 4)
    @r.handle("/static/", 5)
    @r.handle(r"GET /files/{path...}", 6)
    @r.handle(r"/{$}", 7)
    @r.add("GET", "/old/:a/:b", 8)
    assert_eq(r.match("GET", "/tasks").id, 1)
    assert_eq(r.match("POST", "/tasks").id, 2)
    assert_eq(r.match("GET", "/tasks/new").id, 4)
    hit = r.match("GET", "/tasks/42?x=1")
    assert_eq(hit.id, 3)
    assert_eq(route_param(hit, "id"), "42")
    assert_eq(route_param_int(hit, "id", -1), 42)
    assert_eq(hit.pattern, r"/tasks/{id}")
    assert_eq(r.match("HEAD", "/tasks").id, 1)
    d = r.match("DELETE", "/tasks")
    assert_eq(d.status, 405)
    assert_eq(allow_join(d.allow), "GET, HEAD, POST")
    assert_eq(r.simulate("DELETE", "/tasks").status, 405)
    assert_eq(header_of(r.simulate("DELETE", "/tasks"), "Allow") or "?", "GET, HEAD, POST")
    assert_eq(r.match("GET", "/static/css/app.css").id, 5)
    assert_eq(route_param(r.match("GET", "/static/css/app.css"), "*"), "css/app.css")
    assert_eq(r.match("GET", "/static/").id, 5)
    sl = r.match("GET", "/static")
    assert_eq(sl.status, 301)
    assert_eq(sl.redirect, "/static/")
    assert_eq(route_param(r.match("GET", "/files/a/b%20c.txt"), "path"), "a/b c.txt")
    assert_eq(r.match("GET", "/").id, 7)
    assert_eq(r.match("GET", "/nope").status, 404)
    cl = r.match("GET", "/tasks//7?q=1")
    assert_eq(cl.status, 301)
    assert_eq(cl.redirect, "/tasks/7?q=1")
    assert_eq(r.match("GET", "/a/../tasks").redirect, "/tasks")
    assert_eq(route_param(r.match("GET", "/old/x/y"), "b"), "y")
    assert_eq(r.allowed("/tasks/9"), "GET, HEAD")
    assert_eq(path_value(r, "GET", "/tasks/77", "id"), "77")
    assert_eq(r.size(), 8)
    assert_eq(pattern_capture(r"/a/{x}/b", "/a/1/b").status, 200)
    assert_eq(pattern_capture(r"/a/{x}/b", "/a//b").status, 404)
    assert_eq(pattern_capture("/a/b", "/a/b/c").status, 404)
    assert_eq(pattern_capture("/a/b/c", "/a/b").status, 404)
}

/// Test that p6 middleware smoke.
test "p6 middleware smoke" {
    anon = request("GET", "/", "")
    #assert(secure_eq("abc", "abc"))
    #assert(!(secure_eq("abc", "abd")))
    #assert(!(secure_eq("abc", "abcd")))
    ba = req_set_basic_auth(anon, "ana", "pw")
    assert_eq((mw_basic_auth(ba, "ana", "pw", "api") or ok("pass")).status, 200)
    bad = mw_basic_auth(ba, "ana", "nope", "api") or ok("pass")
    assert_eq(bad.status, 401)
    assert_eq(header_of(bad, "WWW-Authenticate") or "?", "Basic realm=\"api\", charset=\"UTF-8\"")
    assert_eq((mw_basic_auth(anon, "ana", "pw", "api") or ok("pass")).status, 401)
    pre = req_with_header(req_with_header(req_with_header(request("OPTIONS", "/x", ""), "Origin", "https://app.test"), "Access-Control-Request-Method", "POST"), "Access-Control-Request-Headers", "x-token")
    pr = mw_cors_preflight(pre, ["https://app.test"], "GET, POST", "", 600) or ok("none")
    assert_eq(pr.status, 204)
    assert_eq(header_of(pr, "Access-Control-Allow-Origin") or "?", "https://app.test")
    assert_eq(header_of(pr, "Access-Control-Allow-Headers") or "?", "x-token")
    assert_eq(header_of(pr, "Access-Control-Max-Age") or "?", "600")
    assert_eq((mw_cors_preflight(pre, ["https://other.test"], "GET", "", 0) or ok("none")).status, 403)
    assert_eq((mw_cors_preflight(anon, ["*"], "GET", "", 0) or ok("none")).status, 200)
    simple = req_with_header(request("GET", "/x", ""), "Origin", "https://app.test")
    cr = mw_cors_headers(simple, ok("{}"), ["https://app.test"], true)
    assert_eq(header_of(cr, "Access-Control-Allow-Credentials") or "?", "true")
    assert_eq(header_of(cr, "Vary") or "?", "Origin")
    assert_eq(header_of(mw_cors_headers(simple, ok("{}"), ["https://x.test"], true), "Access-Control-Allow-Origin") or "none", "none")
    assert_eq(header_of(mw_hsts(ok(""), 31536000, true), "Strict-Transport-Security") or "?", "max-age=31536000; includeSubDomains")
    tls = mw_https_redirect(req_with_header(request("GET", "/a?b=1", ""), "Host", "x.test")) or ok("none")
    assert_eq(tls.status, 308)
    assert_eq(header_of(tls, "Location") or "?", "https://x.test/a?b=1")
    assert_eq((mw_https_redirect(req_with_header(req_with_header(request("GET", "/", ""), "Host", "x.test"), "X-Forwarded-Proto", "https")) or ok("none")).status, 200)
    assert_eq((mw_strip_trailing_slash(request("GET", "/a/b/?q=1", "")) or ok("none")).status, 301)
    assert_eq(header_of(mw_strip_trailing_slash(request("GET", "/a/b/?q=1", "")) or ok("none"), "Location") or "?", "/a/b?q=1")
    assert_eq((mw_strip_trailing_slash(request("GET", "/", "")) or ok("none")).status, 200)
    assert_eq((mw_require_method(anon, ["GET", "POST"]) or ok("pass")).status, 200)
    m405 = mw_require_method(request("PUT", "/", ""), ["GET", "POST"]) or ok("pass")
    assert_eq(m405.status, 405)
    assert_eq(header_of(m405, "Allow") or "?", "GET, HEAD, POST")
    js = req_with_header(request("POST", "/", "{}"), "Content-Type", "Application/JSON; charset=utf-8")
    assert_eq((mw_require_json(js) or ok("pass")).status, 200)
    assert_eq((mw_require_json(request("POST", "/", "x=1")) or ok("pass")).status, 415)
    assert_eq((mw_max_body(request("POST", "/", "12345"), 4) or ok("pass")).status, 413)
    assert_eq((mw_max_body(request("POST", "/", "123"), 4) or ok("pass")).status, 200)
    tagged = mw_etag(request("GET", "/", ""), ok("hello"))
    tag = header_of(tagged, "ETag") or ""
    assert_eq(tag, etag_of("hello"))
    again = mw_etag(req_with_header(request("GET", "/", ""), "If-None-Match", tag), ok("hello"))
    assert_eq(again.status, 304)
    assert_eq(req_header(mw_request_id(anon, 255), "X-Request-Id") or "?", "00000000000000ff")
    assert_eq(req_header(mw_request_id(req_with_header(anon, "X-Request-Id", "abc"), 255), "X-Request-Id") or "?", "abc")
    assert_eq(mw_log_line(request("GET", "/a?b=1", ""), ok("hello"), 340), "GET /a 200 5B 340us")
    assert_eq((mw_timeout(100, 150, 100) or ok("pass")).status, 200)
    assert_eq((mw_timeout(100, 250, 100) or ok("pass")).status, 503)
    fwd = req_with_header(request("GET", "/", ""), "X-Forwarded-For", "203.0.113.9, 10.0.0.1")
    assert_eq(req_client_ip(fwd), "203.0.113.9")
    direct = request("GET", "/", "")
    direct.remote_addr = "198.51.100.4:51234"
    assert_eq(req_client_ip(direct), "198.51.100.4")
    direct.remote_addr = "[::1]:80"
    assert_eq(req_client_ip(direct), "::1")
}

/// Test that p6 rate limiter.
test "p6 rate limiter" {
    lim = RateLimiter.new(16, 2, 3)
    #assert(@lim.allow("a", 0))
    #assert(@lim.allow("a", 0))
    #assert(@lim.allow("a", 0))
    #assert(!(@lim.allow("a", 0)))
    assert_eq(lim.retry_after_ms("a", 0), 500)
    #assert(@lim.allow("a", 500))
    #assert(!(@lim.allow("a", 500)))
    assert_eq(lim.remaining("a", 10000), 3)
    r = @lim.check("a", 500) or ok("pass")
    assert_eq(r.status, 429)
    assert_eq(header_of(r, "Retry-After") or "?", "1")
    assert_eq((@lim.check("zz", 0) or ok("pass")).status, 200)
}

test "serve config applies stack-only limits" {
    config = ServeConfig.defaults()
    config = @config
        .read_timeout(100)
        .write_timeout(200)
        .idle_timeout(300)
        .header_limit(4096)
        .body_limit(8192)
        .keep_alive_limit(16)
    assert_eq(config.read_timeout_ms, 100)
    assert_eq(config.write_timeout_ms, 200)
    assert_eq(config.idle_timeout_ms, 300)
    assert_eq(config.max_header_bytes, 4096)
    assert_eq(config.max_body_bytes, 8192)
    assert_eq(config.max_requests, 16)
}

// --- sockets: server + client over loopback (single thread: phases interleave) ------------------------

/// Test HTTP server bound to a local port.
t_server() : Server => Server.listen("127.0.0.1:0") or Server.{fd: -1, addr: "", read_timeout_ms: 0, write_timeout_ms: 0, idle_timeout_ms: 0, max_header_bytes: 0, max_body_bytes: 0, max_requests: 0, closed: true, why: ""}

/// Test HTTP client pointed at `t_server`.
t_client() : Client {
    c = Client.new()
    c.timeout_ms = 200
    c
}

/// Test connection that is already closed.
t_dead_conn() : Conn => Conn.{fd: -1, buf: [], remote: "", served: 0, open: false, keep: false, detached: false, sent_continue: false, read_timeout_ms: 0, write_timeout_ms: 0, idle_timeout_ms: 0, max_header_bytes: 0, max_body_bytes: 0, max_requests: 0, why: ""}

/// T url (`srv`, `path`). Returns `str`.
t_url(srv: Server, path: str) : str => "http://{srv.addr}{path}"

/// A raw TCP client for malformed-input tests.
t_raw(srv: Server) : i64 => socket_tcp_connect(srv.addr) or -1

/// T read all (`fd`). Returns `str`.
t_read_all(fd: i64) : str {
    socket_set_timeout(fd, 200, 0) or false
    out = ""
    for 0..64 {
        chunk = socket_tcp_read(fd, 4096) or socket_buf_slice("", 0, 0)
        if socket_buf_len(chunk) > 0 { out = out + socket_buf_text(chunk) }
        if socket_buf_len(chunk) == 0 { break }
    }
    out
}

/// Test that loopback: GET, keep-alive reuse, HEAD and Connection: close.
test "loopback: GET, keep-alive reuse, HEAD and Connection: close" {
    srv = t_server()
    if srv.fd < 0 { return }
    c = t_client()
    call = @c.start("GET", t_url(srv, "/hello?x=1"), ["X-Token", "abc"], "")
    #assert(call_ok(call))
    conn = @srv.accept() or t_dead_conn()
    req = @conn.read_request() or request("", "", "")
    assert_eq(req.method, "GET")
    assert_eq(req.path, "/hello?x=1")
    assert_eq(req_host(req), srv.addr)
    assert_eq(req_header(req, "x-token") or "?", "abc")
    assert_eq(req_user_agent(req), "super-http/0.1")
    #assert(req.remote_addr != "")
    #assert(conn.keep)
    sent = @conn.write_response(req, with_header(text("hi there"), "X-Served", "1")) or -1
    #assert(sent > 0)
    ex = @c.finish(call)
    assert_eq(ex.res.status, 200)
    assert_eq(ex.res.body, "hi there")
    assert_eq(ex.res.content_type, "text/plain")
    assert_eq(header_of(ex.res, "X-Served") or "?", "1")
    #assert(has_header(ex.res, "Date"))
    assert_eq(c.idle_count(), 1)

    // Second request reuses the pooled connection; the server sees served == 2 on the same Conn.
    call2 = @c.start("HEAD", t_url(srv, "/head"), [], "")
    #assert(call2.reused)
    req2 = @conn.read_request() or request("", "", "")
    assert_eq(req2.method, "HEAD")
    assert_eq(conn.served, 2)
    @conn.write_response(req2, ok("0123456789")) or -1
    ex2 = @c.finish(call2)
    assert_eq(ex2.res.status, 200)
    assert_eq(ex2.res.body, "")
    assert_eq(c.idle_count(), 1)

    // Connection: close ends the connection after the response.
    call3 = @c.start("GET", t_url(srv, "/bye"), ["Connection", "close"], "")
    req3 = @conn.read_request() or request("", "", "")
    #assert(!(conn.keep))
    @conn.write_response(req3, ok("bye")) or -1
    #assert(!(conn.open))
    ex3 = @c.finish(call3)
    assert_eq(ex3.res.body, "bye")
    assert_eq(header_of(ex3.res, "Connection") or "?", "close")
    assert_eq(c.idle_count(), 0)
    assert_eq(@c.close_idle(), 0)
    #assert(@srv.shutdown())
    #assert(!(@srv.shutdown()))
}

/// Test that loopback: POST JSON body, 404 router path and binary response.
test "loopback: POST JSON body, 404 router path and binary response" {
    srv = t_server()
    if srv.fd < 0 { return }
    c = t_client()
    router = Router.new()
    @router.handle("POST /orders", 1)
    @router.handle("GET /blob", 2)
    call = @c.start("POST", t_url(srv, "/orders"), ["Content-Type", HTTP_JSON, "Accept", HTTP_JSON], "\{\"item\":\"é\",\"qty\":2\}")
    conn = @srv.accept() or t_dead_conn()
    req = @conn.read_request() or request("", "", "")
    m = router.match(req.method, req.path)
    assert_eq(m.id, 1)
    assert_eq(req.body, "\{\"item\":\"é\",\"qty\":2\}")
    assert_eq(req_content_length(req), req.body.len)
    #assert(wants_json(req))
    @conn.write_response(req, json_status(201, "\{\"order_id\":9001\}")) or -1
    ex = @c.finish(call)
    assert_eq(ex.res.status, 201)
    assert_eq(ex.res.body, "\{\"order_id\":9001\}")

    // Missing route -> 404 handled by the caller; unknown method on a known path -> 405 + Allow.
    call2 = @c.start("DELETE", t_url(srv, "/orders"), [], "")
    req2 = @conn.read_request() or request("", "", "")
    m2 = router.match(req2.method, req2.path)
    assert_eq(m2.status, 405)
    @conn.write_response(req2, with_header(method_not_allowed(""), "Allow", allow_join(m2.allow))) or -1
    ex2 = @c.finish(call2)
    assert_eq(ex2.res.status, 405)
    assert_eq(header_of(ex2.res, "Allow") or "?", "POST")

    // Binary payload goes out byte-exact (Content-Length from the byte count) and framed for the client.
    call3 = @c.start("GET", t_url(srv, "/blob"), ["Accept", "application/x-protobuf"], "")
    req3 = @conn.read_request() or request("", "", "")
    #assert(wants_binary(req3, "application/x-protobuf"))
    payload = socket_octets("proto-é")
    @conn.write_response(req3, binary(200, "application/x-protobuf", payload)) or -1
    ex3 = @c.finish(call3)
    assert_eq(ex3.res.status, 200)
    assert_eq(ex3.res.content_type, "application/x-protobuf")
    assert_eq(ex3.res.body, "proto-é")
    @conn.close()
    @c.close_idle()
    @srv.shutdown()
}

/// Test that loopback: redirects (302 -> GET, 307 keeps method and body, cross-host drops credentials).
test "loopback: redirects (302 -> GET, 307 keeps method and body, cross-host drops credentials)" {
    srv = t_server()
    if srv.fd < 0 { return }
    c = t_client()
    call = @c.start("POST", t_url(srv, "/old"), ["Authorization", "Bearer s3", "Content-Type", "text/plain"], "payload")
    conn = @srv.accept() or t_dead_conn()
    req = @conn.read_request() or request("", "", "")
    @conn.write_response(req, redirect("/new?a=1")) or -1
    ex = @c.finish(call)
    assert_eq(ex.res.status, 302)
    assert_eq(ex.call.next_url, t_url(srv, "/new?a=1"))
    assert_eq(ex.call.next_method, "GET")
    hop = @c.follow(ex.call)
    #assert(call_ok(hop))
    assert_eq(hop.hops, 1)
    req2 = @conn.read_request() or request("", "", "")
    assert_eq(req2.method, "GET")
    assert_eq(req2.path, "/new?a=1")
    assert_eq(req2.body, "")
    assert_eq(req_header(req2, "Authorization") or "none", "Bearer s3")
    #assert(!(req_has_header(req2, "Content-Type")))
    @conn.write_response(req2, redirect_with(307, "/again")) or -1
    ex2 = @c.finish(hop)
    assert_eq(ex2.call.next_method, "GET")
    hop2 = @c.follow(ex2.call)
    req3 = @conn.read_request() or request("", "", "")
    assert_eq(req3.path, "/again")
    @conn.write_response(req3, ok("done")) or -1
    ex3 = @c.finish(hop2)
    assert_eq(ex3.res.body, "done")
    assert_eq(ex3.call.next_url, "")
    assert_eq(ex3.call.hops, 2)

    // 307 replays the POST body.
    callp = @c.start("POST", t_url(srv, "/p"), ["Content-Type", "text/plain"], "again")
    reqp = @conn.read_request() or request("", "", "")
    @conn.write_response(reqp, redirect_with(307, "/q")) or -1
    exp = @c.finish(callp)
    assert_eq(exp.call.next_method, "POST")
    hopp = @c.follow(exp.call)
    reqq = @conn.read_request() or request("", "", "")
    assert_eq(reqq.method, "POST")
    assert_eq(reqq.body, "again")
    @conn.write_response(reqq, ok("ok")) or -1
    assert_eq((@c.finish(hopp)).res.status, 200)

    // Cross-host redirect strips Authorization.
    callx = @c.start("GET", t_url(srv, "/x"), ["Authorization", "Bearer s3"], "")
    reqx = @conn.read_request() or request("", "", "")
    @conn.write_response(reqx, redirect_with(301, "http://localhost:{srv.port()}/y")) or -1
    exx = @c.finish(callx)
    hopx = @c.follow(exx.call)
    if hopx.fd >= 0 {
        conn2 = @srv.accept() or t_dead_conn()
        reqy = @conn2.read_request() or request("", "", "")
        assert_eq(reqy.path, "/y")
        #assert(!(req_has_header(reqy, "Authorization")))
        @conn2.write_response(reqy, ok("y")) or -1
        assert_eq((@c.finish(hopx)).res.body, "y")
        @conn2.close()
    }

    c_err = t_client()
    c_err.redirect_policy = "error"
    call_err = @c_err.start("GET", t_url(srv, "/e1"), [], "")
    conne = @srv.accept() or t_dead_conn()
    reqe = @conne.read_request() or request("", "", "")
    @conne.write_response(reqe, redirect_with(301, "/e2")) or -1
    exe = @c_err.finish(call_err)
    assert_eq(exe.call.next_url, "")
    assert_eq(exe.res.status, 301)

    // Redirect limit.
    c2 = t_client()
    c2.max_redirects = 1
    callr = @c2.start("GET", t_url(srv, "/r1"), [], "")
    connr = @srv.accept() or t_dead_conn()
    reqr = @connr.read_request() or request("", "", "")
    @connr.write_response(reqr, redirect("/r2")) or -1
    exr = @c2.finish(callr)
    hopr = @c2.follow(exr.call)
    reqr2 = @connr.read_request() or request("", "", "")
    @connr.write_response(reqr2, redirect("/r3")) or -1
    exr2 = @c2.finish(hopr)
    assert_eq(exr2.res.status, 0)
    assert_eq(c2.why, "stopped after 1 redirects")
    @conn.close()
    @connr.close()
    @c.close_idle()
    @c2.close_idle()
    @srv.shutdown()
}

/// Test that loopback: cookie jar round trip.
test "loopback: cookie jar round trip" {
    srv = t_server()
    if srv.fd < 0 { return }
    c = t_client()
    call = @c.start("GET", t_url(srv, "/login"), [], "")
    conn = @srv.accept() or t_dead_conn()
    req = @conn.read_request() or request("", "", "")
    #assert(!(req_has_header(req, "Cookie")))
    res = with_cookie(ok("in"), cookie_session("sid", "abc123", 600))
    @conn.write_response(req, res) or -1
    ex = @c.finish(call)
    assert_eq(ex.res.status, 200)
    assert_eq(c.jar.live(http_now()), 1)
    call2 = @c.start("GET", t_url(srv, "/me"), [], "")
    req2 = @conn.read_request() or request("", "", "")
    // Secure cookies are not sent over plain http.
    assert_eq(req_cookie(req2, "sid") or "none", "none")
    @conn.write_response(req2, ok("anon")) or -1
    @c.finish(call2)
    plain = with_cookie(ok("x"), cookie_new("theme", "dark"))
    call3 = @c.start("GET", t_url(srv, "/theme"), [], "")
    req3 = @conn.read_request() or request("", "", "")
    @conn.write_response(req3, plain) or -1
    @c.finish(call3)
    call4 = @c.start("GET", t_url(srv, "/next"), [], "")
    req4 = @conn.read_request() or request("", "", "")
    assert_eq(req_cookie(req4, "theme") or "none", "dark")
    @conn.write_response(req4, ok("ok")) or -1
    @c.finish(call4)
    @conn.close()
    @c.close_idle()
    @srv.shutdown()
}

/// Test that loopback: chunked streaming, SSE and hijack.
test "loopback: chunked streaming, SSE and hijack" {
    srv = t_server()
    if srv.fd < 0 { return }
    c = t_client()
    call = @c.start("GET", t_url(srv, "/stream"), [], "")
    conn = @srv.accept() or t_dead_conn()
    req = @conn.read_request() or request("", "", "")
    @conn.begin_stream(text("")) or -1
    @conn.write_chunk("héllo ") or -1
    @conn.write_chunk("stream") or -1
    @conn.end_stream() or -1
    ex = @c.finish(call)
    assert_eq(ex.res.status, 200)
    assert_eq(ex.res.body, "héllo stream")
    assert_eq(req.method, "GET")

    call2 = @c.start("GET", t_url(srv, "/events"), [], "")
    req2 = @conn.read_request() or request("", "", "")
    @conn.begin_sse() or -1
    @conn.write_event("tick", "a\nb", "7") or -1
    @conn.write_event("", "plain", "") or -1
    @conn.end_stream() or -1
    ex2 = @c.finish(call2)
    assert_eq(ex2.res.content_type, "text/event-stream")
    assert_eq(ex2.res.body, "event: tick\ndata: a\ndata: b\nid: 7\n\ndata: plain\n\n")
    assert_eq(req2.path, "/events")

    // Upgrade request: hijack hands back the raw fd and any bytes already buffered.
    ws = req_with_header(req_with_header(request("GET", "/ws", ""), "Connection", "Upgrade"), "Upgrade", "websocket")
    #assert(req_is_websocket(ws))
    call3 = @c.start("GET", t_url(srv, "/ws"), ["Connection", "Upgrade", "Upgrade", "websocket"], "")
    req3 = @conn.read_request() or request("", "", "")
    #assert(req_is_websocket(req3))
    fd = @conn.hijack()
    #assert(fd >= 0)
    #assert(!(conn.open))
    #assert(!(@conn.close()))
    socket_tcp_write(fd, "HTTP/1.1 101 Switching Protocols\r\nUpgrade: websocket\r\nConnection: Upgrade\r\n\r\n") or -1
    ex3 = @c.finish(call3)
    assert_eq(ex3.res.status, 101)
    socket_fd_close(fd)
    @c.close_idle()
    @srv.shutdown()
}

/// Test that loopback: protocol errors and limits answered by the server.
test "loopback: protocol errors and limits answered by the server" {
    srv = t_server()
    if srv.fd < 0 { return }
    srv.read_timeout_ms = 200
    srv.max_body_bytes = 8
    srv.max_header_bytes = 256

    // Malformed request line -> 400 written, read_request fails with the reason.
    raw = t_raw(srv)
    conn = @srv.accept() or t_dead_conn()
    socket_tcp_write(raw, "BROKEN\r\n\r\n") or -1
    bad = @conn.read_request() or request("", "", "")
    assert_eq(bad.method, "")
    assert_eq(error_status(conn.why, 0), 400)
    #assert(!(conn.open))
    answer = t_read_all(raw)
    #assert(http_starts_with(answer, "HTTP/1.1 400 Bad Request"))
    #assert(http_index_of(answer, "Connection: close", 0) > 0)
    socket_fd_close(raw)

    // Body over the limit -> 413 before the body is read.
    raw2 = t_raw(srv)
    conn2 = @srv.accept() or t_dead_conn()
    socket_tcp_write(raw2, "POST /u HTTP/1.1\r\nHost: h\r\nContent-Length: 100\r\n\r\n") or -1
    @conn2.read_request() or request("", "", "")
    assert_eq(error_status(conn2.why, 0), 413)
    #assert(http_starts_with(t_read_all(raw2), "HTTP/1.1 413"))
    socket_fd_close(raw2)

    // Header block over the limit -> 431.
    raw3 = t_raw(srv)
    conn3 = @srv.accept() or t_dead_conn()
    big = repeat("a", 400)
    socket_tcp_write(raw3, "GET / HTTP/1.1\r\nHost: h\r\nX-Big: {big}\r\n\r\n") or -1
    @conn3.read_request() or request("", "", "")
    assert_eq(error_status(conn3.why, 0), 431)
    socket_fd_close(raw3)

    // Slow client: partial head then silence -> 408 after the read timeout.
    raw4 = t_raw(srv)
    conn4 = @srv.accept() or t_dead_conn()
    socket_tcp_write(raw4, "GET / HTTP/1.1\r\nHo") or -1
    @conn4.read_request() or request("", "", "")
    assert_eq(conn4.why, "timeout")
    #assert(http_starts_with(t_read_all(raw4), "HTTP/1.1 408"))
    socket_fd_close(raw4)

    // Idle connection that never sends: closed quietly (no reply), EOF reported for a peer close.
    raw5 = t_raw(srv)
    conn5 = @srv.accept() or t_dead_conn()
    socket_fd_close(raw5)
    @conn5.read_request() or request("", "", "")
    assert_eq(conn5.why, "eof")

    // Expect: 100-continue gets its interim reply while the body is outstanding (here it never
    // arrives, so the read timeout then produces the 408).
    raw6 = t_raw(srv)
    conn6 = @srv.accept() or t_dead_conn()
    socket_tcp_write(raw6, "POST /e HTTP/1.1\r\nHost: h\r\nContent-Length: 4\r\nExpect: 100-continue\r\n\r\n") or -1
    @conn6.read_request() or request("", "", "")
    assert_eq(conn6.why, "timeout")
    got = t_read_all(raw6)
    #assert(http_starts_with(got, "HTTP/1.1 100 Continue\r\n\r\nHTTP/1.1 408 Request Timeout"))
    socket_fd_close(raw6)

    // Pipelining: two requests in one write are served in order from the same buffer.
    raw7 = t_raw(srv)
    conn7 = @srv.accept() or t_dead_conn()
    socket_tcp_write(raw7, "GET /1 HTTP/1.1\r\nHost: h\r\n\r\nGET /2 HTTP/1.1\r\nHost: h\r\n\r\n") or -1
    p1 = @conn7.read_request() or request("", "", "")
    p2 = @conn7.read_request() or request("", "", "")
    assert_eq(p1.path, "/1")
    assert_eq(p2.path, "/2")
    assert_eq(conn7.served, 2)
    socket_fd_close(raw7)
    @conn.close()
    @conn2.close()
    @conn3.close()
    @conn4.close()
    @conn5.close()
    @conn6.close()
    @conn7.close()
    @srv.shutdown()
}

/// Test that client failures are values, not hangs.
test "client failures are values, not hangs" {
    c = t_client()
    #assert(!(call_ok(@c.start("GET", "not a url", [], ""))))
    assert_eq(c.why, "bad url: not a url")
    #assert(!(call_ok(@c.start("GET", "https://example.test/", [], ""))))
    #assert(http_starts_with(c.why, ""))
    assert_eq((@c.get("ftp://x/") or failed_response()).status, 0)
    srv = t_server()
    if srv.fd < 0 { return }
    addr = srv.addr
    @srv.shutdown()
    #assert(!(call_ok(@c.start("GET", "http://{addr}/", [], ""))))
    #assert(http_starts_with(c.why, "dial"))
    // Timeout: server accepts but never answers.
    srv2 = t_server()
    c.timeout_ms = 150
    call = @c.start("GET", t_url(srv2, "/slow"), [], "")
    conn = @srv2.accept() or t_dead_conn()
    ex = @c.finish(call)
    assert_eq(ex.res.status, 0)
    assert_eq(c.why, "timeout")
    @conn.close()
    @srv2.shutdown()
}

// --- constants, status table, token and header helpers -----------------------------------------------

/// Test that status table covers every registered code and classifies by class.
test "status table covers every registered code and classifies by class" {
    assert_eq(status_text(100), "Continue")
    assert_eq(status_text(101), "Switching Protocols")
    assert_eq(status_text(103), "Early Hints")
    assert_eq(status_text(202), "Accepted")
    assert_eq(status_text(206), "Partial Content")
    assert_eq(status_text(207), "Multi-Status")
    assert_eq(status_text(301), "Moved Permanently")
    assert_eq(status_text(303), "See Other")
    assert_eq(status_text(304), "Not Modified")
    assert_eq(status_text(307), "Temporary Redirect")
    assert_eq(status_text(308), "Permanent Redirect")
    assert_eq(status_text(402), "Payment Required")
    assert_eq(status_text(406), "Not Acceptable")
    assert_eq(status_text(408), "Request Timeout")
    assert_eq(status_text(409), "Conflict")
    assert_eq(status_text(410), "Gone")
    assert_eq(status_text(411), "Length Required")
    assert_eq(status_text(412), "Precondition Failed")
    assert_eq(status_text(413), "Payload Too Large")
    assert_eq(status_text(414), "URI Too Long")
    assert_eq(status_text(415), "Unsupported Media Type")
    assert_eq(status_text(416), "Range Not Satisfiable")
    assert_eq(status_text(417), "Expectation Failed")
    assert_eq(status_text(418), "I'm a teapot")
    assert_eq(status_text(422), "Unprocessable Entity")
    assert_eq(status_text(425), "Too Early")
    assert_eq(status_text(428), "Precondition Required")
    assert_eq(status_text(431), "Request Header Fields Too Large")
    assert_eq(status_text(451), "Unavailable For Legal Reasons")
    assert_eq(status_text(501), "Not Implemented")
    assert_eq(status_text(502), "Bad Gateway")
    assert_eq(status_text(504), "Gateway Timeout")
    assert_eq(status_text(505), "HTTP Version Not Supported")
    assert_eq(status_text(511), "Network Authentication Required")
    assert_eq(status_text(299), "Unknown")
    assert_eq(status_text(0), "Unknown")
    assert_eq(status_text(-5), "Unknown")
    #assert(status_is_informational(101))
    #assert(status_is_success(204))
    #assert(status_is_redirect(302))
    #assert(status_is_client_error(404))
    #assert(status_is_server_error(503))
    #assert(!(status_is_server_error(404)))
    #assert(status_has_body(200))
    #assert(!(status_has_body(204)))
    #assert(!(status_has_body(304)))
    #assert(!(status_has_body(100)))
    #assert(status_follows_location(301))
    #assert(!(status_follows_location(300)))
    #assert(!(status_follows_location(305)))
    assert_eq(STATUS_OK, 200)
    assert_eq(STATUS_TEAPOT, 418)
    assert_eq(METHOD_PATCH, "PATCH")
    assert_eq(error_status("431 too large", 0), 431)
    assert_eq(error_status("oops", 500), 500)
    assert_eq(error_status("99 x", 7), 7)
    assert_eq(error_message("413 request body too large"), "request body too large")
    assert_eq(error_message("plain"), "plain")
}

/// Test that tokens, case folding and canonical header names.
test "tokens, case folding and canonical header names" {
    #assert(http_is_token("Content-Type"))
    #assert(!(http_is_token("bad name")))
    #assert(!(http_is_token("bad:name")))
    #assert(!(http_is_token("")))
    assert_eq(http_lower("AbC-9"), "abc-9")
    assert_eq(http_lower("already"), "already")
    #assert(http_ieq("ETag", "etag"))
    #assert(!(http_ieq("ETag", "etags")))
    assert_eq(canonical_header("content-type"), "Content-Type")
    assert_eq(canonical_header("CONTENT-LENGTH"), "Content-Length")
    assert_eq(canonical_header("x-requested-with"), "X-Requested-With")
    assert_eq(canonical_header("etag"), "Etag")
    assert_eq(canonical_header("bad header"), "bad header")
    assert_eq(http_trim(" \t x y \t"), "x y")
    assert_eq(http_trim(""), "")
    assert_eq(http_index_of("hello world", "o w", 0), 4)
    assert_eq(http_index_of("hello", "z", 0), -1)
    assert_eq(http_index_of("a,b,c", ",", 2), 3)
    #assert(http_starts_with("abc", "ab"))
    #assert(!(http_starts_with("a", "ab")))
    #assert(http_ends_with("abc", "bc"))
    #assert(!(http_ends_with("c", "bc")))
    assert_eq(http_parse_uint("0042"), 42)
    assert_eq(http_parse_uint("-1"), -1)
    assert_eq(http_parse_uint("12a"), -1)
    assert_eq(http_parse_uint(""), -1)
    assert_eq(http_parse_uint("1234567890123456"), -1)
    assert_eq(http_parse_hex("ff"), 255)
    assert_eq(http_parse_hex("1A"), 26)
    assert_eq(http_parse_hex("xyz"), -1)
    assert_eq(http_hex(0, 1), "0")
    assert_eq(http_hex(4095, 1), "fff")
    assert_eq(http_hex(5, 4), "0005")
    assert_eq(http_hex_value("a"), 10)
    assert_eq(http_hex_value("G"), -1)
}

/// Test that the allocation-free header helpers keep exact semantics.
test "header helpers: has_upper, ieq, canonical fast path, early-exit lookup" {
    #assert(!(http_has_upper("abc-9")))
    #assert(!(http_has_upper("")))
    #assert(http_has_upper("abC"))
    #assert(http_has_upper("Abc"))
    #assert(http_ieq("Content-Type", "content-type"))
    #assert(http_ieq("CONTENT-TYPE", "content-type"))
    #assert(!(http_ieq("Content-Type", "Content-Typf")))
    #assert(!(http_ieq("Host", "Hosts")))
    #assert(http_ieq("", ""))
    #assert(!(http_ieq("a", "")))
    assert_eq(canonical_header("Content-Type"), "Content-Type")
    assert_eq(canonical_header("X-Request-Id"), "X-Request-Id")
    assert_eq(canonical_header("x-request-ID"), "X-Request-Id")
    assert_eq(canonical_header(""), "")
    assert_eq(canonical_header("Bad Name"), "Bad Name")
    r = request("GET", "/", "")
    r = req_with_header(r, "x-trace", "first")
    r = req_with_header(r, "X-Trace", "second")
    assert_eq(req_header(r, "X-TRACE") or "", "first")
    assert_eq(req_header(r, "x-missing") or "none", "none")
    assert_eq(len(req_header_values(r, "x-trace")), 2)
}

/// Test that request heads count Host once and reject lower-case methods.
test "request head: host counting and method case" {
    ok = parse_request_head("GET /a HTTP/1.1\r\nHost: x\r\nX-A: 1\r\n\r\n") or request("BAD", "", "")
    assert_eq(ok.method, "GET")
    assert_eq(req_header(ok, "host") or "", "x")
    dup = parse_request_head("GET /a HTTP/1.1\r\nHost: x\r\nhost: y\r\n\r\n") or request("BAD", "", "")
    assert_eq(dup.method, "BAD")
    none_host = parse_request_head("GET /a HTTP/1.1\r\nX-A: 1\r\n\r\n") or request("BAD", "", "")
    assert_eq(none_host.method, "BAD")
    lower = parse_request_head("get /a HTTP/1.1\r\nHost: x\r\n\r\n") or request("BAD", "", "")
    assert_eq(lower.method, "BAD")
    h10 = parse_request_head("GET /a HTTP/1.0\r\n\r\n") or request("BAD", "", "")
    assert_eq(h10.method, "GET")
}

/// Test that router lookups stay correct without eager miss allocation.
test "router: capture hit and miss paths" {
    hit = pattern_capture("/users/:id", "/users/42")
    assert_eq(hit.status, 200)
    assert_eq(route_param(hit, "id"), "42")
    assert_eq(pattern_capture("/users/:id", "/users/").status, 404)
    assert_eq(pattern_capture("/users/:id", "/posts/42").status, 404)
    assert_eq(pattern_capture("/a/b", "/a/b/c").status, 404)
    assert_eq(pattern_capture("", "/a").status, 404)
    assert_eq(pattern_capture("/files/*", "/files/x/y").status, 200)
}

/// Test that header injection is neutralised and invalid names are ignored.
test "header injection is neutralised and invalid names are ignored" {
    evil = "ok\r\nSet-Cookie: pwned=1"
    assert_eq(header_value_clean(evil), "okSet-Cookie: pwned=1")
    #assert(!(header_valid_value(evil)))
    #assert(header_valid_value("fine value"))
    r = with_header(ok("x"), "X-A", evil)
    assert_eq(len(header_values(r, "Set-Cookie")), 0)
    assert_eq(header_of(r, "X-A") or "?", "okSet-Cookie: pwned=1")
    assert_eq(render(r), "HTTP/1.1 200 OK\r\nContent-Type: application/json\r\nContent-Length: 1\r\nX-A: okSet-Cookie: pwned=1\r\n\r\nx")
    bad = with_header(ok("x"), "Bad Name", "v")
    assert_eq(len(bad.headers), 0)
    loc = redirect("/a\r\nX-Evil: 1")
    assert_eq(header_of(loc, "Location") or "?", "/aX-Evil: 1")
    q = req_with_header(request("GET", "/", ""), "X-In", "a\nb")
    assert_eq(req_header(q, "X-In") or "?", "ab")
}

