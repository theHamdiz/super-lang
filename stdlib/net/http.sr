/// Test that response constructors and shortcuts.
test "response constructors and shortcuts" {
    assert_eq(accepted("x").status, 202)
    assert_eq(not_acceptable("x").status, 406)
    assert_eq(request_timeout("x").status, 408)
    assert_eq(length_required("x").status, 411)
    assert_eq(precondition_failed("x").status, 412)
    assert_eq(payload_too_large("x").status, 413)
    assert_eq(uri_too_long("x").status, 414)
    assert_eq(unsupported_media_type("x").status, 415)
    assert_eq(teapot("x").status, 418)
    assert_eq(precondition_required("x").status, 428)
    assert_eq(header_fields_too_large("x").status, 431)
    assert_eq(not_implemented("x").status, 501)
    assert_eq(bad_gateway("x").status, 502)
    assert_eq(gateway_timeout("x").status, 504)
    assert_eq(version_not_supported("x").status, 505)
    assert_eq(payment_required("x").status, 402)
    assert_eq(html("<p>").content_type, "text/html; charset=utf-8")
    #assert(is_redirect(redirect("/x")))
    #assert(!(is_redirect(ok(""))))
    assert_eq(moved_permanently("/n").status, 301)
    assert_eq(see_other("/n").status, 303)
    assert_eq(temporary_redirect("/n").status, 307)
    assert_eq(permanent_redirect("/n").status, 308)
    assert_eq(header_of(permanent_redirect("/n"), "Location") or "?", "/n")
    assert_eq(not_modified().status, 304)
    e = http_error(404, "gone fishing")
    assert_eq(e.body, "gone fishing\n")
    assert_eq(e.content_type, "text/plain; charset=utf-8")
    assert_eq(header_of(e, "X-Content-Type-Options") or "?", "nosniff")
    assert_eq(error_for(500).body, "Internal Server Error\n")
    rn = range_not_satisfiable(10)
    assert_eq(rn.status, 416)
    assert_eq(header_of(rn, "Content-Range") or "?", "bytes */10")
}

/// Test that json fallback bodies and problem details.
test "json fallback bodies and problem details" {
    assert_eq(json_ok("[]").body, "[]")
    assert_eq(json_status(207, "\{\}").status, 207)
    e = json_error(422, "bad \"title\"")
    assert_eq(e.status, 422)
    assert_eq(e.content_type, "application/json")
    assert_eq(e.body, "\{\"error\":\"bad \\\"title\\\"\"\}")
    p = problem(404, "Not Found", "no such order 7")
    assert_eq(p.content_type, "application/problem+json")
    assert_eq(p.body, "\{\"type\":\"about:blank\",\"title\":\"Not Found\",\"status\":404,\"detail\":\"no such order 7\"\}")
    anon = request("GET", "/", "")
    #assert(wants_json(anon))
    pb = req_with_header(anon, "Accept", "application/x-protobuf")
    #assert(!(wants_json(pb)))
    #assert(wants_binary(pb, "application/x-protobuf"))
    both = negotiate_body(req_with_header(anon, "Accept", "application/x-protobuf, application/json;q=0.5"), "application/x-protobuf", "\{\"id\":1\}", socket_octets("\x08\x01"))
    assert_eq(both.content_type, "application/x-protobuf")
    assert_eq(len(both.bin), 2)
    fallback = negotiate_body(req_with_header(anon, "Accept", "*/*"), "application/x-protobuf", "\{\"id\":1\}", socket_octets("\x08\x01"))
    assert_eq(fallback.content_type, "application/json")
    assert_eq(fallback.body, "\{\"id\":1\}")
    assert_eq(negotiate_body(anon, "application/x-protobuf", "\{\}", []).content_type, "application/json")
}

/// Test that response header editing: set, delete, values, content type.
test "response header editing: set, delete, values, content type" {
    r = ok("abc")
    r = with_header(r, "Set-Cookie", "a=1")
    r = with_header(r, "set-cookie", "b=2")
    assert_eq(len(header_values(r, "Set-Cookie")), 2)
    assert_eq(header_values(r, "SET-COOKIE")[1], "b=2")
    r = set_header(r, "Set-Cookie", "c=3")
    assert_eq(len(header_values(r, "Set-Cookie")), 1)
    assert_eq(header_of(r, "set-cookie") or "?", "c=3")
    r = del_header(r, "SET-COOKIE")
    #assert(!(has_header(r, "Set-Cookie")))
    ct = with_header(r, "content-type", "text/csv")
    assert_eq(ct.content_type, "text/csv")
    assert_eq(len(ct.headers), 0)
    assert_eq(header_of(ct, "Content-Type") or "?", "text/csv")
    assert_eq(header_of(r, "content-length") or "?", "3")
    assert_eq(with_status(r, 201).status, 201)
    assert_eq(with_status(r, 201).body, "abc")
    assert_eq(with_body(r, "zz").body, "zz")
    assert_eq(with_body(r, "zz").status, 200)
    assert_eq(response_body_len(ok("héllo")), 6)
    cc = with_max_age(ok(""), 60)
    assert_eq(header_of(cc, "Cache-Control") or "?", "public, max-age=60")
    ns = with_no_store(ok(""))
    assert_eq(header_of(ns, "Cache-Control") or "?", "no-store, no-cache, must-revalidate")
    assert_eq(header_of(ns, "Pragma") or "?", "no-cache")
    assert_eq(header_of(with_etag(ok(""), "\"x\""), "ETag") or "?", "\"x\"")
    assert_eq(header_of(with_last_modified(ok(""), 784111777), "Last-Modified") or "?", "Sun, 06 Nov 1994 08:49:37 GMT")
    assert_eq(header_of(with_cache_control(ok(""), "no-cache"), "cache-control") or "?", "no-cache")
}

/// Test that binary wire length matches UTF-8 byte count.
test "binary wire length matches UTF-8 byte count" {
    payload = socket_octets("proto-é")
    res = binary(200, "application/x-protobuf", payload)
    #assert(len(payload) >= 7)
    assert_eq(response_body_len(res), len(payload))
    head = render_head(res, response_body_len(res))
    wire = socket_buf_concat(head, payload)
    f = frame_response(wire, false, true, HTTP_MAX_BODY_BYTES)
    assert_eq(f.stage, 0)
    assert_eq(f.res.status, 200)
    assert_eq(f.res.body, "proto-é")
}

/// Test that rendering rules: no body for 1xx/204/304, HEAD, Date, Connection.
test "rendering rules: no body for 1xx/204/304, HEAD, Date, Connection" {
    assert_eq(render(no_content()), "HTTP/1.1 204 No Content\r\n\r\n")
    assert_eq(render(not_modified()), "HTTP/1.1 304 Not Modified\r\n\r\n")
    assert_eq(render(response(200, "héllo", "text/plain")), "HTTP/1.1 200 OK\r\nContent-Type: text/plain\r\nContent-Length: 6\r\n\r\nhéllo")
    assert_eq(render_head_only(ok("hello")), "HTTP/1.1 200 OK\r\nContent-Type: application/json\r\nContent-Length: 5\r\n\r\n")
    assert_eq(render_head(ok("x"), 123), "HTTP/1.1 200 OK\r\nContent-Type: application/json\r\nContent-Length: 123\r\n\r\n")
    full = render_full(ok("hi"), 784111777, true)
    assert_eq(full, "HTTP/1.1 200 OK\r\nContent-Type: application/json\r\nContent-Length: 2\r\nDate: Sun, 06 Nov 1994 08:49:37 GMT\r\n\r\nhi")
    closed = render_full(ok("hi"), 0, false)
    #assert(http_index_of(closed, "Connection: close", 0) > 0)
    assert_eq(render(binary(200, "application/octet-stream", socket_octets("abc"))), "HTTP/1.1 200 OK\r\nContent-Type: application/octet-stream\r\nContent-Length: 0\r\n\r\n")
    assert_eq(render_head(binary(200, "x/y", socket_octets("abc")), response_body_len(binary(200, "x/y", socket_octets("abc")))), "HTTP/1.1 200 OK\r\nContent-Type: x/y\r\nContent-Length: 3\r\n\r\n")
}

// --- requests, query strings, forms ----------------------------------------------------------------

/// Test that request headers: case-insensitive get, set, values, helpers.
test "request headers: case-insensitive get, set, values, helpers" {
    r = request("GET", "/", "")
    r = req_with_header(r, "host", "api.test")
    r = req_with_header(r, "user-agent", "curl/8")
    r = req_with_header(r, "Referer", "https://r.test/")
    r = req_with_header(r, "x-multi", "1")
    r = req_with_header(r, "X-Multi", "2")
    assert_eq(req_host(r), "api.test")
    assert_eq(req_user_agent(r), "curl/8")
    assert_eq(req_referer(r), "https://r.test/")
    assert_eq(req_header(r, "HOST") or "?", "api.test")
    assert_eq(len(req_header_values(r, "x-multi")), 2)
    #assert(req_has_header(r, "referer"))
    r2 = req_set_header(r, "X-Multi", "only")
    assert_eq(len(req_header_values(r2, "X-Multi")), 1)
    assert_eq(req_header(r2, "x-multi") or "?", "only")
    assert_eq(len(r.hdr_names), 5)
    assert_eq(req_content_type(req_with_header(r, "Content-Type", "Text/Plain; charset=utf-8")), "Text/Plain; charset=utf-8")
    assert_eq(media_type("Text/Plain; charset=utf-8"), "text/plain")
    assert_eq(media_type("application/json"), "application/json")
    assert_eq(req_content_length(req_with_header(r, "Content-Length", " 12 ")), 12)
    assert_eq(req_content_length(r), -1)
    assert_eq(req_content_length(req_with_header(r, "Content-Length", "x")), -1)
}

/// Test that query strings: raw, decoded, typed, repeated.
test "query strings: raw, decoded, typed, repeated" {
    t = "/search?q=super%20lang&page=3&tag=a&tag=b&flag&empty=&u=%C3%A9&plus=a+b"
    assert_eq(query_raw(t), "q=super%20lang&page=3&tag=a&tag=b&flag&empty=&u=%C3%A9&plus=a+b")
    assert_eq(query_raw("/nope"), "")
    assert_eq(query_get(t, "q") or "?", "super%20lang")
    assert_eq(query_value(t, "q") or "?", "super lang")
    assert_eq(query_value(t, "u") or "?", "é")
    assert_eq(query_value(t, "plus") or "?", "a b")
    assert_eq(query_value(t, "flag") or "?", "")
    assert_eq(query_value(t, "empty") or "?", "")
    assert_eq(query_value(t, "missing") or "none", "none")
    #assert(query_has(t, "flag"))
    #assert(!(query_has(t, "nope")))
    assert_eq(query_int(t, "page", 1), 3)
    assert_eq(query_int(t, "q", 9), 9)
    assert_eq(query_int(t, "absent", 5), 5)
    pairs = query_pairs(t)
    assert_eq(len(pairs_get_all(pairs, "tag")), 2)
    assert_eq(pairs_get_all(pairs, "tag")[1], "b")
    assert_eq(pairs_get(pairs, "page") or "?", "3")
    assert_eq(len(query_pairs("/x")), 0)
    assert_eq(len(form_pairs("")), 0)
    assert_eq(len(form_pairs("&&a=1&")), 2)
    assert_eq(pairs_get(form_pairs("bad=%zz"), "bad") or "?", "%zz")
}

/// Test that percent encoding round trips UTF-8 and rejects malformed escapes.
test "percent encoding round trips UTF-8 and rejects malformed escapes" {
    assert_eq(http_escape("hello world"), "hello%20world")
    assert_eq(http_escape("a/b?c=d&e"), "a%2Fb%3Fc%3Dd%26e")
    assert_eq(http_escape("AZaz09-._~"), "AZaz09-._~")
    assert_eq(http_escape("日本"), "%E6%97%A5%E6%9C%AC")
    assert_eq(http_unescape("%E6%97%A5%E6%9C%AC", false) or "?", "日本")
    assert_eq(http_unescape("a+b", false) or "?", "a+b")
    assert_eq(http_unescape("a+b", true) or "?", "a b")
    assert_eq(http_unescape("plain", true) or "?", "plain")
    assert_eq(http_unescape("%4", false) or "bad", "bad")
    assert_eq(http_unescape("%", false) or "bad", "bad")
    assert_eq(http_unescape("%GG", false) or "bad", "bad")
    assert_eq(path_escape("/a b/ç/d"), "/a%20b/%C3%A7/d")
    for ["", "x", "a b", "é ü ñ", "100%", "a&b=c", "日本語 text/with/slash"] {
        assert_eq(http_unescape(http_escape(it), false) or "FAIL", it)
    }
    assert_eq(build_query([]), "")
    assert_eq(build_query(["a", "1"]), "a=1")
    assert_eq(build_query(["k v", "x&y", "n", "é"]), "k%20v=x%26y&n=%C3%A9")
    back = form_pairs(build_query(["k v", "x&y", "n", "é"]))
    assert_eq(pairs_get(back, "k v") or "?", "x&y")
    assert_eq(pairs_get(back, "n") or "?", "é")
}

/// Test that forms: FormValue prefers the body for POST, PostFormValue ignores the query.
test "forms: FormValue prefers the body for POST, PostFormValue ignores the query" {
    form = req_with_header(request("POST", "/x?a=query&b=2", "a=body&c=3"), "Content-Type", "application/x-www-form-urlencoded")
    assert_eq(req_form_value(form, "a") or "?", "body")
    assert_eq(req_form_value(form, "b") or "?", "2")
    assert_eq(req_form_value(form, "c") or "?", "3")
    assert_eq(req_form_value(form, "zz") or "none", "none")
    assert_eq(req_post_value(form, "a") or "?", "body")
    assert_eq(req_post_value(form, "b") or "none", "none")
    gr = request("GET", "/x?a=1", "a=ignored")
    assert_eq(req_form_value(gr, "a") or "?", "1")
    wrong = req_with_header(request("POST", "/x?a=1", "a=2"), "Content-Type", "application/json")
    assert_eq(req_form_value(wrong, "a") or "?", "1")
    assert_eq(req_post_value(wrong, "a") or "none", "none")
}

/// Test that multipart: parameters, binary-safe offsets, empty parts and malformed bodies.
test "multipart: parameters, binary-safe offsets, empty parts and malformed bodies" {
    assert_eq(multipart_boundary("multipart/form-data; boundary=\"a b\"") or "?", "a b")
    assert_eq(multipart_boundary("multipart/form-data") or "none", "none")
    assert_eq(header_param("a; filename=\"x;y.txt\"; name=\"f\"", "name"), "f")
    assert_eq(header_param("form-data; xname=\"no\"; name=yes", "name"), "yes")
    assert_eq(header_param("form-data; name=\"unterminated", "name"), "unterminated")
    assert_eq(header_param("nothing", "name"), "")
    wire = "--B\r\nContent-Disposition: form-data; name=\"empty\"\r\n\r\n\r\n--B\r\nContent-Disposition: form-data; name=\"note\"\r\nContent-Type: text/plain; charset=utf-8\r\n\r\nünï\r\ncode\r\n--B--\r\n"
    f = multipart_parse(wire, "B") or MultipartForm.{names: [], filenames: [], ctypes: [], datas: []}
    assert_eq(len(f.names), 2)
    assert_eq(mp_get(f, "empty") or "?", "")
    assert_eq(mp_get(f, "note") or "?", "ünï\r\ncode")
    assert_eq(f.ctypes[1], "text/plain; charset=utf-8")
    assert_eq(mp_get(f, "absent") or "none", "none")
    assert_eq(mp_filename(f, "note"), "")
    pre = "preamble text\r\n--B\r\nContent-Disposition: form-data; name=\"a\"\r\n\r\n1\r\n--B--"
    assert_eq(mp_get(multipart_parse(pre, "B") or f, "a") or "?", "1")
    assert_eq(len((multipart_parse("no boundary here", "B") or MultipartForm.{names: ["fail"], filenames: [], ctypes: [], datas: []}).names), 1)
    assert_eq(len((multipart_parse("--B\r\nContent-Disposition: form-data; name=\"a\"\r\n\r\nx", "B") or MultipartForm.{names: ["fail"], filenames: [], ctypes: [], datas: []}).names), 1)
    assert_eq(len((multipart_parse(wire, "") or MultipartForm.{names: ["fail"], filenames: [], ctypes: [], datas: []}).names), 1)
    body = multipart_encode("Z", ["f1", "f2"], ["a.bin", ""], ["application/octet-stream", ""], ["data\r\n--Y not a delimiter", "plain"])
    rt = multipart_parse(body, "Z") or f
    assert_eq(mp_get(rt, "f1") or "?", "data\r\n--Y not a delimiter")
    assert_eq(mp_filename(rt, "f1"), "a.bin")
    assert_eq(mp_get(rt, "f2") or "?", "plain")
}

// --- dates and cookies ----------------------------------------------------------------------------------------

/// Test that HTTP dates round trip across eras and reject malformed input.
test "HTTP dates round trip across eras and reject malformed input" {
    assert_eq(http_date(0), "Thu, 01 Jan 1970 00:00:00 GMT")
    assert_eq(http_date(951782400), "Tue, 29 Feb 2000 00:00:00 GMT")
    assert_eq(http_date(1700000000), "Tue, 14 Nov 2023 22:13:20 GMT")
    assert_eq(http_date(4102444799), "Thu, 31 Dec 2099 23:59:59 GMT")
    assert_eq(http_date(-50), "Thu, 01 Jan 1970 00:00:00 GMT")
    for [0, 86399, 86400, 951782400, 1700000000, 1234567890, 2000000000, 4102444799] {
        assert_eq(parse_http_date(http_date(it)), it)
    }
    assert_eq(parse_http_date("garbage"), -1)
    assert_eq(parse_http_date(""), -1)
    assert_eq(parse_http_date("Sun, 06 Foo 1994 08:49:37 GMT"), -1)
    assert_eq(parse_http_date("Sun, 06 Nov 1994 08:49:37 UTC"), -1)
    assert_eq(parse_http_date("Sun, 99 Nov 1994 08:49:37 GMT"), -1)
    assert_eq(parse_http_date("Sun, 06 Nov 1994 28:49:37 GMT"), -1)
}

/// Test that cookies: attributes, sanitising, request parsing, deletion.
test "cookies: attributes, sanitising, request parsing, deletion" {
    c = cookie_new("sid", "a\"b;c d\\e")
    assert_eq(set_cookie_header(c), "sid=abc de; Path=/")
    full = Cookie.{name: "id", value: "7", path: "/app", http_only: true, secure: true, max_age: 120, domain: "example.com", same_site: "Strict", expires: 784111777}
    assert_eq(set_cookie_header(full), "id=7; Path=/app; Domain=example.com; Expires=Sun, 06 Nov 1994 08:49:37 GMT; HttpOnly; Secure; SameSite=Strict; Max-Age=120")
    sess = cookie_session("s", "v", 60)
    assert_eq(set_cookie_header(sess), "s=v; Path=/; HttpOnly; Secure; SameSite=Lax; Max-Age=60")
    d = delete_cookie("sid", "/")
    assert_eq(set_cookie_header(d), "sid=; Path=/; Expires=Thu, 01 Jan 1970 00:00:00 GMT; Max-Age=0")
    // Partial literals (older call sites) keep working: the new attributes are simply absent.
    old = Cookie.{name: "k", value: "v", path: "/", http_only: false, secure: false, max_age: -1}
    assert_eq(set_cookie_header(old), "k=v; Path=/")
    r = with_cookie(with_cookie(ok(""), cookie_new("a", "1")), cookie_new("b", "2"))
    assert_eq(len(header_values(r, "Set-Cookie")), 2)
    q = chr(34)
    req = req_with_header(req_with_header(request("GET", "/", ""), "Cookie", "a=1; b={q}two words{q}; c="), "cookie", "d=4")
    assert_eq(req_cookie(req, "a") or "?", "1")
    assert_eq(req_cookie(req, "b") or "?", "two words")
    assert_eq(req_cookie(req, "c") or "?", "")
    assert_eq(req_cookie(req, "d") or "?", "4")
    assert_eq(req_cookie(req, "zz") or "none", "none")
    assert_eq(len(req_cookies(req)), 8)
    assert_eq(len(parse_cookie_header("garbage; =novalue; ok=1")), 2)
}

/// Test that Set-Cookie parsing (client side) and malformed input.
test "Set-Cookie parsing (client side) and malformed input" {
    c = parse_set_cookie("token=xyz; path=/api; max-age=30; samesite=none; secure") or cookie_new("FAIL", "")
    assert_eq(c.name, "token")
    assert_eq(c.value, "xyz")
    assert_eq(c.path, "/api")
    assert_eq(c.max_age, 30)
    assert_eq(c.same_site, "none")
    #assert(c.secure)
    #assert(!(c.http_only))
    e = parse_set_cookie("a=b; Expires=Sun, 06 Nov 1994 08:49:37 GMT; Max-Age=-5") or cookie_new("FAIL", "")
    assert_eq(e.expires, 784111777)
    assert_eq(e.max_age, 0)
    assert_eq((parse_set_cookie("novalue") or cookie_new("FAIL", "")).name, "FAIL")
    assert_eq((parse_set_cookie("=x") or cookie_new("FAIL", "")).name, "FAIL")
    assert_eq((parse_set_cookie("bad name=x") or cookie_new("FAIL", "")).name, "FAIL")
    assert_eq((parse_set_cookie("k=v; Domain=.Example.COM") or cookie_new("FAIL", "")).domain, "example.com")
    assert_eq((parse_set_cookie("k=a=b=c") or cookie_new("FAIL", "")).value, "a=b=c")
}

/// Test that cookie jar: domain/path/secure matching, replacement, expiry, bounded size.
test "cookie jar: domain/path/secure matching, replacement, expiry, bounded size" {
    jar = CookieJar.new(3)
    host = cookie_new("h", "1")
    #assert(@jar.store("a.test", host, 100))
    dom = parse_set_cookie("d=2; Domain=a.test; Path=/api") or host
    #assert(@jar.store("www.a.test", dom, 100))
    assert_eq(jar.header_for("a.test", "/x", false, 150), "h=1")
    assert_eq(jar.header_for("www.a.test", "/api/v1", false, 150), "d=2")
    assert_eq(jar.header_for("a.test", "/api/v1", false, 150), "h=1; d=2")
    assert_eq(jar.header_for("b.test", "/", false, 150), "")
    assert_eq(jar.header_for("evil-a.test", "/api", false, 150), "")
    assert_eq(jar.header_for("a.test", "/apix", false, 150), "h=1")
    // A cookie for a foreign domain is refused.
    foreign = parse_set_cookie("f=3; Domain=other.test") or host
    #assert(!(@jar.store("a.test", foreign, 100)))
    // Same name+domain+path replaces in place.
    #assert(@jar.store("a.test", cookie_new("h", "2"), 120))
    assert_eq(jar.header_for("a.test", "/", false, 150), "h=2")
    assert_eq(jar.live(150), 2)
    // Secure cookies only travel over https.
    sec = cookie_session("s", "x", 1000)
    @jar.store("a.test", sec, 100)
    assert_eq(jar.header_for("a.test", "/", false, 150), "h=2")
    assert_eq(jar.header_for("a.test", "/", true, 150), "h=2; s=x")
    // Expiry and explicit deletion.
    assert_eq(jar.live(100000), 2)
    assert_eq(jar.header_for("a.test", "/", true, 100000), "h=2")
    @jar.store("a.test", cookie_new("h", "again"), 200000)
    assert_eq(jar.header_for("a.test", "/", false, 200001), "h=again")
    @jar.store("a.test", delete_cookie("h", "/"), 200002)
    assert_eq(jar.header_for("a.test", "/", false, 200003), "")
    // Fixed capacity: a flood of distinct cookies never grows the arrays.
    small = CookieJar.new(2)
    for 0..50 {
        @small.store("z.test", cookie_new("k{it}", "v"), 10)
    }
    assert_eq(len(small.names), 2)
    assert_eq(small.live(11), 2)
}

// --- content: types, sniffing, negotiation, auth -------------------------------------------------

/// Test that path_clean, strip_prefix_path and mime tables.
test "path_clean, strip_prefix_path and mime tables" {
    assert_eq(path_clean("/a/b/../c"), "/a/c")
    assert_eq(path_clean("//a//b"), "/a/b")
    assert_eq(path_clean("/a/b/."), "/a/b/")
    assert_eq(path_clean("/a/b/.."), "/a/")
    assert_eq(path_clean("/./"), "/")
    assert_eq(path_clean("/../../.."), "/")
    assert_eq(path_clean("rel/x"), "/rel/x")
    assert_eq(strip_prefix_path("/api", "/api") or "?", "/")
    assert_eq(strip_prefix_path("/apix", "/api") or "?", "/x")
    assert_eq(strip_prefix_path("/other", "/api") or "none", "none")
    assert_eq(mime_by_ext(".html"), "text/html; charset=utf-8")
    assert_eq(mime_by_ext("JSON"), "application/json")
    assert_eq(mime_by_ext("png"), "image/png")
    assert_eq(mime_by_ext("svg"), "image/svg+xml")
    assert_eq(mime_by_ext("wasm"), "application/wasm")
    assert_eq(mime_by_ext("woff2"), "font/woff2")
    assert_eq(mime_by_ext("unknownext"), "application/octet-stream")
    assert_eq(mime_for_path("/static/app.min.js"), "text/javascript; charset=utf-8")
    assert_eq(mime_for_path("/dir.d/file"), "application/octet-stream")
    assert_eq(mime_for_path("noext"), "application/octet-stream")
}

/// Test that content sniffing.
test "content sniffing" {
    assert_eq(sniff_content_type("<html><body>"), "text/html; charset=utf-8")
    assert_eq(sniff_content_type("  <?xml version=\"1.0\"?>"), "text/plain; charset=utf-8")
    assert_eq(sniff_content_type("<?xml version=\"1.0\"?>"), "text/xml; charset=utf-8")
    assert_eq(sniff_content_type("%PDF-1.7 ..."), "application/pdf")
    assert_eq(sniff_content_type("GIF89a...."), "image/gif")
    assert_eq(sniff_content_type("just words"), "text/plain; charset=utf-8")
    assert_eq(sniff_content_type(""), "text/plain; charset=utf-8")
    assert_eq(sniff_content_type("bin\x01ary"), "application/octet-stream")
}

/// Test that Accept negotiation: q-values, specificity, offers and explicit binary.
test "Accept negotiation: q-values, specificity, offers and explicit binary" {
    assert_eq(http_parse_q(""), 1000)
    assert_eq(http_parse_q("q=0.5"), 500)
    assert_eq(http_parse_q("q=0.25"), 250)
    assert_eq(http_parse_q("q=0.001"), 1)
    assert_eq(http_parse_q("q=1"), 1000)
    assert_eq(http_parse_q("q=0"), 0)
    assert_eq(http_parse_q("level=1; q=0.7"), 700)
    h = "text/html;q=0.9, application/json;q=0.8, */*;q=0.1"
    assert_eq(accept_quality(h, "text/html"), 900)
    assert_eq(accept_quality(h, "application/json"), 800)
    assert_eq(accept_quality(h, "image/png"), 100)
    assert_eq(accept_quality("text/*;q=0.4, text/plain;q=0.9", "text/plain"), 900)
    assert_eq(accept_quality("text/*;q=0.4, text/plain;q=0.9", "text/css"), 400)
    assert_eq(accept_quality("application/json;q=0", "application/json"), 0)
    assert_eq(accept_quality("", "application/json"), 0)
    assert_eq(accept_quality("APPLICATION/JSON", "application/json"), 1000)
    r = req_with_header(request("GET", "/", ""), "Accept", h)
    assert_eq(negotiate(r, ["application/json", "text/html"]), "text/html")
    assert_eq(negotiate(r, ["image/png"]), "image/png")
    assert_eq(negotiate(req_with_header(request("GET", "/", ""), "Accept", "text/html"), ["application/json"]), "")
    assert_eq(negotiate(request("GET", "/", ""), ["a/b", "c/d"]), "a/b")
    #assert(accepts(request("GET", "/", ""), "anything/x"))
    #assert(!(accepts(req_with_header(request("GET", "/", ""), "Accept", "text/html"), "application/json")))
    #assert(!(wants_binary(req_with_header(request("GET", "/", ""), "Accept", "Application/X-Protobuf;q=0"), "application/x-protobuf")))
}

/// Test that Basic and bearer credentials.
test "Basic and bearer credentials" {
    assert_eq(basic_auth_header("Aladdin", "open sesame"), "Basic QWxhZGRpbjpvcGVuIHNlc2FtZQ==")
    r = req_with_header(request("GET", "/", ""), "Authorization", "basic QWxhZGRpbjpvcGVuIHNlc2FtZQ==")
    c = req_basic_auth(r) or Credentials.{user: "?", password: "?"}
    assert_eq(c.user, "Aladdin")
    assert_eq(c.password, "open sesame")
    assert_eq((req_basic_auth(request("GET", "/", "")) or Credentials.{user: "none", password: ""}).user, "none")
    nocolon = req_with_header(request("GET", "/", ""), "Authorization", "Basic " + base64_encode("nocolon"))
    assert_eq((req_basic_auth(nocolon) or Credentials.{user: "none", password: ""}).user, "none")
    assert_eq((req_basic_auth(req_with_header(request("GET", "/", ""), "Authorization", "Bearer x")) or Credentials.{user: "none", password: ""}).user, "none")
    empty_pw = req_set_basic_auth(request("GET", "/", ""), "u", "")
    assert_eq((req_basic_auth(empty_pw) or Credentials.{user: "none", password: "?"}).password, "")
    assert_eq(mw_bearer(req_with_header(request("GET", "/", ""), "Authorization", "bearer lower")) or "none", "lower")
    t401 = mw_require_token(request("GET", "/", ""), "x") or ok("pass")
    assert_eq(header_of(t401, "WWW-Authenticate") or "?", "Bearer")
}

