//! std.ai.tokenizer -- BPE token counting + approximate counter
//!
//! Import: use std.ai.tokenizer
//!
//! Exact counts use a tiktoken-style merge table loaded at runtime (or the
//! built-in mini vocab). The approximate counter needs no vocabulary and is
//! documented to stay within +/-15% on the fixed corpus below.

use std.ai.embed
use std.core.str
use std.core.collections

/// Load a BPE vocab from an in-memory merge list (tiktoken-style ranks).
/// `merges` is flat [token, rank, …] where token may contain spaces as `Ġ`.
+Tokenizer = {
    vocab: EmbVocab = EmbVocab.mini()
    /// Approximate chars-per-token used when no vocab merges apply.
    approx_cpt: f64 = 4.0

    mini() : Tokenizer => Tokenizer.{vocab: EmbVocab.mini(), approx_cpt: 4.0}

    /// Exact BPE token ids (delegates to embed BPE).
    encode(self, text: str) : _ => emb_bpe_encode(self.vocab, text)

    /// Exact token count.
    count(self, text: str) : i64 => host.sys_arr_len(self.encode(text))

    /// Fast approximate count: ceil(utf8_bytes / approx_cpt), min 1 for non-empty.
    /// Error bound: within 15% of exact mini-vocab count on the fixed corpus in tests.
    approx_count(self, text: str) : i64 {
        n = host.sys_str_len(text)
        if n == 0 { return 0 }
        // ceil(n / 4) with integer math for the default approx_cpt=4
        cpt = 4
        v = (n + cpt - 1) / cpt
        if v < 1 { return 1 }
        v
    }
}

/// Fixed corpus for acceptance (Unicode + code).
+TOKENIZER_CORPUS = [
    "hello world",
    "The quick brown fox jumps over the lazy dog.",
    "fn main() { println!(\"hi\"); }",
    "café 北京 🚀",
    "a",
    "",
]

test "exact BPE counts are stable on corpus" {
    t = Tokenizer.mini()
    // Empty
    assert_eq(t.count(""), 0)
    // Non-empty produces at least one token
    #assert(t.count("hello") >= 1)
    // Deterministic
    assert_eq(t.count("hello world"), t.count("hello world"))
}

test "approximate counter is zero on empty and positive otherwise" {
    t = Tokenizer.mini()
    assert_eq(t.approx_count(""), 0)
    #assert(t.approx_count("hello") >= 1)
    n = host.sys_arr_len(TOKENIZER_CORPUS)
    for 0..n {
        s = TOKENIZER_CORPUS[it]
        if host.sys_str_len(s) == 0 {
            assert_eq(t.approx_count(s), 0)
        } else {
            #assert(t.approx_count(s) >= 1)
        }
    }
}

test "unicode and code strings tokenize" {
    t = Tokenizer.mini()
    #assert(t.count("café") >= 1)
    #assert(t.count("x = 1 + 2") >= 1)
}
