fr_events() : Frame {
    f = Frame.new()
    @f.add_str(str_col("grp", ["a", "a", "a", "b", "b", "a"]))
    @f.add_int(int_col("t", [3, 1, 2, 2, 1, 4]))
    @f.add_float(float_col("v", [10.0, 20.0, 30.0, 5.0, 7.0, 40.0]))
    f
}

test "over: row_number, cumulative and shifted windows keep row order" {
    f = fr_events()
    r = f.over(["grp"], ["t"], [win_row_number("rn"), win_cum_sum("v", "cs"), win_lag("v", "prev", 1), win_lead("v", "next", 1)])
    assert_eq(r.height(), 6)
    assert_eq(r.width(), 7)
    // original columns and order are untouched
    assert_eq(r.get_int("t").get(0), 3)
    assert_eq(r.get_str("grp").get(3), "b")
    rn = r.get_int("rn")
    assert_eq(rn.get(0), 3)
    assert_eq(rn.get(1), 1)
    assert_eq(rn.get(2), 2)
    assert_eq(rn.get(3), 2)
    assert_eq(rn.get(4), 1)
    assert_eq(rn.get(5), 4)
    cs = r.get_float("cs")
    assert_eq(cs.get(1), 20.0)
    assert_eq(cs.get(2), 50.0)
    assert_eq(cs.get(0), 60.0)
    assert_eq(cs.get(5), 100.0)
    assert_eq(cs.get(4), 7.0)
    assert_eq(cs.get(3), 12.0)
    prev = r.get_float("prev")
    #assert(prev.is_null(1))
    assert_eq(prev.get(2), 20.0)
    assert_eq(prev.get(0), 30.0)
    assert_eq(prev.get(5), 10.0)
    #assert(prev.is_null(4))
    assert_eq(prev.get(3), 7.0)
    next = r.get_float("next")
    assert_eq(next.get(1), 30.0)
    assert_eq(next.get(0), 40.0)
    #assert(next.is_null(5))
    assert_eq(next.get(4), 5.0)
    #assert(next.is_null(3))
    // the input frame is not touched
    assert_eq(f.width(), 3)
}

test "over: partition aggregates broadcast to every row" {
    f = fr_events()
    r = f.over(["grp"], [], [win_sum("v", "s"), win_mean("v", "m"), win_min("v", "lo"), win_max("v", "hi"), win_count("v", "c"), win_rows("n"), win_std("v", "sd"), win_first("v", "f"), win_last("v", "l"), win_nunique("t", "u")])
    s = r.get_float("s")
    assert_eq(s.get(0), 100.0)
    assert_eq(s.get(1), 100.0)
    assert_eq(s.get(3), 12.0)
    assert_eq(r.get_float("m").get(2), 25.0)
    assert_eq(r.get_float("m").get(4), 6.0)
    assert_eq(r.get_float("lo").get(5), 10.0)
    assert_eq(r.get_float("hi").get(0), 40.0)
    assert_eq(r.get_int("c").get(3), 2)
    assert_eq(r.get_int("n").get(0), 4)
    #assert(dt_abs(r.get_float("sd").get(3) - host.sys_sqrt(2.0)) < 1.0e-12)
    // no order keys: first/last follow the original row order
    assert_eq(r.get_float("f").get(0), 10.0)
    assert_eq(r.get_float("l").get(0), 40.0)
    assert_eq(r.get_int("u").get(0), 4)
    assert_eq(r.get_int("u").get(3), 2)
    // with an order, first/last follow it
    o = f.over(["grp"], ["t"], [win_first("v", "f"), win_last("v", "l")])
    assert_eq(o.get_float("f").get(0), 20.0)
    assert_eq(o.get_float("l").get(0), 40.0)
    // no partition: one global window
    g = f.over([], [], [win_sum("v", "s")])
    assert_eq(g.get_float("s").get(2), 112.0)
    assert_eq(g.get_float("s").get(5), 112.0)
}

test "over: rank, dense_rank and descending order" {
    f = Frame.new()
    @f.add_int(int_col("k", [1, 1, 2, 3, 3, 3]))
    @f.add_str(str_col("who", ["a", "b", "c", "d", "e", "f"]))
    r = f.over([], ["k"], [win_rank("r"), win_dense_rank("d"), win_row_number("n")])
    rk = r.get_int("r")
    assert_eq(rk.get(0), 1)
    assert_eq(rk.get(1), 1)
    assert_eq(rk.get(2), 3)
    assert_eq(rk.get(3), 4)
    assert_eq(rk.get(5), 4)
    dn = r.get_int("d")
    assert_eq(dn.get(1), 1)
    assert_eq(dn.get(2), 2)
    assert_eq(dn.get(4), 3)
    assert_eq(r.get_int("n").get(5), 6)
    // descending keys and two order columns
    d = f.over_desc([], ["k"], [true], [win_rank("r")])
    assert_eq(d.get_int("r").get(3), 1)
    assert_eq(d.get_int("r").get(5), 1)
    assert_eq(d.get_int("r").get(2), 4)
    assert_eq(d.get_int("r").get(0), 5)
    two = f.over_desc([], ["k", "who"], [false, true], [win_row_number("n")])
    assert_eq(two.get_int("n").get(0), 2)
    assert_eq(two.get_int("n").get(1), 1)
    assert_eq(two.get_int("n").get(5), 4)
    // without order keys everything ties
    assert_eq(f.over([], [], [win_rank("r")]).get_int("r").get(4), 1)
    // partitioned ranks restart
    p = fr_events().over(["grp"], ["v"], [win_rank("r")])
    assert_eq(p.get_int("r").get(0), 1)
    assert_eq(p.get_int("r").get(5), 4)
    assert_eq(p.get_int("r").get(3), 1)
    assert_eq(p.get_int("r").get(4), 2)
}

test "over: rolling windows respect min_periods and nulls" {
    f = fr_events()
    r = f.over(["grp"], ["t"], [win_rolling_mean("v", "m2", 2), win_rolling_sum("v", "s3", 3), win_rolling_min("v", "lo3", 3), win_rolling_max("v", "hi3", 3), win_rolling_std("v", "sd2", 2)])
    m2 = r.get_float("m2")
    #assert(m2.is_null(1))
    assert_eq(m2.get(2), 25.0)
    assert_eq(m2.get(0), 20.0)
    assert_eq(m2.get(5), 25.0)
    #assert(m2.is_null(4))
    assert_eq(m2.get(3), 6.0)
    s3 = r.get_float("s3")
    #assert(s3.is_null(1))
    #assert(s3.is_null(2))
    assert_eq(s3.get(0), 60.0)
    assert_eq(s3.get(5), 80.0)
    assert_eq(r.get_float("lo3").get(5), 10.0)
    assert_eq(r.get_float("hi3").get(5), 40.0)
    assert_eq(r.get_float("hi3").get(0), 30.0)
    #assert(dt_abs(r.get_float("sd2").get(2) - host.sys_sqrt(50.0)) < 1.0e-12)
    #assert(r.get_float("sd2").is_null(1))
    // lowering min_periods lets the first rows report partial windows
    p = f.over(["grp"], ["t"], [win_min_periods(win_rolling_mean("v", "m", 2), 1), win_min_periods(win_rolling_sum("v", "s", 3), 2)])
    assert_eq(p.get_float("m").get(1), 20.0)
    assert_eq(p.get_float("m").get(2), 25.0)
    #assert(p.get_float("s").is_null(1))
    assert_eq(p.get_float("s").get(2), 50.0)
    // int columns keep int sums, nulls inside a window reduce the valid count
    n = Frame.new()
    c = IntCol.new("x")
    @c.push(1)
    @c.push_null()
    @c.push(3)
    @c.push(4)
    @n.add_int(c)
    ni = n.over([], [], [win_rolling_sum("x", "s", 2), win_min_periods(win_rolling_sum("x", "s1", 2), 1), win_cum_sum("x", "cs"), win_cum_count("x", "cc"), win_cum_max("x", "cx"), win_cum_min("x", "cn")])
    assert_eq(ni.kind_of("s"), DT_INT)
    #assert(ni.get_int("s").is_null(1))
    #assert(ni.get_int("s").is_null(2))
    assert_eq(ni.get_int("s").get(3), 7)
    assert_eq(ni.get_int("s1").get(1), 1)
    assert_eq(ni.get_int("s1").get(2), 3)
    assert_eq(ni.get_int("cs").get(0), 1)
    #assert(ni.get_int("cs").is_null(1))
    assert_eq(ni.get_int("cs").get(2), 4)
    assert_eq(ni.get_int("cs").get(3), 8)
    assert_eq(ni.get_int("cc").get(1), 1)
    assert_eq(ni.get_int("cc").get(3), 3)
    assert_eq(ni.get_int("cx").get(3), 4)
    assert_eq(ni.get_int("cn").get(3), 1)
    // string cumulative min / max, and lag keeps the dtype
    s = frame_from_rows([["b"], ["a"], ["c"]], false)
    sr = s.over([], [], [win_cum_min("c0", "lo"), win_cum_max("c0", "hi"), win_lag("c0", "p", 1), win_cum_sum("c0", "bad")])
    assert_eq(sr.get_str("lo").get(2), "a")
    assert_eq(sr.get_str("hi").get(2), "c")
    assert_eq(sr.get_str("p").get(1), "b")
    #assert(sr.get_str("p").is_null(0))
    assert_eq(sr.get_float("bad").null_count(), 3)
}

test "over: edge cases" {
    f = fr_events()
    assert_eq(f.over(["ghost"], [], [win_sum("v", "s")]).width(), 0)
    assert_eq(f.over([], ["ghost"], [win_sum("v", "s")]).width(), 0)
    assert_eq(f.over([], [], []).width(), 3)
    // an unknown value column gives a null column
    u = f.over(["grp"], [], [win_sum("ghost", "s"), win_lag("ghost", "p", 1), win_rolling_sum("ghost", "r", 2), win_cum_sum("ghost", "c")])
    assert_eq(u.get_float("s").null_count(), 6)
    assert_eq(u.width(), 7)
    // lag / lead with larger and negative offsets
    far = f.over(["grp"], ["t"], [win_lag("v", "p", 3), win_lag("v", "n", -1), win_lead("v", "q", 9)])
    assert_eq(far.get_float("p").get(5), 20.0)
    assert_eq(far.get_float("p").null_count(), 5)
    assert_eq(far.get_float("n").get(1), 30.0)
    assert_eq(far.get_float("q").null_count(), 6)
    // an empty frame stays empty
    e = f.filter(expr("v > 1000") or fail_expr()).over(["grp"], ["t"], [win_row_number("rn"), win_cum_sum("v", "cs")])
    assert_eq(e.height(), 0)
    assert_eq(e.width(), 5)
    // null partition keys form their own partition, null order keys sort last
    k = Frame.new()
    pk = StrCol.new("k")
    @pk.push("x")
    @pk.push_null()
    @pk.push("x")
    @pk.push_null()
    @k.add_str(pk)
    ok = IntCol.new("o")
    @ok.push_null()
    @ok.push(2)
    @ok.push(1)
    @ok.push(1)
    @k.add_int(ok)
    kr = k.over(["k"], ["o"], [win_row_number("n")])
    assert_eq(kr.get_int("n").get(0), 2)
    assert_eq(kr.get_int("n").get(2), 1)
    assert_eq(kr.get_int("n").get(3), 1)
    assert_eq(kr.get_int("n").get(1), 2)
    // window columns can feed expressions
    d = f.over(["grp"], [], [win_mean("v", "m")]).with_column("dev", expr("v - m") or fail_expr())
    assert_eq(d.get_float("dev").total(), 0.0)
}

test "over: conformance with eager group_by and sorting" {
    f = fr_events()
    w = f.over(["grp"], [], [win_sum("v", "s"), win_rows("n")])
    g = f.group_by(["grp"], [agg_sum("v", "s"), agg_rows("n")])
    row = 0
    while row < f.height() {
        gi = 0
        if f.get_str("grp").get(row) == "b" { gi = 1 }
        assert_eq(w.get_float("s").get(row), g.get_float("s").get(gi))
        assert_eq(w.get_int("n").get(row), g.get_int("n").get(gi))
        row += 1
    }
    // cum_sum on the last row of every partition is the partition total
    c = f.over(["grp"], ["t"], [win_cum_sum("v", "cs"), win_row_number("rn"), win_sum("v", "tot")])
    row = 0
    while row < f.height() {
        if c.get_int("rn").get(row) == w.get_int("n").get(row) { assert_eq(c.get_float("cs").get(row), c.get_float("tot").get(row)) }
        row += 1
    }
    // row_number over a total order is a permutation of 1..n
    r = f.over([], ["v"], [win_row_number("rn")])
    assert_eq(r.get_int("rn").total(), 21)
    // many rows exercise every merge width of the order-key sorts
    big = Frame.new()
    ks = []
    vs = []
    i = 0
    while i < 150 {
        ks = host.sys_arr_push(ks, i % 4)
        vs = host.sys_arr_push(vs, (i * 37 + 11) % 101)
        i += 1
    }
    @big.add_int(int_col("k", ks))
    @big.add_int(int_col("v", vs))
    bw = big.over(["k"], ["v"], [win_row_number("rn"), win_rows("n"), win_cum_sum("v", "cs"), win_sum("v", "tot")])
    ok = true
    i = 0
    while i < 150 {
        if bw.get_int("rn").get(i) == bw.get_int("n").get(i) && bw.get_int("cs").get(i) != bw.get_int("tot").get(i) { ok = false }
        i += 1
    }
    #assert(ok)
    assert_eq(bw.get_int("rn").total(), 38 * 39 / 2 * 2 + 37 * 38 / 2 * 2)
}

fr_quotes() : Frame {
    f = Frame.new()
    @f.add_str(str_col("sym", ["A", "A", "A", "B"]))
    @f.add_int(int_col("t", [1, 5, 10, 2]))
    @f.add_float(float_col("bid", [100.0, 101.0, 102.0, 50.0]))
    f
}

fr_trades() : Frame {
    f = Frame.new()
    @f.add_str(str_col("sym", ["A", "A", "B", "A", "C"]))
    @f.add_int(int_col("t", [2, 5, 3, 12, 1]))
    @f.add_int(int_col("qty", [1, 2, 3, 4, 5]))
    f
}

test "join_asof strategies, grouping and tolerance" {
    q = fr_quotes()
    t = fr_trades()
    back = t.join_asof(q, "t", ["sym"], "backward", -1.0)
    assert_eq(back.height(), 5)
    assert_eq(back.width(), 4)
    assert_eq(back.names[3], "bid")
    bb = back.get_float("bid")
    assert_eq(bb.get(0), 100.0)
    assert_eq(bb.get(1), 101.0)
    assert_eq(bb.get(2), 50.0)
    assert_eq(bb.get(3), 102.0)
    #assert(bb.is_null(4))
    // left order and columns are preserved
    assert_eq(back.get_int("qty").get(3), 4)
    fwd = t.join_asof(q, "t", ["sym"], "forward", -1.0).get_float("bid")
    assert_eq(fwd.get(0), 101.0)
    assert_eq(fwd.get(1), 101.0)
    #assert(fwd.is_null(2))
    #assert(fwd.is_null(3))
    #assert(fwd.is_null(4))
    near = t.join_asof(q, "t", ["sym"], "nearest", -1.0).get_float("bid")
    assert_eq(near.get(0), 100.0)
    assert_eq(near.get(1), 101.0)
    assert_eq(near.get(2), 50.0)
    assert_eq(near.get(3), 102.0)
    // tolerance
    tol = t.join_asof(q, "t", ["sym"], "backward", 1.0).get_float("bid")
    assert_eq(tol.get(0), 100.0)
    #assert(tol.is_null(3))
    assert_eq(tol.get(2), 50.0)
    // no by: a single timeline
    flat = t.join_asof(q.drop(["sym"]), "t", [], "backward", -1.0)
    assert_eq(flat.width(), 4)
    fb = flat.get_float("bid")
    assert_eq(fb.get(0), 50.0)
    assert_eq(fb.get(1), 101.0)
    assert_eq(fb.get(2), 50.0)
    assert_eq(fb.get(3), 102.0)
    assert_eq(fb.get(4), 100.0)
    // the inputs are unchanged
    assert_eq(t.width(), 3)
    assert_eq(q.height(), 4)
}

test "join_asof edge cases: exact int keys, clashes, nulls, errors" {
    big = 1700000000000000000
    l = Frame.new()
    @l.add_int(int_col("t", [big + 3, big + 1, big]))
    r = Frame.new()
    @r.add_int(int_col("t", [big + 2, big + 1]))
    @r.add_int(int_col("x", [20, 10]))
    j = l.join_asof(r, "t", [], "backward", -1.0)
    assert_eq(j.get_int("x").get(0), 20)
    assert_eq(j.get_int("x").get(1), 10)
    #assert(j.get_int("x").is_null(2))
    // exact ties on the key match backward and forward alike
    assert_eq(l.join_asof(r, "t", [], "forward", -1.0).get_int("x").get(1), 10)
    // nearest tie goes backward
    tie = Frame.new()
    @tie.add_int(int_col("t", [5]))
    pair = Frame.new()
    @pair.add_int(int_col("t", [3, 7]))
    @pair.add_str(str_col("tag", ["lo", "hi"]))
    assert_eq(tie.join_asof(pair, "t", [], "nearest", -1.0).get_str("tag").get(0), "lo")
    // float keys and a mixed int / float pair
    fl = Frame.new()
    @fl.add_float(float_col("t", [1.5, 2.5]))
    fr = Frame.new()
    @fr.add_float(float_col("t", [1.0, 2.0]))
    @fr.add_int(int_col("v", [7, 8]))
    assert_eq(fl.join_asof(fr, "t", [], "backward", -1.0).get_int("v").get(1), 8)
    assert_eq(l.join_asof(fr, "t", [], "backward", -1.0).get_int("v").get(0), 8)
    // column name clash gets a suffix
    c = Frame.new()
    @c.add_int(int_col("t", [10]))
    @c.add_int(int_col("v", [1]))
    d = Frame.new()
    @d.add_int(int_col("t", [9]))
    @d.add_int(int_col("v", [2]))
    cj = c.join_asof(d, "t", [], "backward", -1.0)
    assert_eq(cj.get_int("v").get(0), 1)
    assert_eq(cj.get_int("v_right").get(0), 2)
    // null keys never match, on either side
    ln = IntCol.new("t")
    @ln.push(4)
    @ln.push_null()
    lf = Frame.new()
    @lf.add_int(ln)
    rn = IntCol.new("t")
    @rn.push_null()
    @rn.push(3)
    rf = Frame.new()
    @rf.add_int(rn)
    @rf.add_int(int_col("w", [1, 2]))
    nj = lf.join_asof(rf, "t", [], "backward", -1.0)
    assert_eq(nj.get_int("w").get(0), 2)
    #assert(nj.get_int("w").is_null(1))
    // failures give an empty frame
    assert_eq(l.join_asof(r, "ghost", [], "backward", -1.0).width(), 0)
    assert_eq(l.join_asof(r, "t", ["ghost"], "backward", -1.0).width(), 0)
    assert_eq(l.join_asof(r, "t", [], "sideways", -1.0).width(), 0)
    assert_eq(fr_events().join_asof(fr_events(), "grp", [], "backward", -1.0).width(), 0)
    // empty sides
    assert_eq(l.join_asof(r.filter(expr("x > 100") or fail_expr()), "t", [], "backward", -1.0).get_int("x").null_count(), 3)
    assert_eq(l.filter(expr("t < 0") or fail_expr()).join_asof(r, "t", [], "backward", -1.0).height(), 0)
}

fr_ticks() : Frame {
