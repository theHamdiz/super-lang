    @f.add_int(int_col("ts", [0, 1, 2, 5, 6, 11, 12]))
    @f.add_int(int_col("v", [1, 2, 3, 4, 5, 6, 7]))
    @f.add_str(str_col("k", ["x", "x", "y", "x", "y", "x", "x"]))
    f
}

test "group_by_dynamic tumbling, keyed and sparse windows" {
    g = fr_ticks().group_by_dynamic("ts", 5, [], [agg_sum("v", "s"), agg_rows("n")])
    assert_eq(g.height(), 3)
    assert_eq(g.names[0], "ts")
    assert_eq(g.get_int("ts").get(0), 0)
    assert_eq(g.get_int("ts").get(1), 5)
    assert_eq(g.get_int("ts").get(2), 10)
    assert_eq(g.get_int("s").get(0), 6)
    assert_eq(g.get_int("s").get(1), 9)
    assert_eq(g.get_int("s").get(2), 13)
    assert_eq(g.get_int("n").total(), 7)
    keyed = fr_ticks().group_by_dynamic("ts", 5, ["k"], [agg_sum("v", "s")])
    assert_eq(keyed.height(), 5)
    assert_eq(keyed.names[0], "k")
    assert_eq(keyed.names[1], "ts")
    assert_eq(keyed.get_str("k").get(0), "x")
    assert_eq(keyed.get_int("ts").get(2), 10)
    assert_eq(keyed.get_int("s").get(2), 13)
    assert_eq(keyed.get_str("k").get(3), "y")
    assert_eq(keyed.get_int("s").get(3), 3)
    assert_eq(keyed.get_int("s").get(4), 5)
    assert_eq(keyed.get_int("s").total(), 28)
    // empty windows are skipped even across a huge gap
    sparse = Frame.new()
    @sparse.add_int(int_col("ts", [0, 1000000000000]))
    @sparse.add_int(int_col("v", [1, 2]))
    sg = sparse.group_by_dynamic("ts", 5, [], [agg_sum("v", "s")])
    assert_eq(sg.height(), 2)
    assert_eq(sg.get_int("ts").get(1), 1000000000000)
    // unsorted input gives the same windows
    shuffled = fr_ticks().take([6, 3, 0, 5, 2, 1, 4]).group_by_dynamic("ts", 5, [], [agg_sum("v", "s"), agg_first("v", "f"), agg_max("v", "hi")])
    assert_eq(shuffled.get_int("s").get(0), 6)
    assert_eq(shuffled.get_int("f").get(0), 1)
    assert_eq(shuffled.get_int("hi").get(2), 7)
    // mean / min over windows, and a conservation check
    m = fr_ticks().group_by_dynamic("ts", 5, [], [agg_mean("v", "m"), agg_min("v", "lo")])
    assert_eq(m.get_float("m").get(0), 2.0)
    assert_eq(m.get_int("lo").get(2), 6)
}

test "group_by_dynamic overlapping windows, offsets and negatives" {
    ov = fr_ticks().group_by_dynamic_with("ts", 5, 10, 0, [], [agg_sum("v", "s")])
    assert_eq(ov.height(), 4)
    assert_eq(ov.get_int("ts").get(0), -5)
    assert_eq(ov.get_int("ts").get(3), 10)
    assert_eq(ov.get_int("s").get(0), 6)
    assert_eq(ov.get_int("s").get(1), 15)
    assert_eq(ov.get_int("s").get(2), 22)
    assert_eq(ov.get_int("s").get(3), 13)
    off = fr_ticks().group_by_dynamic_with("ts", 5, 5, 2, [], [agg_sum("v", "s")])
    assert_eq(off.get_int("ts").get(0), -3)
    assert_eq(off.get_int("s").get(0), 3)
    assert_eq(off.get_int("s").get(1), 12)
    assert_eq(off.get_int("s").get(2), 6)
    assert_eq(off.get_int("s").get(3), 7)
    neg = Frame.new()
    @neg.add_int(int_col("ts", [-7, -1, 0]))
    @neg.add_int(int_col("v", [1, 1, 1]))
    ng = neg.group_by_dynamic("ts", 5, [], [agg_rows("n")])
    assert_eq(ng.get_int("ts").get(0), -10)
    assert_eq(ng.get_int("ts").get(1), -5)
    assert_eq(ng.get_int("ts").get(2), 0)
    // a period shorter than `every` leaves gaps
    gap = fr_ticks().group_by_dynamic_with("ts", 5, 2, 0, [], [agg_rows("n")])
    assert_eq(gap.get_int("n").total(), 2 + 0 + 1 + 1 + 1)
    // null index rows are ignored; bad arguments give an empty frame
    ix = IntCol.new("ts")
    @ix.push(1)
    @ix.push_null()
    @ix.push(2)
    nf = Frame.new()
    @nf.add_int(ix)
    @nf.add_int(int_col("v", [1, 2, 3]))
    assert_eq(nf.group_by_dynamic("ts", 5, [], [agg_sum("v", "s")]).get_int("s").get(0), 4)
    assert_eq(fr_ticks().group_by_dynamic("ghost", 5, [], []).width(), 0)
    assert_eq(fr_ticks().group_by_dynamic("ts", 0, [], []).width(), 0)
    assert_eq(fr_ticks().group_by_dynamic("ts", 5, ["ghost"], []).width(), 0)
    assert_eq(fr_ticks().group_by_dynamic("k", 5, [], []).width(), 0)
    assert_eq(fr_ticks().group_by_dynamic_with("ts", 5, 0, 0, [], []).width(), 0)
    assert_eq(fr_ticks().filter(expr("v > 100") or fail_expr()).group_by_dynamic("ts", 5, [], [agg_sum("v", "s")]).height(), 0)
}

test "durations and floor division" {
    assert_eq(fr_duration("500ms", 1000), 500)
    assert_eq(fr_duration("30s", 1000), 30000)
    assert_eq(fr_duration("5m", 1), 300)
    assert_eq(fr_duration("2h", 1000), 7200000)
    assert_eq(fr_duration("1d", 1), 86400)
    assert_eq(fr_duration("1w", 1), 604800)
    assert_eq(fr_duration("250us", 1000000), 250)
    assert_eq(fr_duration("7ns", 1000000000), 7)
    assert_eq(fr_duration(" 3s ", 1), 3)
    assert_eq(fr_duration("5", 1), -1)
    assert_eq(fr_duration("ms", 1), -1)
    assert_eq(fr_duration("0s", 1), -1)
    assert_eq(fr_duration("5x", 1), -1)
    assert_eq(fr_duration("", 1), -1)
    assert_eq(fr_floor_div(7, 5), 1)
    assert_eq(fr_floor_div(-7, 5), -2)
    assert_eq(fr_floor_div(-10, 5), -2)
    assert_eq(fr_floor_div(0, 5), 0)
    assert_eq(fr_floor_div(7, -5), -2)
    // group by an hourly window via a parsed duration
    hourly = Frame.new()
    @hourly.add_int(int_col("ts", [10, 3600, 3601, 7300]))
    @hourly.add_int(int_col("v", [1, 1, 1, 1]))
    h = hourly.group_by_dynamic("ts", fr_duration("1h", 1), [], [agg_rows("n")])
    assert_eq(h.get_int("ts").get(1), 3600)
    assert_eq(h.get_int("n").get(1), 2)
    assert_eq(h.get_int("n").get(2), 1)
}

test "selectors: exclude, dtype_cols, numeric_cols" {
    f = fr_sales()
    assert_eq(f.exclude(["price", "rush"])[0], "region")
    assert_eq(host.sys_arr_len(f.exclude(["price", "rush"])), 2)
    assert_eq(host.sys_arr_len(f.exclude([])), 4)
    assert_eq(host.sys_arr_len(f.exclude(["ghost"])), 4)
    assert_eq(f.select(f.exclude(["region"])).width(), 3)
    assert_eq(f.dtype_cols(DT_FLOAT)[0], "price")
    assert_eq(host.sys_arr_len(f.dtype_cols(DT_BOOL)), 1)
    assert_eq(host.sys_arr_len(f.dtype_cols(DT_STR)), 1)
    num = f.numeric_cols()
    assert_eq(host.sys_arr_len(num), 2)
    assert_eq(num[0], "price")
    assert_eq(num[1], "qty")
    assert_eq(f.select_dtype(DT_INT).names[0], "qty")
    assert_eq(f.select_dtype(DT_INT).height(), 6)
    assert_eq(f.select(f.numeric_cols()).get_int("qty").total(), 25)
    #assert(!(Frame.new().numeric_cols()[0] == "x"))
    assert_eq(host.sys_arr_len(Frame.new().dtype_cols(DT_INT)), 0)
}

test "when / then / otherwise and coalesce drive derived columns" {
    f = fr_sales()
    size = f.with_column("size", when_expr(expr("qty > 3") or fail_expr()).then(str_expr("big")).otherwise(str_expr("small")))
    assert_eq(size.kind_of("size"), DT_STR)
    assert_eq(size.get_str("size").get(0), "small")
    assert_eq(size.get_str("size").get(3), "big")
    assert_eq(size.get_str("size").get(5), "big")
    tiers = f.with_column("tier", when_expr(expr("qty >= 10") or fail_expr()).then(int_expr(3)).and_when(expr("qty >= 4") or fail_expr()).then(int_expr(2)).otherwise(int_expr(1)))
    assert_eq(tiers.kind_of("tier"), DT_INT)
    assert_eq(tiers.get_int("tier").total(), 1 + 1 + 1 + 3 + 2 + 2)
    text = f.with_column("size", expr("if(qty > 3, 'big', 'small')") or fail_expr())
    #assert(text.same_as(size))
    // a null condition falls through to the next arm
    n = Frame.new()
    c = IntCol.new("x")
    @c.push(5)
    @c.push_null()
    @c.push(-1)
    @n.add_int(c)
    sign = n.with_column("s", expr("if(x > 0, 'pos', if(x < 0, 'neg', 'unknown'))") or fail_expr())
    assert_eq(sign.get_str("s").get(0), "pos")
    assert_eq(sign.get_str("s").get(1), "unknown")
    assert_eq(sign.get_str("s").get(2), "neg")
    // branches may read different columns
    mixed = f.with_column("m", expr("if(rush, qty * 2, price)") or fail_expr())
    assert_eq(mixed.kind_of("m"), DT_FLOAT)
    assert_eq(mixed.get_float("m").get(0), 6.0)
    assert_eq(mixed.get_float("m").get(1), 20.0)
    // filters may use when too
    assert_eq(f.filter(expr("if(rush, qty > 4, qty < 3)") or fail_expr()).height(), 4)
    // variadic coalesce picks the first non-null
    k = Frame.new()
    a = IntCol.new("a")
    @a.push_null()
    @a.push_null()
    @a.push(1)
    @k.add_int(a)
    b = IntCol.new("b")
    @b.push_null()
    @b.push(2)
    @b.push(3)
    @k.add_int(b)
    co = k.with_column("c", expr("coalesce(a, b, 99)") or fail_expr())
    assert_eq(co.get_int("c").get(0), 99)
    assert_eq(co.get_int("c").get(1), 2)
    assert_eq(co.get_int("c").get(2), 1)
    co2 = k.with_column("c", coalesce_expr([col_expr("a"), col_expr("b")]))
    assert_eq(co2.get_int("c").get(0) , 0)
    #assert(co2.get_int("c").is_null(0))
    assert_eq(co2.get_int("c").get(1), 2)
}

test "concat_str builds text columns" {
    f = Frame.new()
    @f.add_str(str_col("first", ["Ada", "Alan", "Grace"]))
    last = StrCol.new("last")
    @last.push("Lovelace")
    @last.push_null()
    @last.push("Hopper")
    @f.add_str(last)
    @f.add_int(int_col("age", [36, 41, 85]))
    r = f.concat_str(["first", "last"], " ", "full", false)
    assert_eq(r.get_str("full").get(0), "Ada Lovelace")
    #assert(r.get_str("full").is_null(1))
    assert_eq(r.get_str("full").get(2), "Grace Hopper")
    k = f.concat_str(["first", "last", "age"], "-", "full", true)
    assert_eq(k.get_str("full").get(1), "Alan-41")
    assert_eq(k.get_str("full").get(0), "Ada-Lovelace-36")
    assert_eq(f.concat_str(["first"], ",", "x", false).get_str("x").get(2), "Grace")
    assert_eq(f.concat_str(["first", "ghost"], ",", "x", false).width(), 3)
    assert_eq(f.concat_str([], ",", "x", true).get_str("x").get(0), "")
    // the expression form matches
    e = f.with_column("full", expr("concat_str(first, ' ', last)") or fail_expr())
    assert_eq(e.get_str("full").get(0), "Ada Lovelace")
    #assert(e.get_str("full").is_null(1))
    n = f.with_column("tag", expr("concat_str(first, ':', age)") or fail_expr())
    assert_eq(n.get_str("tag").get(1), "Alan:41")
    assert_eq(f.with_column("j", concat_str_expr([col_expr("first"), col_expr("age")], "/")).get_str("j").get(2), "Grace/85")
}

test "fr_concat stacks many frames and keeps dtypes" {
    f = fr_sales()
    parts = [fr_slice(f, 0, 2), fr_slice(f, 2, 3), fr_slice(f, 5, 10)]
    c = fr_concat(parts)
    #assert(c.same_as(f))
    assert_eq(fr_slice(f, 4, 100).height(), 2)
    assert_eq(fr_slice(f, 6, 3).height(), 0)
    assert_eq(fr_concat([]).width(), 0)
    #assert(fr_concat([f]).same_as(f))
    // all-empty keeps the typed schema
    empty = f.take([])
    e2 = fr_concat([empty, empty])
    assert_eq(e2.height(), 0)
    assert_eq(e2.kind_of("qty"), DT_INT)
    // an all-null batch does not change the dtype of the column
    n = Frame.new()
    c1 = StrCol.new("s")
    @c1.push_null()
    @c1.push_null()
    @n.add_str(c1)
    m = Frame.new()
    @m.add_str(str_col("s", ["z"]))
    nm = fr_concat([n, m])
    assert_eq(nm.kind_of("s"), DT_STR)
    assert_eq(nm.get_str("s").null_count(), 2)
    // a dtype mismatch is re-inferred
    ia = Frame.new()
    @ia.add_int(int_col("v", [1, 2]))
    fb = Frame.new()
    @fb.add_float(float_col("v", [0.5]))
    assert_eq(fr_concat([ia, fb, ia]).kind_of("v"), DT_FLOAT)
    assert_eq(fr_concat([ia, fb]).get_float("v").total(), 3.5)
    // schema mismatches give an empty frame
    assert_eq(fr_concat([f, f.drop(["rush"])]).width(), 0)
    assert_eq(fr_concat([f, f.rename("qty", "q")]).width(), 0)
}

test "sorting, windows and dynamic groups are exact beyond 2^53" {
    big = 1700000000000000000
    f = Frame.new()
    @f.add_int(int_col("t", [big + 3, big + 1, big + 2, big, big + 1]))
    @f.add_int(int_col("id", [0, 1, 2, 3, 4]))
    up = f.sort_by("t", false)
    assert_eq(up.get_int("id").get(0), 3)
    assert_eq(up.get_int("id").get(1), 1)
    assert_eq(up.get_int("id").get(2), 4)
    assert_eq(up.get_int("id").get(3), 2)
    assert_eq(up.get_int("id").get(4), 0)
    down = f.sort_by("t", true)
    assert_eq(down.get_int("id").get(0), 0)
    assert_eq(down.get_int("id").get(4), 3)
    neg = Frame.new()
    @neg.add_int(int_col("t", [0 - big, big, 0 - big - 1, 5, 0 - 5]))
    @neg.add_int(int_col("id", [0, 1, 2, 3, 4]))
    n = neg.sort_by("t", false)
    assert_eq(n.get_int("id").get(0), 2)
    assert_eq(n.get_int("id").get(1), 0)
    assert_eq(n.get_int("id").get(2), 4)
    assert_eq(n.get_int("id").get(3), 3)
    assert_eq(n.get_int("id").get(4), 1)
    r = f.over([], ["t"], [win_row_number("rn")])
    assert_eq(r.get_int("rn").get(3), 1)
    assert_eq(r.get_int("rn").get(0), 5)
    w = f.group_by_dynamic("t", 2, [], [agg_rows("n")])
    assert_eq(w.get_int("n").total(), 5)
    assert_eq(w.get_int("t").get(0), big)
}
