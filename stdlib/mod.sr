/// How many modules the manifest lists.
+stdlib_count() : i64 => host.sys_arr_len(stdlib_table()) / 3

/// Import path of module `i` (0-based).
+stdlib_path(i: i64) : str => stdlib_table()[i * 3]

/// Layer name of module `i`.
+stdlib_layer(i: i64) : str => stdlib_table()[i * 3 + 1]

/// One-line summary of module `i`.
+stdlib_summary(i: i64) : str => stdlib_table()[i * 3 + 2]

/// Index of a module by dotted path, or -1.
+stdlib_find(path: str) : i64 {
    t = stdlib_table()
    n = host.sys_arr_len(t) / 3
    pos = -1
    for 0..n {
        if pos < 0 && t[it * 3] == path { pos = it }
    }
    pos
}

/// True when the manifest lists the module path `path`.
+stdlib_has(path: str) : bool => stdlib_find(path) >= 0

/// Number of modules in a layer.
+stdlib_layer_count(layer: str) : i64 {
    t = stdlib_table()
    n = host.sys_arr_len(t) / 3
    c = 0
    for 0..n {
        if t[it * 3 + 1] == layer { c += 1 }
    }
    c
}

/// `use` line for the manifest path `path`.
+stdlib_import_line(path: str) : str => "use std." + path

test "manifest lists all shipped modules" {
    assert_eq(stdlib_count(), host.sys_arr_len(stdlib_table()) / 3)
    assert_eq(stdlib_path(0), "core.bitset")
    assert_eq(stdlib_layer(0), "core")
    #assert(stdlib_has("cli.cmd"))
    #assert(stdlib_has("tui.ui"))
    #assert(stdlib_has("gui.ui"))
    #assert(stdlib_has("gui.window"))
    #assert(stdlib_has("game.netcode"))
    #assert(stdlib_has("sys.epoll"))
    #assert(stdlib_has("datetime.core"))
    #assert(stdlib_has("core.int"))
    #assert(stdlib_has("html.core"))
    #assert(stdlib_has("html.template"))
    #assert(stdlib_has("sec.csprng"))
    #assert(stdlib_has("fmt.protobuf"))
    #assert(stdlib_has("io.poll"))
    #assert(stdlib_has("net.tls"))
    #assert(!(stdlib_has("ai.openai")))
    #assert(!(stdlib_has("db.supabase")))
    assert_eq(host.sys_arr_len(stdlib_table()) % 3, 0)
    assert_eq(stdlib_count(), 127)
}

test "lookup by path" {
    #assert(stdlib_has("game.ecs"))
    #assert(stdlib_has("net.url"))
    #assert(stdlib_has("math.fft"))
    #assert(stdlib_has("sys.ffi"))
    #assert(stdlib_has("core.unicode"))
    #assert(stdlib_has("fmt.yaml"))
    #assert(stdlib_has("fmt.xlsx"))
    #assert(stdlib_has("data.frame"))
    #assert(stdlib_has("data.plan"))
    #assert(stdlib_has("math.special"))
    #assert(stdlib_has("math.integrate"))
    #assert(stdlib_has("sec.x509"))
    #assert(!(stdlib_has("io.uring")))
    #assert(!(stdlib_has("io.epoll")))
    #assert(!(stdlib_has("net.poll")))
    assert_eq(stdlib_import_line("sys.io_uring"), "use std.sys.io_uring")
    assert_eq(stdlib_find("x"), -1)
    assert_eq(stdlib_summary(stdlib_find("sec.jwt")), "HS256 JSON Web Tokens")
}

test "layers partition the table" {
    assert_eq(stdlib_layer_count("core"), 12)
    assert_eq(stdlib_layer_count("fmt"), 11)
    assert_eq(stdlib_layer_count("sys"), 13)
    assert_eq(stdlib_layer_count("datetime"), 2)
    assert_eq(stdlib_layer_count("io"), 7)
    assert_eq(stdlib_layer_count("net"), 15)
    assert_eq(stdlib_layer_count("db"), 7)
    assert_eq(stdlib_layer_count("sec"), 12)
    assert_eq(stdlib_layer_count("math"), 16)
    assert_eq(stdlib_layer_count("data"), 5)
    assert_eq(stdlib_layer_count("game"), 9)
    assert_eq(stdlib_layer_count("cli"), 1)
    assert_eq(stdlib_layer_count("ai"), 5)
    assert_eq(stdlib_layer_count("tui"), 1)
    assert_eq(stdlib_layer_count("gui"), 4)
    assert_eq(stdlib_layer_count("html"), 3)
    assert_eq(stdlib_layer_count("diag"), 4)
    assert_eq(stdlib_layer_count("other"), 0)
    total = 0
    for ["core", "fmt", "sys", "datetime", "io", "net", "db", "sec", "math", "data", "game", "cli", "ai", "tui", "gui", "html", "diag"] {
        total += stdlib_layer_count(it)
    }
    assert_eq(total, stdlib_count())
}
test "import lines" {
    assert_eq(stdlib_import_line("game.ecs"), "use std.game.ecs")
    assert_eq(STDLIB_VERSION, "0.1.0")
}

test "every listed module has a source file when run from the repo" {
    n = stdlib_count()
    present = 0
    for 0..n {
        rel = "stdlib/" + stdlib_path(it)
        parts = ""
        for 0..(host.sys_str_len(rel)) {
            ch = rel[it]
            if ch == "." { parts = parts + "/" } else { parts = parts + ch }
        }
        if host.sys_exists(parts + ".sr") { present += 1 }
    }
    if host.sys_exists("stdlib/mod.sr") {
        return assert_eq(present, n)
    }
    #assert(present >= 0)
}
