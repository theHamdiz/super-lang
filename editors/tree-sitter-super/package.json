{
  "name": "tree-sitter-super",
  "version": "0.1.0",
  "description": "Tree-sitter grammar for the Super programming language",
  "main": "bindings/node",
  "keywords": ["tree-sitter", "super"],
  "license": "MIT",
  "tree-sitter": [
    {
      "scope": "source.sr",
      "file-types": ["sr"]
    }
  ],
  "scripts": {
    "build": "tree-sitter generate && tree-sitter build --wasm",
    "test": "tree-sitter test"
  },
  "devDependencies": {
    "tree-sitter-cli": "^0.25.6"
  }
}
