{
  "grammars": [
    {
      "name": "super",
      "camelcase": "Super",
      "scope": "source.sr",
      "path": ".",
      "file-types": ["sr"],
      "highlights": ["queries/highlights.scm"],
      "injection-regex": "sr"
    }
  ],
  "metadata": {
    "version": "0.1.0",
    "license": "MIT",
    "description": "Super grammar for tree-sitter",
    "authors": [{ "name": "Super Contributors" }],
    "links": {
      "repository": "https://github.com/theHamdiz/super-lang"
    }
  },
  "bindings": {
    "c": true,
    "go": false,
    "node": false,
    "python": false,
    "rust": false,
    "swift": false,
    "zig": false
  }
}
