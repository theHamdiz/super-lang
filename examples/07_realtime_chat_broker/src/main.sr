// Multi-room chat broker — chan[Message], when+after heartbeats, shared registry
//
// Run: super test examples/07_realtime_chat_broker/

use std.net.ws
use std.core.collections

WireKind = {
    Chat
    Join
    Part
    Ping
}

#WIRE_OPS = WireKind.variants
#ENCODER_SCHEMA = #WIRE_OPS.join(", ")
#WIRE_KIND_COUNT = 4

+Message = {
    room: str = ""
    user: str = ""
    body: str = ""
}

+Presence = {
    user: str = ""
    online: bool = true
}

/// Append one chat message to a room log; returns the new length.
+publish(room: str, user: str, body: str, log: _) : _ {
    arr_push(log, Message{room, user, body})
}

/// Fan-out `msgs` across `rooms` room logs (deterministic, no spawn deadlock).
+broker_tick(msgs: i64, rooms: i64) : i64 {
    logs = []
    for 0..rooms {
        logs = arr_push(logs, [])
    }
    for i in 0..msgs {
        room = i % rooms
        logs[room] = publish("room{room}", "u{i}", "hi", logs[room])
    }
    // Concurrent delivery count via channel + worker (single room smoke).
    inbox = chan[Message](64)
    delivered = shared 0
    scope {
        worker = spawn {
            n = 0
            for _m in inbox {
                @delivered += 1
                n += 1
            }
            n
        }
        for row in logs[0] {
            inbox.send(row)
        }
        select {
            after 1.ms => 1
        }
        inbox.close()
        await worker
    }
    total = 0
    for log in logs {
        total += len(log)
    }
    total + delivered.load()
}

+wire_tags() : str {
    #ENCODER_SCHEMA
}

+room_count(n: i64) : i64 {
    rooms = shared 0
    par 0..n {
        @rooms += 1
    }
    rooms.load()
}

test "publish routes into room log" {
    log = []
    log = publish("general", "amina", "hello", log)
    assert_eq(len(log), 1)
    assert_eq(log[0].room, "general")
    assert_eq(log[0].user, "amina")
    assert_eq(log[0].body, "hello")
}

test "broker multi-room broadcast" {
    // 6 messages across 3 rooms → 6 in logs + len(logs[0]) channel deliveries
    // room0 gets messages 0,3 → 2 deliveries; total = 6 + 2 = 8
    assert_eq(broker_tick(6, 3), 8)
}

test "shared room registry parallel" {
    assert_eq(room_count(20), 20)
}

test "presence struct" {
    p = Presence{user: "amina", online: true}
    #assert(p.online)
}

test "comptime wire encoder" {
    assert_eq(#WIRE_KIND_COUNT, 4)
    assert_eq(wire_tags(), "Chat, Join, Part, Ping")
}

test "stdlib: ws frame encode/decode round trip" {
    wire = ws_encode(ws_text("hi room"), 0) or []
    #assert(len(wire) > 0)
    f = ws_decode(wire) or ws_close(1002, "bad")
    assert_eq(ws_text_of(f), "hi room")
    assert_eq(ws_close_code(ws_close(WS_CLOSE_NORMAL, "bye")), 1000)
}
