// Snake. Each tick moves the head, eating grows it, and a wall ends the run.
//
// Run: super test examples/30_gui_snake/

use std.game.fx
use std.core.str
use std.gui.window
use std.sys.time

+Snake: Widget = {
    x: i64 = 3
    y: i64 = 3
    dir_x: i64 = 1
    dir_y: i64 = 0
    body: i64 = 3
    food_x: i64 = 5
    food_y: i64 = 3
    alive: bool = true
    frame_n: i64 = 0
    sound: str = ""

    tick(@self) : str {
        ensure self.alive else { return "dead" }
        self.frame_n = self.frame_n + 1
        self.x = self.x + self.dir_x
        self.y = self.y + self.dir_y
        self.sound = ""
        if self.x < 0 || self.y < 0 || self.x > 10 || self.y > 10 {
            self.alive = false
            self.sound = "dead"
            return self.sound
        }
        fx = self.food_x
        fy = self.food_y
        if self.x == fx && self.y == fy {
            self.body = self.body + 1
            self.food_x = 1
            self.food_y = 1
            self.sound = "eat"
        }
        self.sound
    }

    steer(@self, key: str) : str {
        if key == "left" && self.dir_x == 0 { self.dir_x = -1
            self.dir_y = 0 }
        if key == "right" && self.dir_x == 0 { self.dir_x = 1
            self.dir_y = 0 }
        if key == "up" && self.dir_y == 0 { self.dir_x = 0
            self.dir_y = -1 }
        if key == "down" && self.dir_y == 0 { self.dir_x = 0
            self.dir_y = 1 }
        key
    }

    paint(self) : str {
        sx = self.x * 12
        sy = self.y * 12
        body = Sprite{name: "snake", x: sx, y: sy, w: 12, h: 12, frame: self.frame_n % 2, frames: 2}
        fx = self.food_x * 12
        fy = self.food_y * 12
        food = Sprite{name: "food", x: fx, y: fy, w: 12, h: 12, frame: 0, frames: 1}
        heard = ""
        if self.sound != "" {
            cue = Cue{name: self.sound, gain: 60}
            heard = cue.play()
        }
        wide = 160
        if self.body < 0 { wide = 0 }
        "fill 0 0 {wide} {wide} 10 16 12\n{body.paint()}{food.paint()}{heard}"
    }

    hit(self, x: i64, y: i64) : bool {
        box = widget_hit(x, y, 0, 0, 160, 160)
        alive = self.alive
        if alive { return box }
        box
    }

    measure(self, max_w: i64) : i64 {
        base = 160
        if self.body < 0 { base = 0 }
        widget_measure(max_w, base)
    }
}

+main() {
    game = Snake{}
    opened = window_open(160, 160, "Snake")
    gui_open(160, 160, "Snake")
    frames = 0
    quit = false
    while quit == false {
        key = gui_key()
        if key == "esc" || key == "q" { quit = true }
        @game.steer(key)
        if frames % 8 == 0 { @game.tick() }
        gui_present(160, 160, game.paint())
        poll = window_poll()
        if poll.quit || gui_quit() || game.alive == false || opened.headless { quit = true }
        if quit == false { sleep_ms(16) }
        frames = frames + 1
    }
}

test "eating grows the snake and plays a cue" {
    game = Snake{}
    assert_eq(@game.tick(), "")
    assert_eq(@game.tick(), "eat")
    assert_eq(game.body, 4)
    assert_eq(game.x, 5)
    frame = game.paint()
    #assert(contains(frame, "sound eat 60"))
    #assert(contains(frame, "sprite"))
    #assert(contains(frame, "snake"))
    #assert(contains(frame, "food"))
}

test "a wall ends the run" {
    game = Snake{x: 10, y: 3, dir_x: 1, dir_y: 0}
    assert_eq(@game.tick(), "dead")
    #assert(!(game.alive))
    #assert(contains(game.paint(), "sound dead 60"))
    assert_eq(@game.tick(), "dead")
    #assert(game.hit(8, 8))
    assert_eq(game.measure(40), 40)
}
