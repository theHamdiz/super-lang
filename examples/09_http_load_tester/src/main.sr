// Concurrent HTTP load tester — scope workers + chan[Sample] histograms
//
// Run: super test examples/09_http_load_tester/

use std.net.http
use std.diag.metrics
use std.cli.cmd
use std.tui

#HIST_BOUNDS = #for i in 0..6 { i * 200 }
#HIST_BUCKET_COUNT = 6

+Sample = {
    latency_us: i64 = 0
    status: i64 = 200
}

+percentile(sorted_n: i64, p: i64) : i64 {
    (sorted_n * p) / 100
}

+bench_app() : App {
    app = App.new()
    @app.get("/bench", |_req| { ok({ok: true}) })
}

+plan_from(argv: _) : i64 {
    m = Command.new("load")
        .opt("workers", "w", "N", "2", "workers", false)
        .as_int()
        .opt("reqs", "n", "N", "3", "requests each", false)
        .as_int()
        .parse(argv) or err { return run_load(2, 3) }
    run_load(m.get_int("workers", 2), m.get_int("reqs", 3))
}

+load_bar(done: i64, total: i64) : str {
    view = Screen.new(10, 1)
    ratio = 0.0
    if total > 0 { ratio = (done * 1.0) / total }
    @view.gauge(Rect.new(0, 0, 10, 1), ratio, "")
    view.row(0)
}

+run_load(workers: i64, reqs: i64) : i64 {
    app = bench_app()
    samples = chan[Sample](256)
    _ok = shared 0
    scope {
        collector = spawn {
            n = 0
            for _s in samples {
                @_ok += 1
                n += 1
            }
            n
        }
        for 0..workers {
            w = spawn {
                for i in 0..reqs {
                    res = @app.handle(request("GET", "/bench", ""))
                    samples.send(Sample{latency_us: 100 + i, status: res.status})
                }
                reqs
            }
            await w
        }
        samples.close()
        collected = await collector
        collected + _ok.load()
    }
}

+hist_p99(n: i64) : i64 {
    percentile(n, 99)
}

+bucket_for(latency_us: i64) : i64 {
    b = 0
    for bound in #HIST_BOUNDS {
        if latency_us >= bound {
            b += 1
        }
    }
    b
}

test "app.handle bench route" {
    app = bench_app()
    res = @app.handle(request("GET", "/bench", ""))
    assert_eq(res.status, 200)
}

test "percentile index" {
    assert_eq(percentile(100, 50), 50)
    assert_eq(hist_p99(1000), 990)
}

test "load workers stream samples" {
    // 2 workers * 3 reqs = 6 samples; collector + shared = 12
    assert_eq(run_load(2, 3), 12)
    assert_eq(plan_from([]), 12)
    assert_eq(plan_from(["-w", "1", "-n", "1"]), run_load(1, 1))
    #assert(contains(load_bar(10, 10), "\u{2588}"))
    #assert(contains(load_bar(0, 10), "\u{2591}"))
}

test "comptime histogram bounds" {
    assert_eq(#HIST_BUCKET_COUNT, 6)
    assert_eq(bucket_for(350), 2)
    assert_eq(bucket_for(1000), 6)
}

test "stdlib: metrics histogram records latencies for http responses" {
    m = Metrics.new()
    @m.histogram("latency_us", [200.0, 400.0, 800.0])
    for [150, 350, 700, 900] { @m.observe("latency_us", it) }
    assert_eq(m.hist_count("latency_us"), 4)
    res = http.ok(.{ok: true})
    @m.inc("responses", 1)
    assert_eq(m.counter("responses"), 1)
    assert_eq(res.status, 200)
}
