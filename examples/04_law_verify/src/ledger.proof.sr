//! AI-authored lemmas for ledger laws.

#proof(transfer_conserves_total)
prove_transfer_conserves(src: Account, dst: Account, amount: i64) {
    #assert(src.balance - amount + (dst.balance + amount) == src.balance + dst.balance)
}

#proof(add_comm)
prove_add_comm(a: i64, b: i64) {
    #assert(a + b == b + a)
}
