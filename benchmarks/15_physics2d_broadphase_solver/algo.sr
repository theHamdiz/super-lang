// 15_physics2d_broadphase_solver - 6k circles/boxes: uniform spatial-hash broadphase,
// circle/box manifolds, sequential-impulse solver (4 iterations x 10 steps), all via
// std.game.physics2d (p2_world / p2_add / p2_step).
use std.game.physics2d

+COLS = 100
+ROWS = 60
+N_DYN = 6000
+FLOOR_TILES = 62
+WALL_TILES = 40
+STEPS = 10
+MOD = 1000000007

#inline
+draw(@rng, m: i64) : i64 {
    rng[0] = (rng[0] * 1103515245 + 12345) % 2147483648
    rng[0] / 256 % m
}

#inline
+fl(v: f64) : i64 => to_int(floor(v))

#inline
+posmod(v: i64) : i64 => ((v % MOD) + MOD) % MOD

+build_world() : World2D {
    w = p2_world(0.0, -9.81)
    for k in 0..FLOOR_TILES { @w.p2_add(p2_box(1.0 + 2.0 * k, -1.0, 1.0, 1.0, 0.0)) }
    for k in 0..WALL_TILES { @w.p2_add(p2_box(-1.0, 1.0 + 2.0 * k, 1.0, 1.0, 0.0)) }
    for k in 0..WALL_TILES { @w.p2_add(p2_box(122.0, 1.0 + 2.0 * k, 1.0, 1.0, 0.0)) }
    rng = [150015]
    // One bulk append (avoids O(n²) per-body `p2_add` copies).
    lattice = []
    for i in 0..N_DYN {
        kind = draw(@rng, 3)
        sw = 0.35 + draw(@rng, 400001) * 0.000001
        sh = 0.35 + draw(@rng, 400001) * 0.000001
        mass = 1.0 + draw(@rng, 4)
        jx = (draw(@rng, 600001) - 300000) * 0.000001
        jy = (draw(@rng, 600001) - 300000) * 0.000001
        vx = (draw(@rng, 8000001) - 4000000) * 0.000001
        vy = (draw(@rng, 8000001) - 4000000) * 0.000001
        x = 0.75 + (i % COLS) * 1.2 + jx
        y = 1.75 + (i / COLS) * 1.2 + jy
        b = if kind == 0 { p2_box(x, y, sw, sh, mass) } else { p2_circle(x, y, sw, mass) }
        b.vx = vx
        b.vy = vy
        lattice = arr_push(lattice, b)
    }
    @w.p2_add_all(lattice)
    w
}

+main() {
    w = build_world()
    cs = 0
    for s in 0..STEPS { cs += @w.p2_step(1.0 / 60.0) * (s + 1) }
    h = 0
    for i in 0..arr_len(w.bodies) {
        b = w.bodies[i]
        h = (h * 131 + posmod(fl(b.x * 1000.0))) % MOD
        h = (h * 131 + posmod(fl(b.y * 1000.0))) % MOD
        h = (h * 131 + posmod(fl(b.vx * 1000.0))) % MOD
        h = (h * 131 + posmod(fl(b.vy * 1000.0))) % MOD
    }
    cs += h + fl(p2_kinetic_energy(w) * 10.0)
    print("CHECKSUM={cs}")
}
