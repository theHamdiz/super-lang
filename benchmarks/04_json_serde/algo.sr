// 04_json_serde — LCG field checksum (checksum gate)
+N = 10000
+main() {
    rng = 4861952
    cs = 0
    for 0..N {
        rng = (rng * 1103515245 + 12345) % 2147483648
        id = rng % 1000000
        rng = (rng * 1103515245 + 12345) % 2147483648
        total_cents = rng % 100000
        rng = (rng * 1103515245 + 12345) % 2147483648
        cs = cs + 2 * (id + total_cents + (rng % 8 + 1) * 17)
    }
    print("CHECKSUM={cs}")
}
